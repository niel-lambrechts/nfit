class IncompleteResponseError(Exception):
    """A chunked InfluxQL response ended before its final chunk."""


class InfluxQueryError(Exception):
    """InfluxDB reported an error for a query; retrying cannot help."""


def utc_date_to_ns(date_str, hh_mm_ss='00:00:00'):
    """Exact integer nanoseconds since the epoch for a UTC date and time."""
    t = time.strptime(f'{date_str} {hh_mm_ss}', '%Y-%m-%d %H:%M:%S')
    return calendar.timegm(t) * NS_PER_SECOND


def build_time_slices(start_ns, end_exclusive_ns, slice_ns):
    """Half-open slices [s, e) that cover [start_ns, end_exclusive_ns) exactly,
    with no gap and no overlap."""
    if slice_ns <= 0:
        raise ValueError('slice length must be positive')
    slices = []
    s = start_ns
    while s < end_exclusive_ns:
        e = min(s + slice_ns, end_exclusive_ns)
        slices.append((s, e))
        s = e
    return slices


def ns_to_legacy_timestamp(ns):
    """'YYYY-MM-DD HH:MM:SS' (UTC) with the sub-second part discarded, exactly
    as the former parse-then-strftime path produced it."""
    return time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(ns // NS_PER_SECOND))


def ns_to_utc_datetime(ns):
    """Timezone-aware UTC datetime truncated to the second. Every consumer of
    the acquisition minimum and maximum uses second resolution (strftime or
    int(timestamp())), so truncation preserves their results."""
    return datetime.fromtimestamp(ns // NS_PER_SECOND, tz=timezone.utc)


def _msgpack_ext_hook(code, data):
    """InfluxDB MessagePack extension 5 is a timestamp: big-endian unsigned
    seconds then nanoseconds. Decode it to exact integer nanoseconds. Only a
    query without epoch= produces it; epoch=ns returns plain integers."""
    import msgpack
    import struct
    if code == 5:
        seconds, nanos = struct.unpack('>QI', data)
        return seconds * NS_PER_SECOND + nanos
    return msgpack.ExtType(code, data)


def _open_query_stream(client, params):
    """
    Issues a GET /query through the client's own session, URL, credentials,
    headers, proxies, TLS and timeout settings, and returns the unread
    streaming response.

    InfluxDBClient.request() cannot be used: for a MessagePack response it reads
    and unpacks the whole body before returning, even with stream=True, and
    fails on a chunked body of concatenated objects. Forcing JSON instead is
    not equivalent, because the server's JSON encoder writes whole-number
    floats as integers (1.0 as 1), whereas MessagePack keeps the field type
    that the legacy client.query() path wrote to the cache.
    """
    from influxdb.exceptions import InfluxDBClientError, InfluxDBServerError

    try:
        session, baseurl, headers = client._session, client._baseurl, dict(client._headers)
        username, password = client._username, client._password
        proxies, verify, timeout = client._proxies, client._verify_ssl, client._timeout
    except AttributeError as exc:
        raise RuntimeError(f'unsupported influxdb client version: {exc}') from exc

    auth = None if 'Authorization' in headers else (username, password)
    if auth is not None and None in auth:
        auth = None
    response = session.request(method='GET', url=f'{baseurl}/query', auth=auth,
                               params=params, stream=True, headers=headers,
                               proxies=proxies, verify=verify, timeout=timeout)
    if response.status_code == 200:
        return response
    try:
        body = response.content
    finally:
        response.close()
    if 500 <= response.status_code < 600:
        raise InfluxDBServerError(body)
    raise InfluxDBClientError(body, response.status_code)


def _iter_response_chunks(response, meter=None):
    """Yields each decoded chunk object of a chunked /query response, in the
    encoding the server chose: concatenated MessagePack objects, or one JSON
    object per line. Raises IncompleteResponseError on a truncated object.
    If given, meter.bytes is increased by the response body bytes read."""
    content_type = (response.headers.get('Content-Type') or '').split(';')[0].strip()
    if content_type == 'application/x-msgpack':
        import msgpack
        unpacker = msgpack.Unpacker(raw=False, ext_hook=_msgpack_ext_hook)
        fed = 0
        for block in response.iter_content(chunk_size=65536):
            if not block:
                continue
            unpacker.feed(block)
            fed += len(block)
            if meter is not None:
                meter.bytes += len(block)
            for chunk in unpacker:
                yield chunk
        if hasattr(unpacker, 'tell') and unpacker.tell() != fed:
            raise IncompleteResponseError(
                f'truncated chunk: {fed - unpacker.tell()} byte(s) left undecoded')
        return
    for raw in response.iter_lines():
        if meter is not None:
            meter.bytes += len(raw) + 1
        if not raw:
            continue
        try:
            yield json.loads(raw.decode('utf-8') if isinstance(raw, bytes) else raw)
        except ValueError as exc:
            raise IncompleteResponseError(f'truncated chunk: {exc}') from exc


def iter_influxql_points(client, database, query, chunk_size, meter=None):
    """
    Streams one InfluxQL v1 SELECT as (tags, point) pairs. Timestamps are exact
    integer nanoseconds (epoch=ns) and fields are addressed by name.

    The HTTP response is chunked and decoded incrementally, so memory is bounded
    by the chunk size rather than the result size. The client's default Accept
    header (MessagePack for the v1 client) is kept, so field values keep the
    types the legacy acquisition wrote; a JSON response is also accepted.
    Completion is verified: every chunk but the last carries "partial": true, so
    a stream that ends on a partial chunk, delivers no chunk at all, or breaks
    off mid-transfer raises IncompleteResponseError. An error reported in any
    chunk raises InfluxQueryError. An optional meter accumulates response bytes.
    """
    import requests  # dependency of the influxdb client package

    params = {'q': query, 'db': database, 'epoch': 'ns',
              'chunked': 'true', 'chunk_size': int(chunk_size)}
    response = _open_query_stream(client, params)
    saw_chunk = False
    last_partial = False
    try:
        for chunk in _iter_response_chunks(response, meter):
            saw_chunk = True
            if 'error' in chunk:
                raise InfluxQueryError(chunk['error'])
            results = chunk.get('results', [])
            last_partial = any(r.get('partial') for r in results)
            for result in results:
                if 'error' in result:
                    raise InfluxQueryError(result['error'])
                for series in result.get('series', []):
                    tags = series.get('tags') or {}
                    columns = series.get('columns', [])
                    for values in series.get('values', []):
                        yield tags, dict(zip(columns, values))
    except requests.exceptions.RequestException as exc:
        raise IncompleteResponseError(f'response interrupted: {exc}') from exc
    finally:
        response.close()
    if not saw_chunk:
        raise IncompleteResponseError('no chunk received')
    if last_partial:
        raise IncompleteResponseError('stream ended on a partial chunk')


class AcquisitionStats:
    """Per-metric acquisition counters, reported after each metric."""

    def __init__(self):
        self.rows = 0
        self.null_values = 0
        self.no_host = 0
        self.exact_duplicates = 0       # same host, same nanosecond
        self.same_second = 0            # same host and second, different nanosecond
        self.out_of_order = 0           # earlier than the previous point of its host
        self.slice_retries = 0
        self.optional_without_primary = 0   # optional values on points lacking the row's field
        self.vms = set()
        self.min_ns = None
        self.max_ns = None
        self.last_ns_by_vm = {}         # the last sample written for each VM (D-025)

    def merge(self, other):
        for vm, ns in other.last_ns_by_vm.items():
            if ns > self.last_ns_by_vm.get(vm, -1):
                self.last_ns_by_vm[vm] = ns
        for name in ('rows', 'null_values', 'no_host', 'exact_duplicates',
                     'same_second', 'out_of_order', 'slice_retries', 'optional_without_primary'):
            setattr(self, name, getattr(self, name) + getattr(other, name))
        self.vms |= other.vms
        for ns in (other.min_ns, other.max_ns):
            if ns is None:
                continue
            self.min_ns = ns if self.min_ns is None else min(self.min_ns, ns)
            self.max_ns = ns if self.max_ns is None else max(self.max_ns, ns)

    def anomalies(self):
        return {k: v for k, v in (('null values skipped', self.null_values),
                                  ('series without host', self.no_host),
                                  ('exact duplicate timestamps', self.exact_duplicates),
                                  ('same-second timestamps', self.same_second),
                                  ('out-of-order points', self.out_of_order),
                                  ('slice retries', self.slice_retries),
                                  ('optional values on points without the row field',
                                   self.optional_without_primary)) if v}


def acquire_metric_to_file(client, database, measurement, field, entity_filter,
                           slices, chunk_size, out_fh, verbose=False, extra_fields=()):
    """
    Acquires one field across half-open time slices and appends rows to out_fh
    in the temporary-file format (timestamp,vm_name,value; no header line).

    extra_fields (schema 2) are further fields of the same points, written as
    additional cells after the value: timestamp,vm_name,value,extra1,... An
    entry of None is a declared but unavailable field: its cell is blank and
    it is not selected. A row is written only when `field` itself has a value,
    exactly as without extra fields; extra values on points without it are
    counted, never written on their own and never turned into zero.

    A slice whose response is interrupted is rolled back (the file is truncated
    to the slice's starting offset) and queried again, up to SLICE_ATTEMPTS
    times. Rows are written exactly as before: values via str(), timestamps at
    second resolution, duplicates retained (they are counted, not removed).
    """
    import requests
    from influxdb.exceptions import InfluxDBServerError

    # Transient failures: interrupted or truncated transfers, connection
    # errors and HTTP 5xx. Query errors (InfluxQueryError, HTTP 4xx) are
    # deterministic and fail immediately.
    retryable = (IncompleteResponseError, requests.exceptions.RequestException, InfluxDBServerError)

    total = AcquisitionStats()
    for slice_start, slice_end in slices:
        selected = ''.join(f', "{x}"' for x in extra_fields if x)
        query = (f'SELECT "{field}"{selected} FROM "{measurement}" WHERE {entity_filter} '
                 f'AND time >= {slice_start} AND time < {slice_end} GROUP BY "host"')
        attempt = 0
        while True:
            attempt += 1
            out_fh.flush()
            mark = out_fh.tell()
            part = AcquisitionStats()
            last_ns_by_host = {}
            try:
                for tags, point in iter_influxql_points(client, database, query, chunk_size):
                    vm_name = tags.get('host')
                    if not vm_name:
                        part.no_host += 1
                        continue
                    part.vms.add(vm_name)
                    value = point.get(field)
                    if value is None:
                        part.null_values += 1
                        if any(x and point.get(x) is not None for x in extra_fields):
                            part.optional_without_primary += 1
                        continue
                    ts_ns = int(point['time'])
                    previous = last_ns_by_host.get(vm_name)
                    if previous is not None:
                        if ts_ns == previous:
                            part.exact_duplicates += 1
                        elif ts_ns < previous:
                            part.out_of_order += 1
                        elif ts_ns // NS_PER_SECOND == previous // NS_PER_SECOND:
                            part.same_second += 1
                    last_ns_by_host[vm_name] = ts_ns
                    if ts_ns > part.last_ns_by_vm.get(vm_name, -1):
                        part.last_ns_by_vm[vm_name] = ts_ns
                    part.min_ns = ts_ns if part.min_ns is None else min(part.min_ns, ts_ns)
                    part.max_ns = ts_ns if part.max_ns is None else max(part.max_ns, ts_ns)
                    extras = ''.join(',' + ('' if not x or point.get(x) is None else str(point[x]))
                                     for x in extra_fields)
                    out_fh.write(f"{ns_to_legacy_timestamp(ts_ns)},{vm_name},{value}{extras}\n")
                    part.rows += 1
                break
            except retryable as exc:
                out_fh.seek(mark)
                out_fh.truncate()
                if attempt >= SLICE_ATTEMPTS:
                    raise RuntimeError(
                        f'{measurement}.{field}: slice [{slice_start}, {slice_end}) failed after '
                        f'{attempt} attempts: {exc}') from exc
                delay = SLICE_RETRY_DELAY_S * (2 ** (attempt - 1))
                print(f"\n    WARNING: {measurement}.{field} slice [{slice_start}, {slice_end}) "
                      f"attempt {attempt} failed ({exc}); retrying in {delay}s.", file=sys.stderr)
                total.slice_retries += 1
                time.sleep(delay)
        total.merge(part)
    return total


# --- Helper Functions ---
class FcntlLock:
    """A context manager for file locking using the native fcntl module."""
    def __init__(self, lock_path, timeout=10):
        self.lock_path = lock_path
        self.timeout = timeout
        self.lock_file = None

    def __enter__(self):
        start_time = time.time()
        self.lock_file = open(self.lock_path, 'a')
        while time.time() - start_time < self.timeout:
            try:
                fcntl.flock(self.lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.lock_file.write(str(os.getpid()))
                self.lock_file.flush()
                return self
            except (IOError, BlockingIOError):
                time.sleep(0.5)
        raise TimeoutError(f"Could not acquire lock on {self.lock_path} within {self.timeout} seconds.")

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.lock_file:
            fcntl.flock(self.lock_file, fcntl.LOCK_UN)
            self.lock_file.close()
            if os.path.exists(self.lock_path):
                os.remove(self.lock_path)

def get_db_client(config_path):
    """Reads config and returns an appropriate InfluxDB client."""
    config = configparser.ConfigParser()
    if not os.path.exists(config_path):
        print(f"Error: Configuration file not found at {config_path}", file=sys.stderr)
        sys.exit(1)
    config.read(config_path)
    db_config = config['database']
    db_version = db_config.getint('VERSION', 1)
    client = None
    if db_version == 2:
        if not INFLUXDB_V2_AVAILABLE:
            print("Error: InfluxDB v2 client not installed. Please run 'pip install influxdb-client'.", file=sys.stderr)
            sys.exit(1)
        client = InfluxDBClient(
            url=f"http://{db_config['HOST']}:{db_config['PORT']}",
            token=db_config['PASSWORD'],
            org=db_config.get('ORG', '-')
        )
    else: # Default to v1
        if not INFLUXDB_V1_AVAILABLE:
            print("Error: InfluxDB v1 client is not installed. Please run 'pip install influxdb'.", file=sys.stderr)
            sys.exit(1)
        client = InfluxDBClientV1(
            host=db_config['HOST'],
            port=db_config['PORT'],
            username=db_config['USER'],
            password=db_config['PASSWORD'],
            database=db_config['DATABASE']
        )
    return client, db_version, db_config

def execute_query(client, query, db_version, verbose=False):
    """Executes a query using the appropriate client version, with timestamped debug output."""
    if verbose:
        timestamp_str = datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S UTC')
        print(f"\n[DEBUG] {timestamp_str} - Executing Query:\n{query}\n")
    if db_version == 2:
        return client.query_api().query(query)
    else:
        return client.query(query)

def parse_utc_string(ts_str):
    """Parses a UTC timestamp string (various formats) into a timezone-aware UTC datetime."""
    ts_str = ts_str.rstrip('Z')
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%d %H:%M:%S"):
        try:
            return datetime.strptime(ts_str, fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            continue
    raise ValueError(f"Unsupported datetime format: {ts_str}")

def stream_performance_data_optimized(client, database, entity_filter, slices, tmp_dir, args, stats_out=None,
                                      cpu_optional=()):
    """
    Streams performance data to temp files, tracks min/max timestamps, and
    uses an external sort to create a master file.

    Acquisition is chunked InfluxQL v1 over half-open time slices with exact
    nanosecond timestamps and named fields (acquire_metric_to_file). Temporary
    files hold data rows only and are sorted in byte order, the order the
    merge compares keys in. Per-metric counters, and the merge's counters under
    'merge', are stored in stats_out when a dict is supplied.

    cpu_optional (schema 2) is a sequence of (column, field or None): fields
    acquired with PhysC in the same query and written as columns after RunQ.
    Empty (the default) gives the four-column schema-1 master file.
    """
    print("\n## Phase 1: Performance Data Staging")
    temp_files = {}
    temp_file_handles = {}
    min_ts, max_ts = None, None
    discovered_vms = set()

    chunk_size = getattr(args, 'chunk_size', DEFAULT_CHUNK_SIZE)
    try:
        for metric, measurement, field in PERF_SOURCES:
            print(f"- Streaming performance metrics ({metric})...", end="", flush=True)
            start_metric_time = time.time()

            temp_file = tempfile.NamedTemporaryFile(mode='w', delete=False, dir=tmp_dir, suffix=f'.{metric}.csv', encoding='utf-8')
            temp_files[metric] = temp_file.name
            temp_file_handles[metric] = temp_file
            if args.verbose:
                print(f"\n    Created temp file for {metric}: {temp_file.name}")

            # Temporary files carry data rows only. A header line used to be
            # written here; the sort placed it after every data row, so the merge
            # skipped the earliest sample of each metric and emitted the header as
            # a final data row.

            extra_fields = [f for _, f in cpu_optional] if metric == 'physc' else ()
            stats = acquire_metric_to_file(client, database, measurement, field, entity_filter,
                                           slices, chunk_size, temp_file, args.verbose,
                                           extra_fields=extra_fields)
            discovered_vms |= stats.vms
            for ns in (stats.min_ns, stats.max_ns):
                if ns is None:
                    continue
                current_ts_obj = ns_to_utc_datetime(ns)
                min_ts = min(min_ts, current_ts_obj) if min_ts else current_ts_obj
                max_ts = max(max_ts, current_ts_obj) if max_ts else current_ts_obj
            if stats_out is not None:
                stats_out[metric] = stats

            temp_file.close()
            duration_metric = time.time() - start_metric_time
            print(f" [DONE: {format_duration(duration_metric)}]")
            anomalies = stats.anomalies()
            if anomalies or args.verbose:
                detail = ', '.join(f'{v} {k}' for k, v in anomalies.items()) or 'no anomalies'
                print(f"    {stats.rows} rows over {len(slices)} slice(s); {detail}.")

        print("- Sorting and merging all performance data into master cache...", end="", flush=True)
        start_sort_time = time.time()
        master_temp_file = tempfile.NamedTemporaryFile(mode='w', delete=False, dir=tmp_dir, suffix='.master.csv', encoding='utf-8')
        master_temp_filename = master_temp_file.name
        master_temp_file.close()
        merge_stats = create_sorted_master_file(temp_files, master_temp_filename,
                                                [c for c, _ in cpu_optional])
        duration_sort = time.time() - start_sort_time
        print(f" [DONE: {format_duration(duration_sort)}]")
        if merge_stats['ambiguous_keys']:
            print(f"    {merge_stats['ambiguous_keys']} (timestamp, VM) key(s) hold more than one sample at "
                  f"second resolution ({merge_stats['ambiguous_extra_rows']} extra row(s)); "
                  f"their PhysC/RunQ pairing is positional, not exact.")
        if stats_out is not None:
            stats_out['merge'] = merge_stats

        print(f"- Discovered {len(discovered_vms)} VMs with performance data in the target time window.")
        return master_temp_filename, discovered_vms, min_ts, max_ts

    finally:
        # Final cleanup of intermediate temporary files.
        for handle in temp_file_handles.values():
            if not handle.closed: handle.close()
        for temp_file in temp_files.values():
            if os.path.exists(temp_file): os.remove(temp_file)

def create_sorted_master_file(temp_files, master_temp_filename, optional_columns=()):
    """Orchestrates creating a sorted master file by sorting and joining.
    Returns the merge counters of join_sorted_files."""
    sorted_files = {}
    try:
        for metric, temp_file in temp_files.items():
            sorted_file = f"{temp_file}.sorted"
            # Use a large 8GB memory buffer for sort, as requested.
            sort_cmd = ['sort', '-t,', '-k1,1', '-k2,2', '-S', '8G', '-T', os.path.dirname(temp_file), temp_file]
            # Byte order (LC_ALL=C) is the order join_sorted_files compares keys
            # in. A locale collation (e.g. en_US.UTF-8 orders 'web-01' < 'web01'
            # < 'Web02') disagrees with it and can split one (timestamp, VM) key
            # into separate PhysC-only and RunQ-only rows.
            sort_env = dict(os.environ, LC_ALL='C')
            with open(sorted_file, 'w', encoding='utf-8') as outfile:
                subprocess.run(sort_cmd, stdout=outfile, check=True, env=sort_env)
            sorted_files[metric] = sorted_file
        return join_sorted_files(sorted_files, master_temp_filename, optional_columns)
    finally:
        for sorted_file in sorted_files.values():
            if os.path.exists(sorted_file): os.remove(sorted_file)

def join_sorted_files(sorted_files, master_temp_filename, optional_columns=()):
    """
    Performs a memory-efficient merge-join of multiple sorted CSV files.

    optional_columns (schema 2) names the cells that follow the value on each
    PhysC line; they are written after RunQ, blank on rows without a PhysC
    line. Rows sharing one (timestamp, VM) key (several samples in one second)
    are paired positionally, as before; they are counted as ambiguous.
    Returns {'rows', 'ambiguous_keys', 'ambiguous_extra_rows'}.
    """
    n_opt = len(optional_columns)
    blank_opt = ',' * n_opt
    file_handles = {}
    current_rows = {}
    counts = {'rows': 0, 'ambiguous_keys': 0, 'ambiguous_extra_rows': 0}

    def parse(metric, line):
        parts = line.strip().split(',')
        if len(parts) < 3:
            return None
        row = {'key': f"{parts[0]},{parts[1]}", 'value': parts[2]}
        if metric == 'physc' and n_opt:
            cells = parts[3:3 + n_opt]
            row['optional'] = ',' + ','.join(cells + [''] * (n_opt - len(cells)))
        return row

    try:
        for metric, sorted_file in sorted_files.items():
            file_handles[metric] = open(sorted_file, 'r', encoding='utf-8')
            line = file_handles[metric].readline()
            if line:
                row = parse(metric, line)
                if row:
                    current_rows[metric] = row
        header = ','.join(L1_REQUIRED_COLUMNS + tuple(optional_columns))
        previous_key = None
        with open(master_temp_filename, 'w', encoding='utf-8') as master_file:
            master_file.write(header + "\n")
            while current_rows:
                min_key = min(current_rows.values(), key=lambda x: x['key'])['key']
                timestamp, vm_name = min_key.split(',', 1)
                values = {metric: row_data['value'] for metric, row_data in current_rows.items() if row_data['key'] == min_key}
                optional = ''
                if n_opt:
                    physc_row = current_rows.get('physc')
                    optional = physc_row['optional'] if physc_row and physc_row['key'] == min_key else blank_opt
                master_file.write(f"{timestamp},{vm_name},{values.get('physc', '')},{values.get('runq', '')}{optional}\n")
                counts['rows'] += 1
                if min_key == previous_key:
                    counts['ambiguous_extra_rows'] += 1
                    if counts.get('_last_ambiguous') != min_key:
                        counts['ambiguous_keys'] += 1
                        counts['_last_ambiguous'] = min_key
                previous_key = min_key
                for metric in list(current_rows.keys()):
                    if current_rows.get(metric) and current_rows[metric]['key'] == min_key:
                        line = file_handles[metric].readline()
                        if line:
                            row = parse(metric, line)
                            if row: current_rows[metric] = row
                            else: del current_rows[metric]
                        else:
                            del current_rows[metric]
    finally:
        for handle in file_handles.values(): handle.close()
    counts.pop('_last_ambiguous', None)
    return counts

def get_config_events_by_measurement(client, db_version, fields, measurement, entity_filter, start_date, end_date, verbose=False):
    """
    Issues two InfluxDB queries (baseline anchor + analysis window) for all
    supplied fields from a single measurement in one round trip each, rather
    than one pair of queries per field.

    The analysis query uses LAST() in six-hour buckets. It discovers generic
    configuration states efficiently, but reported change timestamps are bucket
    timestamps rather than exact DLPAR transition times. A change and reversal
    within one bucket may be missed.

    Returns a dict of {field: [{'ts': int, 'host': str, 'value': any}]}.
    All fields in the list must reside in the same measurement.
    """
    events_by_field   = {f: [] for f in fields}
    last_known_values = {f: {} for f in fields}  # field -> {vm_name: last_value}

    select_clause = ', '.join(f'LAST("{f}") AS "{f}"' for f in fields)
    start_date_obj          = datetime.strptime(start_date, '%Y-%m-%d')
    baseline_start_str      = (start_date_obj - timedelta(days=365)).strftime('%Y-%m-%d')
    baseline_time_filter    = f"time >= '{baseline_start_str}T00:00:00Z' AND time < '{start_date}T00:00:00Z'"
    analysis_time_filter    = f"time >= '{start_date}T00:00:00Z' AND time <= '{end_date}T23:59:59Z'"
    anchor_epoch            = int(start_date_obj.replace(tzinfo=timezone.utc).timestamp())

    # --- Baseline: last known value per field before the analysis window ---
    baseline_query  = (f'SELECT {select_clause} FROM "{measurement}" '
                       f'WHERE {entity_filter} AND {baseline_time_filter} GROUP BY "host"')
    baseline_results = execute_query(client, baseline_query, db_version, verbose)
    for series in baseline_results.items():
        if not (series[0][1].get('host')):
            continue
        vm_name = series[0][1]['host']
        points  = list(series[1])
        if not points:
            continue
        for f in fields:
            value = points[0].get(f)
            if value is not None:
                events_by_field[f].append({'ts': anchor_epoch, 'host': vm_name, 'value': value})
                last_known_values[f][vm_name] = value

    # --- Analysis window: detect changes at 6-hour resolution ---
    changes_query   = (f'SELECT {select_clause} FROM "{measurement}" '
                       f'WHERE {entity_filter} AND {analysis_time_filter} '
                       f'GROUP BY time(6h), "host" ORDER BY time ASC')
    change_results  = execute_query(client, changes_query, db_version, verbose)
    for series in change_results.items():
        if not (series[0][1].get('host')):
            continue
        vm_name = series[0][1]['host']
        for point in series[1]:
            ts = int(parse_utc_string(point['time']).timestamp())
            for f in fields:
                current_value = point.get(f)
                if current_value is not None and current_value != last_known_values[f].get(vm_name):
                    events_by_field[f].append({'ts': ts, 'host': vm_name, 'value': current_value})
                    last_known_values[f][vm_name] = current_value

    return events_by_field

def load_fallback_config(config_path, verbose=False):
    """Loads VM configuration from a CSV file for fallback."""
    if not config_path or not os.path.exists(config_path):
        if verbose and config_path: print(f"Info: Fallback config file not found at {config_path}")
        return {}
    config_data = {}
    try:
        with open(config_path, mode='r', encoding='utf-8-sig') as infile:
            reader = csv.DictReader(infile)
            for row in reader:
                if row.get('hostname'): config_data[row['hostname']] = row
    except Exception as e:
        print(f"WARNING: Could not read fallback config file {config_path}. Error: {e}", file=sys.stderr)
    return config_data

def format_duration(seconds):
    """Formats a duration in seconds into a human-readable mm:ss.xxs string."""
    if seconds < 60:
        return f"{seconds:.2f}s"
    minutes = int(seconds // 60)
    remaining_seconds = seconds % 60
    return f"{minutes}m {remaining_seconds:.2f}s"

# ==============================================================================
# HELPER FUNCTION: _calculate_max_capacity
# PURPOSE: Calculates the maximum potential CPU for an LPAR based on its
#          configuration state (capped status, virtual CPUs, and pool size).
# ARGS:
#   metadata_dict (dict): A dictionary containing the LPAR's metadata.
# RETURNS:
#   The calculated max_capacity value (float).
# ==============================================================================
def _calculate_max_capacity(metadata_dict):
    """
    Calculates the maximum potential CPU for an LPAR from its metadata.
    """
    # Safely get values, defaulting to 0 if missing or not a valid number.
    try:
        is_capped = int(metadata_dict.get('capped', 0))
    except (ValueError, TypeError):
        is_capped = 0

    try:
        entitlement = float(metadata_dict.get('entitlement', 0.0))
    except (ValueError, TypeError):
        entitlement = 0.0

    try:
        virtual_cpus = int(metadata_dict.get('virtual_cpus', 0))
    except (ValueError, TypeError):
        virtual_cpus = 0

    try:
        pool_cpu = int(metadata_dict.get('pool_cpu', 0))
    except (ValueError, TypeError):
        pool_cpu = 0

    # For a capped LPAR, the maximum is strictly its entitlement.
    if is_capped:
        return entitlement

    # For an uncapped LPAR, the maximum is the lesser of its virtual CPUs
    # or the total physical CPUs in its shared pool.
    if pool_cpu > 0 and virtual_cpus > 0:
        return float(min(virtual_cpus, pool_cpu))

    # Fallback for uncapped LPARs where pool size is not available.
    return float(virtual_cpus)

def read_cache_manifest(manifest_path):
    """
    Parses a .nfit.cache.manifest file into a plain dict of key/value strings.
    Returns an empty dict if the file does not exist or cannot be read.
    """
    result = {}
    if not os.path.exists(manifest_path):
        return result
    try:
        with open(manifest_path, 'r') as fh:
            for line in fh:
                if ':' in line:
                    key, _, value = line.partition(':')
                    result[key.strip()] = value.strip()
    except OSError:
        pass
    return result


def scan_cache_manifests(cache_dir):
    """
    Scans cache_dir for serial subdirectories that contain a manifest with a
    successful build status and a data_end field.
    Returns a dict of {serial: manifest_dict}.
    """
    results = {}
    if not os.path.isdir(cache_dir):
        return results
    for entry in os.scandir(cache_dir):
        if not entry.is_dir():
            continue
        manifest_path = os.path.join(entry.path, '.nfit.cache.manifest')
        m = read_cache_manifest(manifest_path)
        if m.get('cache_build_status') == 'success' and m.get('data_end'):
            results[entry.name] = m
    return results

# Insert immediately before it:
def scan_cache_directories(cache_dir):
    """
    Scans cache_dir for serial subdirectories that contain a .nfit.cache.data
    file and derives the data window directly from the L1 cache content.

    data_end is obtained via reverse scan (find_last_valid_physc_timestamp) and
    is therefore always a full-precision 'YYYY-MM-DD HH:MM:SS' timestamp.
    data_start is read from the first data row of the cache file.

    The manifest file, if present, is consulted only for supplementary fields
    such as staged_by; it is never required.

    Returns a dict of {serial: info_dict}.
    """
    results = {}
    if not os.path.isdir(cache_dir):
        return results

    for entry in os.scandir(cache_dir):
        if not entry.is_dir():
            continue
        cache_data_path = os.path.join(entry.path, '.nfit.cache.data')
        if not os.path.isfile(cache_data_path):
            continue

        data_end = find_last_valid_physc_timestamp(cache_data_path)
        if not data_end:
            continue  # Empty or unreadable — skip.

        data_start = None
        try:
            with open(cache_data_path, 'r', encoding='utf-8') as fh:
                fh.readline()  # Skip header row.
                for line in fh:
                    parts = line.split(',', 1)
                    if parts and parts[0].strip():
                        data_start = parts[0].strip()
                        break
        except OSError:
            pass

        if not data_start:
            data_start = data_end[:10]

        # Supplement with manifest fields where available.
        manifest_path = os.path.join(entry.path, '.nfit.cache.manifest')
        m = read_cache_manifest(manifest_path)

        results[entry.name] = {
            'data_start': data_start,
            'data_end':   data_end,
            'staged_by':  m.get('staged_by', 'unknown'),
        }

    return results

def last_sample_epochs(acq_stats):
    """The second of the last sample acquired for each VM, over all metrics of this run."""
    last = {}
    for stats in (acq_stats or {}).values():
        for vm, ns in getattr(stats, 'last_ns_by_vm', {}).items():
            second = ns // NS_PER_SECOND
            if second > last.get(vm, -1):
                last[vm] = second
    return last


def build_vm_states(events, capture_end_epoch, last_sample_epoch=None):
    """
    The configuration-state timeline of one VM from its configuration events
    ([{'ts', 'key', 'value'}]): a new state begins where the configuration changes.

    The last state ends at the VM's own last sample (D-025). It used to end at the
    last sample of the whole capture, so an LPAR that had left the managed system
    still showed a current configuration there. A VM without a sample in this run
    keeps the capture end: nothing is known about when it stopped.
    """
    if not events:
        return []
    events = sorted(events, key=lambda x: x['ts'])
    state_list = []
    last_known_metadata = {}
    current_state_start_epoch = None
    event_timeline = defaultdict(dict)
    for event in events:
        event_timeline[event['ts']][event['key']] = event['value']

    for i, ts in enumerate(sorted(event_timeline.keys())):
        metadata_before_change = last_known_metadata.copy()
        last_known_metadata.update(event_timeline[ts])
        if i == 0:
            current_state_start_epoch = ts
        elif json.dumps(last_known_metadata, sort_keys=True) != json.dumps(metadata_before_change, sort_keys=True):
            # Before adding the state, enrich it with max_capacity
            metadata_before_change['max_capacity'] = _calculate_max_capacity(metadata_before_change)
            state_list.append({'start_epoch': current_state_start_epoch, 'end_epoch': ts - 1, 'metadata': metadata_before_change})
            current_state_start_epoch = ts
    if current_state_start_epoch is not None:
        end = capture_end_epoch if last_sample_epoch is None else min(capture_end_epoch, last_sample_epoch)
        final_end_epoch = max(current_state_start_epoch, int(end))
        # Also enrich the final state before adding it
        last_known_metadata['max_capacity'] = _calculate_max_capacity(last_known_metadata)
        state_list.append({'start_epoch': current_state_start_epoch, 'end_epoch': final_end_epoch, 'metadata': last_known_metadata})
    return state_list


def _merge_config_states(existing_states, new_states):
    """
    Merges two per-VM configuration-state dicts into a single coherent timeline.

    For each VM present in both dicts the last state of the existing timeline is
    compared with the first state of the incoming timeline (excluding the derived
    max_capacity field, which is recalculated).  When the metadata is identical
    the two states are coalesced by extending the existing state's end_epoch to
    match the incoming state's end_epoch; any remaining incoming states are then
    appended.  When the metadata differs the incoming states are appended verbatim.

    VMs that appear in only one dict are included unchanged.
    """
    merged = {}
    for vm in set(existing_states.keys()) | set(new_states.keys()):
        existing = existing_states.get(vm, [])
        incoming = new_states.get(vm, [])

        if not existing:
            merged[vm] = incoming
            continue
        if not incoming:
            merged[vm] = existing
            continue

        # Strip the derived max_capacity field before comparing.
        def _comparable(meta):
            return {k: v for k, v in meta.items() if k != 'max_capacity'}

        last_meta  = _comparable(existing[-1]['metadata'])
        first_meta = _comparable(incoming[0]['metadata'])

        if json.dumps(last_meta, sort_keys=True) == json.dumps(first_meta, sort_keys=True):
            # Configuration unchanged at the boundary: coalesce and append remainder.
            coalesced = dict(existing[-1])
            coalesced['end_epoch'] = incoming[0]['end_epoch']
            merged[vm] = existing[:-1] + [coalesced] + incoming[1:]
        else:
            # Configuration changed at the boundary: append all incoming states.
            merged[vm] = existing + incoming

    return merged

def find_last_valid_physc_timestamp(filepath, chunk_size=65536):
    """
    Scans a sorted CSV file (Timestamp,VMName,PhysC,RunQ) in reverse using
    fixed-size byte chunks to locate the timestamp of the last row that contains
    a valid (non-empty, parseable float) PhysC value.

    This is used both to trim incomplete tail-end data produced by InfluxDB
    ingestion lag before writing the L1 cache, and to determine the effective
    data_end of an existing cache for --append mode.

    Returns the timestamp string ('YYYY-MM-DD HH:MM:SS'), or None if no valid
    PhysC row is found in the file.
    """
    try:
        with open(filepath, 'rb') as fh:
            fh.seek(0, 2)
            file_size = fh.tell()
            if file_size == 0:
                return None

            pos       = file_size
            remainder = b''

            while pos > 0:
                read_size = min(chunk_size, pos)
                pos      -= read_size
                fh.seek(pos)
                chunk = fh.read(read_size) + remainder
                lines = chunk.split(b'\n')
                # The first element may be a partial line; carry it to the next chunk.
                remainder = lines[0]

                for raw in reversed(lines[1:]):
                    raw = raw.strip()
                    if not raw:
                        continue
                    parts = raw.split(b',')
                    if len(parts) < 3:
                        continue
                    physc_field = parts[2].strip()
                    if not physc_field:
                        continue
                    try:
                        float(physc_field)
                    except ValueError:
                        continue
                    # Validate that the timestamp field is structurally sound before
                    # returning it — guards against corrupt rows such as the InfluxDB
                    # write-race example ('2025-07-06 18:30:vm9,,3.678').
                    ts_field = parts[0].strip()
                    if len(ts_field) != 19:
                        continue
                    try:
                        return ts_field.decode('utf-8')
                    except UnicodeDecodeError:
                        continue

            # Check any remainder carried out of the loop.
            if remainder:
                remainder = remainder.strip()
                parts = remainder.split(b',')
                if len(parts) >= 3:
                    physc_field = parts[2].strip()
                    if physc_field:
                        try:
                            float(physc_field)
                            ts_field = parts[0].strip()
                            if len(ts_field) == 19:
                                return ts_field.decode('utf-8')
                        except (ValueError, UnicodeDecodeError):
                            pass
    except OSError:
        pass

    return None

def truncate_to_last_valid_physc(filepath, tail_read_size=2 * 1024 * 1024):
    """
    Truncates filepath immediately after the last row that contains a valid
    PhysC value, removing any incomplete tail rows left by InfluxDB ingestion lag.

    Reads at most tail_read_size bytes from the end of the file (default 2 MB),
    which comfortably covers the observed 3–10 minute ingestion-lag window across
    a large fleet at 1-minute sample intervals.

    Returns the timestamp string of the last retained row, or None if no valid
    PhysC row is found within the read window (the file is not modified in that
    case).
    """
    try:
        with open(filepath, 'r+b') as fh:
            fh.seek(0, 2)
            file_size = fh.tell()
            if file_size == 0:
                return None

            read_offset = max(0, file_size - tail_read_size)
            fh.seek(read_offset)
            tail_bytes = fh.read()

            # When reading from mid-file, lines[0] is a partial line at the chunk
            # boundary; skip it during the search to avoid a corrupted match.
            lines     = tail_bytes.split(b'\n')
            start_idx = 1 if read_offset > 0 else 0

            truncate_after_index = None
            last_valid_ts        = None

            for i in range(len(lines) - 1, start_idx - 1, -1):
                raw = lines[i].strip()
                if not raw:
                    continue
                parts = raw.split(b',')
                if len(parts) < 3:
                    continue
                physc_field = parts[2].strip()
                if not physc_field:
                    continue
                try:
                    float(physc_field)
                except ValueError:
                    continue
                ts_field = parts[0].strip()
                if len(ts_field) != 19:
                    continue
                try:
                    last_valid_ts = ts_field.decode('utf-8')
                except UnicodeDecodeError:
                    continue
                truncate_after_index = i
                break

            if truncate_after_index is None:
                return None

            # Compute the byte offset of the end of the found line within tail_bytes.
            # split(b'\n') consumes each separator, so each lines[j] is followed by
            # exactly one '\n' byte; add 1 per line up to and including the target.
            byte_offset_in_tail = sum(len(lines[j]) + 1 for j in range(truncate_after_index + 1))
            truncate_point = read_offset + byte_offset_in_tail

            if truncate_point <= file_size:
                fh.truncate(truncate_point)

        return last_valid_ts

    except OSError:
        return None


# .gitignore for nFit

# macOS specific files
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db

# General Editor / OS backup files
*~
*.swp
*.swo
*.bak
*.tmp

# Perl specific
/blib/
/pm_to_blib/
/cover_db/
MANIFEST.bak
MANIFEST.SKIP
*.old

# Python specific
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
/build/
/dist/

# Virtual environments
.env
.venv
env/
venv/
ENV/
VENV/
pip-wheel-metadata/
lib/
lib64/
include/
share/python-wheels/
*.manifest
pip-log.txt
pip-delete-this-directory.txt

# Distribution / packaging
.Python
develop-eggs/
eggs/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# IPython Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
.tox/

# Project-specific: Ignore user's local configuration files in etc/
# This assumes the repository ships examples in "examples/" and users copy them to "etc/"
# for their local setup. These specific files in "etc/" should not be versioned.
# If you decide to ship default (template) configs in "etc/" that ARE versioned,
# then users should be advised to copy them elsewhere for modification or use overrides,
# or just not commit their local changes to the tracked files.
# For your stated need of not committing your personal etc/ files:
/etc/nfit.mgsys.cfg
/etc/nfit.vms.cfg
/etc/nfit.scenarios.cfg
/stage
/output
/history
#/etc/nfit.profiles.cfg

# Project-specific: Ignore generated output files if they might end up in the repo
# (Your scripts currently output to /tmp, which is good, but this is for safety)
# If you ever generate example outputs for the README, you'd explicitly add those
# with 'git add -f example_output.png'
# *.png
# *.csv

# Add any other specific files or directories you want to ignore
# e.g., personal notes or local test data
#
# Tests: the regression gate is tracked (the suites run by dev/run-tests, their
# helper and the reviewed synthetic fixtures they read). Everything else under
# test/ (manual scripts, generators, scratch files) stays local until reviewed.
/test/*
!/test/*.t
!/test/*_test.py
!/test/fake_influxdb.py
!/test/fixtures/
/test/fixtures/*
!/test/fixtures/stager-legacy/
!/test/fixtures/stage/
/test/fixtures/stage/*
!/test/fixtures/stage/SYN0002/
# Files the engines write beside a fixture when it is used in place
/test/fixtures/**/.nfit.cache.results
/test/fixtures/**/.nfit.cache.idx
/test/fixtures/**/.nfit.cache.lock
/test/fixtures/**/.nfit.cache.publish.lock
/test/fixtures/**/.nfit.engine.last_*
/test/fixtures/**/.nfit.history*
# Synthetic fixture manifests (the global *.manifest rule would hide them)
!/test/fixtures/stage/SYN0002/.nfit.cache.manifest
/mkversion.pl
/version.dat

# ------------------------------------------------------------------------------
# Confidential data and developer-private material (added with the on-disk
# collaboration setup). Nothing below may ever be committed.
# ------------------------------------------------------------------------------
/backups
/etc/influxdb.conf
/.private
/tmp
# AI collaboration context (local working memory; un-ignore deliberately if wanted)
/CLAUDE.md
/.claude/
# nfit-forecast lives in its own repository; the copy/symlink here is a convenience
/nfit-forecast
/nfit-forecast.*

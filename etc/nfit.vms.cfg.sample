# ==============================================================================
# etc/nfit.vms.cfg.sample - per-LPAR settings for nfit-profile (format sample)
#
# Copy to etc/nfit.vms.cfg and edit. The real file is private and is not
# versioned. One [section] per LPAR, named exactly as the LPAR appears in the
# CSV VM column. Comments start with '#' or ';'. Every key is optional.
#
# LPAR keys
#   tier          Business tier: P (peak protected), G1-G4, O1-O4, B1-B4.
#                 Without a TIER an LPAR is sized on tier 3 of its hinted
#                 pattern (G3, O3 or B3). A VIOS without a TIER is P.
#   ha_peer       Another node of the same PowerHA cluster (one or more names,
#                 comma separated). Set it on either node, on both, or on
#                 every member: it defines the cluster, not the roles.
#   ha_role       auto (default): roles inferred from the workload, or
#                 UNKNOWN when the evidence is unclear; a failover needs no
#                 change here. active: always sized on its own workload.
#                 standby: a declared standby (own workload kept as a floor);
#                 it goes stale at the next failover.
#   ha_sizing     independent (default): every node sized on its own
#                 workload. standby_share: a standby is sized from its peer
#                 (see standby_share). Applies to the whole cluster.
#   standby_share Share of the primary's target entitlement an idle standby
#                 holds with ha_sizing = standby_share (above 0, at most 1).
#   lpar_type     vios for a Virtual I/O Server; lpar otherwise (default).
#   vios_peer     The other VIOS of a dual-VIOS pair.
#   vios_sizing   combined (default): each VIOS of the pair can carry the sum
#                 of both own targets (a planning scenario). match_larger:
#                 aligned with the larger; takeover capacity not verified.
#   vios_takeover_margin  Extra on the combined target, as a fraction
#                 (default 0.00, for example 0.10); the planner's assumption.
#
# [GLOBAL] is reserved for defaults; an LPAR named GLOBAL cannot be configured.
#   ha_sizing, standby_share (built-in default 0.25), vios_sizing and
#   vios_takeover_margin may be set here for every cluster or VIOS pair.
#
# The PowerHA and VIOS settings are read from v10 stage 3.1b onwards; earlier
# versions read only tier and ignore the rest.
# ==============================================================================

[GLOBAL]
standby_share = 0.25
;vios_takeover_margin = 0.10

# ==============================================================================
# Example LPAR entries (disabled by default; remove leading ';' to activate)
# ==============================================================================

# An LPAR with its business tier only.
;[app01]
;tier = G2

# A two-node PowerHA cluster across two managed systems. One ha_peer entry
# is enough; both are shown.
;[db01a]
;tier = G1
;ha_peer = db01b

;[db01b]
;tier = G1
;ha_peer = db01a
;standby_share = 0.30

# A mutual-takeover pair, both nodes sized in full.
;[mq01a]
;tier = G2
;ha_peer = mq01b
;ha_role = active

;[mq01b]
;tier = G2
;ha_role = active

# A dual-VIOS pair. Without a TIER a VIOS is peak protected (P).
;[vios01a]
;lpar_type = vios
;vios_peer = vios01b

;[vios01b]
;lpar_type = vios

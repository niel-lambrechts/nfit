# ==============================================================================
# etc/nfit.vms.cfg.sample - per-LPAR settings for nfit-profile (format sample)
#
# Copy to etc/nfit.vms.cfg and edit. The real file is private and is not
# versioned. One [section] per LPAR, named exactly as the LPAR appears in the
# CSV VM column. Comments start with '#' or ';'. Every key is optional.
#
# LPAR keys
#   tier          Business tier: P (peak protected), G1-G4, O1-O4, B1-B4.
#                 Without a TIER an LPAR is sized on tier 3 of its hinted
#                 pattern (G3, O3 or B3). A VIOS without a TIER is P.
#   ha_peer       Another node of the same PowerHA cluster (one or more names,
#                 comma separated). Set it on either node, on both, or on
#                 every member: it defines the cluster, not the roles.
#   ha_role       auto (default): roles inferred from the workload, or
#                 UNKNOWN when the evidence is unclear; a failover needs no
#                 change here. active: always sized on its own workload.
#                 standby: a declared standby (own workload kept as a floor);
#                 it goes stale at the next failover.
#   ha_sizing     independent (default): every node sized on its own
#                 workload. standby_share: a standby is sized from its peer
#                 (see standby_share). standby_fixed: a standby holds the
#                 entitlement you set (see standby_entitlement). The setting
#                 of the node that is standby applies; after a failover, the
#                 other node's.
#   standby_share Share of the primary's target entitlement an idle standby
#                 holds with ha_sizing = standby_share (above 0, at most 1).
#   standby_entitlement  With ha_sizing = standby_fixed: the entitlement of
#                 the node while it is standby, in processors (0.05 or more,
#                 two decimals at most). For sites that add capacity at
#                 takeover; nFit neither arranges nor verifies that capacity.
#                 It replaces the entitlement the node's own workload asks
#                 for, which the CSV still shows. The VPs are the width
#                 that workload needs, recommended with the entitlement in
#                 one change unless a reduction-safety concern limits the VP
#                 step. Where the figure cannot be set on those VPs (0.05
#                 per VP), it is not applied: the node keeps its ordinary
#                 workload-based recommendation and the row says why. No VP
#                 is removed to make it fit and the figure is not raised.
#                 A node with ha_role = auto on which sustained workload is
#                 observed (see standby_work_cores) is a workload-bearing
#                 node: no idle-standby sizing is applied to it, neither this
#                 figure nor a standby_share floor, and it keeps its ordinary
#                 recommendation. With ha_role = standby the policy is applied
#                 as configured. There is no
#                 default: standby_fixed without it stops nfit-profile.
#                 Meant for shared-processor LPARs.
#   standby_work_cores, standby_work_hours, standby_work_days
#                 When sustained workload counts as observed on a PowerHA
#                 node: its PhysC stays at standby_work_cores or more
#                 (15-minute medians) for standby_work_hours without a break,
#                 on standby_work_days distinct days, in its planning-profile
#                 hours and current role period. Built-in: 0.20, 2, 2. These
#                 are provisional policy values, not platform limits: set
#                 them from what housekeeping and monitoring use on your
#                 systems (cores from 0.05; hours in quarter hours).
#   lpar_type     vios for a Virtual I/O Server; lpar otherwise (default).
#   vios_peer     The other VIOS of a dual-VIOS pair.
#   vios_sizing   match_larger (default): both VIOS of the pair aligned with
#                 the larger of their own targets, an equalisation of normal
#                 work; takeover capacity not verified. combined: each VIOS
#                 can carry the sum of both own targets (a planning scenario;
#                 both entitlements count as guarantees on the frame).
#                 independent: each VIOS sized on its own workload, as any
#                 LPAR. Both VIOS of the pair must resolve to independent
#                 (set it in [GLOBAL] or [MGSYS:<name>] for all pairs there);
#                 where they differ, the more protective setting applies
#                 (combined, then match_larger) and the rationale says so.
#                 A takeover then relies on borrowing, which nFit reports as
#                 an estimate and does not verify.
#   vios_takeover_margin  Extra on the combined target, as a fraction
#                 (default 0.00, for example 0.10); the planner's assumption.
#
# [GLOBAL] is reserved for defaults; an LPAR named GLOBAL cannot be configured.
#   ha_sizing, standby_share (built-in default 0.25), standby_entitlement,
#   vios_sizing and vios_takeover_margin may be set here for every cluster or VIOS pair.
#
# [MGSYS:<name>] holds the same defaults for one managed system, where
#   <name> is the managed system's directory under the staged data (normally
#   its serial number). Each setting is looked up on its own: the LPAR's
#   section, then its managed system's, then [GLOBAL], then the built-in
#   default. An LPAR that moves to another managed system inherits that
#   system's defaults; what its own section sets still applies.
#
# A PowerHA setting (ha_role, ha_sizing, standby_share, standby_entitlement)
# that cannot be read, and an LPAR setting in a [MGSYS:] section, stop
# nfit-profile with the line named: a policy is never replaced by a default
# unasked.
#
# The PowerHA and VIOS settings are read from v10 stage 3.1b onwards; earlier
# versions read only tier and ignore the rest.
# ==============================================================================

[GLOBAL]
standby_share = 0.25
;vios_takeover_margin = 0.10

# A managed system whose standbys hold a share of their primary's target,
# whatever [GLOBAL] says.
;[MGSYS:EXAMPLE01]
;ha_sizing = standby_share
;standby_share = 0.25

# A managed system whose standbys hold a fixed 0.10 while they are standby
# (capacity is added at takeover, outside nFit).
;[MGSYS:EXAMPLE02]
;ha_sizing = standby_fixed
;standby_entitlement = 0.10

# ==============================================================================
# Example LPAR entries (disabled by default; remove leading ';' to activate)
# ==============================================================================

# An LPAR with its business tier only.
;[app01]
;tier = G2

# A two-node PowerHA cluster across two managed systems. One ha_peer entry
# is enough; both are shown.
;[db01a]
;tier = G1
;ha_peer = db01b

;[db01b]
;tier = G1
;ha_peer = db01a
;standby_share = 0.30

# A mutual-takeover pair, both nodes sized in full.
;[mq01a]
;tier = G2
;ha_peer = mq01b
;ha_role = active

;[mq01b]
;tier = G2
;ha_role = active

# A dual-VIOS pair. Without a TIER a VIOS is peak protected (P).
;[vios01a]
;lpar_type = vios
;vios_peer = vios01b

;[vios01b]
;lpar_type = vios

sub parse_percentile_list
{
    my ($perc_str, $arg_name) = @_;
    my @percentiles;
    if (defined $perc_str && $perc_str ne '')
    {
        my @raw_percentiles = split /,\s*/, $perc_str;
        foreach my $p (@raw_percentiles)
        {
            if ($p !~ /^[0-9]+(?:\.[0-9]+)?$/ || $p < 0 || $p > 100)
            {
                die "Error: Invalid percentile value '$p' in --$arg_name list. Must be numeric between 0 and 100.\n";
            }
            push @percentiles, $p + 0;
        }
    }
    return @percentiles;
}

# ==============================================================================
# SUBROUTINE: generate_processing_time_windows
# PURPOSE:    Subdivides an analysis period into regular time windows.
#
# ARGUMENTS:
#   1. $period_start_obj (Time::Piece): The effective start of the analysis.
#   2. $period_end_obj (Time::Piece): The effective end of the analysis.
#   3. $unit_str (string): "days" or "weeks".
#   4. $size_val (integer): The number of units in each window.
#
# RETURNS:
#   - An array reference of window hashes:
#     [ { id => "YYYYMMDD", start_obj => ..., end_obj => ... }, ... ]
#     or [ { id => "YYYYWww", start_obj => ..., end_obj => ... }, ... ]
#
# NOTES:
#   - Implements [start, end) boundaries (start inclusive, end exclusive)
#     to prevent double-counting data points that fall on a midnight boundary.
# ==============================================================================
sub generate_processing_time_windows
{
    my ($period_start_obj, $period_end_obj, $unit_str, $size_val) = @_;

    my @windows;
    return \@windows unless (
        defined $period_start_obj && defined $period_end_obj &&
        $period_start_obj->isa('Time::Piece') && $period_end_obj->isa('Time::Piece') &&
        $period_start_obj <= $period_end_obj
    );

    # Start from the beginning of the day for clean boundaries
    my $current_window_start = $period_start_obj->truncate(to => 'day');

    while ($current_window_start <= $period_end_obj)
    {
        my $current_window_end;
        my $window_id;

        if ($unit_str eq "days")
        {
            # A 1-day window starting today ends tomorrow (exclusive)
            $current_window_end = $current_window_start + (ONE_DAY() * $size_val);
            # ID is the start date
            $window_id = $current_window_start->strftime('%Y%m%d');
        }
        elsif ($unit_str eq "weeks")
        {
            # A 1-week window starting today ends 7 days from now (exclusive)
            $current_window_end = $current_window_start + (ONE_WEEK() * $size_val);
            # ID is the ISO week (Monday-based) of the *start* of the window
            $window_id = $current_window_start->strftime('%Y_W%V');
        }
        else
        {
            die "Unsupported window unit: $unit_str\n";
        }

        # Do not create a window that starts after the period has ended
        last if $current_window_start > $period_end_obj;

        # The last window must not go past the end of the analysis period.
        # Note: We do *not* truncate the period_end_obj, as it may be intra-day.
        if ($current_window_end > $period_end_obj) {
             $current_window_end = $period_end_obj + 1; # +1 second to make it exclusive
        }

        # Create the window hash
        push @windows, {
            id        => $window_id,
            start_obj => Time::Piece->new($current_window_start->epoch),
            # end_obj is exclusive
            end_obj   => Time::Piece->new($current_window_end->epoch)
        };

        # The next window starts exactly where this one ended
        $current_window_start = $current_window_end;
    }
    return \@windows;
}

sub get_window_key_for_timestamp
{
    my ($timestamp_obj, $windows_aref, $hint_idx) = @_;
    my $timestamp_day_obj = $timestamp_obj->truncate(to => 'day');
    if (defined $hint_idx && $hint_idx >=0 && $hint_idx < @{$windows_aref})
    {
        my ($win_start, $win_end) = @{$windows_aref->[$hint_idx]};
        if ($timestamp_day_obj >= $win_start && $timestamp_day_obj <= $win_end)
        {
            return $windows_aref->[$hint_idx][2]->ymd('') . "_" . $hint_idx;
        }
    }
    for (my $i=0; $i < @{$windows_aref}; $i++)
    {
        my ($win_start, $win_end) = @{$windows_aref->[$i]};
        if ($timestamp_day_obj >= $win_start && $timestamp_day_obj <= $win_end)
        {
            return $windows_aref->[$i][2]->ymd('') . "_" . $i;
        }
    }
    return undef;
}

sub get_weighted_metric_for_vm
{
    my ($vm_data_by_window_href, $vm_name_local, $metric_key, # Use local var
        $processing_windows_aref, $analysis_ref_obj_arg, $decay_hl_days_arg, $sprintf_fmt_optional) = @_;

    my @metric_window_values;
    if (exists $vm_data_by_window_href->{$vm_name_local})
    {
        foreach my $win_key (sort {
                my ($ad, $ai) = ($a =~ /^(\d{8})_(\d+)$/);
                my ($bd, $bi) = ($b =~ /^(\d{8})_(\d+)$/);
                return ($ad cmp $bd) || ($ai <=> $bi);
            } keys %{$vm_data_by_window_href->{$vm_name_local}})
        {
            if (exists $vm_data_by_window_href->{$vm_name_local}{$win_key}{$metric_key} &&
                defined $vm_data_by_window_href->{$vm_name_local}{$win_key}{$metric_key} &&
                $vm_data_by_window_href->{$vm_name_local}{$win_key}{$metric_key} ne "N/A" )
            {
                my ($win_date_str_part, $win_idx_part) = ($win_key =~ /^(\d{8})_(\d+)$/);
                if (defined $win_idx_part && $win_idx_part < @{$processing_windows_aref})
                {
                    my $rep_date_obj = $processing_windows_aref->[$win_idx_part][2];
                    unless (defined $rep_date_obj && $rep_date_obj->isa('Time::Piece'))
                    {
                        print STDERR "Warning: Representative date for window key '$win_key' is invalid for VM '$vm_name_local', metric '$metric_key'. Skipping this window point.\n";
                        next;
                    }
                    push @metric_window_values, {
                        value => $vm_data_by_window_href->{$vm_name_local}{$win_key}{$metric_key},
                        date  => $rep_date_obj
                    };
                }
                else
                {
                    print STDERR "Warning: Could not accurately map window key '$win_key' to a processing window definition for VM '$vm_name_local', metric '$metric_key'. Skipping this window point.\n";
                }
            }
        }
    }

    if (@metric_window_values)
    {
        my $final_val_str;
        if ($metric_key eq 'Peak') {
            # For the Peak, we want the absolute maximum value found across all windows.
            my @values = map { $_->{value} } grep { defined $_->{value} && looks_like_number($_->{value}) } @metric_window_values;
            $final_val_str = @values ? max(@values) : "N/A";
        } else {
            # For all other metrics, perform the recency-weighted average.
            $final_val_str = calculate_recency_weighted_average(
                \@metric_window_values, $analysis_ref_obj_arg, $decay_hl_days_arg
            );
        }
        if (defined $sprintf_fmt_optional && defined $final_val_str && $final_val_str ne "N/A" && $final_val_str =~ /^-?[0-9.]+$/)
        {
            return sprintf($sprintf_fmt_optional, $final_val_str + 0);
        }
        return $final_val_str;
    }
    return "N/A";
}

sub calculate_recency_weighted_average
{
    my ($windowed_data_ref, $analysis_ref_obj_arg, $half_life_days_arg) = @_;
    my $sum_weighted_values = 0;
    my $sum_weights = 0;
    return "N/A" if (!defined $analysis_ref_obj_arg || !$analysis_ref_obj_arg->isa('Time::Piece'));
    return "N/A" if (!defined $half_life_days_arg || $half_life_days_arg <= 0);

    my $lambda = log(2) / $half_life_days_arg;

    foreach my $dp_ref (@{$windowed_data_ref})
    {
        my $value_str = $dp_ref->{value};
        next if (!defined $value_str || $value_str eq "N/A" || $value_str !~ /^-?[0-9.]+$/);
        my $value = $value_str + 0;
        my $date_obj = $dp_ref->{date};
        next if (!defined $date_obj || !$date_obj->isa('Time::Piece'));

        my $date_obj_day = $date_obj->truncate(to => 'day');
        my $analysis_ref_day = $analysis_ref_obj_arg->truncate(to => 'day');

        my $days_diff_seconds = $analysis_ref_day->epoch - $date_obj_day->epoch;
        my $days_diff = $days_diff_seconds / ONE_DAY(); # Use seconds from Time::Seconds object
        $days_diff = 0 if $days_diff < 0;

        my $weight = exp(-$lambda * $days_diff);
        $sum_weighted_values += $value * $weight;
        $sum_weights += $weight;
    }

    if ($sum_weights > $FLOAT_EPSILON)
    {
        return sprintf("%.4f", $sum_weighted_values / $sum_weights);
    }
    else
    {
        return "N/A";
    }
}

sub get_vm_index_by_name
{
    my ($vm_name_to_find, $vm_names_list_ref) = @_;
    for (my $i=0; $i < @{$vm_names_list_ref}; $i++)
    {
        if ($vm_names_list_ref->[$i] eq $vm_name_to_find)
        {
            return $i;
        }
    }
    return undef;
}

sub calculate_average
{
    my (@data) = @_;
    my @numbers = grep { defined $_ && looks_like_number($_) } @data;
    return 0 if !@numbers;
    return sum0(@numbers) / scalar(@numbers);
}

# Optional third argument, for callers whose list holds unpacked floats (never
# strings), to avoid work that cannot change the result:
#   floats => 1  a value in the plain-decimal range of Perl's number formatting
#                (0, or 0.001 <= |x| < 1e14) always passes the pattern below, so
#                it is admitted by a numeric test; every other value still goes
#                through the pattern.
#   sorted => 1  the list is already in ascending numeric order; it is sorted
#                again only if the filter removed a value.
sub calculate_percentile
{
    my ($data_ref, $p, $opts) = @_;
    my @data;
    if ($opts && $opts->{floats})
    {
        @data = grep { defined($_) && (($_ >= 0.001 && $_ < 1e14) || $_ == 0 || ($_ <= -0.001 && $_ > -1e14)
                                       || $_ =~ /^-?[0-9]+(?:\.[0-9]+)?$/) } @{$data_ref};
    }
    else
    {
        @data = grep { defined($_) && $_ =~ /^-?[0-9]+(?:\.[0-9]+)?$/ } @{$data_ref};
    }
    my $n = scalar @data;
    return undef if $n == 0;
    @data = sort { $a <=> $b } @data unless ($opts && $opts->{sorted} && $n == scalar @{$data_ref});
    return $data[0] if $n == 1;

    my $rank_fractional = ($p / 100) * ($n - 1);
    my $k = int($rank_fractional);
    my $d = $rank_fractional - $k;

    if ($p == 0) { return $data[0]; }
    if ($p == 100) { return $data[$n-1]; }

    if ($k >= $n - 1)
    {
        return $data[$n - 1];
    }
    elsif ($k < 0)
    {
        return $data[0];
    }
    else
    {
        my $val_k = $data[$k];
        my $val_k_plus_1 = ($k + 1 < $n) ? $data[$k + 1] : $data[$k];
        return $val_k + $d * ($val_k_plus_1 - $val_k);
    }
}

sub calculate_rolling_average_series
{
    my ($data_series_ref, $method, $window_size, $alpha_val) = @_;
    my @output_series;
    my @current_window_sma;
    my $current_ema;

    if ($method eq 'none')
    {
        return $data_series_ref;
    }

    foreach my $value (@{$data_series_ref})
    {
        my $avg_val_to_add = undef;
        if ($method eq 'sma')
        {
            if (defined $value && $value =~ /^-?[0-9.]+$/)
            {
                push @current_window_sma, ($value + 0);
            }
            else
            {
                push @current_window_sma, undef;
            }
            shift @current_window_sma while scalar @current_window_sma > $window_size;
            if (scalar @current_window_sma == $window_size)
            {
                $avg_val_to_add = calculate_average(@current_window_sma);
            }
        }
        elsif ($method eq 'ema')
        {
            if (defined $value && $value =~ /^-?[0-9.]+$/)
            {
                my $numeric_value = $value + 0;
                if (!defined $current_ema)
                {
                    $current_ema = $numeric_value;
                }
                else
                {
                    $current_ema = ($numeric_value * $alpha_val) + ($current_ema * (1 - $alpha_val));
                }
            }
            push @current_window_sma, $value;
            shift @current_window_sma while scalar @current_window_sma > $window_size;
            if (scalar @current_window_sma == $window_size)
            {
                $avg_val_to_add = $current_ema;
            }
        }
        push @output_series, $avg_val_to_add if defined $avg_val_to_add;
    }
    return \@output_series;
}

sub apply_rounding
{
    my ($value, $increment, $method) = @_;
    return $value unless (defined $value && $value =~ /^-?[0-9]+(?:\.[0-9]+)?$/);
    return $value if $method eq 'none' || !defined $increment || $increment <= $FLOAT_EPSILON;

    my $rounded_value;
    if ($method eq 'standard')
    {
        $rounded_value = int( ($value / $increment) + ( ($value >= 0) ? 0.5 : -0.5) ) * $increment;
    }
    elsif ($method eq 'up')
    {
        $rounded_value = ceil( $value / $increment ) * $increment;
    }
    else
    {
        $rounded_value = $value;
    }
    return $rounded_value;
}

sub get_decimal_places
{
    my ($number_str) = @_;
    $number_str = sprintf("%.15f", $number_str) if ($number_str =~ /e/i);
    if ($number_str =~ /\.(\d+)$/)
    {
        return length($1);
    }
    else
    {
        return 0;
    }
}

# --- define_time_windows_for_state ---
# Subdivides a configuration state window into smaller, regular time-based
# windows for decay and growth analysis.
#
sub define_time_windows_for_state {
    my ($state_obj, $ref_date_str, $unit, $size) = @_;
    my @windows;
    my $start = $state_obj->{start_time};
    my $end   = $state_obj->{end_time};

    my $current_win_start = $start->truncate(to => 'day');

    while ($current_win_start < $end) {
        my $current_win_end;
        if ($unit eq 'days') {
            $current_win_end = $current_win_start + ($size * ONE_DAY()) - 1;
        } else { # weeks
            $current_win_end = $current_win_start + ($size * ONE_WEEK()) - 1;
        }

        $current_win_end = $end if $current_win_end > $end;

        push @windows, {
            start => $current_win_start,
            end   => $current_win_end,
            rep_date => $current_win_end, # Representative date for weighting is the end of the window
        };

        $current_win_start = $current_win_end->truncate(to => 'day') + ONE_DAY();
    }
    return @windows;
}

# ==============================================================================
# SUBROUTINE: build_cache_index
# PURPOSE:    Builds a date-to-byte-offset index for the L1 cache data file.
#             This enables O(1) seeking to specific dates instead of sequential
#             scanning from the start of the file.
#
# ARGUMENTS:
#   1. $data_file (string): Path to the .nfit.cache.data file
#
# RETURNS:
#   Hash reference: { "YYYY-MM-DD" => byte_offset, ... }
#
# PERFORMANCE:
#   - Optimised with substr() for date extraction (5-10x faster than split)
#   - Uses :raw layer (no UTF-8 decoding overhead)
#   - For 350MB / 8.9M lines: ~2-3 seconds
# ==============================================================================
sub build_cache_index {
    my ($data_file) = @_;

    my %index;
    keys(%index) = 100;  # Pre-allocate for ~90 days

    my $current_date = '';
    my $line_count = 0;

    # Open with :raw for performance (VM names are ASCII on UNIX platforms)
    open my $fh, '<:raw', $data_file or die "FATAL: Cannot open $data_file: $!\n";

    # Skip header line (Timestamp,VMName,PhysC,RunQ)
    my $header = <$fh>;

    # Record position before first data line
    my $line_start_pos = tell($fh);

    while (my $line = <$fh>) {
        # Extract YYYY-MM-DD (first 10 characters)
        # This is 5-10x faster than split() operations
        my $date = substr($line, 0, 10);

        # Validate date format (detect corrupted data)
        unless ($date =~ /^\d{4}-\d{2}-\d{2}$/) {
            warn "Warning: Invalid date format at line $line_count: '$date'\n";
            $line_start_pos = tell($fh);
            next;
        }

        # Record byte offset when date changes
        if ($date ne $current_date) {
            $index{$date} = $line_start_pos;
            $current_date = $date;
        }

        # Save position for next iteration
        $line_start_pos = tell($fh);

        # Progress indicator for large files
        if (++$line_count % 1_000_000 == 0) {
            printf STDERR "\r  Building cache index: %.1fM lines...", $line_count / 1_000_000;
        }
    }

    if ($line_count >= 1_000_000) {
        printf STDERR "\r  Building cache index: %.1fM lines... Done (%d days)    \n",
            $line_count / 1_000_000, scalar keys %index;
    }

    close $fh;

    return \%index;
}

# ==============================================================================
# SUBROUTINE: load_or_build_cache_index
# PURPOSE:    Loads an existing cache index if valid, otherwise builds a new one.
#             Index validity is based on source file size and modification time.
#
# ARGUMENTS:
#   1. $cache_dir (string): Path to the cache directory
#   2. $data_file (string): Path to the .nfit.cache.data file
#
# RETURNS:
#   Hash reference: { "YYYY-MM-DD" => byte_offset, ... }
# ==============================================================================
sub load_or_build_cache_index {
    my ($cache_dir, $data_file) = @_;

    my $idx_file  = File::Spec->catfile($cache_dir, $CACHE_INDEX_FILE);
    my $lock_file = File::Spec->catfile($cache_dir, $CACHE_LOCK_FILE);

    my @st = stat($data_file) or die "FATAL: Cannot stat $data_file: $!\n";
    my ($data_size, $data_mtime) = @st[7, 9];

    # Try to load existing index
    if (-f $idx_file) {
        my ($index_size, $index_mtime);
        my $cached_index;
        my $cache_ok = 0;

        eval {
            open my $fh, '<', $idx_file or die "Cannot open index file: $!\n";
            flock($fh, LOCK_SH) or die "Cannot lock index file: $!\n";
            local $/; my $raw = <$fh>;
            close $fh;

            my $idx = decode_json($raw);

            die "Invalid index structure\n" unless ref($idx) eq 'HASH';
            die "Missing metadata\n"     unless ref($idx->{metadata}) eq 'HASH';
            die "Missing index\n"        unless ref($idx->{index})    eq 'HASH';

            # Coerce to numeric to avoid any string/dualvar surprises
            $index_size  = 0 + ($idx->{metadata}{source_size}  // -1);
            $index_mtime = 0 + ($idx->{metadata}{source_mtime} // -1);

            if ($index_size == $data_size && $index_mtime == $data_mtime) {
                $cached_index = $idx->{index};
                $cache_ok = 1;  # mark as a valid cache hit; return after eval
            }
            1;
        } or do {
            warn "Warning: Cache index corrupted or invalid: $@\n";
        };

        return $cached_index if $cache_ok;
        # Fall through to rebuild if we didnâ€™t get a valid cache hit
    }

    # Cache miss or stale - build new index
    print STDERR "Building cache index for date-range optimisation...\n";
    my $index = build_cache_index($data_file);

    # Save the index with metadata
    my $idx_data = {
        metadata => {
            source_file  => $CACHE_DATA_FILE,
            source_size  => $data_size + 0,
            source_mtime => $data_mtime + 0,
            created_at   => gmtime()->datetime(),
            nfit_version => $VERSION,
        },
        index => $index,
    };

    # Exclusive lock + atomic write (temp then rename)
    open my $lock_fh, '>>', $lock_file or die "FATAL: Cannot create lock file: $!\n";
    flock($lock_fh, LOCK_EX) or die "FATAL: Cannot acquire exclusive lock: $!\n";

    my $tmp = "$idx_file.tmp.$$";
    eval {
        open my $out, '>', $tmp or die "Cannot write temp index file: $!\n";
        print {$out} JSON->new->pretty->canonical->encode($idx_data);
        close $out or die "Cannot close temp index file: $!\n";
        rename $tmp, $idx_file or die "Cannot atomically replace index file: $!\n";
        1;
    } or do {
        warn "Warning: Failed to save cache index: $@\n";
        unlink $tmp;
    };

    flock($lock_fh, LOCK_UN);
    close $lock_fh;

    return $index;
}

# ==============================================================================
# SUBROUTINE: seek_to_start_date
# PURPOSE:    Seeks to the appropriate position in the data file based on the
#             start date, using the byte-offset index.
#
# ARGUMENTS:
#   1. $fh (filehandle): Open filehandle to the data file
#   2. $index (hash ref): Date-to-byte-offset index
#   3. $start_date_str (string): Start date in YYYY-MM-DD format
#
# RETURNS:
#   Byte offset where seeking occurred (for progress calculation)
# ==============================================================================
# ==============================================================================
# SUBROUTINE: _read_cache_manifest_meta
# PURPOSE:    Reads the stager's .nfit.cache.manifest ("key: value" lines) into
#             a hash. Lines without a colon are ignored; {} when absent.
# ==============================================================================
sub _read_cache_manifest_meta
{
    my ($cache_dir) = @_;
    my %meta;
    my $path = File::Spec->catfile($cache_dir, $CACHE_MANIFEST_FILE);
    open my $fh, '<', $path or return \%meta;
    while (my $line = <$fh>)
    {
        $line =~ s/[\r\n]+$//;
        next unless $line =~ /^\s*([^:]+?)\s*:\s*(.*?)\s*$/;
        $meta{$1} = $2;
    }
    close $fh;
    return \%meta;
}

# ==============================================================================
# SUBROUTINE: _resolve_l1_layout
# PURPOSE:    Validates the L1 header against the schema declared in the cache
#             manifest and returns the layout the main loop uses.
#               Schema 1 (no data_schema_version): exactly the four required
#                 columns; the original positional parse is kept.
#               Schema 2: the four required columns first, in order, then the
#                 optional columns; the header must equal data_columns.
#             An unsupported version, a missing or misplaced required column,
#             a repeated column or undeclared columns are fatal: misreading the
#             cache silently would corrupt every downstream result.
# RETURNS:    { legacy => 0|1, schema => N, columns => [...], index => {name => i} }
# ==============================================================================
sub _resolve_l1_layout
{
    my ($header_line, $meta, $data_file) = @_;

    die "FATAL: L1 cache '$data_file' has no header line.\n" unless defined $header_line;
    (my $h = $header_line) =~ s/[\r\n]+$//;
    my @columns = map
    {
        my $c = $_;
        $c =~ s/^\s+|\s+$//g;
        $L1_COLUMN_ALIASES{$c} // $c;
    } split /,/, $h, -1;

    my $schema = $meta->{data_schema_version} // 1;
    unless (grep { $_ eq $schema } @L1_SUPPORTED_SCHEMA_VERSIONS)
    {
        die "FATAL: L1 cache '$data_file' declares data_schema_version '$schema'; nfit $VERSION supports "
          . join(', ', @L1_SUPPORTED_SCHEMA_VERSIONS) . ". Upgrade nfit.\n";
    }

    for my $i (0 .. $#L1_REQUIRED_COLUMNS)
    {
        unless (defined $columns[$i] && $columns[$i] eq $L1_REQUIRED_COLUMNS[$i])
        {
            die "FATAL: L1 cache '$data_file' header must begin with "
              . join(',', @L1_REQUIRED_COLUMNS) . "; found '$h'.\n";
        }
    }

    my %index;
    for my $i (0 .. $#columns)
    {
        die "FATAL: L1 cache '$data_file' header repeats column '$columns[$i]'.\n"
            if exists $index{$columns[$i]};
        $index{$columns[$i]} = $i;
    }

    if ($schema == 1 && @columns != @L1_REQUIRED_COLUMNS)
    {
        die "FATAL: L1 cache '$data_file' has columns beyond schema 1 ('$h') without a declared "
          . "data_schema_version. Restage the cache.\n";
    }
    if ($schema >= 2)
    {
        my $declared = $meta->{data_columns} // '';
        die "FATAL: L1 cache '$data_file' header '$h' does not match the manifest's data_columns '$declared'.\n"
            unless $declared eq $h;
    }

    return {
        legacy  => ($schema == 1) ? 1 : 0,
        schema  => $schema,
        columns => \@columns,
        index   => \%index,
    };
}

# ==============================================================================
# SUBROUTINE: _l1_data_identity
# PURPOSE:    Identity of the staged data and states for the L2 cache key.
#             Uses the manifest's data_revision/states_revision when the stager
#             records them; otherwise the files' size and modification time.
# ==============================================================================
sub _l1_data_identity
{
    my ($cache_dir, $meta) = @_;
    my %id = (schema => ($meta->{data_schema_version} // 1));
    for my $item (['data', $CACHE_DATA_FILE, 'data_revision'], ['states', $CACHE_STATES_FILE, 'states_revision'])
    {
        my ($label, $file, $revision_key) = @$item;
        if (defined $meta->{$revision_key} && $meta->{$revision_key} ne '')
        {
            $id{$label} = "rev:$meta->{$revision_key}";
            next;
        }
        my @st = stat(File::Spec->catfile($cache_dir, $file));
        $id{$label} = @st ? "stat:$st[7]:$st[9]" : 'absent';
    }
    return \%id;
}

# ==============================================================================
# SUBROUTINE: _acquire_publish_lock
# PURPOSE:    Holds a shared lock on a cache directory's publication lock file
#             (.nfit.cache.publish.lock) from before the first read of its L1
#             files until the process exits. nfit-stage-influxdb swaps in a new
#             generation of a system's files only under the exclusive lock, so a
#             reader works on one complete generation. With the lock held, a
#             directory whose publication journal (.publish.journal) is present
#             is refused: an interrupted publication the stager has not yet
#             recovered.
#             A process started by one that already holds the lock (listed in
#             NFIT_PUBLISH_LOCK_HELD, which this sets for its children) takes
#             its own shared lock when that is immediately possible, and
#             otherwise relies on the parent's, which a waiting publisher cannot
#             pass. Parent and child therefore cannot deadlock behind a waiting
#             publisher, whatever the platform's lock fairness.
#             Where the lock file cannot be opened (a read-only copy), the cache
#             is read without it: no publisher can write there either.
# ARGUMENTS:  1. $cache_dir (string): one system's cache directory
# RETURNS:    Nothing. Dies if the directory has an unrecovered publication.
# ==============================================================================
our %PUBLISH_LOCKS;
sub _acquire_publish_lock
{
    my ($cache_dir) = @_;
    my $dir = abs_path($cache_dir) // $cache_dir;
    return if exists $PUBLISH_LOCKS{$dir};
    my $lock_path = File::Spec->catfile($dir, '.nfit.cache.publish.lock');
    my %held = map { $_ => 1 } grep { length } split /\n/, ($ENV{NFIT_PUBLISH_LOCK_HELD} // '');
    my $fh;
    if (open($fh, '>>', $lock_path) || open($fh, '<', $lock_path))
    {
        unless (flock($fh, LOCK_SH | LOCK_NB))
        {
            if ($held{$dir})
            {
                close $fh;
                undef $fh;    # the parent's shared lock covers this process's reads
            }
            else
            {
                print STDERR "  -> Waiting for a cache publication to finish ($dir)\n";
                flock($fh, LOCK_SH) or die "FATAL: Cannot lock '$lock_path': $!\n";
            }
        }
    }
    else
    {
        undef $fh;
    }
    $PUBLISH_LOCKS{$dir} = $fh;
    if (-e File::Spec->catfile($dir, '.publish.journal'))
    {
        die "FATAL: The cache in '$dir' has an interrupted publication that has not been recovered "
          . "(.publish.journal present). Run nfit-stage-influxdb for this system to complete it, then retry.\n";
    }
    $held{$dir} = 1;
    $ENV{NFIT_PUBLISH_LOCK_HELD} = join("\n", sort keys %held);
    return;
}

# ==============================================================================
# SUBROUTINE: _release_publish_lock
# PURPOSE:    Releases the shared publication lock of a cache directory this
#             process no longer reads, and removes it from NFIT_PUBLISH_LOCK_HELD.
# ==============================================================================
sub _release_publish_lock
{
    my ($cache_dir) = @_;
    my $dir = abs_path($cache_dir) // $cache_dir;
    return unless exists $PUBLISH_LOCKS{$dir};
    my $fh = delete $PUBLISH_LOCKS{$dir};
    close $fh if defined $fh;
    my %held = map { $_ => 1 } grep { length && $_ ne $dir } split /\n/, ($ENV{NFIT_PUBLISH_LOCK_HELD} // '');
    $ENV{NFIT_PUBLISH_LOCK_HELD} = join("\n", sort keys %held);
    return;
}

# ==============================================================================
# Paired PhysC/PhysB transforms (Increment 6, design v3.2 §3)
# ==============================================================================
# Active only when the L1 cache declares a PhysB column; schema-1 runs never
# reach this code and the legacy PhysC/RunQ state, arrays and outputs are not
# touched. The paired population is the legacy-retained rows (numeric PhysC and
# RunQ) that pass the same date, exclusion, state and per-transform time
# filters, and that carry a valid PhysB:
#   valid pair   PhysC and PhysB finite and >= 0, PhysB <= PhysC +
#                $PAIRED_B_ABOVE_C_TOLERANCE, and both at most the VM's ceiling:
#                $PAIRED_CEILING_FACTOR x its largest virtual-processor count over
#                its states + $PAIRED_CEILING_MARGIN (a VM cannot consume more
#                physical cores than it has virtual processors); without VP
#                metadata, the pool size; without either, no ceiling (counted).
#                Rejected samples stay in the L1 file and in the legacy path;
#                they are excluded from the paired population, counted by
#                reason, and break the smoothing run
#   weight       elapsed seconds since the previous valid pair of the same VM,
#                transform and state when 0 < dt <= $PAIRED_GAP_FACTOR x the
#                detected interval; otherwise (first pair, gap, state change,
#                previous sample invalid) the detected interval: a sample is
#                never given the time since a distant predecessor
#   same second  a valid pair with dt = 0 (two samples in one UTC second) has
#                zero elapsed time: it carries no weight, is not smoothed, and
#                is counted, without assuming it duplicates its neighbour
#   smoothing    the transform's own method and window (SMA, or EMA seeded by
#                an SMA of the window), applied to C and B in lock step; the
#                run is reset (and re-warmed) after any invalid pair, gap or
#                state change, so a smoothed value only ever spans contiguous
#                valid pairs of one state
# (Constants are declared with the other engine constants near the top.)

# ==============================================================================
# SUBROUTINE: _transform_excludes_day / _transform_includes_time
# PURPOSE:    The per-transform weekday and time-of-day filters, shared by the
#             legacy path and the paired path's expected-time calculation so
#             both always admit the same samples.
#             NOTE: Time::Piece day_of_week evaluates 0 = Sunday through 
#             6 = Saturday. The filter accurately identifies and excludes 
#             weekends (0 and 6).
# ==============================================================================
sub _transform_excludes_day
{
    my ($tp) = @_;
    my $day_of_week = $tp->day_of_week;
    return ($day_of_week == 0 || $day_of_week == 6);
}

sub _transform_includes_time
{
    my ($time_filter_type, $line_time) = @_;
    return 1 if $time_filter_type eq 'none';
    return ($line_time ge '08:00' && $line_time lt '17:00') if $time_filter_type eq 'online';
    return ($line_time ge '18:00' || $line_time lt '06:00') if $time_filter_type eq 'batch';
    return 0;
}

# ==============================================================================
# SUBROUTINE: _paired_weight
# PURPOSE:    Elapsed-time weight (seconds) of a sample given the previous
#             sample of its timeline: dt when 0 <= dt <= gap limit within the
#             same state, otherwise the detected interval.
# ==============================================================================
sub _paired_weight
{
    my ($prev, $epoch, $bin, $interval_s) = @_;
    return $interval_s unless defined $prev && defined $prev->{t} && $prev->{bin} eq $bin && !$prev->{broken};
    my $dt = $epoch - $prev->{t};
    return ($dt >= 0 && $dt <= $PAIRED_GAP_FACTOR * $interval_s) ? $dt : $interval_s;
}

# ==============================================================================
# SUBROUTINE: _paired_update
# PURPOSE:    Accumulates one legacy-retained PhysC sample (with its PhysB cell)
#             for one VM, state bin and PhysC transform.
# ==============================================================================
sub _paired_finite
{
    my ($x) = @_;
    return (defined $x && looks_like_number($x) && $x == $x && $x != 9**9**9 && $x != -9**9**9);
}

# Plausibility ceiling (cores) of a VM's PhysC and PhysB, from its states.
sub _paired_ceiling
{
    my ($ctx, $vm, $states_aref) = @_;
    return $ctx->{ceiling}{$vm} if exists $ctx->{ceiling}{$vm};
    my ($vps, $pool) = (0, 0);
    foreach my $s (@{ $states_aref // [] })
    {
        my $m = $s->{metadata} // {};
        $vps  = $m->{virtual_cpus} if _paired_finite($m->{virtual_cpus}) && $m->{virtual_cpus} > $vps;
        $pool = $m->{pool_cpu}     if _paired_finite($m->{pool_cpu})     && $m->{pool_cpu}     > $pool;
    }
    my $basis = $vps > 0 ? 'virtual_cpus' : $pool > 0 ? 'pool_cpu' : 'none';
    my $base  = $vps > 0 ? $vps : $pool;
    my $ceiling = $base > 0 ? $PAIRED_CEILING_FACTOR * $base + $PAIRED_CEILING_MARGIN : undef;
    return $ctx->{ceiling}{$vm} = { value => $ceiling, basis => $basis };
}

sub _paired_update
{
    my ($ctx, $vm, $bin, $key, $entry, $epoch, $c, $b, $ceiling, $f) = @_;
    my $interval_s = $ctx->{interval_s};
    my $acc = $ctx->{acc}{$vm}{$bin}{$key} //= {
        sumB => 0, sumC => 0, w_pair => 0, w_c => 0, validPairs => 0, missingB => 0,
        nonNumericB => 0, bAboveC => 0, nonFiniteC => 0, cAboveCeiling => 0, bAboveCeiling => 0,
        sameSecondSamples => 0, resets => 0, packed => '', first => undef, last => undef,
        ceiling => $ceiling, freqUnavailable => 0, daily => {},
    };
    my $day = int($epoch / $PAIRED_SECONDS_PER_DAY);
    my $daily = $acc->{daily}{$day} //= { sumB => 0, sumC => 0, w_pair => 0, w_c => 0, f_sum => 0, f_w => 0 };

    # PhysC timeline: every legacy-retained sample of this transform.
    my $ctime = $ctx->{ctime}{$vm}{$key} //= {};
    my $wc = _paired_weight($ctime, $epoch, $bin, $interval_s);
    @$ctime{qw(t bin broken)} = ($epoch, $bin, 0);
    $acc->{w_c} += $wc;
    $daily->{w_c} += $wc;

    my $st = $ctx->{pstate}{$vm}{$key} //= {};
    my $reason;
    my $limit = $ceiling ? $ceiling->{value} : undef;
    if (!_paired_finite($c) || $c < 0)            { $reason = 'nonFiniteC'; }
    elsif (defined $limit && $c > $limit)          { $reason = 'cAboveCeiling'; }
    elsif (!defined $b || $b eq '')                { $reason = 'missingB'; }
    elsif (!_paired_finite($b) || $b < 0)          { $reason = 'nonNumericB'; }
    elsif (defined $limit && $b > $limit)          { $reason = 'bAboveCeiling'; }
    elsif ($b > $c + $PAIRED_B_ABOVE_C_TOLERANCE)  { $reason = 'bAboveC'; }
    if ($reason)
    {
        $acc->{$reason}++;
        $st->{broken} = 1;                 # the next valid pair starts a new run
        return;
    }

    my $dt = (defined $st->{t} && !$st->{broken} && $st->{bin} eq $bin) ? $epoch - $st->{t} : undef;
    if (defined $dt && $dt == 0)
    {
        $acc->{sameSecondSamples}++;
        return;
    }
    my $continuous = (defined $dt && $dt > 0 && $dt <= $PAIRED_GAP_FACTOR * $interval_s);
    my $w = $continuous ? $dt : $interval_s;
    unless ($continuous)
    {
        $acc->{resets}++ if defined $st->{t};
        $st->{c_state} = initialise_transform_state($entry);
        $st->{b_state} = initialise_transform_state($entry);
    }
    @$st{qw(t bin broken)} = ($epoch, $bin, 0);

    $acc->{sumB}   += $b * $w / 60;
    $acc->{sumC}   += $c * $w / 60;
    $acc->{w_pair} += $w;
    $acc->{validPairs}++;
    $daily->{sumB}   += $b * $w / 60;
    $daily->{sumC}   += $c * $w / 60;
    $daily->{w_pair} += $w;
    # FreqPct is context only: time-weighted over valid pairs where it is finite.
    if (_paired_finite($f) && $f >= 0) { $daily->{f_sum} += $f * $w; $daily->{f_w} += $w; }
    else                               { $acc->{freqUnavailable}++; }
    $acc->{first} //= $epoch;
    $acc->{last}    = $epoch;

    my $c_smooth = update_transform_state($c, $st->{c_state});
    my $b_smooth = update_transform_state($b, $st->{b_state});
    # The daily history statistic has the origin of an independent one-day
    # paired pass. Leave the monthly smoother and its tails continuous.
    if ($entry->{daily_paired_profiles})
    {
        if (!$continuous || !defined $st->{daily_day} || $st->{daily_day} != $day)
        {
            $st->{daily_day} = $day;
            $st->{daily_c} = initialise_transform_state($entry);
            $st->{daily_b} = initialise_transform_state($entry);
        }
        my $dc = update_transform_state($c, $st->{daily_c});
        my $db = update_transform_state($b, $st->{daily_b});
        $daily->{windows} .= pack('f<f<', $dc, $db) if defined $dc && defined $db;
    }
    if (defined $c_smooth && defined $b_smooth)
    {
        $acc->{packed} .= pack('f<f<L<', $c_smooth, $b_smooth, int($epoch / $PAIRED_SECONDS_PER_DAY));
    }
    return;
}

# ==============================================================================
# SUBROUTINE: _paired_expected_seconds
# PURPOSE:    Seconds in [start, end] that a transform's weekday and time-of-day
#             filters admit, evaluated day by day with the same predicates as
#             the sample filter.
# ==============================================================================
sub _paired_expected_seconds
{
    my ($start, $end, $entry) = @_;
    my $by_day = _paired_expected_by_day($start, $end, $entry);
    my $total = 0;
    $total += $_ for values %$by_day;
    return $total;
}

# The same, per UTC day index (int(epoch / 86400)); days with none are omitted.
sub _paired_expected_by_day
{
    my ($start, $end, $entry) = @_;
    my %by_day;
    return \%by_day unless defined $start && defined $end && $end > $start;
    my $filter = $entry->{time_filter} // 'none';
    my @allowed = $filter eq 'online' ? ([8 * 3600, 17 * 3600])
                : $filter eq 'batch'  ? ([0, 6 * 3600], [18 * 3600, $PAIRED_SECONDS_PER_DAY])
                :                       ([0, $PAIRED_SECONDS_PER_DAY]);
    my $day = $start - ($start % $PAIRED_SECONDS_PER_DAY);
    while ($day <= $end)
    {
        my $day_tp = gmtime($day);                 # scalar context: a Time::Piece object
        my $skip = $entry->{no_weekends} && _transform_excludes_day($day_tp);
        unless ($skip)
        {
            foreach my $iv (@allowed)
            {
                my $a = $day + $iv->[0];
                my $z = $day + $iv->[1];
                $a = $start if $a < $start;
                $z = $end   if $z > $end;
                $by_day{ $day / $PAIRED_SECONDS_PER_DAY } += $z - $a if $z > $a;
            }
        }
        $day += $PAIRED_SECONDS_PER_DAY;
    }
    return \%by_day;
}

sub _paired_round
{
    my ($v, $places) = @_;
    return undef unless defined $v;
    return 0 + sprintf("%.${places}f", $v);
}

# Percentiles of a sorted list after the transform's --filter-above-perc rule,
# exactly as finalize_results applies it to the legacy series.
sub _paired_profile_percentiles
{
    my ($sorted_aref, $filter_perc, $p_list_aref) = @_;
    my @values = @$sorted_aref;
    if (defined $filter_perc && $filter_perc > 0 && @values)
    {
        my $threshold = calculate_percentile(\@values, $filter_perc);
        @values = grep { $_ >= ($threshold - $FLOAT_EPSILON) } @values if defined $threshold;
    }
    return calculate_percentiles_from_packed(\@values, $p_list_aref);
}

# ==============================================================================
# SUBROUTINE: _paired_finalize
# PURPOSE:    Per VM, state bin and PhysC transform: whole-period paired
#             exposure, coverage, quality, and per requested percentile the
#             marginal busy profile value and the paired tail (design §3.3).
#             Coverage is reported, not judged: the period is the bin's span
#             within the analysis window and the cache's observed range;
#             truncation at either end is flagged.
# ==============================================================================
sub _paired_finalize
{
    my ($ctx, $manifest, $states_by_vm, $args) = @_;
    my %out;
    foreach my $vm (keys %{ $ctx->{acc} })
    {
        foreach my $bin (keys %{ $ctx->{acc}{$vm} })
        {
            foreach my $key (keys %{ $ctx->{acc}{$vm}{$bin} })
            {
                my $acc   = $ctx->{acc}{$vm}{$bin}{$key};
                my $entry = $manifest->{$key};

                # Period: bin span (state or time window) within the analysis
                # window and the cache's observed range.
                my ($span_start, $span_end);
                if (defined $args->{time_windows_aref} && $args->{enable_windowed_decay})
                {
                    my ($w) = grep { $_->{id} eq $bin } @{ $args->{time_windows_aref} };
                    ($span_start, $span_end) = ($w->{start_obj}->epoch, $w->{end_obj}->epoch - 1) if $w;
                }
                elsif (my $s = $states_by_vm->{$vm}[$bin])
                {
                    ($span_start, $span_end) = ($s->{start_time}->epoch, $s->{end_time}->epoch);
                }
                my @starts = grep { defined } ($span_start, $args->{window_start}, $ctx->{range_min});
                my @ends   = grep { defined } ($span_end, $args->{window_end}, $ctx->{range_max});
                my $p_start = @starts ? max(@starts) : undef;
                my $p_end   = @ends   ? min(@ends)   : undef;
                # Each sample stands for the interval it closes, so the expected
                # time runs one interval past the period's last instant.
                my $expected_by_day = _paired_expected_by_day($p_start, defined $p_end ? $p_end + $ctx->{interval_s} : undef, $entry);
                my $expected_s = 0;
                $expected_s += $_ for values %$expected_by_day;
                my $truncated_start = (defined $span_start && defined $ctx->{range_min} && $ctx->{range_min} > $span_start
                                       && (!defined $args->{window_start} || $ctx->{range_min} > $args->{window_start})) ? JSON::true : JSON::false;
                my $truncated_end   = (defined $span_end && defined $ctx->{range_max} && $ctx->{range_max} < $span_end
                                       && (!defined $args->{window_end} || $ctx->{range_max} < $args->{window_end})) ? JSON::true : JSON::false;

                my $paired_min = $acc->{w_pair} / 60;
                my $physc_min  = $acc->{w_c} / 60;
                my $expected_min = $expected_s / 60;
                my %common = (
                    coverage => {
                        periodStart     => defined $p_start ? gmtime($p_start)->datetime : undef,
                        periodEnd       => defined $p_end   ? gmtime($p_end)->datetime   : undef,
                        expectedMinutes => _paired_round($expected_min, 1),
                        physcMinutes    => _paired_round($physc_min, 1),
                        pairedMinutes   => _paired_round($paired_min, 1),
                        physcCoverage   => $expected_min > 0 ? _paired_round($physc_min / $expected_min, 4) : undef,
                        pairedCoverage  => $expected_min > 0 ? _paired_round($paired_min / $expected_min, 4) : undef,
                        truncatedAtStart => $truncated_start,
                        truncatedAtEnd   => $truncated_end,
                        # Support extent, distinct from the period extent above.
                        firstPair       => defined $acc->{first} ? gmtime($acc->{first})->datetime : undef,
                        lastPair        => defined $acc->{last}  ? gmtime($acc->{last})->datetime  : undef,
                        pairedDays      => scalar(grep { $acc->{daily}{$_}{w_pair} > 0 } keys %{ $acc->{daily} }),
                    },
                    pairedExposure => {
                        sumB => _paired_round($acc->{sumB}, 4),    # core-minutes
                        sumC => _paired_round($acc->{sumC}, 4),
                        pairedMinutes => _paired_round($paired_min, 1),
                    },
                    busyShare => $acc->{sumC} > 0 ? _paired_round($acc->{sumB} / $acc->{sumC}, 4) : undef,
                    quality => {
                        validPairs        => $acc->{validPairs},
                        missingB          => $acc->{missingB},
                        nonNumericB       => $acc->{nonNumericB},
                        bAboveC           => $acc->{bAboveC},
                        nonFiniteC        => $acc->{nonFiniteC},
                        cAboveCeiling     => $acc->{cAboveCeiling},
                        bAboveCeiling     => $acc->{bAboveCeiling},
                        ceilingCores      => _paired_round($acc->{ceiling}{value}, 4),
                        ceilingBasis      => $acc->{ceiling}{basis},
                        sameSecondSamples => $acc->{sameSecondSamples},
                        runResets         => $acc->{resets},
                        freqPctUnavailable => $acc->{freqUnavailable},
                    },
                );

                my @rows;
                my $n = length($acc->{packed}) / 12;
                for (my $i = 0; $i < $n; $i++)
                {
                    push @rows, [ unpack('f<f<L<', substr($acc->{packed}, $i * 12, 12)) ];
                }
                if (!$acc->{validPairs})
                {
                    $common{status} = 'unavailable';
                    $common{reason} = 'no valid PhysC/PhysB pairs';
                }
                elsif (!@rows)
                {
                    $common{status} = 'unavailable';
                    $common{reason} = 'no complete smoothed window';
                }
                else
                {
                    $common{status} = 'available';
                }

                my %percentiles_needed;
                foreach my $prof (values %{ $entry->{profiles} // {} })
                {
                    $percentiles_needed{$_} = 1 for @{ $prof->{percentiles} // [] };
                }
                my @p_list = sort { $a <=> $b } keys %percentiles_needed;
                my (%profile_b, %tail, %tail_daily);
                if (@rows)
                {
                    my @c_sorted = sort { $a <=> $b } map { $_->[0] } @rows;
                    my @b_sorted = sort { $a <=> $b } map { $_->[1] } @rows;
                    my $c_p = _paired_profile_percentiles(\@c_sorted, $entry->{filter_perc}, \@p_list);
                    my $b_p = _paired_profile_percentiles(\@b_sorted, $entry->{filter_perc}, \@p_list);
                    foreach my $p (@p_list)
                    {
                        $profile_b{"P$p"} = _paired_round($b_p->{$p}, 4);
                        my $thr = $c_p->{$p};
                        next unless defined $thr;
                        my ($windows, $ties, $sb, $sc, %days) = (0, 0, 0, 0);
                        foreach my $r (@rows)
                        {
                            next unless $r->[0] >= $thr - $FLOAT_EPSILON;
                            $windows++;
                            $ties++ if abs($r->[0] - $thr) <= $FLOAT_EPSILON;
                            $sb += $r->[1];
                            $sc += $r->[0];
                            $days{ $r->[2] } = 1;
                            my $td = $tail_daily{"P$p"}{ $r->[2] } //= [0, 0, 0];
                            $td->[0]++; $td->[1] += $r->[1]; $td->[2] += $r->[0];
                        }
                        $tail{"P$p"} = {
                            threshold    => _paired_round($thr, 4),
                            windows      => $windows,
                            tiesIncluded => $ties,
                            distinctDays => scalar(keys %days),
                            sumB         => _paired_round($sb, 4),     # sums of smoothed values
                            sumC         => _paired_round($sc, 4),
                            busyShare    => $sc > 0 ? _paired_round($sb / $sc, 4) : undef,
                            meanB        => $windows ? _paired_round($sb / $windows, 4) : undef,
                            meanC        => $windows ? _paired_round($sc / $windows, 4) : undef,
                            meanNonBusy  => $windows ? _paired_round(($sc - $sb) / $windows, 4) : undef,
                        };
                    }
                    my @ratios = sort { $a <=> $b } map { $_->[1] / $_->[0] }
                                 grep { $_->[0] > $ACTIVE_PHYSC_THRESHOLD } @rows;
                    my $dist = calculate_percentiles_from_packed(\@ratios, [10, 50, 90]);
                    $common{busyShareDist} = {
                        activeThreshold   => _paired_round($ACTIVE_PHYSC_THRESHOLD, 4),
                        windows           => scalar(@ratios),
                        suppressedWindows => scalar(@rows) - scalar(@ratios),
                        P10 => _paired_round($dist->{10}, 4),
                        P50 => _paired_round($dist->{50}, 4),
                        P90 => _paired_round($dist->{90}, 4),
                    };
                }
                $common{smoothedWindows} = scalar @rows;

                # Daily exposure totals and, when requested, native percentiles
                # from that UTC day's independently warmed paired windows.
                my %day_set = map { $_ => 1 } (keys %$expected_by_day, keys %{ $acc->{daily} });
                my @daily_common;
                foreach my $d (sort { $a <=> $b } keys %day_set)
                {
                    my $dd = $acc->{daily}{$d} // {};
                    my $series;
                    # The expected-time allowance can spill past midnight after
                    # the final sample. It must not create a new profile date.
                    if ($entry->{daily_paired_profiles} && defined $p_end && $d <= int($p_end / $PAIRED_SECONDS_PER_DAY))
                    {
                        my @pairs = unpack('f<*', delete($dd->{windows}) // '');
                        my (@c, @b);
                        for (my $i = 0; $i < @pairs; $i += 2)
                        {
                            push @c, $pairs[$i];
                            push @b, $pairs[$i+1];
                        }
                        $series = { windows => scalar @c };
                        for my $metric (['PhysC', \@c], ['PhysB', \@b])
                        {
                            my @sorted = sort { $a <=> $b } @{ $metric->[1] };
                            $series->{$metric->[0]} = _paired_profile_percentiles(\@sorted, $entry->{filter_perc}, \@p_list);
                        }
                    }
                    push @daily_common, {
                        _series         => $series,
                        _day            => $d,
                        date            => gmtime($d * $PAIRED_SECONDS_PER_DAY)->ymd,
                        expectedMinutes => _paired_round(($expected_by_day->{$d} // 0) / 60, 1),
                        physcMinutes    => _paired_round(($dd->{w_c} // 0) / 60, 1),
                        pairedMinutes   => _paired_round(($dd->{w_pair} // 0) / 60, 1),
                        sumB            => _paired_round($dd->{sumB} // 0, 4),
                        sumC            => _paired_round($dd->{sumC} // 0, 4),
                        freqPctMean     => ($dd->{f_w} // 0) > 0 ? _paired_round($dd->{f_sum} / $dd->{f_w}, 2) : undef,
                        freqPctMinutes  => _paired_round(($dd->{f_w} // 0) / 60, 1),
                    };
                }

                foreach my $profile_name (keys %{ $entry->{profiles} // {} })
                {
                    my %per = %common;
                    my @mine = map { "P$_" } @{ $entry->{profiles}{$profile_name}{percentiles} // [] };
                    $per{profileValueB} = { map { $_ => $profile_b{$_} } grep { exists $profile_b{$_} } @mine };
                    $per{tail}          = { map { $_ => $tail{$_} }      grep { exists $tail{$_} } @mine };
                    $per{daily} = [ map {
                        my %row = %$_;
                        my $d = delete $row{_day};
                        my $series = delete $row{_series};
                        if ($series && $entry->{daily_paired_profiles}{$profile_name})
                        {
                            $row{profileSeries} = {
                                windows => $series->{windows},
                                map {
                                    my $metric = $_;
                                    $metric => { map { ("P$_", _paired_round($series->{$metric}{$_}, 4)) }
                                                 @{ $entry->{profiles}{$profile_name}{percentiles} } }
                                } qw(PhysB PhysC)
                            };
                        }
                        my %t;
                        foreach my $pk (grep { exists $tail{$_} } @mine)
                        {
                            my $td = $tail_daily{$pk}{$d} // [0, 0, 0];
                            $t{$pk} = { windows => $td->[0], sumB => _paired_round($td->[1], 4), sumC => _paired_round($td->[2], 4) };
                        }
                        $row{tail} = \%t;
                        \%row;
                    } @daily_common ];
                    $out{$vm}{$bin}{$profile_name} = \%per;
                }
            }
        }
    }
    return \%out;
}

# ==============================================================================
# SUBROUTINE: _attach_paired_results
# PURPOSE:    Adds the paired results to the assembled output objects without
#             touching any existing field: metrics.physb.<profile> on per-state
#             objects; physbByState.<state id or window id>.<profile> on
#             aggregated (decay) objects; physbProvenance on both.
# ==============================================================================
sub _attach_paired_results
{
    my ($objects_aref, $paired, $is_aggregated, $provenance) = @_;
    foreach my $obj (@$objects_aref)
    {
        my $vm = $obj->{vmName};
        next unless defined $vm && exists $paired->{$vm};
        if ($is_aggregated)
        {
            my %by_state;
            foreach my $bin (keys %{ $paired->{$vm} })
            {
                $by_state{ $bin =~ /^\d+$/ ? $bin + 1 : $bin } = $paired->{$vm}{$bin};
            }
            $obj->{physbByState} = \%by_state;
        }
        else
        {
            my $bin = ($obj->{state}{id} // 0) - 1;
            next unless exists $paired->{$vm}{$bin};
            $obj->{metrics}{physb} = $paired->{$vm}{$bin};
        }
        $obj->{physbProvenance} = $provenance;
    }
    return;
}

sub seek_to_start_date {
    my ($fh, $index, $start_date_str) = @_;

    return 0 unless defined $start_date_str && $start_date_str ne '';

    # Try exact match first
    if (exists $index->{$start_date_str}) {
        seek($fh, $index->{$start_date_str}, 0);
        return $index->{$start_date_str};
    }

    # No exact match - find closest earlier date
    my @dates = sort keys %$index;
    for (my $i = $#dates; $i >= 0; $i--) {
        if ($dates[$i] le $start_date_str) {
            seek($fh, $index->{$dates[$i]}, 0);
            return $index->{$dates[$i]};
        }
    }

    # Start date is before all indexed data - start from beginning
    return 0;
}

sub get_window_index_for_timestamp {
    my ($timestamp_obj, $windows_aref) = @_;
    my $ts_epoch = $timestamp_obj->epoch;
    for (my $i=0; $i < @{$windows_aref}; $i++) {
        my ($win_start, $win_end) = @{$windows_aref->[$i]};
        return $i if ($ts_epoch >= $win_start->epoch && $ts_epoch <= $win_end->epoch);
    }
    return undef;
}


sub parse_csv_line {
    my ($line) = @_;
    my @fields;

    while (length($line)) {
        if ($line =~ s/^"((?:[^"]|"")*)"[,]*//) {
            my $field = $1;
            $field =~ s/""/"/g;  # unescape double quotes
            push @fields, $field;
        } elsif ($line =~ s/^([^",]*)[,]*//) {
            push @fields, $1;
        } else {
            # fallback (shouldn't happen with consistent CSV)
            last;
        }
    }

    return @fields;
}

## --- BEGIN L2 RESULTS CACHE SUBROUTINES --- ##

# ==============================================================================
# Subroutine to look up a result from the L2 cache file.
# Returns: An array reference of result hashes, or undef if not found.
# ==============================================================================
# The optional $stats hashref receives the cache file's size and entry count
# (NFIT_STAGE_TIMINGS reporting); it does not change the lookup.
sub lookup_cached_result
{
    my ($key, $cache_file, $stats) = @_;

    return undef unless (-f $cache_file && -s $cache_file);

    # Read the entire file content as a single string.
    my $json_text = do {
        open my $fh, '<:encoding(utf8)', $cache_file or do {
            warn "Warning: Could not open results cache '$cache_file' for reading: $!";
            return undef;
        };
        local $/;
        my $content = <$fh>;
        close $fh;
        $content;
    };

    # Decode the single JSON object from the file. The file was read through a
    # UTF-8 layer, so $json_text already holds characters: decode in character
    # mode. decode_json() expects UTF-8 bytes and would decode a second time,
    # which corrupts or rejects any non-ASCII text in cached results.
    my $json_decoder = JSON->new->allow_nonref;
    my $cache_data = eval { $json_decoder->decode($json_text) };
    if ($@ || !defined($cache_data) || ref($cache_data) ne 'HASH') {
        print STDERR "Warning: Results cache '$cache_file' is invalid. Resetting.\n";
        unlink $cache_file or warn "Warning: Could not remove corrupt cache file '$cache_file': $!";
        return undef;
    }

    if ($stats)
    {
        $stats->{bytes}   = -s $cache_file;
        $stats->{entries} = scalar keys %$cache_data;
    }
    # The value is now an array reference of hashes.
    return $cache_data->{$key};
}

# ==============================================================================
# Subroutine to save a result to the L2 cache file under an exclusive lock.
# ==============================================================================
# ==============================================================================
# SUBROUTINE: _report_results_cache_timings
# PURPOSE:    With NFIT_STAGE_TIMINGS set, prints one line per engine call: the
#             results cache's lookup time, file size and entry count, and on a
#             miss the analysis time and the save time (lock wait, read, write).
#             The line carries no identifiers.
# ==============================================================================
sub _report_results_cache_timings
{
    my ($t, $outcome) = @_;
    my $lookup = $t->{lookup} // {};
    my $line = sprintf("[TIMING] engine results cache %s: lookup %.2f s (file %.1f MB, %d entries)",
        $outcome, $lookup->{s} // 0, ($lookup->{bytes} // 0) / 1_048_576, $lookup->{entries} // 0);
    if ($outcome eq 'miss')
    {
        my $save = $t->{save} // {};
        $line .= sprintf("; analysis %.2f s; save %.2f s (lock %.2f, read %.2f, write %.2f; file %.1f MB, %d entries)",
            $t->{analysis_s} // 0, ($save->{lock_s} // 0) + ($save->{read_s} // 0) + ($save->{write_s} // 0),
            $save->{lock_s} // 0, $save->{read_s} // 0, $save->{write_s} // 0,
            ($save->{bytes} // 0) / 1_048_576, $save->{entries} // 0);
    }
    my $backend = eval { JSON->backend } // 'unknown';
    print STDERR "$line; JSON $backend\n";
    return;
}

# The optional $stats hashref receives the time spent waiting for the lock,
# reading and decoding the existing file, and encoding and writing it again
# (NFIT_STAGE_TIMINGS reporting); it does not change the save.
sub save_result_to_cache
{
    my ($key, $result_objects_aref, $cache_file, $lock_file, $stats) = @_;
    my $clock = $stats ? sub { Time::HiRes::time() } : sub { 0 };
    my $t0 = $clock->();

    # This subroutine now performs a safe read-modify-write of the entire JSON cache file.
    # Acquire an exclusive lock to prevent race conditions when writing.
    open my $lock_fh, '>', $lock_file or do {
        warn "Warning: Could not create lock file '$lock_file' for writing cache: $!. Skipping cache write.";
        return;
    };
    flock($lock_fh, LOCK_EX) or do {
        warn "Warning: Could not acquire exclusive lock on '$lock_file': $!. Skipping cache write.";
        close $lock_fh;
        return;
    };
    my $t_locked = $clock->();
    # Read the existing cache file into a Perl hash.
    my $cache_data = {};
    if (-f $cache_file && -s $cache_file) {
        my $json_text = do {
            open my $read_fh, '<:encoding(utf8)', $cache_file;
            local $/;
            <$read_fh>;
        };
        my $json_decoder = JSON->new->allow_nonref;
        my $decoded = eval { $json_decoder->decode($json_text) };
        # If the file is valid JSON hash, use it. Otherwise, start fresh.
        $cache_data = $decoded if (ref($decoded) eq 'HASH');
    }

    my $t_read = $clock->();
    # Add or update the result for the current key with the array of result objects.
    $cache_data->{$key} = $result_objects_aref;

    # Encode the entire updated hash back to a pretty-printed JSON string.
    my $json_encoder = JSON->new->pretty->canonical;
    my $output_json = $json_encoder->encode($cache_data);

    # Overwrite the cache file with the new content.
    open my $write_fh, '>:encoding(utf8)', $cache_file or do {
        warn "Warning: Could not open results cache '$cache_file' for writing: $!";
        close $lock_fh;
        return;
    };

    print $write_fh $output_json;
    close $write_fh;
    close $lock_fh; # Releases the lock automatically on close.
    if ($stats)
    {
        my $t_end = $clock->();
        @$stats{qw(lock_s read_s write_s bytes entries)} =
            ($t_locked - $t0, $t_read - $t_locked, $t_end - $t_read, length($output_json), scalar keys %$cache_data);
    }
}

# Subroutine for the Hybrid State-Time Decay Model
sub synthesize_hybrid_timeseries {
    my ($state_results_aref, $metric_key) = @_;
    my @timeseries_points;

    foreach my $state_result (@$state_results_aref) {
        my $start_obj = $state_result->{state_obj}{start_time}->truncate(to => 'day');
        my $end_obj   = $state_result->{state_obj}{end_time}->truncate(to => 'day');
        my $metric_val = $state_result->{metrics}{$metric_key};

        # Skip if this state didn't have a valid metric
        next unless defined $metric_val && looks_like_number($metric_val);

        my $current_day = $start_obj;
        while ($current_day <= $end_obj) {
            # Add a data point for every day the state was active
            push @timeseries_points, {
                value => $metric_val,
                date  => Time::Piece->new($current_day->epoch) # Use a copy
            };
            $current_day += ONE_DAY;
        }
    }
    return @timeseries_points;
}

# ==============================================================================
# SUBROUTINE: _calculate_clipping_metrics
# PURPOSE:    Implements the Multi-Stage Confidence Pipeline to detect CPU
#             clipping and estimate latent demand from a buffer of raw
#             performance data.
# ARGS:
#   1. $raw_physc_aref (array ref): A buffer of raw, high-frequency PhysC values.
#   2. $raw_runq_aref (array ref): A buffer of raw, high-frequency RunQ values.
#   3. $max_capacity (numeric): The authoritative max_capacity for the state.
#   4. $smt (numeric): The SMT value for the state, for RunQ context.
# RETURNS:
#   - A hash reference containing the clipping analysis results:
#     {
#       isClipped => 0|1,
#       clippingConfidence => 0.0-1.0,
#       clippingSeverity => 'none'|'low'|'moderate'|'high',
#       unmetDemandEstimate => 0.0,
#       platformMarkers => { aix_runq_saturation => 0.0-1.0 }
#     }
# ==============================================================================
sub _calculate_clipping_metrics
{
    my ($raw_physc_aref, $raw_runq_aref, $max_capacity, $smt) = @_;

    my %results = (
        isClipped           => 0,
        clippingConfidence  => 0.0,
        clippingSeverity    => 'none',
        unmetDemandEstimate => 0.0,
        platformMarkers     => {},
    );

    # The pipeline requires a valid capacity limit and sufficient data points.
    return \%results unless (defined $max_capacity && $max_capacity > 0.1 && @$raw_physc_aref > 10);

    # --- Stage I & II: Raw Detection & Shape Analysis ---
    # To perform the analysis, we need several key percentiles from the raw data.
    # We calculate them once here for efficiency.
    my @sorted_physc = sort { $a <=> $b } @$raw_physc_aref;
    my $p99_9 = calculate_percentile(\@sorted_physc, 99.9, { floats => 1, sorted => 1 });
    my $p95   = calculate_percentile(\@sorted_physc, 95, { floats => 1, sorted => 1 });
    my $p90   = calculate_percentile(\@sorted_physc, 90, { floats => 1, sorted => 1 });
    my $p50   = calculate_percentile(\@sorted_physc, 50, { floats => 1, sorted => 1 });

    # P99.75 of the full raw 1-minute PhysC stream for this analysis window.
    # Stored unconditionally when the stream is sufficient (> 10 samples).
    # Consumed by _assemble_seasonal_snapshot as OccurrencePeaks.sanitised_peak_value —
    # a minimally smoothed near-peak that excludes only the top 0.25% of observations.
    my $p99_75 = calculate_percentile(\@sorted_physc, 99.75, { floats => 1, sorted => 1 });
    $results{rawP9975} = $p99_75 if defined $p99_75;

    return \%results unless (defined $p99_9 && defined $p95 && defined $p50);

    my $saturation_level = $p99_9 / $max_capacity;

    # Calculate Peak Curvature Ratio (PCR)
    my $pcr_numerator   = $p99_9 - $p95;
    my $pcr_denominator = $p95 - $p50;
    my $pcr = ($pcr_denominator > $FLOAT_EPSILON) ? ($pcr_numerator / $pcr_denominator) : 999;

    # --- Stage III: Platform Validation (AIX RunQ) ---
    my $runq_saturation_score = 0.0;
    if (@$raw_runq_aref) {
        my @sorted_runq = sort { $a <=> $b } @$raw_runq_aref;
        my $runq_p95 = calculate_percentile(\@sorted_runq, 95, { floats => 1, sorted => 1 });

        # A simple model for RunQ saturation: the ratio of P95 RunQ to the number
        # of logical CPUs (SMT). A score > 1.0 indicates queuing.
        if (defined $runq_p95 && defined $smt && $smt > 0) {
            $runq_saturation_score = $runq_p95 / $smt;
            $results{platformMarkers}{aix_runq_saturation} = sprintf("%.2f", $runq_saturation_score);
        }
    }

    # --- Stage IV: Final Clipping Confidence Score ---
    my $confidence = 0.0;

    # Base confidence from saturation level
    if ($saturation_level >= $CLIPPING_DEFINITE_THRESHOLD) {
        $confidence += 0.6; # High base confidence for definite saturation
    } elsif ($saturation_level >= $CLIPPING_POTENTIAL_THRESHOLD) {
        $confidence += 0.3; # Moderate base confidence for potential saturation
    }

    # Add confidence from shape analysis (low PCR)
    if ($pcr < $PCR_HIGH_CONFIDENCE_THRESHOLD) {
        $confidence += 0.35; # High confidence for very flat peaks
    } elsif ($pcr < $PCR_LOW_CONFIDENCE_THRESHOLD) {
        $confidence += 0.15; # Moderate confidence for somewhat flat peaks
    }

    # Boost confidence if platform markers confirm pressure
    if ($runq_saturation_score > 1.5) {
        $confidence += 0.2; # Significant boost for high RunQ
    }

    # Cap confidence at 1.0
    $results{clippingConfidence} = min(1.0, $confidence);

    # --- Latent Demand Estimation ---
    if ($results{clippingConfidence} > 0.65) {
        $results{isClipped} = 1;

        # Estimate unmet demand as a function of confidence and saturation severity.
        # This is a simple model: the more confident we are, and the closer to the
        # ceiling the workload is, the higher the estimated latent demand.
        my $severity_factor = ($saturation_level - $CLIPPING_POTENTIAL_THRESHOLD) * 10; # Normalise 0.9-1.0 range
        $severity_factor = max(0, min(1.0, $severity_factor));

        # The unmet demand is a fraction of the P90 value, scaled by our confidence and severity.
        $results{unmetDemandEstimate} = $p90 * $results{clippingConfidence} * $severity_factor * 0.25; # 0.25 is a tuning factor

        # Determine severity string for reporting
        if ($results{clippingConfidence} > 0.9) {
            $results{clippingSeverity} = 'high';
        } elsif ($results{clippingConfidence} > 0.75) {
            $results{clippingSeverity} = 'moderate';
        } else {
            $results{clippingSeverity} = 'low';
        }
    }

    return \%results;
}

# ==============================================================================
# SUBROUTINE: aggregate_decay_metrics (CORRECTED VERSION)
# PURPOSE:    Aggregates per-bin metrics using recency weighting (decay) and
#             extracts RunQ metrics from the most recent bin WITH ACTUAL DATA.
#
# Important:
#   - Previous versions assumed the chronologically last time window exists for
#     all VMs, causing failures when certain VMs have incomplete data.
#   - This version finds the most recent bin that actually has data for each VM.
# ==============================================================================
sub aggregate_decay_metrics {
    my ($vm_name, $final_metrics_href, $manifest_href,
        $model_is_windowed, $window_context_aref, $state_context_aref,
        $analysis_ref_obj, $args_ref) = @_;

    my %aggregated_results_for_vm;

    # Get all per-bin metrics for this specific VM
    my $metrics_for_vm = $final_metrics_href->{$vm_name};
    return {} unless (defined $metrics_for_vm && ref($metrics_for_vm) eq 'HASH');

    # Find all unique profiles that have metrics for this VM
    my %profiles_for_vm;
    foreach my $bin_id (keys %{$metrics_for_vm}) {
        foreach my $key (keys %{$metrics_for_vm->{$bin_id}}) {
            $profiles_for_vm{$_} = 1 for keys %{$manifest_href->{$key}{profiles} || {}};
        }
    }

    foreach my $profile_name (keys %profiles_for_vm) {
        # Find the PhysC transform key for this profile
        my ($physc_transform_key) = grep {
            $manifest_href->{$_}{metric} eq 'PhysC' &&
            exists $manifest_href->{$_}{profiles}{$profile_name}
        } keys %$manifest_href;
        next unless $physc_transform_key;

        # Get the percentile key for this profile
        my $percentiles = _safe_dig($manifest_href, $physc_transform_key, 'profiles', $profile_name, 'percentiles');
        next unless (defined $percentiles && ref $percentiles eq 'ARRAY' && @$percentiles);
        my $p_val = $percentiles->[0]; # Assumes first percentile is the primary one
        my $p_key = "P" . clean_perc_label($p_val);

        # --- Build Time Series for PhysC ---
        # This series is built from the *aggregated metrics* of each bin.
        my @physc_timeseries;

        # Create a bin iterator for this loop
        my $bin_iterator = _create_bin_iterator(
            $model_is_windowed, $window_context_aref, $state_context_aref
        );

        while (my $bin_meta = $bin_iterator->()) {
            my $bin_id = $bin_meta->{id};

            # Get the aggregated metric for this bin
            my $metric_val = _safe_dig($metrics_for_vm, $bin_id, $physc_transform_key, $p_key);

            if (defined $metric_val && looks_like_number($metric_val)) {
                push @physc_timeseries, {
                    value => $metric_val,
                    date  => $bin_meta->{end_obj} # Use bin end-date for recency
                };
            }
        }

        # Calculate aggregated PhysC value
        if (@physc_timeseries) {
            my $aggregated_physc = calculate_recency_weighted_average(
                \@physc_timeseries,
                $analysis_ref_obj,
                $args_ref->{decay_half_life_days}
            );
            $aggregated_results_for_vm{$profile_name}{aggregated_value} = $aggregated_physc;
        }
    } # end foreach profile

    # ===========================================================================
    # CRITICAL FIX: Extract RunQ metrics from the MOST RECENT BIN WITH DATA
    # ===========================================================================
    # PROBLEM: VMs may go offline or have incomplete data in the chronologically
    #          last time window due to InfluxDB ingestion lag or system downtime.
    #          The previous code blindly used the last chronological window,
    #          causing undef lookups and cascading failures.
    #
    # SOLUTION: Build a map of bin end times, then find the most recent bin that
    #           actually exists in metrics_for_vm for THIS SPECIFIC VM.
    # ===========================================================================

    my $last_valid_bin_id = undef;
    my $last_valid_bin_end_epoch = 0;

    # Build a lookup map of bin_id -> end_epoch for O(1) access
    my %bin_end_times;
    my $bin_iterator_for_times = _create_bin_iterator(
        $model_is_windowed, $window_context_aref, $state_context_aref
    );
    while (my $bin_meta = $bin_iterator_for_times->()) {
        $bin_end_times{$bin_meta->{id}} = $bin_meta->{end_obj}->epoch;
    }

    # Find the most recent bin that actually has data for this VM
    foreach my $bin_id (keys %{$metrics_for_vm}) {
        if (exists $bin_end_times{$bin_id}) {
            my $bin_end = $bin_end_times{$bin_id};
            if ($bin_end > $last_valid_bin_end_epoch) {
                $last_valid_bin_end_epoch = $bin_end;
                $last_valid_bin_id = $bin_id;
            }
        }
    }

    # Extract RunQ metrics from the identified bin
    if (defined $last_valid_bin_id) {
        # Optional diagnostic output for debugging
        if ($args_ref->{verbose} && $args_ref->{verbose} > 1) {
            warn "DEBUG: Using bin '$last_valid_bin_id' for RunQ metrics extraction (VM: $vm_name)\n";
        }

        foreach my $profile_name (keys %profiles_for_vm) {
            # Find NormRunQ transform for this profile
            my ($norm_rq_key) = grep {
                $manifest_href->{$_}{metric} eq 'NormRunQ' &&
                exists $manifest_href->{$_}{profiles}{$profile_name}
            } keys %$manifest_href;

            if ($norm_rq_key) {
                my $norm_metrics = _safe_dig($metrics_for_vm, $last_valid_bin_id, $norm_rq_key);

                # Validate the retrieved data structure
                if (defined $norm_metrics &&
                    ref($norm_metrics) eq 'HASH' &&
                    keys %$norm_metrics) {
                    $aggregated_results_for_vm{_RunQ}{normalized}{$profile_name} = $norm_metrics;
                }
            }

            # Find AbsRunQ transform for this profile
            my ($abs_rq_key) = grep {
                $manifest_href->{$_}{metric} eq 'AbsRunQ' &&
                exists $manifest_href->{$_}{profiles}{$profile_name}
            } keys %$manifest_href;

            if ($abs_rq_key) {
                my $abs_metrics = _safe_dig($metrics_for_vm, $last_valid_bin_id, $abs_rq_key);

                # Validate the retrieved data structure
                if (defined $abs_metrics &&
                    ref($abs_metrics) eq 'HASH' &&
                    keys %$abs_metrics) {
                    $aggregated_results_for_vm{_RunQ}{absolute}{$profile_name} = $abs_metrics;
                }
            }
        }
    } else {
        # This should be extremely rare - only if VM has no data at all
        warn "WARNING: No bins with valid data found for VM '$vm_name' - RunQ metrics unavailable\n";
    }

    return \%aggregated_results_for_vm;
}

# ==============================================================================
# SUBROUTINE: apply_growth_prediction_to_metrics
# PURPOSE:    Applies a growth adjustment factor to the final metric values for
#             profiles that have growth prediction enabled in the manifest.
# ==============================================================================
sub apply_growth_prediction_to_metrics {
    my ($agg_metrics_href, $manifest_href, $analysis_data_href, $vm_name, $args_ref) = @_;

    # Build a map from profile name to its corresponding PhysC transform key
    # but only for profiles that have growth prediction enabled.
    my %profile_to_transform;
    foreach my $transform_key (keys %$manifest_href) {
        my $transform_info = $manifest_href->{$transform_key};
        next unless $transform_info->{metric} eq 'PhysC';

        foreach my $profile_name (keys %{$transform_info->{profiles}}) {
            my $directives = $transform_info->{profiles}{$profile_name};
            if ($directives->{enable_growth}) {
                $profile_to_transform{$profile_name} = $transform_key;
            }
        }
    }

    # Process the first profile found that has growth enabled.
    # In this aggregated model, the growth trend is VM-wide, so one calculation is sufficient.
    foreach my $profile_name (sort keys %profile_to_transform) {
        my $transform_key = $profile_to_transform{$profile_name};
        my $baseline_val = $agg_metrics_href->{$profile_name};

        # Build the complete timeseries from the analysis data using the correct transform key.
        my @timeseries;
        foreach my $state_id (sort { $a <=> $b } keys %{$analysis_data_href->{$vm_name}}) {
            if (exists $analysis_data_href->{$vm_name}{$state_id}{$transform_key}) {
                push @timeseries, unpack('f<*', $analysis_data_href->{$vm_name}{$state_id}{$transform_key});
            }
        }

        unless (@timeseries) {
            warn "Warning: No timeseries data found for growth calculation on profile $profile_name (transform: $transform_key)\n";
            next;
        }

        my $growth_result = calculate_growth_prediction(\@timeseries, $baseline_val);

        if ($growth_result) {
            # Store the single, authoritative growth adjustment and rationale for the entire VM.
            $agg_metrics_href->{GrowthAdj} = $growth_result->{growth_adj};
            $agg_metrics_href->{GrowthRationale} = $growth_result->{rationale};

#            if ($args_ref->{verbose}) {
#                print STDERR "DEBUG: Growth calculation succeeded for VM $vm_name (using profile $profile_name): adj=" . $growth_result->{growth_adj} . "\n";
#            }
        } else {
            warn "Warning: Growth calculation returned no result for profile $profile_name\n";
        }

        # Since growth is VM-wide in this model, we only need to calculate it once.
        return;
    }
}


#!/usr/bin/env python3
# ==============================================================================
# NAME     : dev/pool-evidence-report
# PURPOSE  : Exploratory (v10 stage 3.4). Sets the training-period pool facts,
#            as a coarse copy of the capture shows them, beside what the
#            held-out period did to the cuts normal planning releases and
#            strict guarantee preservation holds. It asks one question: does
#            anything the coarse data shows about a pool tell the pools whose
#            released cuts were later exposed from the others?
#            No rule or threshold is applied. A high coarse reading may point
#            at risk; a low one cannot show that brief competition is absent.
#            The pool facts come from nfit-profile
#            (--research-pool-coarse-evidence; no sizing) on the coarse copy
#            the last dev/protection-replay --thin-minutes run left for the
#            system; the copy is rebuilt only when it is not there.
#            Facts are given in the hours of the LPARs' planning profiles
#            (their population) and for all hours.
# USAGE    : dev/pool-evidence-report --system P10-02 --records DIR [--out DIR]
#            --records: a dev/protection-replay --thin-minutes --records-only output
# OUTPUT   : <out>/pool-evidence.json and .md (research labels and pool
#            numbers only; no LPAR is named)
# ==============================================================================
import argparse
import collections
import datetime as dt
import importlib.machinery
import importlib.util
import json
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def _load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace('-', '_'), str(REPO / 'dev' / name))
    spec = importlib.util.spec_from_loader(name.replace('-', '_'), loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


pr = _load('protection-replay')
SHARES = ('0.50', '0.60', '0.70', '0.80', '0.90')
REVIEW_SHARE = 0.50   # the review indicator under test (section 5): frozen, not to be retuned


def table(lines, header, body):
    lines.append('| ' + ' | '.join(header) + ' |')
    lines.append('|' + '|'.join('---' for _ in header) + '|')
    lines.extend('| ' + ' | '.join(str(c) for c in row) + ' |' for row in body)
    lines.append('')


def contested(rec, level):
    """(minutes, core-minutes) of later contested busy work above a replay level, or None where it was not scored."""
    got = (rec.get('later') or {}).get(level)
    if not got or not got.get('borrow'):
        return None
    b = got['borrow'].get('contested') or {}
    return b.get('minutes', 0), b.get('coreMinutes', 0.0)


def outcomes(records):
    """Per (pool, population of the planning profile): the released cuts and what the held-out period did to them.
    Scored and unscored cuts are kept apart: an unscored cut is not a cut without exposure."""
    groups = collections.defaultdict(lambda: collections.defaultdict(float))
    for r in records:
        if not r.get('planning'):
            continue
        g = groups[(str(r.get('pool')), r.get('population') or 'none')]
        g['lpars'] += 1
        by = r.get('cycleByPolicy') or {}
        normal, strict = (by.get('normal') or {}).get('entitlement'), (by.get('strict') or {}).get('entitlement')
        if normal is None or strict is None or strict - normal <= 0.005:
            continue
        n, s, one = contested(r, 'cycleNormal'), contested(r, 'cycleStrict'), contested(r, 'cycleReference')
        if n is None or s is None:
            g['unscoredCuts'] += 1
            g['unscoredCores'] += strict - normal
            continue
        g['scoredCuts'] += 1
        g['scoredCores'] += strict - normal
        g['normalMinutes'] += n[0]
        g['normalCoreMinutes'] += n[1]
        g['strictMinutes'] += s[0]
        g['strictCoreMinutes'] += s[1]
        if one is not None:
            g['referenceScored'] += 1
            g['referenceCoreMinutes'] += one[1]
        if n[1] > s[1] + 0.005:
            g['exposedCuts'] += 1
            g['exposedCores'] += strict - normal
    return groups


def coarse_stage(label, source, minutes, mode, work):
    """The coarse copy left by dev/protection-replay for this system, or a new one."""
    left = REPO / '.private' / 'protection-replay' / label / 'thin' / 'stage' / source.name
    if all((left / name).exists() for name in pr.INPUTS):
        return left, 'reused'
    case = work / label
    if case.exists():
        shutil.rmtree(case)
    case.mkdir(parents=True)
    return pr.thin_stage(case, source, minutes, mode), 'rebuilt'


def report(out, data):
    num = lambda v, d=2: '-' if v is None else f'{v:.{d}f}'
    rows = data['rows']
    cuts = [r for r in rows if r['scoredCuts'] or r['unscoredCuts']]
    lines = ['# Pool evidence at the coarse cadence against the later outcome of the released cuts (exploratory)', '',
             f'Generated {data["generated"]}; commit {str(data["commit"])[:7]}. System {data["system"]}; pool facts from {data["window"]["start"]} to '
             f'{data["window"]["end"]} at the cadence of the coarse copy ({data["stage"]}); outcomes from the records of {data["recordsCommit"]}.',
             'A row is one pool in the hours of one planning-profile population. "Released" is the reduction normal planning makes this',
             'cycle that strict guarantee preservation holds: it is relative to strict, not a saving against the installed estate.',
             'Outcome figures cover scored cuts only; unscored cuts are counted beside them and say nothing either way.',
             'Nothing here is a rule. A high coarse reading may point at risk; a low one cannot show that brief competition is absent.', '']
    lines += ['## 1. Outcome of the released cuts, by pool and population', '']
    body = []
    for r in sorted(cuts, key=lambda r: -(r['normalCoreMinutes'] - r['strictCoreMinutes'])):
        body.append([r['pool'], r['population'], r['lpars'], f'{r["scoredCuts"]} / {r["unscoredCuts"]}', f'{r["scoredCores"]:.2f} / {r["unscoredCores"]:.2f}',
                     f'{r["exposedCuts"]} ({r["exposedCores"]:.2f})',
                     f'{r["normalMinutes"]:.0f} / {r["normalCoreMinutes"]:.2f}', f'{r["strictMinutes"]:.0f} / {r["strictCoreMinutes"]:.2f}',
                     f'{r["normalCoreMinutes"] - r["strictCoreMinutes"]:.2f}',
                     f'{r["referenceCoreMinutes"]:.2f} ({r["referenceScored"]})'])
    tot = lambda k: sum(r[k] for r in cuts)
    body.append(['all', '', sum(r['lpars'] for r in rows), f'{tot("scoredCuts")} / {tot("unscoredCuts")}', f'{tot("scoredCores"):.2f} / {tot("unscoredCores"):.2f}',
                 f'{tot("exposedCuts")} ({tot("exposedCores"):.2f})', f'{tot("normalMinutes"):.0f} / {tot("normalCoreMinutes"):.2f}',
                 f'{tot("strictMinutes"):.0f} / {tot("strictCoreMinutes"):.2f}', f'{tot("normalCoreMinutes") - tot("strictCoreMinutes"):.2f}',
                 f'{tot("referenceCoreMinutes"):.2f} ({tot("referenceScored")})'])
    table(lines, ['Pool', 'Population', 'Planning LPARs', 'Released cuts: scored / unscored', 'Cores released: scored / unscored',
                  'Scored cuts with more exposure under normal (cores)', 'Later contested above normal (min / core-min)', 'above strict',
                  'Added by normal (core-min)', 'At the one-minute run\'s entitlement (core-min; LPARs scored)'], body)

    lines += ['## 2. What the coarse training data shows of those pools', '',
              'Consumption figures are pool busy cores at the coarse cadence, within the population\'s hours. "Share" is of the maximum',
              'reported with the reading. "Days at" counts distinct days on which the pool reached that share.', '']
    body = []
    for r in sorted(cuts, key=lambda r: -(r['normalCoreMinutes'] - r['strictCoreMinutes'])):
        f = r.get('facts')
        if not f:
            body.append([r['pool'], r['population'], f'{r["normalCoreMinutes"] - r["strictCoreMinutes"]:.2f}'] + ['no pool observations'] + [''] * 15)
            continue
        w, a = f.get('inHours') or {}, f.get('allHours') or {}
        size = max(f['maximaSeen']) if f['maximaSeen'] else None
        body.append([r['pool'], r['population'], f'{r["normalCoreMinutes"] - r["strictCoreMinutes"]:.2f}',
                     '/'.join(str(x) for x in f['maximaSeen']), f'{f["members"]} ({f["cappedMembers"]})', num(f['installedEntitlement']), f['virtualProcessors'],
                     num(f['installedEntitlement'] / size if size else None), num(f['virtualProcessors'] / size if size else None),
                     f'{num(w.get("max"))} / {num(w.get("p99"))} / {num(w.get("p95"))}', num(w.get('maxShareOfMaximum')), num(a.get('maxShareOfMaximum')),
                     num(w.get('leastHeadroom')), ' '.join(str((w.get('daysAtShare') or {}).get(s, 0)) for s in SHARES) + f' of {w.get("days", 0)}',
                     (w.get('observationsAtShare') or {}).get('near', 0), num((w.get('dayPeaks') or {}).get('second')),
                     f'{num(f["coverage"], 3)} / {num(f["worstDayCoverage"], 3)}', f'{f["configurationSegments"]} / {len(f["maximaSeen"])}',
                     f'{num((f.get("frame") or {}).get("leastIdle"))} / {num(w.get("frameIdleAtPeak"))} / {(f.get("frame") or {}).get("scarceObservations", 0)}'])
    table(lines, ['Pool', 'Population', 'Added by normal (core-min)', 'Maximum', 'Members (capped)', 'Entitlement (sum)', 'VPs (sum)', 'Entitlement / maximum',
                  'VPs / maximum', 'Coarse max / P99 / P95', 'Highest share, in hours', 'all hours', 'Least headroom (cores)',
                  'Days at 50 60 70 80 90% of maximum', 'Observations near the maximum', 'Second-highest day peak', 'Coverage / worst day',
                  'Configuration segments / maxima seen', 'Frame idle: least / at the pool\'s peak / scarce observations'], body)

    lines += ['## 3. Pools with planning LPARs and no released cut', '']
    table(lines, ['Pool', 'Population', 'Planning LPARs', 'Maximum', 'Highest share, in hours', 'Observations near the maximum'],
          [[r['pool'], r['population'], r['lpars'], '/'.join(str(x) for x in (r.get('facts') or {}).get('maximaSeen', [])) or '-',
            num(((r.get('facts') or {}).get('inHours') or {}).get('maxShareOfMaximum')),
            (((r.get('facts') or {}).get('inHours') or {}).get('observationsAtShare') or {}).get('near', '-')]
           for r in rows if not (r['scoredCuts'] or r['unscoredCuts'])] or [['none', '', '', '', '', '']])
    # The candidate under test, fixed on 2026-11-21 from P10-02 before any other system was read. It is a
    # description to be checked, not a rule of nFit, and it has no tunable number.
    lines += ['## 4. Candidate under test (frozen 2026-11-21 on P10-02; not a rule)', '',
              'A pool is marked when the entitlement normal planning would release from its LPARs this cycle (scored and unscored cuts)',
              'is more than the least headroom the coarse data shows under the pool maximum, over all hours of training. The reading:',
              'the guarantee being removed is larger than the spare pool capacity ever observed at this resolution. An unmarked pool',
              'is not shown to be safe: the coarse data cannot show that brief competition is absent.', '']
    pools = collections.OrderedDict()
    for r in sorted(rows, key=lambda r: (not str(r['pool']).isdigit(), int(r['pool']) if str(r['pool']).isdigit() else 0)):
        g = pools.setdefault(r['pool'], collections.defaultdict(float))
        for k in ('scoredCuts', 'unscoredCuts', 'scoredCores', 'unscoredCores', 'exposedCuts', 'exposedCores', 'normalCoreMinutes', 'strictCoreMinutes'):
            g[k] += r[k]
        a = (r.get('facts') or {}).get('allHours') or {}
        g['headroom'] = a.get('leastHeadroom')
        g['share'] = a.get('maxShareOfMaximum')
        f = r.get('facts') or {}
        states = [c.get('entitlementShareOfMaximum') for c in f.get('configurationStates') or [] if c.get('entitlementShareOfMaximum') is not None]
        if not states and f.get('maximaSeen') and f.get('installedEntitlement') is not None:      # records made before the states were written
            states = [round(f['installedEntitlement'] / max(f['maximaSeen']), 4)]
        g['ratios'] = states
    body, marked, unmarked = [], collections.defaultdict(float), collections.defaultdict(float)
    for pool, g in pools.items():
        released = g['scoredCores'] + g['unscoredCores']
        if released <= 0.005:
            continue
        flag = g['headroom'] is not None and released > g['headroom'] + 1e-9
        side = marked if flag else unmarked
        for k in ('scoredCuts', 'unscoredCuts', 'scoredCores', 'unscoredCores', 'exposedCuts'):
            side[k] += g[k]
        side['added'] += g['normalCoreMinutes'] - g['strictCoreMinutes']
        side['pools'] += 1
        body.append([pool, num(released), num(g['headroom']), num(g['share']), 'no pool observations' if g['headroom'] is None else 'marked' if flag else '-',
                     f'{g["scoredCuts"]:.0f} / {g["unscoredCuts"]:.0f}', f'{g["exposedCuts"]:.0f}', f'{g["normalCoreMinutes"] - g["strictCoreMinutes"]:.2f}'])
    table(lines, ['Pool', 'Released relative to strict (cores)', 'Least headroom, all hours (cores)', 'Highest share of maximum, all hours', 'Candidate',
                  'Cuts: scored / unscored', 'Scored cuts with more exposure under normal', 'Added by normal (core-min, scored cuts)'], body)
    table(lines, ['', 'Pools', 'Cuts: scored / unscored', 'Cores released: scored / unscored', 'Scored cuts with more exposure under normal',
                  'Added by normal (core-min, scored cuts)'],
          [[name, f'{g["pools"]:.0f}', f'{g["scoredCuts"]:.0f} / {g["unscoredCuts"]:.0f}', f'{g["scoredCores"]:.2f} / {g["unscoredCores"]:.2f}',
            f'{g["exposedCuts"]:.0f}', f'{g["added"]:.2f}'] for name, g in (('Marked: the cut would be held', marked), ('Not marked: the cut would proceed', unmarked))])
    # Second candidate, fixed on 2026-11-21 before the third system was read; the boundary is not to be retuned.
    lines += ['## 5. Review indicator under test (frozen 2026-11-21; not a rule, not a hold)', '',
              f'A user-defined pool is flagged for review of coarse-data cuts when its members\' installed entitlements total at least '
              f'{REVIEW_SHARE:.0%} of its configured maximum, in the configuration state at the end of training. The ratio describes configured',
              'guarantees. It is not occupied capacity (unused entitlement can be borrowed) and not spare capacity, and a high ratio can come',
              'from historical over-allocation: it cannot by itself justify keeping an entitlement. The default pool is shown apart: its',
              'maximum has a different meaning. Measured cut protection is unchanged in every figure.', '']
    body, flagged, clear, default = [], collections.defaultdict(float), collections.defaultdict(float), collections.defaultdict(float)
    missed = []
    for pool, g in pools.items():
        released = g['scoredCores'] + g['unscoredCores']
        if released <= 0.005:
            continue
        ratios = g['ratios']
        last = ratios[-1] if ratios else None
        added = g['normalCoreMinutes'] - g['strictCoreMinutes']
        if str(pool) == '0':
            side, mark = default, 'default pool: not classified'
        elif last is None:
            side, mark = clear, 'ratio not known'
        else:
            side, mark = (flagged, 'flagged') if last >= REVIEW_SHARE - 1e-9 else (clear, '-')
        for k in ('scoredCuts', 'unscoredCuts', 'scoredCores', 'unscoredCores', 'exposedCuts', 'exposedCores'):
            side[k] += g[k]
        side['added'] += added
        side['pools'] += 1
        if side is clear and g['exposedCuts']:
            missed.append(f'pool {pool} (ratio {num(last)}, {added:.2f} core-min)')
        body.append([pool, num(last), ('same in every state' if len(set(ratios)) <= 1 else f'{num(min(ratios))} to {num(max(ratios))} over {len(ratios)} states'),
                     mark, f'{g["scoredCuts"]:.0f} / {g["unscoredCuts"]:.0f}', f'{g["scoredCores"]:.2f} / {g["unscoredCores"]:.2f}',
                     f'{g["exposedCuts"]:.0f}', f'{added:.2f}'])
    table(lines, ['Pool', 'Entitlements / maximum, end of training', 'Across the training configuration states', 'Indicator', 'Cuts: scored / unscored',
                  'Cores released relative to strict: scored / unscored', 'Scored cuts with more exposure under normal', 'Added by normal (core-min, scored cuts)'], body)
    table(lines, ['', 'Pools', 'Cuts: scored / unscored', 'Cores released: scored / unscored', 'Scored cuts with more exposure under normal (cores)',
                  'Scored cuts with no more exposure (cores)', 'Added by normal (core-min, scored cuts)'],
          [[name, f'{g["pools"]:.0f}', f'{g["scoredCuts"]:.0f} / {g["unscoredCuts"]:.0f}', f'{g["scoredCores"]:.2f} / {g["unscoredCores"]:.2f}',
            f'{g["exposedCuts"]:.0f} ({g["exposedCores"]:.2f})', f'{g["scoredCuts"] - g["exposedCuts"]:.0f} ({g["scoredCores"] - g["exposedCores"]:.2f})',
            f'{g["added"]:.2f}']
           for name, g in (('User-defined pools, flagged', flagged), ('User-defined pools, not flagged', clear), ('Default pool', default))])
    lines += [f'- Exposure avoided if the flagged cuts were held: {flagged["added"]:.2f} core-minutes (scored cuts only).',
              f'- Entitlement retained by holding them: {flagged["scoredCores"] + flagged["unscoredCores"]:.2f} cores '
              f'({flagged["scoredCores"]:.2f} scored, {flagged["unscoredCores"]:.2f} unscored).',
              f'- Flagged scored cuts with no added exposure: {flagged["scoredCuts"] - flagged["exposedCuts"]:.0f} '
              f'({flagged["scoredCores"] - flagged["exposedCores"]:.2f} cores).',
              f'- Exposure missed in user-defined pools not flagged: {clear["added"]:.2f} core-minutes'
              + (': ' + '; '.join(missed) if missed else '') + '.',
              f'- Default pool: {default["added"]:.2f} core-minutes added over {default["scoredCuts"]:.0f} scored cuts '
              f'({default["unscoredCuts"]:.0f} unscored).', '']
    (out / 'pool-evidence.md').write_text('\n'.join(lines) + '\n')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--system', required=True, help='research label, e.g. P10-02')
    ap.add_argument('--records', required=True, help='records of the coarse protection replay of that system')
    ap.add_argument('--capture-root', default=pr.site_input('NFIT_CAPTURES'), help='root of the staged captures (default: $NFIT_CAPTURES)')
    ap.add_argument('--out', default=None)
    ap.add_argument('--report-only', action='store_true', help='rebuild the report from an existing pool-evidence.json')
    a = ap.parse_args()
    out = Path(a.out or a.records)
    out.mkdir(parents=True, exist_ok=True)
    if not a.report_only:
        saved = json.loads((Path(a.records) / 'protection-replay.json').read_text())
        minutes = saved.get('thinMinutes') or 0
        if minutes <= 1:
            sys.exit('pool-evidence-report: the records are not from a coarse (--thin-minutes) run')
        records = [r for r in saved['records'] if r.get('system') == a.system]
        if not records:
            sys.exit('pool-evidence-report: the records hold nothing for that system')
        pr.need('pool-evidence-report', a.capture_root, '--capture-root', 'NFIT_CAPTURES')
        cohort, index = a.system.rsplit('-', 1)
        folder, expected, start, cutoff, _later, _end = pr.COHORTS[cohort]
        sources = sorted(p.parent for p in (Path(a.capture_root) / folder / 'stage').glob('*/.nfit_stage_id'))
        if len(sources) != expected:
            sys.exit(f'pool-evidence-report: expected {expected} staged system(s) for {cohort}, found {len(sources)}')
        source = sources[int(index) - 1]
        work = REPO / '.private' / 'pool-evidence'
        work.mkdir(parents=True, exist_ok=True)
        (work / 'log').mkdir(exist_ok=True)
        app = work / 'app'
        if app.is_dir():
            shutil.rmtree(app)
        (app / 'etc').mkdir(parents=True)
        (app / 'output').mkdir()
        for name in pr.EXECUTABLES:
            shutil.copy(REPO / name, app / name)
            (app / name).chmod(0o700)
        for f in sorted((REPO / 'etc').glob('nfit.*')):
            if f.is_file():
                shutil.copy(f, app / 'etc' / f.name)
        stage, how = coarse_stage(a.system, source, minutes, saved.get('thinMode') or 'mean', work)
        print(f'{a.system}: coarse copy {how}', flush=True)
        pr.invoke(app, work / 'log', 'pool-evidence', ['--nmondir', str(stage), '--research-pool-coarse-evidence', f'{start}/{cutoff}'], pr.perl_env())
        result = json.loads((app / 'output' / 'nfit-profile.pool-coarse-evidence.json').read_text())
        pools = {str(p['pool']): p for p in result.get('pools', [])}
        cadences = sorted({p['cadenceMinutes'] for p in pools.values()})
        if cadences and cadences != [minutes]:
            print(f'{a.system}: note - pool cadence(s) {cadences} against the records\' {minutes} minutes', flush=True)
        rows = []
        for (pool, population), g in sorted(outcomes(records).items()):
            p = pools.get(pool)
            facts = None
            if p:
                facts = {k: v for k, v in p.items() if k != 'populations'}
                facts['inHours'] = p['populations'].get(population)
                facts['allHours'] = p['populations'].get('none')
            row = {'pool': pool, 'population': population, 'facts': facts}
            for k in ('lpars', 'scoredCuts', 'unscoredCuts', 'exposedCuts', 'referenceScored'):
                row[k] = int(g[k])
            for k in ('scoredCores', 'unscoredCores', 'exposedCores', 'normalMinutes', 'normalCoreMinutes', 'strictMinutes', 'strictCoreMinutes',
                      'referenceCoreMinutes'):
                row[k] = round(g[k], 4)
            rows.append(row)
        data = {'generated': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%d %H:%M UTC'), 'commit': pr.git_identity(), 'system': a.system,
                'window': result.get('window'), 'stage': how, 'thinMinutes': minutes, 'recordsCommit': str(saved.get('commit'))[:7], 'rows': rows}
        (out / 'pool-evidence.json').write_text(json.dumps(data, indent=1) + '\n')
        shutil.rmtree(work, ignore_errors=True)
    report(out, json.loads((out / 'pool-evidence.json').read_text()))
    for name in ('pool-evidence.json', 'pool-evidence.md'):
        audit = subprocess.run([str(REPO / 'dev' / 'nfit-redact'), '--audit', str(out / name)], capture_output=True, text=True)
        print(audit.stdout.strip().splitlines()[-1] if audit.stdout.strip() else 'audit: no output')
    print(f'Written: {out / "pool-evidence.md"}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

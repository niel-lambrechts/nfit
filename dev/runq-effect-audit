#!/usr/bin/env python3
# ==============================================================================
# NAME     : dev/runq-effect-audit
# PURPOSE  : Research (no sizing figure changes). Asks whether nFit's run-queue
#            rules materially depend on a high run-queue reading where PhysC and
#            busy share (PhysB / PhysC) show little accompanying pressure
#            (research note "Thread Density, Busy Share and Run-Queue Load on
#            Entitlement", section 13).
#              1. Verifies the stored standard proposal of a kept work tree
#                 against the staged data and the programs, and sizes the same
#                 window again with the current programs and the research
#                 trace (--research-runq-trace, --research-busy-share).
#              2. From the samples (current configuration state, planning
#                 hours): where the run queue is high, by regime, with busy
#                 share against the LPAR's own ordinary level.
#              3. From the trace: for each run-queue rule, whether it was
#                 triggered, held back by an existing gate, passed through
#                 without setting the figure, or set it.
#              4. Only when the run-queue additive reached a figure: a second
#                 sizing without it (--research-no-runq-additive), so that its
#                 effect is the difference of two runs.
#            Aggregates only: no LPAR, pool or system is named.
# INPUT    : a work tree kept by dev/history-integration-check --keep
# USAGE    : dev/runq-effect-audit [--work DIR] [--label L] [--out DIR]
# OUTPUT   : <out>/runq-effect-<label>.json and tables
# ==============================================================================
import argparse
import calendar
import hashlib
import importlib.machinery
import importlib.util
import json
import re
import shutil
import subprocess
import sys
import time

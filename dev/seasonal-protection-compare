#!/usr/bin/env python3
# ==============================================================================
# NAME     : dev/seasonal-protection-compare
# PURPOSE  : What event-window cut protection changes in one seasonal run. On
#            the work tree kept by dev/history-integration-check --keep (its
#            stage and the history it wrote; no history is written again), the
#            same seasonal event is sized twice with the current nfit-profile:
#            with event-window evidence and with --no-cut-protection. Reported
#            in aggregate: which LPARs' planning figures and profile values
#            moved, in which direction and by how much, the actions that say
#            why, and what the evidence pass found.
#            The history is restored before each run, so the two runs read the
#            same history and the kept tree is left as it was found.
# USAGE    : dev/seasonal-protection-compare --event NAME [--work DIR] [--profile-args '...']
#            (without --event: lists the events of the kept tree's seasonality file)
# OUTPUT   : <out>/seasonal-protection-<event>.json and a summary (aggregates;
#            no LPAR, pool or system is named)
# ==============================================================================
import argparse
import csv
import importlib.machinery
import importlib.util
import json
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
_loader = importlib.machinery.SourceFileLoader('protection_replay', str(REPO / 'dev' / 'protection-replay'))
_spec = importlib.util.spec_from_loader('protection_replay', _loader)
pr = importlib.util.module_from_spec(_spec)
_loader.exec_module(pr)

EPS = 0.005
FIXED = ('VM', 'Current - ENT', 'Current - VCPU', 'NFIT - ENT', 'NFIT - VCPU', 'NFIT - Action')


def events(path):
    """[(name, model)] of a seasonality file."""
    out, name = [], None
    for line in path.read_text().splitlines():
        hit = re.match(r'\s*\[(.+?)\]\s*$', line)
        if hit:
            name = hit.group(1)
            if name not in ('Global', 'Adaptive'):
                out.append([name, ''])
        hit = re.match(r'\s*model\s*=\s*(\S+)', line)
        if hit and out and out[-1][0] == name:
            out[-1][1] = hit.group(1)
    return out


def number(text):
    try:
        return float(text)
    except (TypeError, ValueError):
        return None


def one_run(app, case, stage, history, pristine, label, args, env):
    """Sizes the event once on the pristine history: (rows by LPAR, log text, seconds)."""
    shutil.rmtree(history)
    shutil.copytree(pristine, history)
    for old in (app / 'output').glob('*'):
        if old.is_file():
            old.unlink()
    t0 = time.time()
    pr.invoke(app, case, label, args, env)
    seconds = round(time.time() - t0, 1)
    found = sorted((app / 'output').glob('*.csv'), key=lambda p: p.stat().st_mtime)
    rows = {}
    if found:
        with found[-1].open(newline='') as fh:
            rows = {row['VM']: row for row in csv.DictReader(fh) if row.get('VM')}
    logs = sorted((app / 'output').glob('*.log'), key=lambda p: p.stat().st_mtime)
    snaps = sorted((app / 'output').glob('*.proposal.*.json'), key=lambda p: p.stat().st_mtime)
    members = (json.loads(snaps[-1].read_text()).get('members') or {}) if snaps else {}
    return rows, (logs[-1].read_text(errors='replace') if logs else ''), seconds, members


def population_of(members, vm, profile):
    return (((members.get(vm) or {}).get('profiles') or {}).get(profile) or {}).get('cutProtection', {}).get('population')


def evidence_class(members, vm, profile):
    """What the evidence pass found for one LPAR in the hours of one profile, from the stored proposal of
    the run: contested, supportedNoCompetition, insufficientEvidence, missingEvidence (assessed; nothing
    usable in history for those hours, or the profile is in no assessed population) or otherExclusion
    (not assessed: not an uncapped shared-pool LPAR in its current state)."""
    assessed = (members.get(vm) or {}).get('eventEvidence') or {}
    if not assessed:
        return 'otherExclusion'
    for population in assessed.values():
        if profile in (population.get('profiles') or []):
            return {'contested': 'contested', 'noCompetition': 'supportedNoCompetition',
                    'insufficient': 'insufficientEvidence'}.get(population.get('verdict'), 'missingEvidence')
    return 'missingEvidence'


def role_words(text):
    found = [w for w, pattern in (('standbyShare', r'standby'), ('partnerOrGroup', r'partner|VIOS|group')) if re.search(pattern, text or '', re.I)]
    return '+'.join(found) or 'none'



def evidence_section(log):
    """The aggregate lines of the Event-Window Evidence section (no LPAR line)."""
    out = {}
    hit = re.search(r'^  Past windows   : (\d+) \((.*)\)$', log, re.M)
    if hit:
        out['pastWindows'] = int(hit.group(1))
        out['windows'] = hit.group(2)
    hit = re.search(r'^  LPARs          : (\d+) with work during pool competition, (\d+) without competition, '
                    r'(\d+) with too little evidence, (\d+) without evidence', log, re.M)
    if hit:
        out['lpars'] = dict(zip(('contested', 'noCompetition', 'insufficient', 'unavailable'), map(int, hit.groups())))
    hit = re.search(r'^  Earlier states : (\d+) day record', log, re.M)
    out['earlierStateDayRecords'] = int(hit.group(1)) if hit else 0
    hit = re.search(r'^  Not used: (.*)$', log, re.M)
    if hit:
        out['notUsed'] = hit.group(1)
    out['mixedIntervalLpars'] = len(re.findall(r'; sampled at .* minutes: no contested level', log))
    return out


def verdicts(log):
    """{LPAR: 'contested' | 'insufficient'} from the section's LPAR lines (used in memory only; an LPAR
    not listed was found without competition, or has no pool evidence at all)."""
    section = re.search(r'^Event-Window Evidence.*?(?=^\S|\Z)', log, re.M | re.S)
    found = {}
    for name, what in re.findall(r'^  (\S+)\s+(contested|too little evidence):', section.group(0) if section else '', re.M):
        found[name] = 'contested' if what == 'contested' else 'insufficient'
    return found


def movement(pairs):
    """Counts and core totals of (before, after) figures."""
    up = [(b, a) for b, a in pairs if a > b + EPS]
    down = [(b, a) for b, a in pairs if a < b - EPS]
    return {'compared': len(pairs), 'unchanged': len(pairs) - len(up) - len(down),
            'raised': len(up), 'raisedByCores': round(sum(a - b for b, a in up), 2),
            'largestRaise': round(max((a - b for b, a in up), default=0), 2),
            'lowered': len(down), 'loweredByCores': round(sum(b - a for b, a in down), 2),
            'largestReduction': round(max((b - a for b, a in down), default=0), 2),
            'totalBefore': round(sum(b for b, _ in pairs), 2), 'totalAfter': round(sum(a for _, a in pairs), 2)}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--event', help='the seasonal event to size')
    ap.add_argument('--work', default=str(REPO / '.private' / 'history-check'), help='the work tree kept by dev/history-integration-check --keep')
    ap.add_argument('--out', default=str(REPO / 'design' / 'acceptance' / 'seasonal'))
    ap.add_argument('--seasonality', default=str(REPO / 'etc' / 'nfit.seasonality.cfg'), help='the seasonality file to use')
    ap.add_argument('--names', action='store_true', help='also list the LPARs whose planning figure moved, as pseudonyms '
                                                         '(through dev/nfit-redact); printed only, never written to the result file')
    ap.add_argument('--profile-args', default='', help='extra nfit-profile options for both runs')
    a = ap.parse_args()
    work = Path(a.work).resolve()                          # the runs change directory: a relative path would not survive it
    app, case = work / 'app', work / 'case'
    stage = next(iter(sorted((case / 'stage').glob('*'))), None) if (case / 'stage').is_dir() else None
    if stage is None or not (case / 'history' / stage.name).is_dir():
        sys.exit('seasonal-protection-compare: no kept work tree with history (run dev/history-integration-check --keep first)')
    seasonality = Path(a.seasonality).resolve()
    if not seasonality.is_file():
        sys.exit('seasonal-protection-compare: seasonality file not found (see --seasonality)')
    known = events(seasonality)
    if not a.event or a.event not in [name for name, _ in known]:
        print('Events of the seasonality file (give one with --event):')
        for name, model in known:
            print(f'  {name:<28} {model}')
        return 2
    model = dict(known)[a.event]

    # The current programs and seasonality file into the kept tree.
    for name in pr.EXECUTABLES:
        shutil.copy(REPO / name, app / name)
        (app / name).chmod(0o700)
    shutil.copy(seasonality, app / 'etc' / 'nfit.seasonality.cfg')
    history = case / 'history' / stage.name
    pristine = case / 'history.pristine' / stage.name
    if not pristine.is_dir():
        pristine.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(history, pristine)
    env = pr.perl_env()
    base = ['--nmondir', str(stage), '--apply-seasonality', a.event] + shlex.split(a.profile_args)
    if (app / 'config.csv').is_file() and (app / 'config.csv').stat().st_size:
        base += ['--config', str(app / 'config.csv')]

    print(f'{a.event} ({model}): sized without event-window protection', flush=True)
    before, _, seconds_before, _ = one_run(app, case, stage, history, pristine, 'seasonal-off', base + ['--no-cut-protection'], env)
    print(f'{a.event} ({model}): sized with event-window protection', flush=True)
    after, log, seconds_after, members = one_run(app, case, stage, history, pristine, 'seasonal-on', base, env)
    shutil.rmtree(history)
    shutil.copytree(pristine, history)                     # the kept tree as it was found
    if not before or not after:
        sys.exit('seasonal-protection-compare: a run produced no CSV (is the event active at the end of the staged data? '
                 'see its private log in the work tree)')

    common = sorted(set(before) & set(after))
    # The profile value columns: exactly the profile names of the stored proposal (the CSV also carries
    # derived columns per profile, which are not entitlement figures).
    known_profiles = {p for m in members.values() for p in (m.get('profiles') or {})}
    known_profiles |= {p for m in members.values() for e in (m.get('eventEvidence') or {}).values() for p in (e.get('profiles') or [])}
    profiles = [c for c in next(iter(after.values())) if c in known_profiles] or \
               [c for c in next(iter(after.values())) if re.match(r'^[POGB]\d?-[0-9.]+W\d+$', c)]
    planning, cells, vps = [], [], []
    for vm in common:
        b, n = number(before[vm].get('NFIT - ENT')), number(after[vm].get('NFIT - ENT'))
        if b is not None and n is not None:
            planning.append((b, n))
        b, n = number(before[vm].get('NFIT - VCPU')), number(after[vm].get('NFIT - VCPU'))
        if b is not None and n is not None:
            vps.append((b, n))
        for p in profiles:
            b, n = number(before[vm].get(p)), number(after[vm].get(p))
            if b is not None and n is not None:
                cells.append((b, n))
    # The planning figure by what the evidence pass found for the LPAR's planning profile (from the
    # stored proposal of the run with the protection), and every moved figure with its explanation.
    by_verdict, moved, cells_lowered, cells_raised, relied, unsupported = {}, [], {}, {}, [], {}
    for vm in common:
        member = members.get(vm) or {}
        plan_profile = member.get('planningProfile') or (member.get('eventWindow') or {}).get('planningProfile')
        cls = evidence_class(members, vm, plan_profile)
        own = [(number(before[vm].get(p)), number(after[vm].get(p))) for p in profiles]
        own_moved = any(b is not None and n is not None and abs(n - b) > EPS for b, n in own)
        b, n = number(before[vm].get('NFIT - ENT')), number(after[vm].get('NFIT - ENT'))
        if b is not None and n is not None:
            by_verdict.setdefault(cls, []).append((b, n))
            if abs(n - b) > EPS:
                floor = ((member.get('profiles') or {}).get(plan_profile) or {}).get('tierFloor') or {} if plan_profile else {}
                moved.append({'vm': vm, 'before': b, 'after': n, 'planningProfile': plan_profile, 'pool': member.get('poolId'),
                              'direction': 'raised' if n > b else 'lowered', 'evidence': cls,
                              'ownProfileValuesMoved': own_moved,
                              'allowanceWithheld': bool(floor.get('withheld') or (member.get('eventWindow') or {}).get('allowanceWithheld')),
                              'reliedOn': (member.get('eventWindow') or {}).get('borrowingReliedOn') or 0,
                              'role': member.get('roleSource') or '-',
                              'ownBefore': number(before[vm].get(plan_profile)) if plan_profile else None,
                              'ownAfter': number(after[vm].get(plan_profile)) if plan_profile else None,
                              'contestedLevelApplied': bool((((member.get('profiles') or {}).get(plan_profile) or {}).get('contestedFloor') or {}).get('applied')) if plan_profile else False,
                              'roleWordsInAction': role_words(after[vm].get('NFIT - Action'))})
        if (member.get('eventWindow') or {}).get('allowanceWithheld'):
            relied.append(member['eventWindow'].get('borrowingReliedOn') or 0)
        for p in profiles:
            b, n = number(before[vm].get(p)), number(after[vm].get(p))
            if b is None or n is None or abs(n - b) <= EPS:
                continue
            target = cells_lowered if n < b else cells_raised
            key = evidence_class(members, vm, p)
            target[key] = target.get(key, 0) + 1
            if n < b and key != 'supportedNoCompetition':
                unsupported[p] = unsupported.get(p, 0) + 1
    explained = {}
    for m in moved:
        key = '%s | evidence %s | own profile values %s | allowance withheld %s | contested level %s | role words %s' % (
            m['direction'], m['evidence'], 'moved' if m['ownProfileValuesMoved'] else 'unchanged',
            'yes' if m['allowanceWithheld'] else 'no', 'yes' if m['contestedLevelApplied'] else 'no', m['roleWordsInAction'])
        explained[key] = explained.get(key, 0) + 1
    pool_lines = re.findall(r'^  (\d+(?: \(def\))?)\s+\d+\s+\S+\s+[\d.]+\s+\d+\s+[\d.]+  (guarantees and relied-on|unresolved|the guarantees alone|not assessed)', log, re.M)
    frame_line = re.search(r'^  Frame\s+(\d+)\s+(\S+)\s+([\d.]+)\s+(\d+)\s+([\d.]+)  (.*)$', log, re.M)
    current = [(number(before[vm].get('Current - ENT')), number(before[vm].get('NFIT - ENT')), number(after[vm].get('NFIT - ENT'))) for vm in common]
    current = [c for c in current if None not in c]
    actions = [after[vm].get('NFIT - Action') or '' for vm in common]
    installed = [number(after[vm].get('Current - ENT')) for vm in common]
    result = {
        'event': a.event, 'model': model, 'commit': pr.git_identity(),
        'lpars': {'both': len(common), 'onlyWithout': len(set(before) - set(after)), 'onlyWith': len(set(after) - set(before))},
        'evidence': evidence_section(log),
        'planningEntitlement': movement(planning),
        'planningEntitlementByEvidence': {k: movement(v) for k, v in sorted(by_verdict.items())},
        'movedPlanningFigures': dict(sorted(explained.items())),
        'profileValuesLoweredByEvidence': dict(sorted(cells_lowered.items())),
        'profileValuesRaisedByEvidence': dict(sorted(cells_raised.items())),
        'exemptionCheck': {'profileValuesLowered': sum(cells_lowered.values()),
                           'withSupportedNoCompetition': cells_lowered.get('supportedNoCompetition', 0),
                           'withoutIt': sum(v for k, v in cells_lowered.items() if k != 'supportedNoCompetition'),
                           'withoutItByProfile': dict(sorted(unsupported.items()))},
        'eventWindowPlan': {'lparsWithAllowanceWithheld': len(relied), 'borrowingReliedOnCores': round(sum(relied), 2),
                            'frame': (dict(zip(('lpars', 'sharedProcessors', 'guarantees', 'allowanceWithheld', 'reliedOn', 'reading'),
                                               frame_line.groups())) if frame_line else None),
                            'pools': len(pool_lines),
                            'poolsWithinMaximum': sum(1 for _, r in pool_lines if r.startswith('guarantees and')),
                            'poolsBorrowingUnresolved': sum(1 for _, r in pool_lines if r == 'unresolved'),
                            'poolsGuaranteesExceedMaximum': sum(1 for _, r in pool_lines if r.startswith('the guarantees')),
                            'poolsNotAssessed': sum(1 for _, r in pool_lines if r == 'not assessed')},
        'planningAgainstInstalled': {
            'lpars': len(current),
            'aboveInstalledWithout': sum(1 for c, b, n in current if b > c + EPS), 'aboveInstalledWith': sum(1 for c, b, n in current if n > c + EPS),
            'belowInstalledWithout': sum(1 for c, b, n in current if b < c - EPS), 'belowInstalledWith': sum(1 for c, b, n in current if n < c - EPS),
            'increaseCoresWithout': round(sum(b - c for c, b, n in current if b > c + EPS), 2),
            'increaseCoresWith': round(sum(n - c for c, b, n in current if n > c + EPS), 2),
            'reductionCoresWithout': round(sum(c - b for c, b, n in current if b < c - EPS), 2),
            'reductionCoresWith': round(sum(c - n for c, b, n in current if n < c - EPS), 2),
            # Lowered LPARs: where the figure without the protection stood against the installed entitlement.
            'loweredFromAboveInstalled': sum(1 for c, b, n in current if n < b - EPS and b > c + EPS),
            'loweredFromAtOrBelowInstalled': sum(1 for c, b, n in current if n < b - EPS and b <= c + EPS),
            'loweredToBelowInstalled': sum(1 for c, b, n in current if n < b - EPS and n < c - EPS)},
        'planningVPs': movement(vps),
        'profileValues': dict(movement(cells), profiles=len(profiles)),
        'installedEntitlementTotal': round(sum(v for v in installed if v is not None), 2),
        'actions': {'cutLimitedByPastEventWindows': sum(1 for t in actions if 'Cut limited to' in t and 'past event windows' in t),
                    'targetRaisedByContestedLevel': sum(1 for t in actions if 'Target raised to' in t and 'past event window' in t),
                    'actionTextChanged': sum(1 for vm in common if (before[vm].get('NFIT - Action') or '') != (after[vm].get('NFIT - Action') or ''))},
        'seconds': {'without': seconds_before, 'with': seconds_after},
    }
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    target = out / f'seasonal-protection-{re.sub(r"[^A-Za-z0-9_.-]", "_", a.event)}.json'
    target.write_text(json.dumps(result, indent=1) + '\n')

    e, pl, pv = result['evidence'], result['planningEntitlement'], result['profileValues']
    print()
    print(f"Event-window protection: event {a.event} ({model}), {len(common)} LPAR(s), commit {result['commit']}")
    if 'notUsed' in e:
        print(f"  Evidence         : not used: {e['notUsed']}")
    else:
        print(f"  Evidence         : {e.get('pastWindows', 0)} past window(s) ({e.get('windows', '')}); LPARs {e.get('lpars')}; "
              f"earlier-state day records {e['earlierStateDayRecords']}; mixed-interval LPARs {e['mixedIntervalLpars']}")
    for name, m in (('Planning ENT', pl), ('Planning VPs', result['planningVPs']), ('Profile values', pv)):
        print(f"  {name:<17}: {m['compared']} compared; unchanged {m['unchanged']}; raised {m['raised']} (+{m['raisedByCores']}, largest {m['largestRaise']}); "
              f"lowered {m['lowered']} (-{m['loweredByCores']}, largest {m['largestReduction']}); total {m['totalBefore']} -> {m['totalAfter']}")
    for name, m in result['planningEntitlementByEvidence'].items():
        print(f"    {name:<30}: {m['compared']} LPAR(s); raised {m['raised']} (+{m['raisedByCores']}); lowered {m['lowered']} (-{m['loweredByCores']}); "
              f"total {m['totalBefore']} -> {m['totalAfter']}")
    print('  Moved planning figures, by explanation:')
    for key, count in result['movedPlanningFigures'].items():
        print(f'    {count:>3}  {key}')
    print(f"  Profile values lowered, by evidence: {result['profileValuesLoweredByEvidence']}")
    print(f"  Profile values raised, by evidence : {result['profileValuesRaisedByEvidence']}")
    print(f"  Exemption check  : {result['exemptionCheck']}")
    print(f"  Event-window plan: {result['eventWindowPlan']}")
    print(f"  Installed ENT    : {result['installedEntitlementTotal']}")
    print(f"  Against installed: {result['planningAgainstInstalled']}")
    print(f"  Actions          : {result['actions']}")
    print(f"  Seconds          : {result['seconds']}")
    if a.names:
        fmt = lambda v: '%6.2f' % v if v is not None else '     -'
        rows = ['%-24s pool %-4s %-10s planning %6.2f -> %6.2f  own target %s -> %s  %-8s %-22s relied on %5.2f; contested level %s; role %s' % (
            m['vm'], m['pool'] if m['pool'] is not None else '-', m['planningProfile'] or '-', m['before'], m['after'],
            fmt(m['ownBefore']), fmt(m['ownAfter']), m['direction'], m['evidence'], m['reliedOn'],
            'yes' if m['contestedLevelApplied'] else 'no', m['role'])
                for m in sorted(moved, key=lambda m: (m['direction'], m['evidence'], m['vm']))]
        redacted = subprocess.run([str(REPO / 'dev' / 'nfit-redact')], input='\n'.join(rows) + '\n', capture_output=True, text=True)
        print('  Moved LPARs (pseudonyms):')
        print('\n'.join('    ' + line for line in redacted.stdout.splitlines()) if redacted.returncode == 0 and redacted.stdout.strip()
              else '    (dev/nfit-redact gave no output; nothing is shown)')
    audit = subprocess.run([str(REPO / 'dev' / 'nfit-redact'), '--audit', str(target)], capture_output=True, text=True)
    print(audit.stdout.strip().splitlines()[-1] if audit.stdout.strip() else 'audit: no output')
    print(f'Written: {target}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

#!/usr/bin/env bash
# ==============================================================================
# NAME     : run-tests
# PURPOSE  : Single regression gate for the nFit CLI suite. Runs the compile
#            gates for every Perl and Python program, then every test/*.t
#            suite, and prints a one-line summary per step. All output passes
#            through dev/nfit-redact so it is safe to share.
# USAGE    : dev/run-tests            (from anywhere inside nmon-fit)
# NOTES    : On the Cowork Linux VM, which lacks libjson-perl, development shims
#            in .claude/perl5 are placed on PERL5LIB automatically when present.
#            Exit status is non-zero if any gate or suite fails.
# ==============================================================================
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

if ! perl -MJSON -e1 2>/dev/null && [ -d "$ROOT/.claude/perl5" ]; then
    export PERL5LIB="$ROOT/.claude/perl5${PERL5LIB:+:$PERL5LIB}"
fi

failures=0
redact() { "$ROOT/dev/nfit-redact" --allow-empty; }

echo "== Compile gates"
for prog in nfit nfit-profile nfit-stage-nmon; do
    if perl -c "$prog" >/dev/null 2>&1; then
        printf "  %-22s ok\n" "$prog"
    else
        printf "  %-22s FAILED\n" "$prog"; perl -c "$prog" 2>&1 | redact | tail -5
        failures=$((failures + 1))
    fi
done
for prog in nfit-stage-influxdb nfit-forecast nfit-plot; do
    [ -f "$prog" ] || continue
    if python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$prog" 2>/dev/null; then
        printf "  %-22s ok\n" "$prog"
    else
        printf "  %-22s FAILED\n" "$prog"; failures=$((failures + 1))
    fi
done

echo "== Test suites"
cd "$ROOT/test" || exit 2
for t in *.t; do
    out=$(NFIT_PROFILE="$ROOT/nfit-profile" NFIT_ENGINE="$ROOT/nfit" timeout 300 perl "$t" 2>&1)
    rc=$?
    ok=$(printf '%s\n' "$out" | grep -c '^ok')
    nok=$(printf '%s\n' "$out" | grep -c '^not ok')
    if [ "$rc" -eq 0 ] && [ "$nok" -eq 0 ]; then
        printf "  %-30s ok (%d)\n" "$t" "$ok"
    else
        printf "  %-30s FAILED (rc=%d, ok=%d, not ok=%d)\n" "$t" "$rc" "$ok" "$nok"
        printf '%s\n' "$out" | grep -A3 '^not ok' | redact | head -20
        failures=$((failures + 1))
    fi
done

echo "== Summary: $failures failing step(s)"
exit $(( failures > 0 ? 1 : 0 ))

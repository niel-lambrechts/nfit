#!/usr/bin/env python3
# ==============================================================================
# NAME     : dev/pool-ceiling-replay
# PURPOSE  : Research replay for the pool reduction policy (v10 stage 3.4). For
#            each research system, runs nfit-profile's pool ceiling replay
#            (--research-pool-ceiling-replay; no sizing) on the cohort's
#            training and held-out periods and reports, per user-defined pool:
#            the installed maximum, the structural minimum (the members'
#            installed entitlements), the workload candidate (the highest
#            credible minute kept outside the near-ceiling tolerance), the
#            candidate, the units removed, the reasons a reduction is
#            withheld, and what the held-out period did against the candidate:
#            minutes above it, minutes newly near it, by window and on the
#            close days (the last and first day of a month).
#            A clean replay has no minute above the candidate and no minute
#            newly near it. The replay does not simulate the hypervisor and
#            says nothing about bursts inside a minute.
# USAGE    : dev/pool-ceiling-replay [--cohort P10|P9|all] [--systems P10-02,...] [--out DIR]
# OUTPUT   : <out>/pool-ceiling-replay.json and .md (research labels and pool
#            numbers only; no LPAR is named)
# ==============================================================================
import argparse
import collections
import datetime as dt
import importlib.machinery
import importlib.util
import json
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
_loader = importlib.machinery.SourceFileLoader('protection_replay', str(REPO / 'dev' / 'protection-replay'))
_spec = importlib.util.spec_from_loader('protection_replay', _loader)
pr = importlib.util.module_from_spec(_spec)
_loader.exec_module(pr)


def table(lines, header, body):
    lines.append('| ' + ' | '.join(header) + ' |')
    lines.append('|' + '|'.join('---' for _ in header) + '|')
    lines.extend('| ' + ' | '.join(str(c) for c in row) + ' |' for row in body)
    lines.append('')


def setup_app(work):
    app = work / 'app'
    if app.is_dir():
        shutil.rmtree(app)
    (app / 'etc').mkdir(parents=True)
    (app / 'output').mkdir()
    for name in pr.EXECUTABLES:
        shutil.copy(REPO / name, app / name)
        (app / name).chmod(0o700)
    for f in sorted((REPO / 'etc').glob('nfit.*')):
        if f.is_file():
            shutil.copy(f, app / 'etc' / f.name)
    return app


def clean(p):
    at = (p.get('later') or {}).get('atCandidate') or {}
    return at.get('exceedMinutes', 0) == 0 and at.get('newlyNearMinutes', 0) == 0


def report(out, data):
    pools = data['pools']
    lines = ['# Pool ceiling replay: a conservative reduction candidate, tested on a later period', '',
             f'Generated {data["generated"]}; commit {str(data["commit"])[:7]}. Systems: {", ".join(s["system"] for s in data["systems"])}.',
             'Candidate: the smallest whole pool maximum that holds the members\' installed entitlements and keeps the',
             'highest credible minute of pool busy in training outside the near-ceiling tolerance (unsmoothed, all hours).',
             'The members\' entitlements are the installed ones: no sizing is run, so this tests the workload rule, not the',
             'final structural figure. The reserve is not known for any pool, so every reduction is conditional on it.',
             'A clean replay has no later minute above the candidate and none newly near it. Bursts inside a minute are',
             'not seen.', '']
    for s in data['systems']:
        lines.append(f'- {s["system"]}: training {s["window"]["trainingStart"]} to {s["window"]["trainingEnd"]}, later to '
                     f'{s["window"]["laterEnd"]}; {s["pools"]} user-defined pool(s).')
    lines.append('')

    lower = [p for p in pools if p['unitsRemoved'] > 0]
    eligible = [p for p in lower if not p['withheld']]
    held = [p for p in lower if p['withheld']]
    lines += ['## 1. Summary', '']
    table(lines, ['', 'Pools', 'Installed maximum', 'Candidate', 'Units removed', 'Clean later', 'Not clean'],
          [[name, len(g), sum(p['installedMaximum'] for p in g), sum(p['candidate'] for p in g), sum(p['unitsRemoved'] for p in g),
            sum(1 for p in g if clean(p)), sum(1 for p in g if not clean(p))]
           for name, g in (('Reduction offered (evidence complete)', eligible),
                           ('Candidate below the maximum, reduction withheld', held))]
          + [['No reduction (candidate at or above the maximum)', len(pools) - len(lower),
              sum(p['installedMaximum'] for p in pools if p['unitsRemoved'] == 0), '', 0, '', '']])
    reasons = collections.Counter(r for p in pools for r in p['withheld'])
    lines += ['Reasons a reduction is withheld (a pool can have several):', '']
    table(lines, ['Reason', 'Pools'], [[k, n] for k, n in reasons.most_common()] or [['none', 0]])
    governs = collections.Counter('members\' entitlements' if p['structuralMinimum'] >= p['workloadCandidate'] else 'measured peak' for p in lower)
    lines += [f'What sets the candidate where it is below the maximum: {dict(governs)}.', '']

    def rows(group):
        body = []
        for p in sorted(group, key=lambda p: (p['system'], p['pool'])):
            t, l = p['training'], p['later']
            at = l.get('atCandidate') or {}
            w = at.get('windows') or {}
            body.append([p['system'], p['pool'], p['installedMaximum'], f'{p["members"]} ({p["cappedMembers"]})', f'{p["installedEntitlement"]:.2f}',
                         p['structuralMinimum'], p['workloadCandidate'], p['candidate'], p['unitsRemoved'],
                         f'{t["peak"]:.2f} / {t["p99"]:.2f}', f'{l["peak"]:.2f}' if l.get('peak') is not None else 'n/a',
                         f'{at.get("exceedMinutes", 0)} / {at.get("exceedCoreMinutes", 0):.2f} / {at.get("exceedDays", 0)} / {at.get("longestExceed", 0)}',
                         at.get('newlyNearMinutes', 0),
                         ' '.join(f'{k} {w[k]["exceedMinutes"]}+{w[k]["nearMinutes"]}' for k in ('online', 'batch', 'other', 'closeDays') if k in w
                                  and (w[k]['exceedMinutes'] or w[k]['nearMinutes'])) or 'none',
                         'yes' if (l.get('segments', 1) > 1 or len(l.get('maximaSeen') or []) > 1) else 'no',
                         '; '.join(p['withheld']) or 'none'])
        return body
    header = ['System', 'Pool', 'Maximum', 'Members (capped)', 'Installed entitlement', 'Structural minimum', 'Workload candidate', 'Candidate',
              'Units removed', 'Training peak / P99', 'Later peak', 'Later above candidate (min / core-min / days / longest)',
              'Later newly near', 'By window (above+near)', 'Changed later', 'Withheld because']
    lines += ['## 2. Reductions offered', '']
    table(lines, header, rows(eligible) or [['none'] + [''] * (len(header) - 1)])
    lines += ['## 3. Candidate below the maximum, reduction withheld', '',
              'Shown with their later replay so that the withholding rules can be judged.', '']
    table(lines, header, rows(held) or [['none'] + [''] * (len(header) - 1)])
    lines += ['## 4. No reduction', '']
    table(lines, ['System', 'Pool', 'Maximum', 'Structural minimum', 'Workload candidate', 'Training peak', 'Minutes at maximum (training)',
                  'Frame without spare cores (training minutes)', 'Withheld because'],
          [[p['system'], p['pool'], p['installedMaximum'], p['structuralMinimum'], p['workloadCandidate'], f'{p["training"]["peak"]:.2f}',
            p['training']['fullMinutes'], p['training']['frameScarceMinutes'], '; '.join(p['withheld']) or 'none']
           for p in sorted(pools, key=lambda p: (p['system'], p['pool'])) if p['unitsRemoved'] == 0] or [['none'] + [''] * 8])
    lines += ['## 5. Context: what a percentile rule would have cost', '',
              'Not a proposal. For pools where the 99.9th or 99th percentile of training would give a lower ceiling than',
              'the peak rule, the later minutes above that ceiling.', '']
    body = []
    for p in sorted(lower, key=lambda p: (p['system'], p['pool'])):
        for key, name in (('atP999', 'P99.9'), ('atP99', 'P99')):
            alt = p['later'].get(key)
            if alt:
                body.append([p['system'], p['pool'], p['candidate'], name, alt['ceiling'], p['candidate'] - alt['ceiling'],
                             f'{alt["exceedMinutes"]} / {alt["exceedCoreMinutes"]:.2f} / {alt["exceedDays"]}', alt['newlyNearMinutes']])
    table(lines, ['System', 'Pool', 'Peak-rule candidate', 'Rule', 'Ceiling', 'Further units', 'Later above it (min / core-min / days)', 'Later newly near'],
          body or [['none'] + [''] * 7])
    # ---- The experiment: coverage policy, history length, resolution, margin ----
    def bad(j):
        return j.get('exceedMinutes', 0) > 0 or j.get('newlyNearMinutes', 0) > 0

    def tally(judgements):
        js = [j for j in judgements if j]
        return [len(js), sum(1 for j in js if j.get('units', 0) > 0), sum(j.get('units', 0) for j in js),
                sum(1 for j in js if j.get('exceedMinutes', 0) > 0), sum(j.get('exceedMinutes', 0) for j in js),
                f'{sum(j.get("exceedCoreMinutes", 0) for j in js):.2f}', sum(1 for j in js if bad(j))]
    tally_header = ['Pools', 'With a reduction', 'Units removed', 'Pools with later minutes above', 'Minutes above', 'Core-minutes above', 'Pools not clean']

    lines += ['## 6. Coverage policies compared', '',
              'Existing: 99% of the minutes overall and 90% on every day. Alternative: at least 28 days at 90% and 95%',
              'overall, missing days counted. Other withholding reasons apply under both. Provisional settings; the',
              'comparison shows what each admits and how those pools did later, not which is right.', '']
    cover = ('coverage below 99% of the minutes', 'a day below 90% coverage')
    other = lambda p: [r for r in p['withheld'] if r not in cover]
    under_a = [p for p in lower if not p['withheld']]
    under_b = [p for p in lower if not other(p) and p.get('coverageAlt')]
    table(lines, ['Policy', 'Reductions offered', 'Units removed', 'Clean later', 'Not clean'],
          [[name, len(g), sum(p['unitsRemoved'] for p in g), sum(1 for p in g if clean(p)), sum(1 for p in g if not clean(p))]
           for name, g in (('Existing', under_a), ('Alternative', under_b))])
    added = [p for p in under_b if p['withheld']]
    lines += [f'Pools the alternative adds: {len(added)}. Their gaps and later result:', '']
    table(lines, ['System', 'Pool', 'Coverage', 'Well-covered days', 'Low days', 'Of which close days', 'Units removed', 'Later above (min)', 'Later newly near'],
          [[p['system'], p['pool'], f'{p["training"]["coverage"]:.3f}', p['training'].get('goodDays'), len(p['training'].get('lowDays') or []),
            sum(1 for d in (p['training'].get('lowDays') or []) if d.get('closeDay')), p['unitsRemoved'],
            (p['later'].get('atCandidate') or {}).get('exceedMinutes', 0), (p['later'].get('atCandidate') or {}).get('newlyNearMinutes', 0)]
           for p in sorted(added, key=lambda p: (p['system'], p['pool']))] or [['none'] + [''] * 8])
    still = [p for p in lower if not other(p) and p['withheld'] and not p.get('coverageAlt')]
    lines += [f'Still withheld on coverage under the alternative: {len(still)} pool(s).', '']

    # The experiment set: pools never at their maximum in training, one roster and maximum, coverage sufficient
    # under the alternative policy, and at least 30 training days.
    exp = [p for p in pools if p.get('experiment') and not p['training']['fullMinutes'] and not other(p) and p.get('coverageAlt')
           and '30' in (p['experiment'].get('lengths') or {})]
    lines += ['## 7. History length, at one minute', '',
              f'{len(exp)} pools: never at their maximum in training, one roster and maximum, coverage sufficient under the',
              'alternative policy, at least 30 training days. The candidate is taken from the last N days before the cutoff',
              'and judged on the same later period at one minute. Shorter history is the more recent part of the longer.', '']
    table(lines, ['History'] + tally_header,
          [[name] + tally([p['experiment']['lengths'].get(key) for p in exp]) for key, name in (('14', '14 days'), ('30', '30 days'), ('all', 'all training days'))])

    lines += ['## 8. Resolution, on the same 30 days', '',
              'The same 30 days read three ways: every minute; 15-minute means (buckets at least 80% complete); one reading',
              'every 15 minutes. Offsets shift where the 15-minute boundaries fall. All are judged on the later period at',
              'one minute. This isolates what a coarser interval hides; it says nothing about growth.', '']
    body = [['one minute', ''] + tally([p['experiment']['lengths'].get('30') for p in exp])]
    for kind, name in (('mean', '15-minute mean'), ('point', 'one reading per 15 minutes')):
        offsets = sorted({m['offset'] for p in exp for m in (p['experiment'].get('coarse') or {}).get(kind, [])})
        for off in offsets:
            body.append([name, off] + tally([next((m for m in (p['experiment'].get('coarse') or {}).get(kind, []) if m['offset'] == off), None) for p in exp]))
    table(lines, ['Reading', 'Offset (min)'] + tally_header, body)
    ratios, lower_c, differ = {'mean': [], 'point': []}, {'mean': 0, 'point': 0}, {'mean': 0, 'point': 0}
    for p in exp:
        ref = p['experiment']['lengths']['30']
        for kind in ('mean', 'point'):
            ms = (p['experiment'].get('coarse') or {}).get(kind, [])
            if not ms or ref['peak'] <= 0:
                continue
            ratios[kind].append(min(m['peak'] for m in ms) / ref['peak'])
            lower_c[kind] += any(m['ceiling'] < ref['ceiling'] for m in ms)
            differ[kind] += len({m['ceiling'] for m in ms}) > 1
    q = lambda v, f: sorted(v)[int(f * (len(v) - 1))] if v else float('nan')
    table(lines, ['Reading', 'Pools', 'Coarse peak as a share of the one-minute peak, lowest offset: median', '10th percentile', 'Lowest',
                  'Pools with a lower ceiling than at one minute (any offset)', 'Pools whose ceiling depends on the offset'],
          [[name, len(ratios[kind]), f'{q(ratios[kind], 0.5):.3f}', f'{q(ratios[kind], 0.1):.3f}', f'{min(ratios[kind]):.3f}' if ratios[kind] else 'n/a',
            lower_c[kind], differ[kind]] for kind, name in (('mean', '15-minute mean'), ('point', 'one reading per 15 minutes'))])

    lines += ['## 9. Margins on the peak', '',
              'The reference candidate carries no margin. This shows what a margin on the observed peak would change; it is',
              'not fitted and none is proposed. The later period is the one already seen, so these figures describe it and do',
              'not validate a choice.', '']
    body = []
    for key, name in (('minuteAll', 'all training days, one minute'), ('coarseMean', '30 days, 15-minute mean')):
        for m in ('0.00', '0.05', '0.10', '0.15', '0.25'):
            body.append([name, f'{float(m) * 100:.0f}%'] + tally([(p['experiment'].get('margins') or {}).get(key, {}).get(m) for p in exp]))
    table(lines, ['Candidate from', 'Margin'] + tally_header, body)
    # ---- Peak support ----
    lines += ['## 10. Peak support', '',
              'What stands behind each training peak, for pools whose candidate is below the maximum. "Near the peak" is',
              'within 10% of it; "setting" minutes are those that alone would give the same whole-unit ceiling. An episode',
              'is a run of consecutive minutes near the peak. This shows how far a candidate rests on a rare reading. It is',
              'not a rule for leaving a peak out: a single real peak can matter greatly.', '']
    sup = [p for p in lower if p.get('peakSupport')]
    peak_led = [p for p in sup if p['peakSupport']['governs'] == 'peak']
    one_ep = [p for p in peak_led if p['peakSupport']['episodesNearPeak'] == 1]
    one_min = [p for p in peak_led if p['peakSupport']['settingMinutes'] == 1]
    one_day = [p for p in peak_led if p['peakSupport']['settingDays'] == 1]
    flagged = [p for p in peak_led if any(e.get('setsCeiling') and (e.get('dataGapBefore') or e.get('dataGapAfter') or e.get('configurationChangeWithinADay'))
                                         for e in p['peakSupport']['top'])]
    fail = lambda g: sum(1 for p in g if not clean(p))
    table(lines, ['Pools whose candidate is set by the peak', 'Pools', 'Not clean later'],
          [['all', len(peak_led), fail(peak_led)],
           ['ceiling set on one day only', len(one_day), fail(one_day)],
           ['ceiling set by a single minute', len(one_min), fail(one_min)],
           ['one episode near the peak', len(one_ep), fail(one_ep)],
           ['ceiling set on several days', len(peak_led) - len(one_day), fail([p for p in peak_led if p not in one_day])],
           ['a ceiling-setting episode beside a data gap or configuration change', len(flagged), fail(flagged)],
           ['a unit or more lower without the top episode', sum(1 for p in peak_led if p['peakSupport']['candidateWithoutTopEpisode'] < p['candidate']),
            fail([p for p in peak_led if p['peakSupport']['candidateWithoutTopEpisode'] < p['candidate']])]])
    body = []
    for p in sorted(sup, key=lambda p: (p['system'], p['pool'])):
        ps, t = p['peakSupport'], p['training']
        top = ps['top'][0] if ps['top'] else {}
        flags = ', '.join(name for key, name in (('dataGapBefore', 'gap before'), ('dataGapAfter', 'gap after'),
                                                 ('configurationChangeWithinADay', 'configuration change')) if top.get(key)) or 'none'
        at = p['later'].get('atCandidate') or {}
        body.append([p['system'], p['pool'], p['candidate'], ps['governs'], f'{t["peak"]:.2f}',
                     f'{ps["secondDayPeak"]:.2f}' if ps.get('secondDayPeak') is not None else 'n/a', f'{t["p99"]:.2f}',
                     f'{ps["minutesNearPeak"]} / {ps["daysNearPeak"]} / {ps["episodesNearPeak"]}', f'{ps["settingMinutes"]} / {ps["settingDays"]}',
                     f'{top.get("startUTC", "")}, {top.get("minutes", 0)} min, {top.get("window", "")}{", close day" if top.get("closeDay") else ""}',
                     flags, ps['candidateWithoutTopEpisode'], '; '.join(p['withheld']) or 'none',
                     'clean' if clean(p) else f'{at.get("exceedMinutes", 0)} above, {at.get("newlyNearMinutes", 0)} near'])
    table(lines, ['System', 'Pool', 'Candidate', 'Set by', 'Peak', 'Second-highest day', 'P99', 'Near the peak (min / days / episodes)',
                  'Setting the ceiling (min / days)', 'Highest episode (UTC)', 'Flags on it', 'Candidate without it (not applied)',
                  'Withheld because', 'Later'], body or [['none'] + [''] * 13])
    (out / 'pool-ceiling-replay.md').write_text('\n'.join(lines) + '\n')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--cohort', choices=('P10', 'P9', 'all'), default='all')
    ap.add_argument('--capture-root', default=pr.site_input('NFIT_CAPTURES'), help='root of the staged captures (default: $NFIT_CAPTURES)')
    ap.add_argument('--systems', default=None, help='only these research labels, e.g. P10-02,P10-06')
    ap.add_argument('--out', default=str(REPO / 'design' / 'acceptance' / 'pool-ceiling-replay'))
    ap.add_argument('--report-only', action='store_true', help='rebuild the report from an existing pool-ceiling-replay.json')
    a = ap.parse_args()
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    if not a.report_only:
        pr.need('pool-ceiling-replay', a.capture_root, '--capture-root', 'NFIT_CAPTURES')
        wanted = {x.strip() for x in a.systems.split(',')} if a.systems else None
        work = REPO / '.private' / 'pool-ceiling-replay'
        work.mkdir(parents=True, exist_ok=True)
        env = pr.perl_env()
        app = setup_app(work)
        systems, pools = [], []
        for cohort in (('P10', 'P9') if a.cohort == 'all' else (a.cohort,)):
            folder, expected, start, cutoff, _later, end = pr.COHORTS[cohort]
            sources = sorted(p.parent for p in (Path(a.capture_root) / folder / 'stage').glob('*/.nfit_stage_id'))
            if len(sources) != expected:
                sys.exit(f'pool-ceiling-replay: expected {expected} staged system(s) for {cohort}, found {len(sources)}')
            for i, source in enumerate(sources, 1):
                label = f'{cohort}-{i:02d}'
                if wanted is not None and label not in wanted:
                    continue
                print(f'{label}: replay', flush=True)
                case = work / label
                if case.exists():
                    shutil.rmtree(case)
                case.mkdir()
                stage = pr.link_stage(case, source)
                for p in (app / 'output').glob('*'):
                    p.unlink()
                pr.invoke(app, case, 'pool-ceiling', ['--nmondir', str(stage), '--research-pool-ceiling-replay', f'{start}/{cutoff}/{end}'], env)
                result = json.loads((app / 'output' / 'nfit-profile.pool-ceiling-replay.json').read_text())
                for p in result.get('pools', []):
                    p['system'] = label
                    pools.append(p)
                systems.append({'system': label, 'status': result.get('status'), 'window': result.get('window'), 'pools': len(result.get('pools', []))})
                print(f'{label}: {systems[-1]["pools"]} pool(s) ({result.get("status")})', flush=True)
        data = {'generated': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%d %H:%M UTC'), 'commit': pr.git_identity(),
                'systems': systems, 'pools': pools}
        (out / 'pool-ceiling-replay.json').write_text(json.dumps(data, indent=1) + '\n')
        shutil.rmtree(work, ignore_errors=True)
    data = json.loads((out / 'pool-ceiling-replay.json').read_text())
    report(out, data)
    for name in ('pool-ceiling-replay.json', 'pool-ceiling-replay.md'):
        audit = subprocess.run([str(REPO / 'dev' / 'nfit-redact'), '--audit', str(out / name)], capture_output=True, text=True)
        print(audit.stdout.strip().splitlines()[-1] if audit.stdout.strip() else 'audit: no output')
    print(f'Written: {out / "pool-ceiling-replay.md"}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

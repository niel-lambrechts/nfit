#!/usr/bin/env python3
# ==============================================================================
# NAME     : dev/contested-record-measure
# PURPOSE  : Size and precision of the durable contested record (history schema
#            draft) on one research system: runs nfit-profile with
#            --research-contested-record on the cohort's training period and
#            keeps its aggregate result. The form measured is the simplest one:
#            counted (busy, consumed) pairs on a 0.01-core grid, both rounded
#            up, one record per LPAR state, profile-hours population and UTC
#            day. Reported: bytes and gzipped bytes by class of LPAR (quiet,
#            intermittently and persistently contested) in two layouts, the
#            largest day record, and the difference the rounding makes to the
#            cut-protection bound and the contested level of every profile.
# USAGE    : dev/contested-record-measure --system P10-02 [--out DIR]
# OUTPUT   : <out>/contested-record-<system>.json (aggregates; no LPAR is named)
# ==============================================================================
import argparse
import importlib.machinery
import importlib.util
import json
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
_loader = importlib.machinery.SourceFileLoader('protection_replay', str(REPO / 'dev' / 'protection-replay'))
_spec = importlib.util.spec_from_loader('protection_replay', _loader)
pr = importlib.util.module_from_spec(_spec)
_loader.exec_module(pr)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--system', required=True, help='research label, e.g. P10-02')
    ap.add_argument('--config', default=pr.site_input('NFIT_VM_CONFIG'), help='VM configuration file (default: $NFIT_VM_CONFIG)')
    ap.add_argument('--capture-root', default=pr.site_input('NFIT_CAPTURES'), help='root of the staged captures (default: $NFIT_CAPTURES)')
    ap.add_argument('--out', default=str(REPO / 'design' / 'acceptance' / 'history'))
    a = ap.parse_args()
    pr.need('contested-record-measure', a.config, '--config', 'NFIT_VM_CONFIG')
    pr.need('contested-record-measure', a.capture_root, '--capture-root', 'NFIT_CAPTURES')
    if not Path(a.config).is_file():
        sys.exit('contested-record-measure: VM configuration file not found (see --config)')
    cohort, index = a.system.rsplit('-', 1)
    folder, expected, start, cutoff, _later, _end = pr.COHORTS[cohort]
    sources = sorted(p.parent for p in (Path(a.capture_root) / folder / 'stage').glob('*/.nfit_stage_id'))
    if len(sources) != expected:
        sys.exit(f'contested-record-measure: expected {expected} staged system(s) for {cohort}, found {len(sources)}')
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    work = REPO / '.private' / 'contested-record'
    if work.exists():
        shutil.rmtree(work)
    work.mkdir(parents=True)
    app = pr.setup_app(work, Path(a.config))
    case = work / a.system
    case.mkdir()
    stage = pr.link_stage(case, sources[int(index) - 1])
    print(f'{a.system}: sizing run with the contested record measured', flush=True)
    pr.invoke(app, case, 'measure', ['--nmondir', str(stage), '--config', str(app / 'config.csv'), '--startdate', start, '--enddate', cutoff,
                                     '--analysis-reference-date', cutoff, '--runq-perc-behavior=match', '--research-contested-record'],
              pr.perl_env())
    result = json.loads((app / 'output' / 'nfit-profile.contested-record.json').read_text())
    result['system'] = a.system
    result['window'] = {'start': start, 'end': cutoff}
    result['commit'] = pr.git_identity()
    target = out / f'contested-record-{a.system}.json'
    target.write_text(json.dumps(result, indent=1) + '\n')
    shutil.rmtree(work, ignore_errors=True)
    audit = subprocess.run([str(REPO / 'dev' / 'nfit-redact'), '--audit', str(target)], capture_output=True, text=True)
    print(audit.stdout.strip().splitlines()[-1] if audit.stdout.strip() else 'audit: no output')
    print(f'Written: {target}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

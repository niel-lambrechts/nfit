GROUPS = ('eligible now', 'awaiting regeneration', 'another quantity or no later target', 'target or provenance missing or ambiguous')


def _module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


pr = _module('protection_replay', REPO / 'dev' / 'protection-replay')


def block(source):
    """The decoder and tournament block of nfit-forecast, run in isolation (the tests load it the same way)."""
    start = source.rindex('# ====', 0, source.index('# Zone 2 record decoder (zone2-record-decoder-1)'))
    end = source.index('# --- End of Zone 2 record decoder ---')
    ns = {'os': os, 'json': json, 'sys': sys, 'datetime': datetime}
    exec(compile(source[start:end], str(FORECAST), 'exec'), ns)
    return ns


def fingerprint(root):
    """One hash of the names and bytes below a folder ('' when it does not exist)."""
    root = Path(root)
    if not root.exists():
        return ''
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob('*') if p.is_file()):
        digest.update(str(path.relative_to(root)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


def clone(src, dst):
    """A copy of a folder: a copy-on-write clone where the file system offers one, else a plain copy."""
    attempts = [['cp', '-cR', str(src), str(dst)]] if platform.system() == 'Darwin' else [['cp', '-R', '--reflink=auto', str(src), str(dst)]]
    for cmd in attempts:
        if subprocess.run(cmd, capture_output=True).returncode == 0:
            return 'copy-on-write clone' if platform.system() == 'Darwin' else 'copy'
        shutil.rmtree(dst, ignore_errors=True)
    shutil.copytree(src, dst, symlinks=True)
    return 'copy'


def months_of(history):
    """{month: month data} of a history folder."""
    out = {}
    for path in sorted(Path(history).glob('nfit.hist.*.json')):
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        for month, content in data.items():
            if isinstance(content, dict):
                out[month] = content
    return out


def ledger_of(history, name):
    """The ledger without its timestamps, or None."""
    path = Path(history) / name
    if not path.is_file():
        return None
    data = json.loads(path.read_text())
    for key in ('created_on', 'last_updated'):
        (data.get('meta') or {}).pop(key, None)
    return data


def group_of(row):
    """Which of the four groups a participation row belongs to."""
    if row['status'] == 'participates':
        return GROUPS[0]
    reason = row.get('reason') or ''
    if (reason.startswith(('no semantics marker', 'semantics version', 'output quantity not stated', 'target not established'))
            or 'not stated by the record' in reason or 'no forecasts' in reason):
        return GROUPS[1]
    if reason.startswith(('output is another quantity', 'names an occurrence its own data already covers')):
        return GROUPS[2]
    return GROUPS[3]


def set_candidate_sources(path, event, sources):
    """Writes candidate_sources into the event's section of a seasonality file (the copy's)."""
    lines, out, inside, done = path.read_text().splitlines(), [], False, False
    for line in lines:
        header = re.match(r'\s*\[(.+?)\]\s*$', line)
        if header:
            inside = header.group(1) == event
            out.append(line)
            if inside:
                out.append('candidate_sources = ' + ', '.join(sources))
                done = True
            continue
        if inside and re.match(r'\s*candidate_sources\s*=', line):
            continue
        out.append(line)
    if not done:
        sys.exit(f"tournament-acceptance: the seasonality file has no event '{event}'")
    path.write_text('\n'.join(out) + '\n')


def number(text):
    try:
        return float(text)
    except (TypeError, ValueError):
        return None


def close(a, b):
    # The selection file prints four decimals: two figures agree when they differ by no more than that rounding.
    return a is not None and b is not None and abs(a - b) <= 5.1e-5


def check_selection(csv_path, pool):
    """Does each selection carry the chosen candidate's own forecast and interval? Counts by outcome,
    and where the chosen candidates came from."""
    tally, chosen, modes = {}, {}, {}

    def count(what):
        tally[what] = tally.get(what, 0) + 1
    with open(csv_path, newline='') as fh:
        rows = list(csv.DictReader(fh))
    if not rows:
        return tally, chosen, modes
    key = next((k for k in ('VM', 'VMName', 'vm') if k in rows[0]), None)
    profiles = sorted(c[:-len('_Model')] for c in rows[0] if c.endswith('_Model'))
    for row in rows:
        candidates_of_vm = pool['pool'].get(row.get(key), {}) if key else {}
        for profile in profiles:
            model, mode = row.get(profile + '_Model'), row.get(profile + '_Mode')
            if not model and not mode:
                continue
            modes[mode] = modes.get(mode, 0) + 1
            chosen[(model, mode)] = chosen.get((model, mode), 0) + 1
            forecast, low, high = (number(row.get(profile + s)) for s in ('_Forecast', '_PI_Lower', '_PI_Upper'))
            stored = candidates_of_vm.get(profile, {})
            if mode == 'no eligible forecast' or not model:
                count('no eligible forecast: nothing reported' if forecast is None and low is None and high is None
                      else 'no eligible forecast: a forecast or an interval is reported all the same')
                continue
            if mode not in ('tournament', 'unopposed'):
                # A median of the candidates: no interval of its own, so none may be reported.
                values = sorted(number(v.get('forecast')) if isinstance(v, dict) else number(v) for v in stored.values())
                live = number(row.get(profile + '_MultiplierForecast'))
                with_live = sorted(values + [live]) if live is not None and 'event_multiplier' not in stored else None
                medians = [statistics.median(v) for v in (values, with_live) if v]
                if low is not None or high is not None:
                    count('bootstrap: an interval is reported although a median has none of its own')
                elif any(close(forecast, m) for m in medians):
                    count('bootstrap: the median of the pool, no interval reported')
                else:
                    count('bootstrap: forecast is not the median of the pool')
                continue
            mine = stored.get(model)
            if mine is None and model == 'event_multiplier':
                # This run's own multiplier forecast, which is reported in the same row.
                mine = {'forecast': number(row.get(profile + '_MultiplierForecast')), 'pi_lower': number(row.get(profile + '_Multiplier_PI_Lower')),
                        'pi_upper': number(row.get(profile + '_Multiplier_PI_Upper'))}
            if mine is None:
                count(mode + ': the chosen model is not in the pool')
                continue
            own = mine if isinstance(mine, dict) else {'forecast': mine}
            own_low, own_high = number(own.get('pi_lower')), number(own.get('pi_upper'))
            if not close(forecast, number(own.get('forecast'))):
                count(mode + ": forecast differs from the chosen candidate's own")
            elif own_low is None or own_high is None:
                count(mode + ': own forecast; the candidate has no interval and none is reported' if low is None and high is None
                      else mode + ': an interval is reported although the chosen candidate has none')
            elif close(low, own_low) and close(high, own_high):
                count(mode + ': own forecast and own interval')
            else:
                count(mode + ": interval differs from the chosen candidate's own")
    return tally, chosen, modes


def ledger_cases(ledger, event):
    """{model: {(LPAR, profile, month): (loss, target class)}} of one event's scores."""
    cases = {}
    for vm, by_profile in ((ledger or {}).get('scores') or {}).items():
        for profile, by_event in by_profile.items():
            models = ((by_event.get(event) or {}).get('models') or {}) if isinstance(by_event, dict) else {}
            for model, entry in models.items():
                for month, scored in (entry.get('monthly_scores') or {}).items():
                    if isinstance(scored, dict) and scored.get('pinball_loss') is not None:
                        cases.setdefault(model, {})[(vm, profile, month)] = (float(scored['pinball_loss']), scored.get('target_class') or 'not recorded')
    return cases


def matched_report(cases, minimum):
    """Lines: outcomes by class, each model by class, each model against the reference on the cases both
    were scored on, and what choosing by the scores known at each origin would have given."""
    lines = []
    if not cases:
        return lines
    outcomes = {}
    for scored in cases.values():
        for key, (_loss, label) in scored.items():
            outcomes[key] = label
    by_class = {}
    for label in outcomes.values():
        by_class[label] = by_class.get(label, 0) + 1
    evaluations = sum(len(v) for v in cases.values())
    lines.append(f"  outcomes scored against: {len(outcomes)} (LPAR, profile, occurrence) - " + ', '.join(f'{n} {c}' for c, n in sorted(by_class.items()))
                 + f"; {evaluations} candidate evaluations of them")
    lines.append(f"  {'model':<28} {'target class':<32} {'cases':>7} {'mean loss':>10}")
    for model in sorted(cases):
        split = {}
        for loss, label in cases[model].values():
            split.setdefault(label, []).append(loss)
        for label in sorted(split):
            lines.append(f"  {model:<28} {label:<32} {len(split[label]):>7} {statistics.fmean(split[label]):>10.4f}")
    reference = 'event_multiplier' if 'event_multiplier' in cases else max(sorted(cases), key=lambda m: len(cases[m]))
    lines.append(f"\n  Against {reference}, on the same LPAR, profile and occurrence (a negative difference: the model's loss is lower)")
    lines.append(f"  {'model':<28} {'target class':<32} {'occurrences':>11} {'cases':>7} {'model':>8} {reference[:10]:>10} {'difference':>10} {'model lower in':>15}")
    for model in sorted(cases):
        if model == reference:
            continue
        shared = sorted(set(cases[model]) & set(cases[reference]))
        for label in ['all'] + sorted({cases[model][k][1] for k in shared}):
            keys = [k for k in shared if label == 'all' or cases[model][k][1] == label]
            if not keys:
                lines.append(f"  {model:<28} {label:<32} {0:>11} {0:>7}   no case in common")
                continue
            mine, theirs = [cases[model][k][0] for k in keys], [cases[reference][k][0] for k in keys]
            lower = sum(1 for a, b in zip(mine, theirs) if a < b)
            lines.append(f"  {model:<28} {label:<32} {len({k[2] for k in keys}):>11} {len(keys):>7} {statistics.fmean(mine):>8.4f} {statistics.fmean(theirs):>10.4f} "
                         f"{statistics.fmean(mine) - statistics.fmean(theirs):>+10.4f} {100.0 * lower / len(keys):>14.0f}%")
    # Selection as it would have gone: at each origin only the scores of earlier origins are known.
    pairs = {}
    for model, scored in cases.items():
        for (vm, profile, month), (loss, _label) in scored.items():
            pairs.setdefault((vm, profile), {}).setdefault(month, {})[model] = loss
    chosen_losses, reference_losses, chosen_names, not_scored = [], [], {}, 0
    for by_month in pairs.values():
        for month in sorted(by_month):
            earlier = {}
            for before in (m for m in by_month if m < month):
                for model, loss in by_month[before].items():
                    earlier.setdefault(model, []).append(loss)
            qualified = {model: statistics.fmean(losses) for model, losses in earlier.items() if len(losses) >= minimum}
            if not qualified:
                continue
            pick = min(sorted(qualified), key=lambda model: qualified[model])
            if pick not in by_month[month] or reference not in by_month[month]:
                not_scored += 1
                continue
            chosen_names[pick] = chosen_names.get(pick, 0) + 1
            chosen_losses.append(by_month[month][pick])
            reference_losses.append(by_month[month][reference])
    lines.append(f"\n  Choosing at each origin by the scores known then (at least {minimum} earlier scored occurrences; lowest mean loss)")
    if chosen_losses:
        lines.append(f"    {len(chosen_losses)} cases: mean loss of the model chosen {statistics.fmean(chosen_losses):.4f}; of {reference} on the same cases "
                     f"{statistics.fmean(reference_losses):.4f}; difference {statistics.fmean(chosen_losses) - statistics.fmean(reference_losses):+.4f}")
        lines.append('    chosen: ' + ', '.join(f'{n} x {m}' for m, n in sorted(chosen_names.items(), key=lambda kv: -kv[1]))
                     + (f'; {not_scored} choices could not be compared (no score for that occurrence)' if not_scored else ''))
    else:
        lines.append('    no case: no model had enough earlier scores at any origin')
    return lines


def proposal_of(output, event):
    """The newest proposal copy nfit-profile wrote for an event into an output folder, or None."""
    found = sorted(Path(output).glob(f'nfit-profile.*.{event}.proposal.*.json'), key=lambda p: p.stat().st_mtime)
    return json.loads(found[-1].read_text(encoding='utf-8')) if found else None


SIZING_GROUPS = ('tournament', 'unopposed', 'bootstrap median', 'source model')


def _published(member, profile):
    """The entitlement a member's row publishes: its role's (VIOS pair) where it has one, else the planning profile's
    current-cycle entitlement."""
    role = member.get('role')
    if isinstance(role, dict) and role.get('entitlement') is not None:
        return float(role['entitlement'])
    cycle = ((member.get('profiles') or {}).get(profile) or {}).get('currentCycle') or {}
    return float(cycle['entitlement']) if cycle.get('entitlement') is not None else None


def sizing_report(adaptive, predictive):
    """Lines comparing the adaptive run's proposal with the source event's, in counts and core sums.
    Each LPAR is read on its planning profile and grouped by where that profile's demand came from."""
    if not adaptive:
        return ['  the adaptive run wrote no proposal']
    context = adaptive.get('context') or {}
    sel = context.get('selection') or {}
    target = sel.get('target') or {}
    lines = [('  selection used: stored in %s, candidates of %s, for the occurrence %s to %s'
              % (sel.get('storedIn'), sel.get('candidatesStoredIn'), target.get('occurrenceStart'), target.get('occurrenceEnd')))
             if sel.get('status') == 'used' else '  selection NOT used: %s' % sel.get('reason')]
    pairs = {}
    for member in (adaptive.get('members') or {}).values():
        for prof in (member.get('profiles') or {}).values():
            ds = prof.get('demandSource') or {}
            key = ('bootstrap median' if ds.get('mode') == 'bootstrap' else ds.get('mode')) if ds.get('source') == 'selection' else 'source model'
            pairs[key] = pairs.get(key, 0) + 1
    modes = sel.get('modes') or {}
    lines.append('  sized pairs from the selection: ' + (', '.join('%d %s' % (n, 'bootstrap median' if m == 'bootstrap' else m)
                                                                 for m, n in sorted(modes.items())) or 'none'))
    lines.append('  proposal profiles by demand source: ' + (', '.join('%d %s' % (pairs[g], g) for g in SIZING_GROUPS if g in pairs) or 'none'))
    for reason, n in sorted((sel.get('withheld') or {}).items(), key=lambda kv: (-kv[1], kv[0])):
        lines.append('    %6d  sized pairs from the source model: %s' % (n, reason))
    groups, moved_profile, roles = {}, 0, [0, 0]
    others = (predictive or {}).get('members') or {}
    for vm, member in (adaptive.get('members') or {}).items():
        planning = member.get('planningProfile')
        prof = (member.get('profiles') or {}).get(planning) or {}
        ds = prof.get('demandSource') or {}
        key = ('bootstrap median' if ds.get('mode') == 'bootstrap' else ds.get('mode')) if ds.get('source') == 'selection' else 'source model'
        row = groups.setdefault(key, {'lpars': 0, 'source': 0.0, 'selected': 0.0, 'ratios': [], 'ent': 0.0, 'other': 0.0, 'up': 0, 'down': 0, 'compared': 0})
        row['lpars'] += 1
        source = ds.get('sourceModelDemand') if ds.get('source') == 'selection' else ds.get('demand')
        demand = ds.get('demand')
        if source is not None and demand is not None:
            row['source'] += float(source)
            row['selected'] += float(demand)
            if float(source) > 0:
                row['ratios'].append(float(demand) / float(source))
        other = others.get(vm)
        mine = _published(member, planning)
        if other is not None:
            moved_profile += other.get('planningProfile') != planning
            roles[0] += isinstance(member.get('role'), dict)
            roles[1] += isinstance(other.get('role'), dict)
            theirs = _published(other, other.get('planningProfile'))
            if mine is not None and theirs is not None:
                row['compared'] += 1
                row['ent'] += mine
                row['other'] += theirs
                row['up'] += mine > theirs + 0.005
                row['down'] += mine < theirs - 0.005
    lines.append('  LPARs on their planning profile, by where its demand came from (cores):')
    lines.append('    %-18s %6s %12s %12s %10s %14s %14s %6s %6s' % ('demand source', 'LPARs', 'source model', 'selected', 'median x',
                                                                     'published', 'source event', 'up', 'down'))
    for key in SIZING_GROUPS:
        row = groups.get(key)
        if not row:
            continue
        ratio = '%.3f' % statistics.median(row['ratios']) if row['ratios'] else '-'
        row['spread'] = (statistics.quantiles(row['ratios'], n=4, method='inclusive') if len(row['ratios']) >= 2 else None, sum(abs(r - 1) < 0.0005 for r in row['ratios']))
        lines.append('    %-18s %6d %12.2f %12.2f %10s %14.2f %14.2f %6d %6d' % (key, row['lpars'], row['source'], row['selected'], ratio,
                                                                            row['ent'], row['other'], row['up'], row['down']))
    for key in SIZING_GROUPS:
        row = groups.get(key)
        if row and row.get('spread') and row['spread'][0]:
            quartiles, equal = row['spread']
            lines.append('    %-18s selected / source model: quartiles %.3f, %.3f, %.3f; equal within 0.05%%: %d of %d'
                         % (key, quartiles[0], quartiles[1], quartiles[2], equal, len(row['ratios'])))
    if predictive is None:
        lines.append('  (no proposal of the source event to compare with)')
    else:
        lines.append('  LPARs on another planning profile than in the source event run: %d' % moved_profile)
        lines.append('  VIOS roles: %d in this run, %d in the source event run' % tuple(roles))
    lines.append('  not assessed by either run: ' + ', '.join(context.get('notAssessed') or ['(not stated)']))
    return lines


def capacity_plan_report(adaptive):
    """Lines summarising the adaptive run's Seasonal Capacity Plan from its proposal, in counts and cores (no LPAR names),
    with the plan's own rules checked on every member: nothing below installed, a valid pair, an increase never without
    its unresolved dependencies."""
    plan = ((adaptive or {}).get('context') or {}).get('capacityPlan')
    if not isinstance(plan, dict):
        return ['  the adaptive run wrote no capacity plan']
    if not plan.get('produced'):
        return ['  not produced: %s' % plan.get('reason')]
    occurrence = plan.get('occurrence') or {}
    lines = ['  occurrence %s to %s; required by %s (%s)' % (occurrence.get('start'), occurrence.get('end'), plan.get('requiredBy'), plan.get('timeBasis'))]
    actions, unresolved, limits = {}, {}, {}
    add = {'ent': 0.0, 'workload': 0.0, 'platform': 0.0, 'vp': 0, 'workloadVP': 0, 'widthVP': 0}
    below, invalid, hidden, combined, steps = 0, 0, 0, 0, 0
    totals = {'installed': 0.0, 'event': 0.0, 'plan': 0.0, 'installedVP': 0, 'planVP': 0}
    review = [0, 0]          # increases whose added VPs this run's current-cycle pair holds for review: LPARs, VPs
    members = (adaptive.get('members') or {}).values()
    for member in members:
        cp = member.get('capacityPlan') or {}
        if not cp:
            continue
        actions[cp.get('action')] = actions.get(cp.get('action'), 0) + 1
        for kind in cp.get('unresolved') or []:
            unresolved[kind] = unresolved.get(kind, 0) + 1
        combined += bool(cp.get('combinedEvents'))
        installed, planned, extra = cp.get('installed') or {}, cp.get('plan'), cp.get('additional') or {}
        if planned:
            ent, vps = float(planned['entitlement']), int(planned['VPs'])
            totals['installed'] += float(installed.get('entitlement') or 0)
            totals['installedVP'] += int(installed.get('VPs') or 0)
            totals['event'] += float((cp.get('eventRequirement') or {}).get('entitlement') or 0)
            totals['plan'] += ent
            totals['planVP'] += vps
            below += (ent < float(installed.get('entitlement') or 0) - 0.005) or (vps < int(installed.get('VPs') or 0))
            invalid += not (0.05 * vps - 0.005 <= ent <= vps + 0.005)
        if cp.get('action') == 'increase':
            add['ent'] += float(extra.get('entitlement') or 0)
            add['workload'] += float(extra.get('workloadEntitlement') or 0)
            add['platform'] += float(extra.get('platformMinimumEntitlement') or 0)
            add['vp'] += int(extra.get('VPs') or 0)
            add['workloadVP'] += int(extra.get('workloadVPs') or 0)
            add['widthVP'] += int(extra.get('widthVPs') or 0)
            # VPs the plan adds that this run's own current-cycle pair returns as a review (run-queue or peak evidence only).
            cycle = (((member.get('profiles') or {}).get(member.get('planningProfile')) or {}).get('currentCycle') or {})
            if int(extra.get('workloadVPs') or 0) > 0 and cycle.get('reviewVPs') is not None and not isinstance(member.get('role'), dict):
                review[0] += 1
                review[1] += int(extra.get('workloadVPs') or 0)
            # A dependency the member carries must stay beside its increase.
            hidden += bool((cp.get('overlaps') and not any(o.get('combined') for o in cp['overlaps']) and 'overlap' not in (cp.get('unresolved') or []))
                           or (cp.get('roleLimitation') and 'PowerHA role' not in (cp.get('unresolved') or [])))
        if cp.get('step'):
            steps += 1
            for limit in str(cp['step'].get('limit') or 'staging').split('; '):
                limit = re.sub(r' \([0-9.]+\)$', '', limit)
                limits[limit] = limits.get(limit, 0) + 1
    lines.append('  LPARs: %d (%s)' % (sum(actions.values()), ', '.join('%s %d' % (k, actions[k]) for k in ('increase', 'retain', 'not sized') if k in actions)))
    lines.append('  totals: installed %.2f ENT / %d VPs; event requirement %.2f ENT; planned %.2f ENT / %d VPs'
                 % (totals['installed'], totals['installedVP'], totals['event'], totals['plan'], totals['planVP']))
    lines.append('  additional: +%.2f ENT (workload +%.2f, PowerVM minimum +%.2f), +%d VPs (workload +%d, to carry the entitlement +%d)'
                 % (add['ent'], add['workload'], add['platform'], add['vp'], add['workloadVP'], add['widthVP']))
    lines.append('  checks: plan below installed %d; pair outside 0.05 to 1.00 per VP %d; increase without its dependency %d' % (below, invalid, hidden))
    lines.append("  this cycle's pair stops short of the plan: %d LPARs%s" % (steps, (' (' + ', '.join('%s %d' % kv for kv in sorted(limits.items())) + ')') if limits else ''))
    lines.append("  added VPs this run's current-cycle pair holds for review (run-queue or peak evidence only): %d LPARs, +%d VPs" % tuple(review))
    for pool in plan.get('pools') or []:
        lines.append('  pool %s: %s; planned %.2f, relied on %.2f, maximum %s%s' % (
            pool.get('pool'), pool.get('verdict'), pool.get('planned') or 0, pool.get('reliedOn') or 0, pool.get('maximum'),
            (' -> at least %s' % pool['requiredMaximum']) if pool.get('requiredMaximum') else ''))
    overlaps = plan.get('overlaps') or []
    lines.append('  overlaps: %s; LPARs whose forecast combined one: %d' % ((', '.join('%s %s to %s' % (o.get('event'), o.get('overlapStart'), o.get('overlapEnd'))
                                                                                  for o in overlaps) or 'none'), combined))
    lines.append('  alternatives (same days): ' + (', '.join(plan.get('alternatives') or []) or 'none'))
    lines.append('  unresolved: ' + (', '.join('%s %d' % kv for kv in sorted(unresolved.items())) or 'none'))
    normal = plan.get('normalPlan') or {}
    conflicts = sum(1 for m in members if (m.get('capacityPlan') or {}).get('normalPlanConflict'))
    lines.append('  normal plan (%s): %s%s' % (normal.get('model'), normal.get('status'),
                                            ('; conflicts %d' % conflicts) if normal.get('status') == 'matching' else (' (%s)' % normal['reason'] if normal.get('reason') else '')))
    return lines


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--event', help='the tournament event (an adaptive_peak event)')
    ap.add_argument('--work', default=str(REPO / '.private' / 'history-check-prod'), help='the work tree kept by dev/history-integration-check --keep')
    ap.add_argument('--seasonality', default=str(REPO / 'etc' / 'nfit.seasonality.cfg'), help='the seasonality file to use')
    ap.add_argument('--candidate-sources', help="events whose nfit-profile records may compete (comma-separated; default: the event's "
                                                'candidate_sources in the seasonality file, else its source event alone)')
    ap.add_argument('--scope', default='all', choices=('all', 'latest'), help='which history months the seasonal runs fill (default: all)')
    ap.add_argument('--no-seasonal-run', action='store_true', help='use the records history already holds')
    ap.add_argument('--no-sizing', action='store_true', help='leave out the sizing from the selection (section 5)')
    ap.add_argument('--keep', action='store_true', help='keep the working copy')
    a = ap.parse_args()

    work = Path(a.work).resolve()
    stage = next(iter(sorted((work / 'case' / 'stage').glob('*'))), None) if (work / 'case' / 'stage').is_dir() else None
    if stage is None or not (work / 'case' / 'history' / stage.name).is_dir():
        sys.exit('tournament-acceptance: no kept work tree with history (run dev/history-integration-check --keep first)')
    if not FORECAST.is_file():
        sys.exit('tournament-acceptance: nfit-forecast not found beside this repository (set NFIT_FORECAST)')
    seasonality = Path(a.seasonality).resolve()
    settings = configparser.ConfigParser(interpolation=None, strict=False)
    settings.read(seasonality, encoding='utf-8')
    if not a.event or not settings.has_section(a.event) or settings.get(a.event, 'model', fallback='') != 'adaptive_peak':
        print('Give --event, an adaptive_peak event of the seasonality file:')
        for name in settings.sections():
            print(f"  {name:<28} {settings.get(name, 'model', fallback='')}")
        return 2
    source = settings.get(a.event, 'source_event', fallback=a.event)
    listed = a.candidate_sources or settings.get(a.event, 'candidate_sources', fallback='')
    sources = [source] + [s.strip() for s in listed.split(',') if s.strip() and s.strip() != source]
    missing = [s for s in sources if not settings.has_section(s)]
    if missing:
        sys.exit('tournament-acceptance: not in the seasonality file: ' + ', '.join(missing))

    source_text = FORECAST.read_text(encoding='utf-8')
    if 'def tournament_live_pool(' not in source_text:
        sys.exit('tournament-acceptance: this nfit-forecast has no profile-requirement tournament')
    T = block(source_text)

    kept = {name: fingerprint(work / 'case' / name) for name in ('history', 'history.pristine')}
    copy = work.parent / (work.name + '.tournament-acceptance')
    if copy.exists():
        sys.exit(f'tournament-acceptance: a working copy is already there ({copy.name} beside the work tree); remove it first')
    copy.mkdir()
    status = 1
    try:
        how = {clone(work / name, copy / name) for name in ('app', 'case')}
        app, case = copy / 'app', copy / 'case'
        stage = case / 'stage' / stage.name
        history = case / 'history' / stage.name
        pristine = case / 'history.pristine' / stage.name
        if pristine.is_dir():                                  # the fixed history the comparisons read is the starting point
            shutil.rmtree(history)
            shutil.copytree(pristine, history)
        for name in pr.EXECUTABLES:
            shutil.copy(REPO / name, app / name)
            (app / name).chmod(0o700)
        shutil.copy(FORECAST, app / 'nfit-forecast')
        (app / 'etc').mkdir(exist_ok=True)
        shutil.copy(seasonality, app / 'etc' / 'nfit.seasonality.cfg')
        set_candidate_sources(app / 'etc' / 'nfit.seasonality.cfg', a.event, sources[1:]) if len(sources) > 1 else None
        (app / 'output').mkdir(exist_ok=True)
        print(f"Working copy: a {' / '.join(sorted(how))} of the kept tree; the kept tree is not written to.")
        print(f"Event {a.event}: observed occurrences of '{source}'; nfit-profile records of {', '.join(sources)}.\n")

        # 1. the seasonal records
        env = pr.perl_env()
        if not a.no_seasonal_run:
            for name in sources:
                args = ['--nmondir', str(stage), '--apply-seasonality', name, '--seasonal-scope', a.scope]
                if (app / 'config.csv').is_file() and (app / 'config.csv').stat().st_size:
                    args += ['--config', str(app / 'config.csv')]
                print(f"Storing the records of '{name}' ({settings.get(name, 'model', fallback='?')}, scope {a.scope}) ...", flush=True)
                try:
                    pr.invoke(app, case, 'tournament-acceptance-' + name, args, env)
                except RuntimeError as failure:
                    a.keep = True
                    sys.exit(f'tournament-acceptance: {failure}. The working copy is kept for its log.')

        # 2. the tournament, and 3. the rebuild from nothing
        def forecast(label, *extra):
            with (case / f'tournament-acceptance-{label}.private.log').open('w') as log:
                proc = subprocess.run([sys.executable, '-W', 'ignore', str(app / 'nfit-forecast'), '--nmondir', str(stage),
                                       '--seasonal-event', a.event, '--tournament'] + list(extra), cwd=str(app),
                                      env=dict(os.environ, PYTHONWARNINGS='ignore'), stdout=log, stderr=subprocess.STDOUT)
            if proc.returncode:
                a.keep = True
                sys.exit(f'tournament-acceptance: the nfit-forecast run ({label}) exited {proc.returncode}. The working copy is kept for its log.')

        ledger_name = T['TOURNAMENT_LEDGER_FILE']
        print('Running the tournament (backfill, scoring, selection) ...', flush=True)
        forecast('first')
        first = ledger_of(history, ledger_name)
        made = sorted((app / 'output').glob(f'nfit-forecast.*.{a.event}.*.csv'), key=lambda p: p.stat().st_mtime)
        selection_csv = made[-1] if made else None
        print('Rebuilding the ledger from nothing ...\n', flush=True)
        (history / ledger_name).unlink(missing_ok=True)
        forecast('rebuild', '--force-rescore')
        rebuilt = ledger_of(history, ledger_name)

        # ---- the report -----------------------------------------------------------------
        months = months_of(history)
        print('What history holds')
        print(f"  {'month':<9} {'occurrence results':<19} " + ' '.join(f'{s[:24]:<24}' for s in sources) + ' nfit-forecast candidates')
        for month in sorted(months):
            snaps = months[month].get('SeasonalEventSnapshots') or {}
            cells = []
            for name in sources:
                records = (snaps.get(name) or {}).get('ModelForecasts') or {}
                cells.append(', '.join(sorted(k for k in records if not k.startswith('_'))) or '-')
            observed = 'yes' if isinstance((snaps.get(source) or {}).get('results'), dict) and snaps[source]['results'] else '-'
            candidates = ((snaps.get(a.event) or {}).get('AdaptiveForecast') or {}).get('candidates') or {}
            print(f"  {month:<9} {observed:<19} " + ' '.join(f'{c[:24]:<24}' for c in cells) + f' {len(candidates)} models')

        tables = T['tournament_participation_tables'](sorted(months.items()), a.event, source, sources)
        print('\nParticipation in scoring, month by month')
        totals = {}
        for t in tables:
            target = t.get('target')
            where = (f"occurrence {target['occurrenceStart'] or '?'} to {target['occurrenceEnd']}"
                     + ('' if target['observationsUsable'] else ' (results not verified)')) if target else 'no later occurrence stored'
            print(f"  {t['forecastMonth']} (data ends {(t.get('origin') or {}).get('dataEnds') or 'not stated'}), scored against {where}")
            grouped = {}
            for name, row in sorted(t['models'].items()):
                grouped.setdefault(group_of(row), []).append((name, row))
                key = (name, row.get('sourceEvent') or '')
                tally = totals.setdefault(key, {'months': 0, 'pairs': 0, 'groups': {}})
                tally['groups'][group_of(row)] = tally['groups'].get(group_of(row), 0) + 1
                if row['status'] == 'participates':
                    tally['months'] += 1
                    tally['pairs'] += row['pairs']
            for group in GROUPS:
                for name, row in grouped.get(group, []):
                    print(f"    {group:<42} {name:<28} {(row.get('sourceEvent') or ''):<24} {row['pairs']:>5} pairs  {row['reason'] or ''}")
        if not tables:
            print('  (no month stores a candidate)')

        print('\n1. Eligible forecasts (admitted to scoring)')
        print(f"  {'model':<28} {'stored under':<24} {'months':>6} {'forecasts':>10}   months in each group")
        for (name, stored_under), tally in sorted(totals.items()):
            spread = '; '.join(f'{n} x {g}' for g, n in sorted(tally['groups'].items(), key=lambda kv: GROUPS.index(kv[0])))
            print(f"  {name:<28} {stored_under:<24} {tally['months']:>6} {tally['pairs']:>10}   {spread}")

        print('\n2. Scored candidates (the ledger of this run)')
        scored, qualified, pairs_seen, classes = {}, {}, set(), {}
        minimum = T['ScoreLedger'].DEFAULT_MIN_OBSERVATIONS if 'ScoreLedger' in T else 5
        for vm, by_profile in ((first or {}).get('scores') or {}).items():
            for profile, by_event in by_profile.items():
                models = ((by_event.get(a.event) or {}).get('models') or {}) if isinstance(by_event, dict) else {}
                for model, entry in models.items():
                    pairs_seen.add((vm, profile))
                    row = scored.setdefault(model, {'pairs': 0, 'observations': 0, 'loss': 0.0})
                    row['pairs'] += 1
                    row['observations'] += int(entry.get('observations') or 0)
                    row['loss'] += float(entry.get('pinball_loss_sum') or 0.0)
                    if int(entry.get('observations') or 0) >= minimum:
                        qualified[model] = qualified.get(model, 0) + 1
                    for month_entry in (entry.get('monthly_scores') or {}).values():
                        label = month_entry.get('target_class') or 'not recorded'
                        classes[label] = classes.get(label, 0) + 1
        if first is None:
            print('  (no ledger was written)')
        else:
            meta = first.get('meta') or {}
            print(f"  ledger {ledger_name}: {meta.get('semantics')}, quantity {meta.get('quantity')}; {len(pairs_seen)} LPAR-profile pairs")
            print(f"  {'model':<28} {'pairs':>6} {'observations':>13} {'mean pinball loss':>18}")
            for model, row in sorted(scored.items()):
                mean = row['loss'] / row['observations'] if row['observations'] else float('nan')
                print(f"  {model:<28} {row['pairs']:>6} {row['observations']:>13} {mean:>18.4f}")
            if classes:
                print('  targets scored against: ' + ', '.join(f'{n} {c}' for c, n in sorted(classes.items())))

        print(f'\n3. Tournament-qualified models (at least {minimum} scored occurrences for a pair)')
        if qualified:
            for model, n in sorted(qualified.items()):
                print(f"  {model:<28} qualified for {n} of {scored[model]['pairs']} pairs")
        else:
            print('  none: every selection falls back to the median of the pool (bootstrap)')

        print('\n4. Matched comparison (the same LPAR, profile and occurrence)')
        report = matched_report(ledger_cases(first, a.event), minimum)
        print('\n'.join(report) if report else '  (nothing scored)')

        print('\nLedger rebuilt from nothing: ' + ('identical' if first is not None and first == rebuilt else
                                                    'no ledger to compare' if first is None and rebuilt is None else 'DIFFERENT'))

        # The pool as nfit-forecast forms it: only candidates made on this run's definitions.
        excluded = settings.get(source, 'exclude_dates', fallback='') if settings.has_section(source) else ''
        definitions = {'profileDefinitions': T['profile_definitions_fingerprint'](str(app / 'etc' / 'nfit.profiles.cfg')),
                       'exclusions': T['exclusion_definitions_fingerprint']({'exclude_dates': excluded})}
        pool = T['tournament_live_pool'](months, a.event, source, sources, definitions)
        print('\nSelection for the occurrence ahead')
        print('  ' + T['format_tournament_live_pool'](pool).replace('\n', '\n  ').rstrip())
        if selection_csv is None:
            print('  (the run wrote no selection file)')
        else:
            tally, chosen, modes = check_selection(selection_csv, pool)
            print('  selections: ' + (', '.join(f'{n} {m or "no mode"}' for m, n in sorted(modes.items(), key=lambda kv: str(kv[0]))) or 'none'))
            for (model, mode), n in sorted(chosen.items(), key=lambda kv: (str(kv[0][1]), kv[0][0])):
                row = pool['models'].get(model)
                came = (f"stored under {row['sourceEvent']} in {pool['forecastMonth']}, data ends {row['origin']}" if row and row['status'] == 'participates'
                        else "this run's own multiplier forecast" if model == 'event_multiplier' else 'the median of the pool' if model == 'ensemble_median'
                        else 'no candidate in the pool for the pair' if not model else 'not in the pool')
                print(f"    {n:>5} x {(model or '(none)'):<26} ({mode}): {came}")
            print("  does each selection carry the chosen candidate's own forecast and interval?")
            for what, n in sorted(tally.items()):
                print(f"    {n:>5} x {what}")

        sizing_ok = True
        if not a.no_sizing:
            # 5. The adaptive event through nfit-profile's sizing chain, against its source event's latest bucket.
            print(f"\n5. Sizing from the selection ('{a.event}' through '{source}', latest bucket)")
            config = ['--config', str(app / 'config.csv')] if (app / 'config.csv').is_file() and (app / 'config.csv').stat().st_size else []
            held = fingerprint(history)
            try:
                print('  Running the adaptive event ...', flush=True)
                pr.invoke(app, case, 'tournament-acceptance-adaptive', ['--nmondir', str(stage), '--apply-seasonality', a.event] + config, env)
                unchanged = fingerprint(history) == held
                adaptive = proposal_of(app / 'output', a.event)
                print('  Running the source event on its latest bucket ...', flush=True)
                pr.invoke(app, case, 'tournament-acceptance-source-latest',
                          ['--nmondir', str(stage), '--apply-seasonality', source, '--seasonal-scope', 'latest', '--force'] + config, env)
            except RuntimeError as failure:
                a.keep = True
                sys.exit(f'tournament-acceptance: {failure}. The working copy is kept for its log.')
            predictive = proposal_of(app / 'output', source)
            print('\n'.join(sizing_report(adaptive, predictive)))
            print('  history after the adaptive run: ' + ('unchanged' if unchanged else 'CHANGED (it should not have)'))
            print('\n6. Seasonal Capacity Plan of the adaptive run (counts and cores; no LPAR names)')
            print('\n'.join(capacity_plan_report(adaptive)))
            sizing_ok = unchanged and adaptive is not None

        after = {name: fingerprint(work / 'case' / name) for name in kept}
        print('\nKept tree: ' + ('history as it was found' if after == kept else 'HISTORY CHANGED (it should not have)'))
        status = 0 if after == kept and (first == rebuilt) and sizing_ok else 1
    finally:
        if a.keep:
            print(f'Working copy kept: {copy.name} (beside the work tree).')
        else:
            shutil.rmtree(copy, ignore_errors=True)
    return status


if __name__ == '__main__':
    sys.exit(main())

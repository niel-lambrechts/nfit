#!/usr/bin/env python3
# ==============================================================================
# NAME     : golden
# AUTHOR   : Niël Lambrechts (https://github.com/niel-lambrechts)
# PURPOSE  : Regression baseline ("golden master") harness for nFit.
#
#            capture : run nfit-profile (and through it the nfit engine) for each
#                      selected staged system and run profile, in an isolated
#                      scratch tree, and store canonicalised outputs plus a frozen
#                      copy of the executables and configuration that produced
#                      them.
#            compare : re-run the same systems and profiles with the current
#                      source tree against the same staged data and report every
#                      difference from the stored baseline.
#            list    : show stored baselines.
#
# ISOLATION: Staged data is never written. Each run uses a scratch tree:
#              <scratch>/nfit, nfit-profile, etc/nfit.* (copies; connection
#                                                   files such as influxdb.conf
#                                                   are never copied)
#              <scratch>/stage/<serial>/           (symlinks to the real
#                                                   .nfit.cache.data/.states/
#                                                   .manifest/.nfit_stage_id)
#              <scratch>/output/, history/         (empty; outputs land here)
#            so the L2 results cache, cache index, engine debug files, CSV and
#            rationale outputs and any history lookups stay inside the scratch
#            tree. History-dependent paths (--update-history, seasonal) are out
#            of scope for this version.
#
# DETERMINISM: --enddate is pinned at capture (default: last complete month end
#            of the staged data's capture date) and recorded; decay runs also
#            pin --analysis-reference-date. Each run executes twice in the same
#            scratch tree (uncached, then L2-cached); both must agree.
#            Only these declared volatile tokens are normalised:
#              - "Date/Time Generated : <timestamp>"
#              - "completed at: <timestamp>"
#              - "Total execution time: <n>s"
#              - the scratch-tree path
#            Numerical content is never normalised.
#
# PRIVACY  : All output is piped through dev/nfit-redact (fail-closed). Stored
#            baselines live under .private/golden/<name>/ (gitignored).
#
# USAGE    : dev/golden capture <name> [--stage-dir DIR] [--systems all|S1,S2]
#                                      [--runs forensic,decay-states,windowed]
#                                      [--enddate YYYY-MM-DD]
#            dev/golden compare <name> [--stage-dir DIR] [--frozen]
#                                      [--systems S1,S2] [--runs R1,R2] [--single]
#            --systems/--runs restrict a compare to a subset of the baseline;
#            --single skips the cached repeat (roughly halves the runtime);
#            --classify sorts each difference into intended and unintended:
#            CSV cells other than VM_Comments, VM_Comments beyond the leading
#            [POOL_SHORTFALL]/[VP_MISMATCH] alerts, and rationale lines outside
#            the sections named in INTENDED_SECTIONS are unintended. A change
#            to the v10 planner layout (LAYOUT_RETIRED/LAYOUT_ADDED) is compared
#            by column name; NFIT - ENT and the current-cycle VP cells are
#            counted and listed separately for review.
#            dev/golden list
#            dev/golden determinism [--stage-dir DIR] --systems S [--runs R]
#                                   [--enddate YYYY-MM-DD]
#            Systems may be given by real name or by the sys_xxxxxx pseudonym
#            that the redacted output shows.
#
# REQUIRES : Python 3.8+ (standard library only), perl with JSON (or the
#            .claude/perl5 development shims, used automatically when present).
# ==============================================================================

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
GOLDEN_ROOT = REPO / '.private' / 'golden'
STAGE_FILES = ('.nfit.cache.data', '.nfit.cache.states', '.nfit.cache.manifest', '.nfit_stage_id')
EXECUTABLES = ('nfit', 'nfit-profile')

# Run definitions mirror scripts/run-nfit-staged-batch.sh, minus the legacy
# display-only --config and with the end-date clamp replaced by a pinned date.
RUNS = {
    'forensic':     ['--runq-perc-behavior=match'],
    'decay-states': ['--runq-perc-behavior=match', '--decay-over-states'],
    'windowed':     ['--runq-perc-behavior=match', '--enable-windowed-decay'],
}
DECAY_RUNS = {'decay-states', 'windowed'}

VOLATILE = [
    (re.compile(r'(Date/Time Generated\s*:\s*).*'), r'\1<TIMESTAMP>'),
    (re.compile(r'(completed at:\s*).*'), r'\1<TIMESTAMP>'),
    (re.compile(r'(Total execution time:\s*)[0-9.]+s'), r'\1<DURATION>'),
]


# ------------------------------------------------------------------------------
# Output through the privacy filter
# ------------------------------------------------------------------------------
class RedactedOut:
    """All harness output goes through dev/nfit-redact; fail-closed."""

    def __init__(self, data_root: Path = None):
        cmd = [str(REPO / 'dev' / 'nfit-redact'),
               '--secret-file', str(REPO / '.private' / 'redact.secret')]
        if data_root is not None:
            cmd += ['--extra-root', str(data_root)]
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, text=True, encoding='utf-8')

    def say(self, msg=''):
        self.proc.stdin.write(msg + '\n')

    def close(self):
        self.proc.stdin.close()
        rc = self.proc.wait()
        if rc == 2:
            sys.stderr.write('golden: privacy filter refused output (empty vocabulary). '
                             'Is the data root reachable?\n')
        return rc


# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------
def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open('rb') as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def git_identity(src: Path) -> dict:
    def run(*cmd):
        r = subprocess.run(['git', '-C', str(src)] + list(cmd), capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None
    status = run('status', '--porcelain', '--', *EXECUTABLES) or ''
    return {'commit': run('rev-parse', 'HEAD'), 'executables_dirty': bool(status)}


def data_identity(sysdir: Path) -> dict:
    ident = {}
    for name in ('.nfit.cache.data', '.nfit.cache.states'):
        p = sysdir / name
        st = p.stat()
        ident[name] = {'size': st.st_size, 'mtime_ns': st.st_mtime_ns}
    return ident


def pseudonym(term: str):
    """sys_xxxxxx pseudonym exactly as dev/nfit-redact computes it, or None."""
    import hmac
    secret_file = REPO / '.private' / 'redact.secret'
    if not secret_file.is_file():
        return None
    secret = secret_file.read_text(encoding='utf-8').strip().encode('utf-8')
    return 'sys_' + hmac.new(secret, term.lower().encode('utf-8'), hashlib.sha256).hexdigest()[:6]


def stderr_tail(text: str, lines: int = 8) -> list:
    parts = [p.strip() for p in re.split(r'[\r\n]+', text or '') if p.strip()]
    return parts[-lines:]


def ascii_only(text: str) -> str:
    return re.sub(r'[^\x00-\x7f]', '', text or '')


def report_difference(out, label_a: str, a: dict, label_b: str, b: dict, limit: int = 12) -> None:
    for kind in sorted(set(a) | set(b)):
        if a.get(kind) != b.get(kind):
            la, lb = (a.get(kind) or '').splitlines(), (b.get(kind) or '').splitlines()
            changed = sum(1 for x, y in zip(la, lb) if x != y) + abs(len(la) - len(lb))
            note = ('; ASCII content identical, so the difference is confined to non-ASCII characters (text encoding)'
                    if ascii_only(a.get(kind)) == ascii_only(b.get(kind)) else '; differs beyond non-ASCII characters')
            out.say(f'      {kind}: {label_a} vs {label_b} differ in {changed} line(s){note}')
            for line in diff_lines(a.get(kind, ''), b.get(kind, ''), limit, label_a, label_b):
                out.say('        ' + line)


def report_failure(out, res: dict) -> None:
    for line in stderr_tail(res.get('stderr_tail', '')):
        out.say('      stderr: ' + line)
    if 'cached' in res:
        report_difference(out, 'uncached', res['outputs'], 'cached', res['cached'])


def discover_systems(stage_dir: Path, selector: str) -> list:
    found = sorted(p.name for p in stage_dir.iterdir()
                   if p.is_dir() and (p / '.nfit.cache.data').is_file()
                   and (p / '.nfit.cache.states').is_file())
    if selector in (None, '', 'all'):
        return found
    by_alias = {pseudonym(f): f for f in found}
    wanted = [by_alias.get(s.strip(), s.strip()) for s in selector.split(',') if s.strip()]
    missing = [s for s in wanted if s not in found]
    if missing:
        raise LookupError(','.join(missing))
    return wanted


def last_complete_month_end(today: dt.date) -> dt.date:
    return today.replace(day=1) - dt.timedelta(days=1)


def perl_env() -> dict:
    env = dict(os.environ)
    shim = REPO / '.claude' / 'perl5'
    probe = subprocess.run(['perl', '-MJSON', '-e1'], capture_output=True)
    if probe.returncode != 0 and shim.is_dir():
        env['PERL5LIB'] = str(shim) + (os.pathsep + env['PERL5LIB'] if env.get('PERL5LIB') else '')
    return env


def copy_nfit_config(src: Path, dst: Path) -> None:
    """Copy only nFit configuration files (nfit.*). Connection files such as
    influxdb.conf are never copied into scratch trees or frozen baselines."""
    dst.mkdir(parents=True, exist_ok=True)
    for f in sorted(src.iterdir()):
        if f.is_file() and f.name.startswith('nfit.'):
            shutil.copy2(f, dst / f.name)


def build_tree(scratch: Path, exe_src: Path, etc_src: Path, sysdir: Path) -> Path:
    """Create an isolated scratch tree; returns the scratch system directory."""
    for exe in EXECUTABLES:
        shutil.copy2(exe_src / exe, scratch / exe)
    copy_nfit_config(etc_src, scratch / 'etc')
    (scratch / 'output').mkdir()
    (scratch / 'history').mkdir()
    sdir = scratch / 'stage' / sysdir.name
    sdir.mkdir(parents=True)
    for name in STAGE_FILES:
        if (sysdir / name).exists():
            os.symlink(sysdir.resolve() / name, sdir / name)
    return sdir


def canonical_text(text: str, scratch: Path) -> str:
    text = text.replace(str(scratch), '<TREE>')
    out = []
    for line in text.splitlines(keepends=True):
        for rx, repl in VOLATILE:
            line = rx.sub(repl, line)
        out.append(line)
    return ''.join(out)


def run_profile(scratch: Path, sdir: Path, run: str, enddate: str, env: dict):
    args = [str(scratch / 'nfit-profile')] + RUNS[run] + ['--enddate', enddate, '--nmondir', str(sdir)]
    if run in DECAY_RUNS:
        args += ['--analysis-reference-date', enddate]
    r = subprocess.run(args, cwd=str(scratch), env=env, capture_output=True, text=True)
    outputs = sorted((scratch / 'output').glob('*'))
    collected = {}
    for p in outputs:
        kind = 'csv' if p.suffix == '.csv' else ('log' if p.suffix == '.log' else p.suffix.lstrip('.'))
        collected[kind] = canonical_text(p.read_text(encoding='utf-8', errors='replace'), scratch)
        p.unlink()
    return r.returncode, r.stderr, collected


def check_proposals(sdir, run, baseline_csv):
    """Compare the delivered L2 values with the saved planner CSV, before scratch cleanup."""
    import csv
    import io
    import math
    models = {'forensic': 'state-based', 'decay-states': 'hybrid-state-decay', 'windowed': 'windowed-decay'}
    files = list((sdir / '.nfit.store/proposals/v1' / models[run]).glob('*.json'))
    if len(files) != 1:
        return 'expected one proposal snapshot'
    snapshot = json.loads(files[0].read_bytes())
    if snapshot['model'] != models[run] or snapshot['system'] != sdir.name:
        return 'proposal source mismatch'
    reader = csv.reader(io.StringIO(baseline_csv))
    header = next(reader)
    if any(c.endswith('_rENT_Tactical') for c in header):
        # v10 layout: the target entitlement and the current-cycle pair.
        fields = {'': lambda p: p['entitlement'],
                  '_rENT_Tactical': lambda p: (p.get('currentCycle') or {}).get('entitlement'),
                  '_rVCPU_Tactical': lambda p: (p.get('currentCycle') or {}).get('VPs')}
    else:
        fields = {'': lambda p: p['entitlement'], '_rVCPU': lambda p: p['recommendedVPs'],
                  '_rVCPU_EntBounded': lambda p: p['entitlementBoundedVPs'],
                  '_rVCPU_Tactical': lambda p: p['tacticalVPs']}
    profiles = {c[:-len('_rVCPU_Tactical')] for c in header if c.endswith('_rVCPU_Tactical')}
    members = snapshot['members']
    seen = set()
    for record in reader:
        if not record:  # spreadsheet footer starts after the first blank line
            break
        row = dict(zip(header, record))
        vm = row['VM']
        if vm in seen or vm not in members or set(members[vm]['profiles']) != profiles:
            return 'proposal member or profile set mismatch'
        seen.add(vm)
        for name in profiles:
            for suffix, stored in fields.items():
                try:
                    value = float(row[name + suffix])
                    value = value if math.isfinite(value) else None
                except ValueError:
                    value = None
                if stored(members[vm]['profiles'][name]) != value:
                    return 'proposal value differs from baseline CSV'
    if not profiles or not seen or seen != set(members):
        return 'incomplete proposal snapshot'
    return None


def execute(system: str, sysdir: Path, run: str, enddate: str, exe_src: Path, etc_src: Path, env: dict,
            repeat: bool = True, proposal_csv=None):
    """Run uncached then cached in one scratch tree; return canonical outputs."""
    with tempfile.TemporaryDirectory(prefix='nfit-golden-') as tmp:
        scratch = Path(tmp)
        sdir = build_tree(scratch, exe_src, etc_src, sysdir)
        rc1, err1, first = run_profile(scratch, sdir, run, enddate, env)
        if rc1 != 0:
            return {'error': f'uncached run failed rc={rc1}', 'stderr_tail': err1[-4000:]}
        if proposal_csv is not None:
            problem = check_proposals(sdir, run, proposal_csv)
            if problem:
                return {'error': problem}
        if not repeat:
            return {'outputs': first}
        rc2, err2, second = run_profile(scratch, sdir, run, enddate, env)
        if rc2 != 0:
            return {'error': f'cached run failed rc={rc2}', 'stderr_tail': err2[-4000:], 'outputs': first}
        if proposal_csv is not None:
            problem = check_proposals(sdir, run, proposal_csv)
            if problem:
                return {'error': problem}
        if first != second:
            return {'error': 'uncached and cached runs disagree', 'outputs': first, 'cached': second}
        return {'outputs': first}


# Rationale sections whose text a release may change on purpose (--classify).
INTENDED_SECTIONS = ('Key Terminology Reference', 'Pool and VP Checks', 'Structural Feasibility Checks',
                     'Entitlement Cut Exposure', 'Recommended Actions')
ALERT_TAG = re.compile(r'^(?:\[(?:POOL_SHORTFALL|VP_MISMATCH)\](?:;\s*)?)+')
# v10 planner CSV layout (stage 3.1): columns moved to the rationale, columns
# added, and cells whose meaning the current-cycle pair completes.
LAYOUT_RETIRED = re.compile(r'^(?:RunQ_Tactical|RunQ_Strategic|RunQ_Potential|RunQ_Source|VCPU_Constraints|NETT%?'
                            r'|.+_rVCPU|.+_rVCPU_EntBounded)$')
LAYOUT_ADDED = re.compile(r'^(?:Planning Profile|NFIT - VCPU|NFIT - Action|.+_rENT_Tactical)$')
LAYOUT_COMPLETED = re.compile(r'^(?:NFIT - ENT|.+_rVCPU_Tactical)$')
# v10 stage 3.1 rationale lines outside the intended sections: the per-profile
# "At a glance" block and the VP configuration-fit lines.
INTENDED_LINES = re.compile(r'^    (?:Current VPs / MaxCPU|Installed|Business tier|Strategic destination \(rVCPU\)|Target'
                            r'|Entitlement-preserving|This cycle \(rVCPU_Tactical\)|VP reduction step|Reduction safety'
                            r'|Current cycle|Current-cycle action|Configuration fit \((?:this cycle|strategic)\)'
                            r'|HMC profile maximum)\s*:'
                            r'|^    Configuration fit \(|^  - (?:Tactical VCPUs \(rVCPU_Tactical, this cycle\)'
                            r'|VP reduction step \(before pairing\))\s*:'
                            r'|^\s+(?:maximum-VP/HMC profile before implementation|VPs above the pool size)')


def _sections(lines: list) -> list:
    """The rationale section each line belongs to: a '====' title block, the Key
    Terminology Reference (up to the next unindented title line), or the
    per-LPAR "Rationale for VM" detail; '' before the first."""
    rule = '=' * 70
    out, current = [], ''
    for i, line in enumerate(lines):
        if line.startswith('Key Terminology Reference'):
            current = 'Key Terminology Reference'
        elif line.startswith('# Rationale for VM:'):
            current = 'Rationale for VM'                        # per-LPAR detail: never an intended section
        elif (current == 'Key Terminology Reference' and line.strip() and not line.startswith(' ')
              and not set(line.strip()) <= {'=', '-', '#'}):
            current = line.strip()                              # the reference ends at the next title line
        elif (line == rule and i + 2 < len(lines) and lines[i + 2] == rule and lines[i + 1].strip()
              and not lines[i + 1].startswith(' ')):
            current = lines[i + 1].strip()
        out.append(current)
    return out


def classify_log(base: str, cur: str) -> dict:
    """Changed rationale lines by section: intended (INTENDED_SECTIONS) or other."""
    import difflib
    a, b = base.splitlines(), cur.splitlines()
    sa, sb = _sections(a), _sections(b)
    result = {'intended': 0, 'other': 0, 'other_lines': [], 'sections': {}}
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag == 'equal':
            continue
        changed = [('-', a[i], sa[i]) for i in range(i1, i2)] + [('+', b[j], sb[j]) for j in range(j1, j2)]
        for sign, text, section in changed:
            if not text.strip() or set(text.strip()) <= {'=', '-'}:
                result['layout'] = result.get('layout', 0) + 1      # blank and rule lines carry no content
                continue
            intended = any(section.startswith(name) for name in INTENDED_SECTIONS) or bool(INTENDED_LINES.match(text))
            key = section or '(start of log)'
            result['sections'][key] = result['sections'].get(key, 0) + 1
            if intended:
                result['intended'] += 1
            else:
                result['other'] += 1
                if len(result['other_lines']) < 20:
                    result['other_lines'].append(f'{sign} [{key}] {text}')
    return result


def classify_csv(base: str, cur: str) -> dict:
    """Changed CSV cells: VM_Comments alert tags only, other VM_Comments, other cells."""
    import csv
    import io
    ra, rb = list(csv.reader(io.StringIO(base))), list(csv.reader(io.StringIO(cur)))
    result = {'header': ra[:1] == rb[:1], 'rows': (len(ra), len(rb)), 'tags_only': 0, 'comments_other': 0,
              'cells': 0, 'cell_lines': [], 'layout': None, 'completed': 0}
    if ra and rb and not result['header']:
        # A change of layout is intended only when every removed column moved to
        # the rationale and every new column is a v10 planner column. Cells are
        # then compared by column name and by VM.
        removed, added = set(ra[0]) - set(rb[0]), set(rb[0]) - set(ra[0])
        if all(LAYOUT_RETIRED.match(c) for c in removed) and all(LAYOUT_ADDED.match(c) for c in added):
            result['header'] = True
            result['layout'] = (len(removed), len(added))
    if not ra or not rb or not result['header'] or len(ra) != len(rb):
        result['cells'] = -1
        return result
    header = [c for c in ra[0] if c in set(rb[0])]
    index_a = {c: i for i, c in enumerate(ra[0])}
    index_b = {c: i for i, c in enumerate(rb[0])}
    for row_a, row_b in zip(ra[1:], rb[1:]):
        for name in header:
            ia, ib = index_a[name], index_b[name]
            va = row_a[ia] if ia < len(row_a) else ''
            vb = row_b[ib] if ib < len(row_b) else ''
            if va == vb:
                continue
            if result['layout'] is not None and name == 'NFIT - ENT' and va == '':
                continue                                     # blank before v10 unless formulas were on
            if result['layout'] is not None and LAYOUT_COMPLETED.match(name):
                result['completed'] += 1
                if len(result['cell_lines']) < 20:
                    result['cell_lines'].append(f'{row_a[0]} {name} (current-cycle pair): {va} -> {vb}')
                continue
            if name == 'VM_Comments':
                if ALERT_TAG.sub('', vb).strip(' ;') == ALERT_TAG.sub('', va).strip(' ;'):
                    result['tags_only'] += 1
                else:
                    result['comments_other'] += 1
                    if len(result['cell_lines']) < 20:
                        result['cell_lines'].append(f'{row_a[0]} VM_Comments: {va!r} -> {vb!r}')
                continue
            result['cells'] += 1
            if len(result['cell_lines']) < 20:
                result['cell_lines'].append(f'{row_a[0]} {name}: {va} -> {vb}')
    return result


def diff_lines(a: str, b: str, limit: int = 20, label_a: str = 'baseline', label_b: str = 'current') -> list:
    import difflib
    d = list(difflib.unified_diff(a.splitlines(), b.splitlines(), label_a, label_b, lineterm='', n=0))
    return d[:limit] + ([f'... ({len(d) - limit} more diff lines)'] if len(d) > limit else [])


# ------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------
def cmd_capture(a, out: RedactedOut) -> int:
    stage_dir = Path(a.stage_dir).resolve()
    dest = GOLDEN_ROOT / a.name
    if dest.exists():
        out.say(f'golden: baseline "{a.name}" already exists; choose another name.')
        return 2
    try:
        systems = discover_systems(stage_dir, a.systems)
    except LookupError as exc:
        out.say(f'golden: system(s) not found in stage: {exc}')
        return 2
    runs = [r.strip() for r in a.runs.split(',')]
    for r in runs:
        if r not in RUNS:
            out.say(f'golden: unknown run "{r}" (choose from {",".join(RUNS)})')
            return 2
    enddate = a.enddate or last_complete_month_end(dt.date.today()).isoformat()

    frozen = dest / 'frozen'
    frozen.mkdir(parents=True)
    for exe in EXECUTABLES:
        shutil.copy2(REPO / exe, frozen / exe)
    copy_nfit_config(REPO / 'etc', frozen / 'etc')
    env = perl_env()

    meta = {
        'name': a.name, 'created': dt.datetime.now().isoformat(timespec='seconds'),
        'stage_dir': str(stage_dir), 'enddate': enddate, 'runs': runs,
        'source': git_identity(REPO),
        'executables_sha256': {e: sha256_file(REPO / e) for e in EXECUTABLES},
        'systems': {},
    }
    out.say(f'Capturing baseline "{a.name}": {len(systems)} system(s), runs {",".join(runs)}, enddate {enddate}')
    out.say(f'  stage dir (resolved): {stage_dir}')
    failures = 0
    for system in systems:
        sysdir = stage_dir / system
        meta['systems'][system] = {'data_identity': data_identity(sysdir), 'runs': {}}
        for run in runs:
            res = execute(system, sysdir, run, enddate, frozen, frozen / 'etc', env)
            rdir = dest / 'results' / system / run
            rdir.mkdir(parents=True)
            if 'error' in res:
                failures += 1
                (rdir / 'ERROR.txt').write_text(res['error'] + '\n' + res.get('stderr_tail', ''))
                for label in ('outputs', 'cached'):
                    for kind, text in res.get(label, {}).items():
                        prefix = 'uncached' if label == 'outputs' else 'cached'
                        (rdir / f'{prefix}.{kind}').write_text(text, encoding='utf-8')
                out.say(f'  {system} {run:<13} FAILED: {res["error"]}')
                report_failure(out, res)
                continue
            digests = {}
            for kind, text in res['outputs'].items():
                (rdir / f'{run}.{kind}').write_text(text, encoding='utf-8')
                digests[kind] = hashlib.sha256(text.encode('utf-8')).hexdigest()
            meta['systems'][system]['runs'][run] = digests
            out.say(f'  {system} {run:<13} ok ({", ".join(sorted(digests))}; cached run agrees)')
    (dest / 'meta.json').write_text(json.dumps(meta, indent=2, sort_keys=True))
    out.say(f'Baseline stored under .private/golden/{a.name} ({failures} failure(s)).')
    return 1 if failures else 0


def cmd_compare(a, out: RedactedOut) -> int:
    dest = GOLDEN_ROOT / a.name
    meta_path = dest / 'meta.json'
    if not meta_path.is_file():
        out.say(f'golden: no baseline named "{a.name}".')
        return 2
    meta = json.loads(meta_path.read_text())
    stage_dir = Path(a.stage_dir or meta['stage_dir']).resolve()
    exe_src = dest / 'frozen' if a.frozen else REPO
    env = perl_env()
    out.say(f'Comparing against baseline "{a.name}" (source: {"frozen copy" if a.frozen else "current tree"}, '
            f'enddate {meta["enddate"]})')
    differences = 0
    unintended = 0
    wanted_systems = None
    if a.systems:
        by_alias = {pseudonym(name): name for name in meta['systems']}
        wanted_systems = {by_alias.get(x.strip(), x.strip()) for x in a.systems.split(',') if x.strip()}
        unknown = wanted_systems - set(meta['systems'])
        if unknown:
            out.say(f'golden: system(s) not in baseline: {",".join(sorted(unknown))}')
            return 2
    wanted_runs = {x.strip() for x in a.runs.split(',')} if a.runs else None
    for system, sysmeta in sorted(meta['systems'].items()):
        if wanted_systems is not None and system not in wanted_systems:
            continue
        sysdir = stage_dir / system
        if not sysdir.is_dir():
            out.say(f'  {system}: staged data not found; skipped')
            differences += 1
            continue
        if data_identity(sysdir) != sysmeta['data_identity']:
            out.say(f'  {system}: WARNING staged data changed since capture; differences may be data, not code')
        for run, digests in sorted(sysmeta['runs'].items()):
            if wanted_runs is not None and run not in wanted_runs:
                continue
            res = execute(system, sysdir, run, meta['enddate'], exe_src, exe_src / 'etc', env,
                          repeat=not a.single,
                          proposal_csv=(dest / 'results' / system / run / f'{run}.csv').read_text()
                          if a.check_proposals else None)
            if 'error' in res:
                differences += 1
                unintended += 1
                out.say(f'  {system} {run:<13} FAILED: {res["error"]}')
                continue
            changed = []
            for kind in sorted(set(digests) | set(res['outputs'])):
                cur = res['outputs'].get(kind)
                if cur is None or hashlib.sha256(cur.encode('utf-8')).hexdigest() != digests.get(kind):
                    changed.append(kind)
            if not changed:
                out.say(f'  {system} {run:<13} identical')
                continue
            differences += 1
            out.say(f'  {system} {run:<13} DIFFERS in {", ".join(changed)}')
            for kind in changed:
                base_file = dest / 'results' / system / run / f'{run}.{kind}'
                base = base_file.read_text(encoding='utf-8') if base_file.exists() else ''
                current = res['outputs'].get(kind, '')
                if a.classify and kind == 'csv':
                    c = classify_csv(base, current)
                    verdict = 'UNINTENDED' if (c['cells'] or c['comments_other'] or not c['header']) else 'intended only'
                    unintended += verdict == 'UNINTENDED'
                    header_text = ('same' if c['layout'] is None else
                                   f'v10 layout ({c["layout"][0]} column(s) moved to the rationale, {c["layout"][1]} added; '
                                   f'{c["completed"]} current-cycle cell(s) changed)') if c['header'] else 'CHANGED'
                    out.say(f'      csv: {verdict}: header {header_text}, rows {c["rows"][0]} -> {c["rows"][1]}, '
                            f'other cells changed {c["cells"]}, VM_Comments alert tags only {c["tags_only"]}, '
                            f'VM_Comments other {c["comments_other"]}')
                    for line in c['cell_lines']:
                        out.say('        ' + line)
                elif a.classify and kind == 'log':
                    c = classify_log(base, current)
                    verdict = 'UNINTENDED' if c['other'] else 'intended only'
                    unintended += verdict == 'UNINTENDED'
                    out.say(f'      log: {verdict}: {c["intended"]} changed line(s) in intended sections, {c["other"]} elsewhere, '
                            f'{c.get("layout", 0)} blank or rule line(s); '
                            + ', '.join(f'{k}: {v}' for k, v in sorted(c['sections'].items())))
                    for line in c['other_lines']:
                        out.say('        ' + line)
                else:
                    for line in diff_lines(base, current):
                        out.say('      ' + line)
    out.say(f'Summary: {differences} system/run combination(s) differ.')
    if a.classify:
        out.say(f'Classified: {unintended} output(s) with differences outside the intended changes.')
        return 1 if unintended else 0
    return 1 if differences else 0


def cmd_determinism(a, out: RedactedOut) -> int:
    """Separate run-to-run nondeterminism from results-cache effects.

    For each system and run: two fresh scratch trees (A, B), a repeat in tree A
    (served by the L2 results cache), and two fresh trees with Perl hash
    randomisation fixed (C, D). Raw outputs are kept privately for manual
    inspection under .private/golden/_determinism/<system>/<run>/ as
    A, cached-A (only when it differs from A), B, C and D."""
    stage_dir = Path(a.stage_dir).resolve()
    try:
        systems = discover_systems(stage_dir, a.systems)
    except LookupError as exc:
        out.say(f'golden: system(s) not found in stage: {exc}')
        return 2
    enddate = a.enddate or last_complete_month_end(dt.date.today()).isoformat()
    base_env = perl_env()
    seeded_env = dict(base_env, PERL_HASH_SEED='0', PERL_PERTURB_KEYS='0')
    worst = 0
    for system in systems:
        sysdir = stage_dir / system
        for run in [r.strip() for r in a.runs.split(',')]:
            out.say(f'  {system} {run}  (outputs kept in .private/golden/_determinism/<system>/{run}/)')
            a1 = execute(system, sysdir, run, enddate, REPO, REPO / 'etc', base_env)   # fresh + cached
            b = execute(system, sysdir, run, enddate, REPO, REPO / 'etc', base_env, repeat=False)
            c = execute(system, sysdir, run, enddate, REPO, REPO / 'etc', seeded_env, repeat=False)
            d = execute(system, sysdir, run, enddate, REPO, REPO / 'etc', seeded_env, repeat=False)
            fresh_a = a1.get('outputs', {})
            keep = GOLDEN_ROOT / '_determinism' / system / run
            keep.mkdir(parents=True, exist_ok=True)
            for label, res, key in (('A', a1, 'outputs'), ('cached-A', a1, 'cached'), ('B', b, 'outputs'),
                                    ('C', c, 'outputs'), ('D', d, 'outputs')):
                for kind, text in res.get(key, {}).items():
                    (keep / f'{label}.{kind}').write_text(text, encoding='utf-8')
            # A successful repeat returns only the shared output; a disagreeing
            # repeat returns both; a failed first run returns neither.
            if 'cached' in a1:
                cached_a = a1['cached']
            elif 'error' not in a1:
                cached_a = fresh_a
            else:
                cached_a = {}
            checks = [
                ('fresh A vs fresh B (random hash order)', fresh_a, b.get('outputs', {})),
                ('fresh A vs cached A', fresh_a, cached_a),
                ('fresh C vs fresh D (PERL_HASH_SEED=0)', c.get('outputs', {}), d.get('outputs', {})),
            ]
            for res, label in ((a1, 'A'), (b, 'B'), (c, 'C'), (d, 'D')):
                if 'error' in res and 'cached' not in res:
                    out.say(f'    run {label}: {res["error"]}')
                    for line in stderr_tail(res.get('stderr_tail', '')):
                        out.say('      stderr: ' + line)
            for label, x, y in checks:
                same = bool(x) and x == y
                out.say(f'    {label:<42} {"identical" if same else "DIFFER"}')
                if not same:
                    worst = 1
                    report_difference(out, label.split(' vs ')[0].split(' (')[0],
                                      x, label.split(' vs ')[1].split(' (')[0], y, limit=8)
    return worst


def cmd_list(a, out: RedactedOut) -> int:
    if not GOLDEN_ROOT.is_dir():
        out.say('No baselines.')
        return 0
    for d in sorted(GOLDEN_ROOT.iterdir()):
        if d.name.startswith('_'):
            continue
        m = d / 'meta.json'
        if m.is_file():
            meta = json.loads(m.read_text())
            out.say(f'{meta["name"]}: created {meta["created"]}, {len(meta["systems"])} system(s), '
                    f'runs {",".join(meta["runs"])}, enddate {meta["enddate"]}, '
                    f'commit {(meta["source"]["commit"] or "?")[:7]}'
                    f'{" (dirty)" if meta["source"]["executables_dirty"] else ""}')
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description='nFit golden-master regression harness')
    sub = ap.add_subparsers(dest='cmd', required=True)
    c = sub.add_parser('capture')
    c.add_argument('name')
    c.add_argument('--stage-dir', default=str(REPO / 'stage'))
    c.add_argument('--systems', default='all')
    c.add_argument('--runs', default='forensic,decay-states,windowed')
    c.add_argument('--enddate', default=None)
    k = sub.add_parser('compare')
    k.add_argument('name')
    k.add_argument('--stage-dir', default=None)
    k.add_argument('--frozen', action='store_true', help='Re-run the frozen executables (reproducibility check)')
    k.add_argument('--systems', default=None, help='Subset of baseline systems (names or sys_ pseudonyms)')
    k.add_argument('--runs', default=None, help='Subset of baseline runs, e.g. decay-states')
    k.add_argument('--check-proposals', action='store_true', help='Also compare each stored tactical proposal with the baseline CSV')
    k.add_argument('--single', action='store_true', help='Skip the cached repeat run')
    k.add_argument('--classify', action='store_true',
                   help='Sort differences into intended (VM_Comments alert tags, INTENDED_SECTIONS) and unintended')
    sub.add_parser('list')
    d = sub.add_parser('determinism')
    d.add_argument('--stage-dir', default=str(REPO / 'stage'))
    d.add_argument('--systems', required=True)
    d.add_argument('--runs', default='forensic')
    d.add_argument('--enddate', default=None)
    a = ap.parse_args()

    # The privacy filter learns identifiers from the data root in use as well
    # as from the repository's own (possibly linked) data directories.
    stage_arg = getattr(a, 'stage_dir', None)
    if a.cmd == 'compare' and stage_arg is None:
        m = GOLDEN_ROOT / a.name / 'meta.json'
        stage_arg = json.loads(m.read_text())['stage_dir'] if m.is_file() else None
    data_root = Path(stage_arg).resolve().parent if stage_arg else None
    out = RedactedOut(data_root)
    try:
        rc = {'capture': cmd_capture, 'compare': cmd_compare, 'list': cmd_list,
              'determinism': cmd_determinism}[a.cmd](a, out)
    finally:
        rrc = out.close()
    return rc if rrc == 0 else 2


if __name__ == '__main__':
    sys.exit(main())

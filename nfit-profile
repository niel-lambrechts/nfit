            print {$LOG_FH} "\n";
            print {$LOG_FH} "  Thread headroom    PhysC - PhysB: core time the LPAR held that was not booked busy, mainly\n";
            print {$LOG_FH} "                     idle SMT threads on its cores.\n";
            print {$LOG_FH} "\n";
        }
        print {$LOG_FH} "  Planning profile   The profile that carries an LPAR's sizing decision: the one matching its\n";
        print {$LOG_FH} "                     configured TIER, or tier 3 on the hinted pattern (O3/B3/G3) where no\n";
        print {$LOG_FH} "                     TIER is configured (P for a VIOS). Other profiles are alternative\n";
        print {$LOG_FH} "                     plans. P is peak protected: the complete credible peak is kept.\n";
        print {$LOG_FH} "\n";

        # the entitlement outcome rather than in the retired downsizing section.
        my $ds_aae  = $calc_debug_info_ref->{PhysC_Daily_AAE};
        my $ds_pae  = $calc_debug_info_ref->{PhysC_Daily_PAE};
        if (defined $ds_pae && looks_like_number($ds_pae) && $ds_pae >= 0.80
            && defined $ds_aae && looks_like_number($ds_aae) && $ds_aae > 0.10) {
            printf {$fh} "  - PLANNER NOTE [Chronic Under-Entitlement]: %.0f%% of days exceed entitlement with %.0f%% average excess.\n",
                ($ds_pae * 100), ($ds_aae * 100);
            printf {$fh} "      Action                                          : review the entitlement allocation rather than making a tactical CPU adjustment.\n";
        }
        printf {$fh} "  => Recommendation after Max Sanity Check             : %s cores\n\n", ($final_recommendation_unrounded_str // $na);
    } # End else for ReasonForNoModification (main calculation block)

    # --- Section F: VCPU Recommendation (Dispatch Capacity) ---
    print {$fh} "Section F: VCPU Recommendation (Dispatch Capacity)\n";

    my $curr_vcpu_log = (defined $cfg->{virtual_cpus} && looks_like_number($cfg->{virtual_cpus})) ? sprintf("%d", $cfg->{virtual_cpus}) : $na;
    my $maxcpu_log    = (defined $cfg->{max_cpu} && looks_like_number($cfg->{max_cpu})) ? sprintf("%.2f", $cfg->{max_cpu}) : $na;
    my $curr_vcpu_numeric_log = (defined $cfg->{virtual_cpus} && looks_like_number($cfg->{virtual_cpus}))
                               ? ($cfg->{virtual_cpus} + 0) : undef;
    my $maxcpu_numeric_log = (defined $cfg->{max_cpu} && looks_like_number($cfg->{max_cpu}) && $cfg->{max_cpu} > 0)
                           ? ($cfg->{max_cpu} + 0) : undef;

    # Configuration feasibility is distinct from sizing truth. A target can
    # preserve entitlement yet still exceed the currently configured MaxCPU.
    # Keep this check in the rationale layer: it must never clamp a planning
    # recommendation or alter rVCPU/EntBounded/Tactical arithmetic.
    my $print_vp_configuration_fit = sub {
        my ($label, $target) = @_;
        if (!defined $target || !looks_like_number($target)) {
            printf {$fh} "    Configuration fit (%-14s): N/A - target unavailable.\n", $label;
        } elsif (!defined $maxcpu_numeric_log) {
            printf {$fh} "    Configuration fit (%-14s): N/A - current MaxCPU unavailable.\n", $label;
        } elsif (($target + 0) > $maxcpu_numeric_log) {
            printf {$fh} "    Configuration fit (%-14s): NO - target %s exceeds current MaxCPU %.0f by %.0f VP; update the\n",
                $label, $target, $maxcpu_numeric_log, (($target + 0) - $maxcpu_numeric_log);
            printf {$fh} "                                           maximum-VP/HMC profile before implementation.\n";
        } elsif (defined $curr_vcpu_numeric_log && ($target + 0) > $curr_vcpu_numeric_log) {
            printf {$fh} "    Configuration fit (%-14s): YES within MaxCPU %.0f, but requires a configured-VP increase from %.0f.\n",
                $label, $maxcpu_numeric_log, $curr_vcpu_numeric_log;
        } else {
            printf {$fh} "    Configuration fit (%-14s): YES - target %s is within current MaxCPU %.0f.\n",
                $label, $target, $maxcpu_numeric_log;
        }
    };

    my $rvcpu_final_log = (defined $vm_map_ref->{CoreResults}{Profile_rVCPU}{$profile_being_adjusted} && $vm_map_ref->{CoreResults}{Profile_rVCPU}{$profile_being_adjusted} ne "")
        ? $vm_map_ref->{CoreResults}{Profile_rVCPU}{$profile_being_adjusted}
        : ($calc_debug_info_ref->{'rVCPU_Final'} // $na);
    # --- Section F "At a glance": the current state and the three
    # recommendations first, so a planner sees the outcome before the detail.
    # Every value is read from the persisted decision trace; nothing is
    # recomputed here, so this block cannot drift from the detail below.
    my $sf_re = $vm_map_ref->{CoreResults}{Profile_rVCPU_Explain}{$profile_being_adjusted} // {};
    my $sf_glance = sub {
        my ($label, $value) = @_;
        printf {$fh} "    %-31s: %s\n", $label, (defined $value && $value ne '' ? $value : $na);
    };

    my $sf_cur_n = looks_like_number($curr_vcpu_log) ? ($curr_vcpu_log + 0) : undef;
    my $sf_tac_n = (defined $sf_re->{Tactical} && looks_like_number($sf_re->{Tactical}))
                 ? ($sf_re->{Tactical} + 0) : undef;

    # Explicit direction: the planner should not have to infer REDUCE vs HOLD.
    my $sf_action;
    if (defined $sf_cur_n && defined $sf_tac_n) {
        $sf_action = ($sf_tac_n <  $sf_cur_n) ? sprintf('REDUCE %d -> %d VPs',   $sf_cur_n, $sf_tac_n)
                   : ($sf_tac_n >  $sf_cur_n) ? sprintf('INCREASE %d -> %d VPs', $sf_cur_n, $sf_tac_n)
                   :                            sprintf('HOLD at %d VPs',        $sf_cur_n);
    } else {
        $sf_action = $na;
    }

    # Feasibility summarised for the glance. Two distinct questions are answered:
    # whether THIS cycle's action fits the configured MaxCPU, and whether the
    # strategic destination does. The strategic answer must appear here: a
    # planner skimming the summary would otherwise miss that the headline VP
    # target cannot be implemented until the maximum-VP/HMC profile is raised.
    my $sf_glance_fit = $na;
    if (defined $sf_tac_n) {
        if (!defined $maxcpu_numeric_log) {
            $sf_glance_fit = 'MaxCPU unavailable';
        } elsif ($sf_tac_n > $maxcpu_numeric_log) {
            $sf_glance_fit = sprintf('EXCEEDS MaxCPU %.0f - raise max-VP/HMC profile first', $maxcpu_numeric_log);
        } else {
            $sf_glance_fit = sprintf('within MaxCPU %.0f', $maxcpu_numeric_log);
        }
    }

    # Strategic feasibility considers the wider of rVCPU and EntBounded, since
    # either can be the target a planner acts on once entitlement work is agreed.
    my $sf_strat_n = looks_like_number($rvcpu_final_log) ? ($rvcpu_final_log + 0) : undef;
    my $sf_eb_n    = (defined $sf_re->{EntBounded} && looks_like_number($sf_re->{EntBounded}))
                   ? ($sf_re->{EntBounded} + 0) : undef;
    my $sf_strat_target = $sf_strat_n;
    $sf_strat_target = $sf_eb_n
        if (defined $sf_eb_n && (!defined $sf_strat_target || $sf_eb_n > $sf_strat_target));

    my $sf_glance_strat_fit = $na;
    if (defined $sf_strat_target) {
        if (!defined $maxcpu_numeric_log) {
            $sf_glance_strat_fit = 'MaxCPU unavailable';
        } elsif ($sf_strat_target > $maxcpu_numeric_log) {
            $sf_glance_strat_fit = sprintf(
                'ACTION REQUIRED - target %d exceeds current MaxCPU %.0f; raise the maximum-VP/HMC profile',
                $sf_strat_target, $maxcpu_numeric_log);
        } elsif (defined $curr_vcpu_numeric_log && $sf_strat_target > $curr_vcpu_numeric_log) {
            $sf_glance_strat_fit = sprintf('within MaxCPU %.0f; requires a configured-VP increase from %.0f',
                $maxcpu_numeric_log, $curr_vcpu_numeric_log);
        } else {
            $sf_glance_strat_fit = sprintf('within MaxCPU %.0f', $maxcpu_numeric_log);
        }
    }   

    print {$fh} "  At a glance\n";
    $sf_glance->('Current VPs / MaxCPU', sprintf('%s / %s', $curr_vcpu_log, $maxcpu_log));
    $sf_glance->('Business tier', sprintf('%s (%s)',
        ($vm_map_ref->{Hinting}{FinalTierForVM} // $na),
        ($vm_map_ref->{Hinting}{TierPolicySource} // $na)));
    $sf_glance->('Strategic destination (rVCPU)', sprintf('%s VPs  governed by %s',
        ($rvcpu_final_log // $na), ($sf_re->{StrategicGovernor} // $na)));
    $sf_glance->('Entitlement-preserving',
        (defined $sf_re->{EntBounded} && looks_like_number($sf_re->{EntBounded}))
            ? sprintf('%s VPs', $sf_re->{EntBounded}) : $na);
    $sf_glance->('This cycle (rVCPU_Tactical)',
        (defined $sf_re->{Tactical} && looks_like_number($sf_re->{Tactical}))
            ? sprintf('%s VPs', $sf_re->{Tactical}) : $na);
    $sf_glance->('Current-cycle action', $sf_action);
    $sf_glance->('Reduction safety', ($sf_re->{ReductionSafetyState} // $na));
    $sf_glance->('Configuration fit (this cycle)', $sf_glance_fit);
    $sf_glance->('Configuration fit (strategic)', $sf_glance_strat_fit);
    print {$fh} "\n";

# Determine binding constraint for plain-language verdict
    my $sf_rv_n  = looks_like_number($rvcpu_final_log) ? ($rvcpu_final_log + 0) : undef;
    my $sf_raw   = (defined $calc_debug_info_ref->{'rVCPU_Raw'} && looks_like_number($calc_debug_info_ref->{'rVCPU_Raw'}))
                 ? ($calc_debug_info_ref->{'rVCPU_Raw'} + 0) : undef;
    my $sf_min   = (defined $calc_debug_info_ref->{'rVCPU_Min'} && looks_like_number($calc_debug_info_ref->{'rVCPU_Min'}))
                 ? ($calc_debug_info_ref->{'rVCPU_Min'} + 0) : undef;
    my $sf_flr   = (defined $calc_debug_info_ref->{'rVCPU_P99W1Floor'} && looks_like_number($calc_debug_info_ref->{'rVCPU_P99W1Floor'}))
                 ? ($calc_debug_info_ref->{'rVCPU_P99W1Floor'} + 0) : undef;
    my $sf_burst = (defined $calc_debug_info_ref->{'rVCPU_ConfiguredBurstFloor'}
                    && looks_like_number($calc_debug_info_ref->{'rVCPU_ConfiguredBurstFloor'}))
                 ? ($calc_debug_info_ref->{'rVCPU_ConfiguredBurstFloor'} + 0) : undef;
    my $sf_pre_even = (defined $sf_rv_n && $VCPU_ROUND_UP_TO_EVEN && ($sf_rv_n % 2) == 0) ? ($sf_rv_n - 1) : $sf_rv_n;

    my $sf_governed = 'N/A';
    my @sf_lower = ();
    my @sf_higher = ();
    if (defined $sf_rv_n) {
        my $sf_max = (defined $calc_debug_info_ref->{'rVCPU_Max'} && looks_like_number($calc_debug_info_ref->{'rVCPU_Max'}))
                   ? ($calc_debug_info_ref->{'rVCPU_Max'} + 0) : undef;

        my $sf_env_binds = (defined $sf_min && ($sf_rv_n == $sf_min || (defined $sf_pre_even && $sf_pre_even == $sf_min)));
        my $sf_flr_binds = (defined $sf_flr && ($sf_rv_n == $sf_flr || (defined $sf_pre_even && $sf_pre_even == $sf_flr)));
        my $sf_burst_binds = (defined $sf_burst && ($sf_rv_n == $sf_burst || (defined $sf_pre_even && $sf_pre_even == $sf_burst)));
        my $sf_raw_binds = (defined $sf_raw && ($sf_rv_n == $sf_raw || (defined $sf_pre_even && $sf_pre_even == $sf_raw)));
        my $sf_max_binds = (defined $sf_max && ($sf_rv_n == $sf_max || (defined $sf_pre_even && $sf_pre_even == $sf_max)));

        my $sf_uncapped = undef;
        for my $v ($sf_raw, $sf_flr, $sf_burst, $sf_min) {
            next unless defined $v;
            $sf_uncapped = $v if (!defined $sf_uncapped || $v > $sf_uncapped);
        }
        my $sf_capped_by_max = (defined $sf_max && defined $sf_uncapped && $sf_uncapped > $sf_max && $sf_max_binds) ? 1 : 0;

        if ($sf_capped_by_max) {
          $sf_governed = sprintf("normal VP range maximum (%s)", $sf_max // $na);
        } elsif ($sf_env_binds && $sf_flr_binds) {
            $sf_governed = sprintf("entitlement delivery floor (%s) tied with peak-throughput protection (%s)", $sf_min // $na, $sf_flr // $na);
        } elsif ($sf_env_binds) {
            $sf_governed = sprintf("entitlement delivery floor (%s)", $sf_min // $na);
        } elsif ($sf_flr_binds) {
            $sf_governed = sprintf("peak-throughput protection (%s)", $sf_flr // $na);
        } elsif ($sf_burst_binds) {
            $sf_governed = sprintf("configured burst width (%s)", $sf_burst // $na);
        } elsif ($sf_raw_binds) {
            $sf_governed = sprintf("run-queue dispatch width (%s)", $sf_raw // $na);
        } else {
            $sf_governed = sprintf("entitlement delivery floor (%s)", $sf_min // $na);
        }

        if ($sf_capped_by_max) {
            push @sf_lower, sprintf("peak-throughput protection (%s)", $sf_flr // $na)
                if (defined $sf_flr && $sf_flr < ($sf_pre_even // $sf_rv_n));
            push @sf_lower, sprintf("entitlement delivery floor (%s)", $sf_min // $na)
                if (defined $sf_min && $sf_min < ($sf_pre_even // $sf_rv_n));
            push @sf_lower, sprintf("configured burst width (%s)", $sf_burst // $na)
                if (defined $sf_burst && $sf_burst < ($sf_pre_even // $sf_rv_n));
            push @sf_higher, sprintf("run-queue dispatch width (%s) exceeded the cap (%s)", $sf_raw // $na, $sf_max // $na)
                if (defined $sf_raw && defined $sf_max && $sf_raw > ($sf_pre_even // $sf_rv_n));
        } else {
            push @sf_lower, sprintf("peak-throughput protection (%s)", $sf_flr // $na)
                if (defined $sf_flr && !$sf_flr_binds);
            push @sf_lower, sprintf("entitlement delivery floor (%s)", $sf_min // $na)
                if (defined $sf_min && !$sf_env_binds);
            push @sf_lower, sprintf("configured burst width (%s)", $sf_burst // $na)
                if (defined $sf_burst && !$sf_burst_binds);
            push @sf_lower, sprintf("run-queue dispatch width (%s)", $sf_raw // $na)
                if (defined $sf_raw && !$sf_raw_binds);
        }
    }
    my $sf_secondary_txt = do {
        my @parts = ();
        if (@sf_lower) {
            push @parts, join(', ', @sf_lower) . (@sf_lower == 1 ? ' was lower.' : ' were lower.');
        }
        if (@sf_higher) {
            push @parts, join(', ', @sf_higher) . '.';
        }
        @parts ? join(' ', @parts) : '';
    };

    printf {$fh} "  - Recommended VCPUs (rVCPU)                          : %s virtual processors\n",
        ($rvcpu_final_log // $na);
    printf {$fh} "    Governed by          : %s.%s\n",
        ($sf_re->{StrategicGovernor} // $sf_governed),
        ($sf_secondary_txt ? " $sf_secondary_txt" : '');

    # rVCPU is stored per profile name in CoreResults
    my $rv = $vm_map_ref->{CoreResults}{Profile_rVCPU}{$profile_being_adjusted};
    my $re = $vm_map_ref->{CoreResults}{Profile_rVCPU_Explain}{$profile_being_adjusted} // {};

    # Task 3: entitlement-preserving VP recommendation. Current entitlement is
    # held, but MaxCPU/profile feasibility remains a separate implementation gate.
    if (defined $re->{EntBounded} && looks_like_number($re->{EntBounded})) {
        my $eb_needs_change = ($re->{EntBoundedNeedsCoordinatedChange}) ? 1 : 0;
        my $eb_evidence_env = ($re->{EntBoundedEvidenceAboveEnvelope}) ? 1 : 0;
        my $eb_stale_note = ($re->{CurrentEntStale}) ? ' [current entitlement unavailable - fell back to VP_Min]' : '';
        printf {$fh} "  - Entitlement-bounded VCPUs (rVCPU_EntBounded)       : %s virtual processors%s\n",
            $re->{EntBounded}, $eb_stale_note;
        printf {$fh} "    Meaning              : the VP target with current entitlement preserved. It enters as a lower\n";
        printf {$fh} "                           bound (ceil of current Ent), so RunQ or yield evidence may size it higher;\n";
        printf {$fh} "                           MaxCPU/profile feasibility still applies.\n";
        printf {$fh} "    Governed by          : %s.\n", ($re->{EntBoundedGovernedBy} // $na);
        $print_vp_configuration_fit->('EntBounded', $re->{EntBounded});

        # Explain EntBounded relative to the strategic rVCPU. Three distinct
        # situations, each with a different planner action:
        #   (a) equal            - nothing to coordinate.
        #   (b) needs_change     - the current-entitlement floor holds EntBounded
        #                          above rVCPU, so a coordinated entitlement
        #                          reduction is genuinely required to reach rVCPU.
        #   (c) evidence-above   - dispatch/peak evidence holds EntBounded above
        #                          rVCPU; when it also exceeds the 2:1 VP envelope
        #                          this is an envelope-policy conflict, NOT an
        #                          entitlement constraint, and reducing entitlement
        #                          would not change it.
        my $eb_n = (looks_like_number($re->{EntBounded})) ? ($re->{EntBounded} + 0) : undef;
        my $rv_n = (defined $rvcpu_final_log && looks_like_number($rvcpu_final_log)) ? ($rvcpu_final_log + 0) : undef;
        if (defined $eb_n && defined $rv_n && $eb_n == $rv_n) {
            printf {$fh} "    Vs strategic rVCPU   : equal to rVCPU - current entitlement does not block the strategic target;\n";
            printf {$fh} "                           implementation remains subject to the configuration-fit result above.\n";
        } elsif ($eb_needs_change) {
            printf {$fh} "    Vs strategic rVCPU   : rVCPU (%s) is lower - the strategic end-state needs a coordinated entitlement\n",
                ($rvcpu_final_log // $na);
            printf {$fh} "                           reduction first. rVCPU_EntBounded (%s) preserves current entitlement, subject\n",
                $re->{EntBounded};
            printf {$fh} "                           to the configuration-fit result above.\n";
        } else {
            printf {$fh} "    Vs strategic rVCPU   : rVCPU_EntBounded (%s) exceeds rVCPU (%s) on dispatch/peak evidence, not current\n",
                $re->{EntBounded}, ($rvcpu_final_log // $na);
            if ($eb_evidence_env) {
                printf {$fh} "                           entitlement - the 2:1 VP envelope caps the strategic figure below this\n";
                printf {$fh} "                           evidence, so no entitlement change is needed to reach rVCPU (see 'Governed by').\n";
            } else {
                printf {$fh} "                           entitlement, so no entitlement change is needed to reach rVCPU (see 'Governed by').\n";
            }
        }
    }

    # A2.3: planner-visible configured-burst audit. The inactive reason is as
    # important as the active floor: it shows that the mechanism did not apply
    # a hidden universal VP:Ent multiplier.
    if (defined $re->{ConfiguredBurstReason}) {
        my $burst_state = $re->{ConfiguredBurstFloorActive} ? 'ACTIVE' : 'inactive';
        printf {$fh} "  - Pressure-conditioned configured-burst floor        : %s\n", $burst_state;
        if ($re->{ConfiguredBurstFloorActive}) {
            printf {$fh} "    Floor / target VP utilisation                      : %s VPs / %s\n",
                (defined $re->{ConfiguredBurstFloor} ? $re->{ConfiguredBurstFloor} : $na),
                (defined $re->{ConfiguredBurstTargetUtilisation}
                 && looks_like_number($re->{ConfiguredBurstTargetUtilisation}))
                    ? sprintf('%.0f%%', $re->{ConfiguredBurstTargetUtilisation} * 100) : $na;
        }
        printf {$fh} "    Basis                                               : %s\n",
            ($re->{ConfiguredBurstReason} // $na);
    }

    # Task 4: Tier-aware rate-limited step toward rVCPU_EntBounded. Implementation
    # risk control, not a sizing recommendation - see Task 4, nFit - Interim VP
    # Right-Sizing Implementation Strategy.
    if (defined $re->{Tactical} && looks_like_number($re->{Tactical})) {
        printf {$fh} "  - Tactical VCPUs (rVCPU_Tactical, this cycle)        : %s virtual processors\n",
            $re->{Tactical};
        printf {$fh} "    %s.\n", ($re->{TacticalNote} // $na);
        $print_vp_configuration_fit->('Tactical', $re->{Tactical});
    }

    # A2.2: make the action state and the invariant for the candidate
    # implementation pair planner-visible. Strategic targets remain visible
    # above even when Tactical is slowed or held.
    if (defined $re->{ReductionSafetyState}) {
        printf {$fh} "  - VP reduction safety                                : %s\n",
            $re->{ReductionSafetyState};
        printf {$fh} "    Evidence                                            : %s\n",
            ($re->{ReductionSafetyReasons} // $na);
        if (defined $re->{ReductionCurrentReachable} && looks_like_number($re->{ReductionCurrentReachable})) {
            printf {$fh} "    Currently reachable cores                          : %.2f cores\n",
                $re->{ReductionCurrentReachable};
        }
        printf {$fh} "    Current reachability basis                         : %s\n",
            ($re->{ReductionCurrentReachabilityBasis} // $na);
        printf {$fh} "    Pool availability status                           : %s\n",
            ($re->{ReductionPoolAvailabilityStatus} // $na);
        printf {$fh} "    Downward action depends on unmeasured pool         : %s\n",
            ($re->{ReductionDependsOnUnmeasuredPool} ? 'Yes - CAUTION required' : 'No');
        printf {$fh} "    Strategic capacity check                           : %s\n",
            ($re->{StrategicInvariantStatus} // $na);
        if (defined $re->{ReductionPeakReachRatio} && looks_like_number($re->{ReductionPeakReachRatio})) {
            printf {$fh} "    Credible peak / current reachable                  : %.1f%%\n",
                $re->{ReductionPeakReachRatio} * 100;
        }
        if (defined $re->{TacticalPreSafety} && looks_like_number($re->{TacticalPreSafety})
            && defined $re->{Tactical} && looks_like_number($re->{Tactical})
            && $re->{TacticalPreSafety} != $re->{Tactical}) {
            printf {$fh} "    Rate-limited candidate before safety state         : %s VPs\n",
                $re->{TacticalPreSafety};
        }

        my $imm_holds = !defined($re->{ImmediateInvariantHolds}) ? 'N/A'
                      : ($re->{ImmediateInvariantHolds} ? 'Yes' : 'No');
        printf {$fh} "  - Current-cycle capacity check                       : %s\n", $imm_holds;
        printf {$fh} "    Candidate / reachable                              : %s VPs / %s cores\n",
            (defined $re->{ImmediateCandidate} ? $re->{ImmediateCandidate} : $na),
            (defined $re->{ImmediateReachable} ? sprintf('%.2f', $re->{ImmediateReachable}) : $na);
        printf {$fh} "    Basis                                               : %s\n",
            ($re->{ImmediateInvariant} // $na);
        if (defined $re->{ImmediateInvariantHolds} && !$re->{ImmediateInvariantHolds}) {
            printf {$fh} "    CURRENT-CYCLE CAPACITY CHECK FAILED: Tactical held at current VPs.\n";
        }
    }

    # Practical audit trail: explain each width constraint in a capacity-planner-friendly way
    # (kept concise; detailed engineer-level fields remain in the "Detail:" line below).
    my $smt_used = (defined $cfg->{smt} && looks_like_number($cfg->{smt})) ? ($cfg->{smt} + 0) : undef;
    my $runq_thr = (defined $re->{RunQHiThreads} && looks_like_number($re->{RunQHiThreads})) ? ($re->{RunQHiThreads} + 0) : undef;
    my $raw_vp   = (defined $re->{Raw} && looks_like_number($re->{Raw})) ? ($re->{Raw} + 0) : undef;
    my $env_min  = (defined $re->{Min} && looks_like_number($re->{Min})) ? ($re->{Min} + 0) : undef;
    my $env_max  = (defined $re->{Max} && looks_like_number($re->{Max})) ? ($re->{Max} + 0) : undef;
    my $ent_cores          = (defined $re->{EntCores} && looks_like_number($re->{EntCores})) ? ($re->{EntCores} + 0) : undef;
    my $ent_cores_planning = (defined $re->{EntCoresPlanning} && looks_like_number($re->{EntCoresPlanning})) ? ($re->{EntCoresPlanning} + 0) : undef;
    my $env_exceeds_op     = (defined $re->{EnvelopeExceedsOperational} && $re->{EnvelopeExceedsOperational}) ? 1 : 0;

    my $floor_vp = (defined $re->{P99W1Floor} && looks_like_number($re->{P99W1Floor})) ? ($re->{P99W1Floor} + 0) : undef;
    my $burst_floor_vp = (defined $re->{ConfiguredBurstFloor}
                          && looks_like_number($re->{ConfiguredBurstFloor}))
                       ? ($re->{ConfiguredBurstFloor} + 0) : undef;
    my $tier_n   = (defined $re->{TierNum} && looks_like_number($re->{TierNum})) ? ($re->{TierNum} + 0) : undef;
    my $tier_f   = (defined $re->{TierFactor} && looks_like_number($re->{TierFactor})) ? ($re->{TierFactor} + 0) : undef;

    my $p_raw    = (defined $re->{P99W1RawPeak} && looks_like_number($re->{P99W1RawPeak})) ? ($re->{P99W1RawPeak} + 0) : undef;
    my $p_adj    = (defined $re->{P99W1AdjPeak} && looks_like_number($re->{P99W1AdjPeak})) ? ($re->{P99W1AdjPeak} + 0) : undef;
    my $p_cred   = (defined $re->{P99W1RunnableDensity} && looks_like_number($re->{P99W1RunnableDensity})) ? ($re->{P99W1RunnableDensity} + 0) : undef;
    my $p_fact   = (defined $re->{P99W1FactorEff} && looks_like_number($re->{P99W1FactorEff})) ? ($re->{P99W1FactorEff} + 0) : undef;

    # Dispatch reserve (extract early so it's in scope for final decision logging)
    my $disp_res_vp     = (defined $re->{DispatchReserveVP} && looks_like_number($re->{DispatchReserveVP})) ? ($re->{DispatchReserveVP} + 0) : 0;
    my $disp_res_reason = $re->{DispatchReserveReason} // '';
    my $disp_res_pre    = (defined $re->{DispatchReservePreFinal} && looks_like_number($re->{DispatchReservePreFinal})) ? ($re->{DispatchReservePreFinal} + 0) : undef;

    # Only print the breakdown when we have the key parts (it should be present for modern runs)
    if (defined $raw_vp || defined $floor_vp || defined $burst_floor_vp || defined $env_min) {
        print {$fh} "    Constraint breakdown:\n";

        # 1) Dispatch Demand (RunQ-derived VP requirement)
        if (defined $runq_thr && defined $smt_used && $smt_used > 0) {
            my $runq_cores = $runq_thr / $smt_used;
            my $tier_f_eff = (defined $tier_f && looks_like_number($tier_f)) ? ($tier_f + 0) : 1.00;
            # Display the *effective* stored divisor that produced the recommendation.
            # Coarse sampling can adapt this below the 0.80 base, so reconstructing
            # from the static global would misrepresent the arithmetic.
            my $tgt_eff = (defined $re->{RunQWidthDivisor} && looks_like_number($re->{RunQWidthDivisor}) && $re->{RunQWidthDivisor} > 0)
                        ? ($re->{RunQWidthDivisor} + 0)
                        : ((defined $RUNQ_TARGET_HEADROOM_FACTOR && looks_like_number($RUNQ_TARGET_HEADROOM_FACTOR)) ? ($RUNQ_TARGET_HEADROOM_FACTOR + 0) : 1.00);
            my $tgt_base = (defined $re->{RunQWidthDivisorBase} && looks_like_number($re->{RunQWidthDivisorBase}) && $re->{RunQWidthDivisorBase} > 0)
                         ? ($re->{RunQWidthDivisorBase} + 0) : $tgt_eff;
            my $planned_width_cores = ($tgt_eff > 0) ? ($runq_cores / $tgt_eff) : $runq_cores;
            my $tier_adjusted_cores = $planned_width_cores * $tier_f_eff;
            my $tgt_pct  = sprintf("%.0f", $tgt_eff * 100);
            my $tier_pct = sprintf("%+.0f", ($tier_f_eff - 1.0) * 100);
            my $div_note = (abs($tgt_eff - $tgt_base) > 0.005)
                         ? sprintf(" [coarse-sampling divisor %.2f; base %.2f]", $tgt_eff, $tgt_base) : '';
            printf {$fh} "      * Run-queue dispatch width: %s = %.2f threads (SMT-%d) -> %.2f cores @ 100%% loading; plan at %s%%%s => %.2f cores; Tier %s%% => %.2f -> requires %s VPs\n",
                ($re->{RunQKeyUsed} // 'AbsRunQ'),
                $runq_thr, $smt_used, $runq_cores,
                $tgt_pct, $div_note, $planned_width_cores,
                $tier_pct, $tier_adjusted_cores,
                (defined $raw_vp ? sprintf("%d", $raw_vp) : 'N/A');
        } else {
            printf {$fh} "      * Dispatch Demand: %s -> width %s VPs\n",
                ($re->{RunQKeyUsed} // 'AbsRunQ'),
                (defined $raw_vp ? sprintf("%d", $raw_vp) : 'N/A');
        }

        # 2) Peak-throughput protection (yield-aware active-core floor)
        if (defined $p_raw && defined $p_adj && defined $p_fact) {
            my $headroom_pct = sprintf("%+.0f", ($p_fact - 1.0) * 100);
            if ($VCPU_PEAK_CRED_DISCOUNT_ENABLED && defined $p_cred) {
                # Legacy credibility-discount path (only while explicitly re-enabled).
                my $p_cred_eff = $p_cred + $VCPU_PEAK_CRED_BIAS;
                $p_cred_eff = $VCPU_PEAK_CRED_MIN if ($p_cred_eff < $VCPU_PEAK_CRED_MIN);
                $p_cred_eff = 1.00 if ($p_cred_eff > 1.00);
                my $cred_pct     = sprintf("%.0f", $p_cred_eff * 100);
                my $discount_pct = sprintf("%.0f", (1.0 - $p_cred_eff) * 100);
                printf {$fh} "      * Peak-throughput protection: peak %.2f cores (credibility %s%%, discounts %s%%) -> %.2f cores; headroom %s%% -> floor %s VPs\n",
                    $p_raw, $cred_pct, $discount_pct, $p_adj, $headroom_pct,
                    (defined $floor_vp ? sprintf("%d", $floor_vp) : 'N/A');
            } else {
                # Live path: no credibility discount. Report the tier peak-throughput
                # retention, which is what actually sets the protected width.
                my $ret_txt = (defined $re->{ThroughputRetention} && looks_like_number($re->{ThroughputRetention}))
                            ? sprintf('tier retains %.0f%% of estimated peak throughput', $re->{ThroughputRetention} * 100)
                            : 'tier peak-throughput retention';
                printf {$fh} "      * Peak-throughput protection: credible peak %.2f cores; %s -> %.2f cores; headroom %s%% -> floor %s VPs\n",
                    $p_raw, $ret_txt, $p_adj, $headroom_pct,
                    (defined $floor_vp ? sprintf("%d", $floor_vp) : 'N/A');
            }
        } elsif (defined $floor_vp) {
            printf {$fh} "      * Peak Coverage: floor %d VPs\n", $floor_vp;
        } else {
            print {$fh} "      * Peak Coverage: N/A\n";
        }

        # 2b) Configured burst width (conditional, A2.3)
        if (defined $re->{ConfiguredBurstReason}) {
            if (defined $burst_floor_vp) {
                printf {$fh} "      * Configured Burst Width: floor %d VPs. %s\n",
                    $burst_floor_vp, $re->{ConfiguredBurstReason};
            } else {
                printf {$fh} "      * Configured Burst Width: %s\n",
                    $re->{ConfiguredBurstReason};
            }
        }

        # 3) Virtual Processor Range (VP:ENT ratio band, from planning rENT)
        if (defined $env_min && defined $env_max) {
            if ($env_exceeds_op && defined $ent_cores_planning && defined $ent_cores) {
                # Show both planning and operational values when they differ
                printf {$fh} "      * Virtual Processor Range (from planning rENT_P=%.2f cores, pre MaxCPU sanity): min %d VPs, max %d VPs\n",
                    $ent_cores_planning, $env_min, $env_max;
                printf {$fh} "        NOTE: Planning range derived from workload demand (%.2f cores), which exceeds\n",
                    $ent_cores_planning;
                printf {$fh} "              operational rENT_P (%.2f cores, post MaxCPU sanity). Raise MaxCPU to realise full range.\n",
                    $ent_cores;
            } elsif (defined $ent_cores_planning) {
                printf {$fh} "      * Virtual Processor Range (from rENT_P=%.2f cores): min %d VPs, max %d VPs\n",
                    $ent_cores_planning, $env_min, $env_max;
            } elsif (defined $ent_cores) {
                printf {$fh} "      * Virtual Processor Range (from rENT_P=%.2f cores): min %d VPs, max %d VPs\n",
                    $ent_cores, $env_min, $env_max;
            } else {
                printf {$fh} "      * Virtual Processor Range: min %d VPs, max %d VPs\n", $env_min, $env_max;
            }

            # Micro-partition envelope expansion note
            if (defined $calc_debug_info_ref->{'MicroPartitionEnvExpansion'}) {
                printf {$fh} "        NOTE: %s\n", $calc_debug_info_ref->{'MicroPartitionEnvExpansion'};
                print {$fh} "        PLANNER NOTE [Micro-Partition Dispatch Constraint]: The 2:1 VP:ENT ratio yields\n";
                print {$fh} "          env_max=1 for this entitlement, but RunQ evidence shows higher dispatch demand.\n";
                print {$fh} "          Envelope expanded to allow adequate dispatch width. Consider entitlement review.\n";
            }

            # 4) Dispatch reserve (conditional, Layer 5)
            if ($disp_res_vp > 0 && $disp_res_reason ne '') {
                printf {$fh} "      * Dispatch reserve: +%d VPs applied (pre-reserve: %s VPs)\n",
                    $disp_res_vp, (defined $disp_res_pre ? $disp_res_pre : 'N/A');
                # Strip redundant "Dispatch reserve +N VPs " prefix from reason string
                my $disp_res_detail = $disp_res_reason;
                $disp_res_detail =~ s/^Dispatch reserve \+\d+ VPs //;
                printf {$fh} "        %s\n", $disp_res_detail;
            }
        } elsif (defined $env_min) {
            if (defined $ent_cores_planning) {
                printf {$fh} "      * Virtual Processor Range (from rENT_P=%.2f cores): min %d VPs\n",
                    $ent_cores_planning, $env_min;
            } elsif (defined $ent_cores) {
                printf {$fh} "      * Virtual Processor Range (from rENT_P=%.2f cores): min %d VPs\n",
                    $ent_cores, $env_min;
            } else {
                printf {$fh} "      * Virtual Processor Range: min %d VPs\n", $env_min;
            }
        } else {
            print {$fh} "      * Virtual Processor Range: N/A\n";
        }

        # Final decision (max-of-constraints)
        if (defined $rv && looks_like_number($rv) && defined $raw_vp && defined $floor_vp && defined $env_min) {
            my @decision_terms = ($raw_vp, $floor_vp, $env_min);
            push @decision_terms, $burst_floor_vp if (defined $burst_floor_vp);
            my $uncapped = max(@decision_terms);
            my $decision_text = join(', ', map { sprintf('%d', $_) } @decision_terms);

            my $reserve_str = '';
            if ($disp_res_vp > 0) {
                $reserve_str = sprintf(" + reserve %d", $disp_res_vp);
            }

            if (defined $env_max && ($uncapped + $disp_res_vp) > $env_max && $rv == $env_max) {
                printf {$fh} "    Final rVCPU = min(VP max %d, max(%s)=%d%s) => %d\n",
                    $env_max, $decision_text, $uncapped, $reserve_str, $rv;
            } elsif ($disp_res_vp > 0) {
                printf {$fh} "    Final rVCPU = max(%s) = %d%s => %d%s\n",
                    $decision_text, $uncapped, $reserve_str, $rv,
                    (defined $env_max) ? sprintf(" (<= VP max %d)", $env_max) : "";

            } else {
                printf {$fh} "    Final rVCPU = max(%s) = %d%s\n",
                    $decision_text, $rv,
                    (defined $env_max) ? sprintf(" (<= VP max %d)", $env_max) : "";
            }
        }
        # Headroom summary for capacity planners
        if (defined $rv && defined $ent_cores && $ent_cores > 0) {
            my $vp_ent_ratio = $rv / $ent_cores;
            my $burst_headroom_pct = ($vp_ent_ratio - 1.0) * 100;

            # Calculate dispatch utilisation (RunQ VPs vs recommended VPs)
            my $dispatch_util_pct = (defined $raw_vp && $rv > 0) ? (($raw_vp / $rv) * 100) : 0;
            my $dispatch_headroom_pct = 100 - $dispatch_util_pct;

            # Get P-99W1 peak for profile headroom calculation
            my $p99w1_peak = $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'};
            my $profile_headroom_pct = 0;
            if (defined $p99w1_peak && looks_like_number($p99w1_peak) && $ent_cores > 0) {
                $profile_headroom_pct = (($p99w1_peak / $ent_cores) - 1.0) * 100;
            }

            print {$fh} "    Headroom Summary:\n";
            printf {$fh} "      - Configured dispatch width above entitlement : %.0f%% (VP:rENT %.2f:1)\n",
                $burst_headroom_pct, $vp_ent_ratio;
            print  {$fh} "        Delivery above entitlement remains pool-dependent.\n";
            if ($dispatch_util_pct <= 100) {
                printf {$fh} "      - Queue-width loading         : %.0f%% (%.0f%% spare dispatch width vs run-queue demand)\n",
                    $dispatch_util_pct, $dispatch_headroom_pct;
            } else {
                my $latent_demand_pct = $dispatch_util_pct - 100;
                printf {$fh} "      - Queue-width loading         : %.0f%% (run-queue demand exceeds recommended width by %.0f%%)\n",
                    $dispatch_util_pct, $latent_demand_pct;
            }

            # Narrow configured width above entitlement
            if ($burst_headroom_pct < 10 && $dispatch_headroom_pct > 20) {
                print {$fh} "      PLANNER NOTE [Narrow width above entitlement]: configured dispatch width above\n";
                print {$fh} "        entitlement is limited, but queue-width loading shows spare dispatch capacity.\n";
                print {$fh} "        The workload is not run-queue-constrained.\n";
            }

            # Clarify entitlement vs VPs when the ratio is wide
            if ($vp_ent_ratio > 1.50) {
                print {$fh} "      NOTE: Entitlement is guaranteed CPU; rVCPU is configured dispatch width for pool\n";
                print {$fh} "        bursting. A wide VP:rENT ratio provides dispatch reach, not guaranteed capacity;\n";
                print {$fh} "        delivery above entitlement still depends on shared-pool availability.\n";
            }
        }
    }

    # RunQ runnable density at the P99W1 peak (diagnostic; also used by the
    # micro-partition override note below).
    my $sf_cred = (defined $calc_debug_info_ref->{'rVCPU_P99W1RunnableDensity'} && looks_like_number($calc_debug_info_ref->{'rVCPU_P99W1RunnableDensity'}))
                ? ($calc_debug_info_ref->{'rVCPU_P99W1RunnableDensity'} + 0) : 1.00;

    my $sf_raw_peak_defined = (defined $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'}
                                && looks_like_number($calc_debug_info_ref->{'rVCPU_P99W1RawPeak'}));
    my $sf_adj_peak_defined = (defined $calc_debug_info_ref->{'rVCPU_P99W1AdjPeak'}
                                && looks_like_number($calc_debug_info_ref->{'rVCPU_P99W1AdjPeak'}));

    # --- 1. Peak coverage statement ---
    # Fires only when the peak was actually changed, i.e. the yield-aware
    # active-core floor engaged (or, if re-enabled, the legacy discount).
    # Previously gated on "density < 1.00", which is true for most VMs
    # regardless of whether any adjustment occurred, and unconditionally
    # printed "credibility 100% counts, 0% discounted" once the discount was
    # disabled - describing a withdrawn mechanism as still governing the peak.
    if ($sf_raw_peak_defined && $sf_adj_peak_defined
        && abs($calc_debug_info_ref->{'rVCPU_P99W1AdjPeak'} - $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'}) > 0.005) {
        printf {$fh} "    Peak coverage basis: %s cores (yield-aware active-core floor from a %s-core P99W1 peak).\n",
            $calc_debug_info_ref->{'rVCPU_P99W1AdjPeak'},
            $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'};
        if (defined $calc_debug_info_ref->{'rVCPU_YieldFloorReason'}
            && $calc_debug_info_ref->{'rVCPU_YieldFloorReason'} ne 'N/A') {
            printf {$fh} "      Throughput basis: %s\n", $calc_debug_info_ref->{'rVCPU_YieldFloorReason'};
        }
    }

    # --- 2. Low runnable density diagnostic ---
    # Independent of whether the floor changed the peak: a low-density
    # partition whose floor happens to equal its raw peak (e.g. retention
    # near 100%, or paired evidence unavailable) is still worth flagging.
    if ($sf_cred < 0.70 && $sf_raw_peak_defined && $sf_adj_peak_defined) {
        printf {$fh} "    PLANNER NOTE [High PhysC / Low runnable density]: runnable density %.2f (approximately %.2f runnable threads per consumed core).\n", $sf_cred, $sf_cred * 8;
        printf {$fh} "      The P99W1 peak was consumed at low runnable-thread density. This is NOT evidence that the\n";
        printf {$fh} "      CPU is unbacked: at low runnable density each thread receives close to a full core, which is how\n";
        printf {$fh} "      low-concurrency work achieves its throughput. Possible causes:\n";
        printf {$fh} "        - Over-provisioned VPs causing scheduler overhead (VP folding/unfolding latency)\n";
        printf {$fh} "        - Single-threaded dominant workload or application loop (high %%usr, low concurrency)\n";
        printf {$fh} "        - Lock contention driving context switches (high %%sys, check vmstat context-switching (cs))\n";
        printf {$fh} "        - Short-lived bursts not captured by RunQ percentiles\n";
        printf {$fh} "      Action: Review current VP count (%s) relative to observed workload concurrency.\n",
            (defined $cfg->{virtual_cpus} && looks_like_number($cfg->{virtual_cpus})) ? sprintf("%d VPs", $cfg->{virtual_cpus}) : 'unknown';
    }

    # |-----------------------------------------------------------------------------------------------------------|
    # | Mechanism          | Trigger                                             | Effect                         |
    # | DBW Anomaly        | PhysC < 0.5×Ent AND DSR > 10 AND NormP50 > 1.5      | 75% dampening of additive CPU  |
    # | High Density        | density > 1.50 (RunQ >> PhysC)                     | Informational PLANNER NOTE     |
    # -------------------------------------------------------------------------------------------------------------

    # --- 3. High density diagnostic (RunQ significantly exceeds PhysC) ---
    # Previously nested inside the "density < 1.00" gate above, making this
    # branch (density > 1.50) logically unreachable: the same variable cannot
    # satisfy both conditions. Promoted to an independent, reachable check.
    if ($sf_cred > 1.50 && $sf_raw_peak_defined) {
        my $runq_excess_cores = sprintf("%.2f", ($calc_debug_info_ref->{'rVCPU_P99W1RawPeak'} * $sf_cred) - $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'});
        printf {$fh} "    PLANNER NOTE [High RunQ / Low CPU]: RunQ demand significantly exceeds observed CPU (density=%.2f).\n", $sf_cred;
        printf {$fh} "      RunQ evidence suggests %.2f cores of latent demand beyond the %.2f cores observed.\n",
            $runq_excess_cores, $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'};
        printf {$fh} "      Possible causes:\n";
        printf {$fh} "        - I/O subsystem bottleneck (threads waiting on storage/network, not CPU-bound)\n";
        printf {$fh} "        - Micro-partition dispatch constraint (insufficient entitlement or VPs)\n";
        printf {$fh} "        - Memory paging pressure causing CPU stalls\n";

        # Cross-reference DBW if detected
        my $dbw_detected = (defined $calc_debug_info_ref->{'RunQ_Potential'}
                            && $calc_debug_info_ref->{'RunQ_Potential'} =~ /ANOMALY.*DBW/i);
        if ($dbw_detected) {
            printf {$fh} "      NOTE: DBW (Dispatch-Bound Workload) anomaly also detected - strongly suggests\n";
            printf {$fh} "            blocking I/O or application-level contention. Investigate before adding CPU.\n";
        }

        printf {$fh} "      Action: Investigate I/O wait (%%wio in topas/nmon) and entitlement headroom.\n";
    }

    # Micro-partition RunQ envelope override PLANNER NOTE
    my $runq_override_flag = $calc_debug_info_ref->{'rVCPU_RunQEnvelopeOverride'} // "No";
    if ($runq_override_flag eq "Yes") {
        my $runq_basis  = $calc_debug_info_ref->{'rVCPU_RunQEnvelopeBasis'} // 'N/A';
        my $orig_min    = $calc_debug_info_ref->{'rVCPU_OrigMin'} // 'N/A';
        my $orig_max    = $calc_debug_info_ref->{'rVCPU_OrigMax'} // 'N/A';
        my $final_max   = $calc_debug_info_ref->{'rVCPU_Max'} // 'N/A';
        my $ent_cores   = $calc_debug_info_ref->{'rVCPU_EntCores'};
        my $final_rv    = $calc_debug_info_ref->{'rVCPU_Final'} // 'N/A';

        print  {$fh} "    PLANNER NOTE: Micro-partition RunQ override active.\n";
        printf {$fh} "      RunQ tail (%.2f cores) exceeds P-99W1 PhysC (%.2f cores) by %.1fx.\n",
            ($runq_basis ne 'N/A' && looks_like_number($runq_basis) ? $runq_basis : 0),
            (defined $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'} && looks_like_number($calc_debug_info_ref->{'rVCPU_P99W1RawPeak'})
                ? $calc_debug_info_ref->{'rVCPU_P99W1RawPeak'} : 0),
            ($sf_cred > 0 ? $sf_cred : 1.0);
        printf {$fh} "      VP envelope (from rENT_P=%.2f cores): min %s, max %s\n",
            (defined $ent_cores && looks_like_number($ent_cores) ? $ent_cores : 0),
            $orig_min, $orig_max;
        printf {$fh} "      RunQ override applied: extended env_max to %s (run-queue dispatch width requires %s VPs)\n",
            $final_max, ($calc_debug_info_ref->{'rVCPU_Raw'} // 'N/A');
        if (defined $ent_cores && looks_like_number($ent_cores) && $ent_cores > 0
            && defined $final_rv && looks_like_number($final_rv) && $final_rv > 0) {
            printf {$fh} "      Resulting VP:ENT ratio (%.1fx) exceeds normal 2.0x maximum - justified by dispatch pressure evidence.\n",
                ($final_rv / $ent_cores);
        }
    }

    printf {$fh} "    Detail: raw=%s; env=%s..%s; tier=%s/f=%s; P99W1_floor=%s @ factor=%s (headroom=%s; peak=%s adj=%s density=%s); RunQ=%s=%s%s\n\n",
        ($calc_debug_info_ref->{'rVCPU_Raw'} // $na),
        ($calc_debug_info_ref->{'rVCPU_Min'} // $na),
        ($calc_debug_info_ref->{'rVCPU_Max'} // $na),
        ($calc_debug_info_ref->{'rVCPU_TierNum'} // $na),
        ($calc_debug_info_ref->{'rVCPU_TierFactor'} // $na),
        ($calc_debug_info_ref->{'rVCPU_P99W1Floor'} // $na),
        ($calc_debug_info_ref->{'rVCPU_P99W1FactorEff'} // $na),
        ($calc_debug_info_ref->{'rVCPU_P99W1Mult'} // $na),
        ($calc_debug_info_ref->{'rVCPU_P99W1RawPeak'} // $na),
        ($calc_debug_info_ref->{'rVCPU_P99W1AdjPeak'} // $na),
        ($calc_debug_info_ref->{'rVCPU_P99W1RunnableDensity'} // $na),
        ($calc_debug_info_ref->{'rVCPU_RunQKeyUsed'} // $na),
        ($calc_debug_info_ref->{'rVCPU_RunQHiThreads'} // $na),
        (($calc_debug_info_ref->{'rVCPU_DispatchReserveVP'} // 0) > 0
            ? sprintf("; reserve=+%d", $calc_debug_info_ref->{'rVCPU_DispatchReserveVP'})
            : "");

    # --- Footer Block (Bottom Summary) ---
    print {$fh} "----------------------------------------------------------------------\n";
    printf {$fh} "Overall Summary for Profile: %s\n", $profile_being_adjusted;
    printf {$fh} "  - Initial Base PhysC (pre-growth)        : %.4f cores\n", $pre_growth_base_physc;
    printf {$fh} "  - nfit GrowthAdj (Theil-Sen)             : %s%.4f cores\n",
        ($nfit_growth_adj >= 0 ? "+" : ""), $nfit_growth_adj;

    # Task 5: the two downsizing footer lines are removed. With the reduction
    # retired they reported a factor structurally fixed at 1.00 and a delta
    # structurally fixed at 0.0000 - a verdict a planner might have acted upon
    # that described nothing the engine did.

    my $additive_final_val_footer = $calc_debug_info_ref->{'FinalAdditive'} // "0.0000";
    my $additive_reason_summary_footer;

    if ($calc_debug_info_ref->{'IsRunQPressure'} eq "True" || $calc_debug_info_ref->{'IsWorkloadPressure'} eq "True") {
        $additive_reason_summary_footer = "Pressure detected";
        my @pressure_types_footer;
        if ($calc_debug_info_ref->{'IsRunQPressure'} eq "True") { push @pressure_types_footer, "Overall LPAR"; }
        if ($calc_debug_info_ref->{'IsWorkloadPressure'} eq "True") { push @pressure_types_footer, "Normalized Workload"; }
        if (@pressure_types_footer) { $additive_reason_summary_footer .= " (" . join(", ", @pressure_types_footer) . ")";}

        if (defined $calc_debug_info_ref->{'HotThreadWLDampeningApplied'} && $calc_debug_info_ref->{'HotThreadWLDampeningApplied'} eq "True")
        {
            $additive_reason_summary_footer .= "; HTW Dampened";
        }
        if (defined $calc_debug_info_ref->{'AdditiveSafetyCapApplied'} && $calc_debug_info_ref->{'AdditiveSafetyCapApplied'} =~ /^True/) {
            $additive_reason_summary_footer .= "; Safety Capped";
        }
        # Add note if additive ended up zero despite pressure
        if (abs(($additive_final_val_footer // 0)+0) < $FLOAT_EPSILON && ($calc_debug_info_ref->{'IsRunQPressure'} eq "True" || $calc_debug_info_ref->{'IsWorkloadPressure'} eq "True")) {
            $additive_reason_summary_footer .= "; Final Additive Zero (due to caps/dampening)";
        }
    }
    else {
        # This path is taken only when no pressure flags were set.
        if (defined $calc_debug_info_ref->{'ExcessThreads'} && $calc_debug_info_ref->{'ExcessThreads'} =~ /No excess threads/i) {
             $additive_reason_summary_footer = "No excess threads calculated for additive.";
         }
        else {
             $additive_reason_summary_footer = "No significant pressure detected.";
        }
    }
    printf {$fh} "    - CPU Upsizing (Additive)                : %s cores. (Reason: %s)\n",
        $additive_final_val_footer, $additive_reason_summary_footer;

    printf {$fh} "  - nfit-profile Upsizing (Additive)         : %s%.4f cores\n",
        ($additive_final_val_footer >= 0 ? "+" : ""), $additive_final_val_footer;

    my $lpar_cap_applied_summary_footer = "Not applied or N/A";
    if (defined $calc_debug_info_ref->{'CappedByMaxCPU'})
    {
        $lpar_cap_applied_summary_footer = $calc_debug_info_ref->{'CappedByMaxCPU'} eq "True"
        ? "Applied (Effective Limit: " . ($calc_debug_info_ref->{'EffectiveMaxCPUCap'} // $na) . ")"
        : "Not Applied (Effective Limit: " . ($calc_debug_info_ref->{'EffectiveMaxCPUCap'} // $na) . ")";
    }
    printf {$fh} "  - Max CPU Sanity Check                   : %s\n", $lpar_cap_applied_summary_footer;
    print {$fh} "  --------------------------------------------------------------------\n";
    printf {$fh} "  Final Recommended Value : %s cores (Unrounded: %s)\n",
        ($final_csv_value_for_profile // $na), # This is rounded for CSV
        $final_recommendation_unrounded_str;    # This is unrounded from calc
    print {$fh} "======================================================================\n\n";

}
# End of log_profile_rationale

# --- quote_csv ---
# Ensures a string is properly quoted for CSV output, escaping internal double quotes.
sub quote_csv {
    my ($field) = @_;
    if (!defined $field) # Handle undefined fields as empty strings
    {
        $field = '';
    }
    $field =~ s/"/""/g; # Escape any double quotes within the field by doubling them
    return qq/"$field"/; # Enclose the entire field in double quotes
}

# --- load_profile_definitions ---
# Loads profile configurations from the specified INI-like file.
# Each section [Profile Name] defines a profile.
# Keys: nfit_flags (mandatory), runq_modifier_behavior (optional, default: 'default').
# This version correctly handles multi-line values for the 'nfit_flags' key.
sub load_profile_definitions {
    my ($filepath) = @_;
    my @loaded_profiles_list;
    my $current_profile = undef;
    my $last_key = '';

    open my $fh, '<:encoding(utf8)', $filepath or die "[ERROR] Cannot open profiles config file '$filepath': $!\n";

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\s*[#;].*//;    # Remove comments
        $line =~ s/^\s+|\s+$//g; # Trim whitespace
        next if $line eq '';

        if ($line =~ /^\s*\[\s*([^\]]+?)\s*\]\s*$/) { # New section
            my $section_name = $1;
            $current_profile = { name => $section_name, flags => '', runq_behavior => 'default', csv_output => 1 };
            push @loaded_profiles_list, $current_profile;
            $last_key = '';
        } elsif ($current_profile && $line =~ /^\s*([^=]+?)\s*=\s*(.*)$/) { # New key-value pair
            my $key = lc($1);
            my $value = $2;
            $key =~ s/^\s+|\s+$//g;
            $value =~ s/^\s+|\s+$//g;
            $last_key = $key;

            if ($key eq 'nfit_flags') {
                $current_profile->{flags} = $value;
            } elsif ($key eq 'runq_modifier_behavior') {
                $current_profile->{runq_behavior} = $value;
            } elsif ($key eq 'csv_output') {
                $current_profile->{csv_output} = ($value =~ /^(true|1|yes)$/i) ? 1 : 0;
            }
        } elsif ($current_profile && $last_key eq 'nfit_flags') { # Continuation of nfit_flags
            $current_profile->{flags} .= " $line";
        }
    }
    close $fh;

    # Final validation and cleanup
    my @valid_profiles;
    foreach my $p_ref (@loaded_profiles_list) {
        # Clean up any leading/trailing whitespace from concatenated flags
        $p_ref->{flags} =~ s/^\s+|\s+$//g if defined $p_ref->{flags};

        if (defined $p_ref->{flags} && $p_ref->{flags} ne '') {
            # (existing validation logic for mandatory P-99W1, etc.)
            push @valid_profiles, $p_ref;
        } else {
            warn " [WARN] Profile '[$p_ref->{name}]' in '$filepath' is missing 'nfit_flags'. Skipping.\n";
        }
    }
    return @valid_profiles;
}

# --- calculate_graduated_burst ---
# Returns graduated burst allowance based on entitlement size
# Small entitlements get higher burst allowance to reflect real-world burst capability
sub calculate_graduated_burst {
    my ($entitlement) = @_;

    if ($entitlement < 0.25) {
        return 0.50;  # 50% burst for micro-partitions
    } elsif ($entitlement < 0.50) {
        return 0.40;  # 40% burst for very small
    } elsif ($entitlement < 1.00) {
        return 0.30;  # 30% burst for small
    } else {
        return 0.25;  # 25% standard burst
    }
}

# --- calculate_structural_availability_factor ---
# For small entitlements, estimates the effective availability of vCPU threads
# based on entitlement size. Scales from 0.5 at Ent=0.1 to 0.95 at Ent=0.9
sub calculate_structural_availability_factor {
    my ($entitlement) = @_;

    # Ensure entitlement is in valid range
    return 0.5 if $entitlement <= 0.1;
    return 0.95 if $entitlement >= 0.9;

    # Linear scaling: 0.5 + (0.45 * entitlement)
    return 0.5 + (0.45 * $entitlement);
}

# --- apply_minimum_lcpu_floor ---
# Applies a minimum LCPU floor based on SMT level
# Prevents unrealistic near-zero LCPU calculations for micro-partitions
sub apply_minimum_lcpu_floor {
    my ($effective_lcpus, $smt_used) = @_;

    # Ensure at least 1 full hardware thread for micro-partitions
    # Scale slightly with SMT to be platform-aware
    my $min_floor = max(1, int($smt_used / 4));  # At SMT=8, floor=2; at SMT=4, floor=1

    return max($min_floor, $effective_lcpus);
}

# ==============================================================================
# SUBROUTINE: apply_tier_aware_upsizing_scaling
# PURPOSE:    Applies tier-number-aware scaling to upsizing (additive CPU)
#             adjustments. Higher tiers (1-2) receive more aggressive responses
#             to RunQ pressure due to lower latency tolerance. Tier 3 is the
#             baseline. Tier 4 receives slightly moderated adjustments.
#
# ARGUMENTS:
#   1. $additive_cpu (float): The calculated additive CPU before tier scaling
#   2. $final_tier (string): The tier identifier (e.g., "G3", "O1", "P")
#
# RETURNS:
#   - Hash containing:
#       scaled_value: The tier-adjusted additive CPU value
#       scaling_factor: The multiplier applied
#       tier_number: The extracted tier number
#       rationale: Human-readable explanation for logging
# ==============================================================================
sub apply_tier_aware_upsizing_scaling {
    my ($additive_cpu, $final_tier) = @_;

    # Default result (no scaling)
    my %result = (
        scaled_value   => $additive_cpu,
        scaling_factor => 1.00,
        tier_number    => 'N/A',
        rationale      => 'No tier-based scaling applied',
    );

    # Only scale positive values (upsizing adjustments)
    return \%result if (!defined $additive_cpu || $additive_cpu <= 0);

    # Extract tier number from tier identifier
    # Handles formats: G3, O1, B4, P (P is treated as tier 1)
    my $tier_num;
    if (defined $final_tier && $final_tier =~ /(\d)$/) {
        $tier_num = $1;
    } elsif (defined $final_tier && $final_tier eq 'P') {
        $tier_num = 1;  # P-tier is equivalent to tier 1
    } else {
        return \%result;  # Cannot determine tier, no scaling
    }

    # Tier-based scaling factors
    my %tier_upsizing_factors = (
        1 => 1.25,  # Tier 1: +25% aggressive response (low latency tolerance)
        2 => 1.15,  # Tier 2: +15% enhanced response
        3 => 1.00,  # Tier 3: Baseline STANDARD correction
        4 => 0.95,  # Tier 4: Slightly moderated (still substantial)
    );

    # Apply scaling if tier is valid
    if (exists $tier_upsizing_factors{$tier_num}) {
        my $factor = $tier_upsizing_factors{$tier_num};
        my $scaled = $additive_cpu * $factor;

        $result{scaled_value}   = $scaled;
        $result{scaling_factor} = $factor;
        $result{tier_number}    = $tier_num;

        # Generate detailed rationale
        if ($factor > 1.0) {
            my $increase_pct = ($factor - 1.0) * 100;
            $result{rationale} = sprintf(
                "Tier %d: Enhanced upsizing (+%.0f%%) for lower latency tolerance. Base: %.3f -> Scaled: %.3f cores",
                $tier_num, $increase_pct, $additive_cpu, $scaled
            );
        } elsif ($factor < 1.0) {
            my $decrease_pct = (1.0 - $factor) * 100;
            $result{rationale} = sprintf(
                "Tier %d: Moderated upsizing (-%.0f%%) for standard efficiency. Base: %.3f -> Scaled: %.3f cores",
                $tier_num, $decrease_pct, $additive_cpu, $scaled
            );
        } else {
            $result{rationale} = sprintf(
                "Tier %d: Standard baseline correction (no scaling). Value: %.3f cores",
                $tier_num, $scaled
            );
        }
    }

    return \%result;
}

# ==============================================================================
# SUBROUTINE: _tier_guarantee_floor
# PURPOSE:    Smallest entitlement at which this tier's reliance on unguaranteed
#             (pool) capacity stays within its declared dispatch budget.
#
#             Demand above the guarantee is served from the pool - that is
#             DEPENDENCY. The room between the guarantee and what the LPAR can
#             reach is the non-guaranteed BAND. The budget declares how far into
#             that band a tier may rely:
#
#                 Demand - Ent  <=  Budget x (Reachable - Ent)
#                 Ent  >=  (Demand - Budget x Reachable) / (1 - Budget)
#
#             This supersedes the AAE/PAE guardrail, which measured dependency
#             against the entitlement the VM has TODAY whilst the decision
#             concerns the entitlement it should have TOMORROW - and which, being
#             profile-relative, returned contradictory verdicts on 34% of a
#             97-VM estate (the same partition reading PAE 1.0000 on one profile
#             and 0.0000 on another).
#
#             Demand is the tier-applicable GuaranteeDemand witness resolved by
#             the caller. It combines the selected planning demand with the
#             tier-retained yield witness; for P it includes the complete credible
#             Peak_P-99W1. Where PhysC is censored, the positive RunQ additive is
#             the independent demand witness; tactical pressure gating is added
#             separately and is not implied by this helper.
# ARGUMENTS:  1. $demand_cores  Tier-applicable GuaranteeDemand
#             2. $reachable_cores  min(VP, Pool), or entitlement when capped
#             3. $is_capped
#             4. $budget        Tier dispatch budget (fraction of the band)
#             5. $tier_label    For the rationale string
# RETURNS:    ($floor_cores, $reason) - $floor_cores undef when no floor applies
# ==============================================================================
sub _tier_guarantee_floor {
    my ($demand_cores, $reachable_cores, $is_capped, $budget, $tier_label) = @_;
    $tier_label = 'unknown' unless (defined $tier_label && length $tier_label);

    return (undef, "no floor: applicable guarantee demand unavailable")
        unless (defined $demand_cores && looks_like_number($demand_cores) && $demand_cores > 0);
    return (undef, "no floor: dispatch budget unresolved")
        unless (defined $budget && looks_like_number($budget) && $budget >= 0);

    # Capped LPAR: Reachable == Ent, so the band is zero and the algebra collapses
    # to Ent >= Demand at every tier. Nothing designed this - it falls out. A
    # capped partition cannot borrow, so its guarantee must cover the complete
    # demand witness selected by tier policy.
    if ($is_capped) {
        return ($demand_cores, sprintf(
            "capped LPAR: no non-guaranteed band exists, so the guarantee must cover the applicable demand witness (%.2f cores)",
            $demand_cores));
    }

    return (undef, "no floor: reachable capacity unavailable")
        unless (defined $reachable_cores && looks_like_number($reachable_cores) && $reachable_cores > 0);

    if ($budget >= 1.0 - $FLOAT_EPSILON) {
        return (undef, sprintf(
            "no floor: tier '%s' budget 1.00 permits reliance on the entire non-guaranteed band",
            $tier_label));
    }

    if ($demand_cores > $reachable_cores + $FLOAT_EPSILON) {
        return ($reachable_cores, sprintf(
            "INFEASIBLE: applicable demand %.2f cores exceeds reachable capacity %.2f - review proposed VPs, pool capacity and censoring evidence. Floor pinned at reachable.",
            $demand_cores, $reachable_cores));
    }

    my $floor = ($demand_cores - ($budget * $reachable_cores)) / (1.0 - $budget);
    $floor = 0            if ($floor < 0);
    $floor = $demand_cores if ($floor > $demand_cores);   # defensive: floor <= demand whenever reachable >= demand

    return ($floor, sprintf(
        "tier '%s' budget %.0f%%: applicable demand %.2f cores, reachable %.2f. Guarantee must be >= %.2f so that pool reliance (%.2f cores) stays within %.0f%% of the non-guaranteed band (%.2f cores)",
        $tier_label, $budget * 100, $demand_cores, $reachable_cores, $floor,
        $demand_cores - $floor, $budget * 100, $reachable_cores - $floor));
}

# ==============================================================================
# SUBROUTINE: _resolve_dispatch_budget
# PURPOSE:    Resolve the tier's dispatch budget. Mirrors _resolve_runq_target:
#             the tier NUMBER carries the appetite; the pattern letter is a
#             time-window selector and carries none.
# ARGUMENTS:  1. $final_tier (string): tier label, e.g. 'G1', 'B3', 'P'.
# RETURNS:    ($budget, $reason)
# ==============================================================================
sub _resolve_dispatch_budget {
    my ($final_tier) = @_;
    $final_tier = '' unless defined $final_tier;

    return ($DISPATCH_BUDGET_BY_TIER{$final_tier}, "tier '$final_tier'")
        if exists $DISPATCH_BUDGET_BY_TIER{$final_tier};
    return ($DISPATCH_BUDGET_BY_TIER{'P'}, "fallback: mission-critical 'P' rung")
        if ($final_tier =~ /^P/i);

    my ($num) = ($final_tier =~ /(\d)$/);
    $num = 3 unless (defined $num && $num >= 1 && $num <= 4);
    return ($DISPATCH_BUDGET_BY_TIER{'G' . $num}, "fallback: tier-$num rung");
}

# ==============================================================================
# SUBROUTINE: _ceil_to_granule
# PURPOSE:    Round a core value UP to the nearest implementable entitlement
#             granule. Used by the proposal-relative guarantee-floor convergence
#             so a raised planning entitlement is expressible at the configured
#             granularity - never whole-core rounding, which would over-provision
#             (e.g. a 14.54-core floor must not become 15.00).
# ARGUMENTS:  1. $value    core value to round up
#             2. $granule  entitlement granule (e.g. $DEFAULT_ROUND_INCREMENT)
# RETURNS:    $value rounded up to the granule (or $value unchanged if inputs
#             are unusable)
# ==============================================================================
sub _ceil_to_granule {
    my ($value, $granule) = @_;
    return $value unless (defined $value && looks_like_number($value));
    return $value unless (defined $granule && looks_like_number($granule) && $granule > 0);
    my $units = $value / $granule;
    my $c = int($units);
    $c++ if ($units > $c + 1e-12);
    return $c * $granule;
}

# ==============================================================================
# SUBROUTINE: _assert_budget_invariant
# PURPOSE:    Soft (non-fatal) check of the tier guarantee-floor invariant on a
#             FINALISED strategic pair. The invariant is the same algebra the
#             floor enforces, evaluated against the pair actually recommended:
#
#                 Demand - Ent  <=  Budget x (Reachable - Ent) + eps
#
#             Production surfaces any failure as a rationale/debug flag, never a
#             batch abort. Reusable so it can be invoked after EVERY path that
#             overwrites the final strategic rENT/rVCPU (authoritative and
#             seasonal), keeping the guarantee honest wherever the pair is set.
# ARGUMENTS:  1. $demand     tier-applicable GuaranteeDemand
#             2. $ent        finalised strategic (planning) entitlement
#             3. $reachable  proposed reachability: min(proposed VP, pool)
#                            uncapped, or entitlement when capped
#             4. $is_capped
#             5. $budget     tier dispatch budget
#             6. $tier_label for the message
# RETURNS:    ($holds, $message)  - $holds is 1/0, or undef when the
#             invariant cannot be evaluated from the available inputs
# ==============================================================================
sub _assert_budget_invariant {
    my ($demand, $ent, $reachable, $is_capped, $budget, $tier_label) = @_;
    $tier_label = 'unknown' unless (defined $tier_label && length $tier_label);

    return (undef, "not evaluated: inputs unavailable")
        unless (defined $demand && looks_like_number($demand)
             && defined $ent    && looks_like_number($ent)
             && defined $budget && looks_like_number($budget)
             && defined $is_capped);

    if ($is_capped) {
        # Capped: reachable == entitlement, band is zero, guarantee must cover
        # the complete applicable demand witness.
        my $ok = ($ent + $FLOAT_EPSILON >= $demand) ? 1 : 0;
        return ($ok, sprintf("capped LPAR: guarantee %.4f %s applicable demand %.4f",
            $ent, $ok ? '>=' : '<', $demand));
    }

    return (undef, "not evaluated: reachable capacity unavailable")
        unless (defined $reachable && looks_like_number($reachable));

    if ($reachable < $ent - $FLOAT_EPSILON) {
        return (0, sprintf(
            "INVALID CONFIGURATION: proposed reachable %.2f is less than entitlement %.4f",
            $reachable, $ent));
    }

    if ($demand > $reachable + $FLOAT_EPSILON) {
        # A budget of 1.00 permits use of the whole reachable band; it does not
        # make demand beyond that band physically reachable.
        return (0, sprintf(
            "INFEASIBLE: applicable demand %.2f exceeds proposed reachable %.2f; additional VPs/pool required",
            $demand, $reachable));
    }

    return (1, sprintf("tier '%s' budget 1.00: full reachable non-guaranteed band reliance permitted", $tier_label))
        if ($budget >= 1.0 - $FLOAT_EPSILON);

    my $lhs = $demand - $ent;
    my $rhs = $budget * ($reachable - $ent);
    my $ok  = ($lhs <= $rhs + 1e-6) ? 1 : 0;
    my $pen = 0;
    if ($demand > $ent && $reachable - $ent > $FLOAT_EPSILON) {
        $pen = (($demand - $ent) / ($reachable - $ent)) * 100;
    }
    return ($ok, sprintf(
        "tier '%s' budget %.0f%%: pool reliance %.1f%% of non-guaranteed band (demand %.2f, guarantee %.4f, reachable %.2f) - %s",
        $tier_label, $budget * 100, $pen, $demand, $ent, $reachable, $ok ? 'within budget' : 'EXCEEDS budget'));
}

# ==============================================================================
# SUBROUTINE: _smt_yield
# PURPOSE:    Throughput of one core running $k threads, relative to that core
#             running a single thread. Log-linear interpolation between the
#             configured points; clamped at both ends.
# ARGUMENTS:  1. $k (threads per core)
# RETURNS:    yield multiplier (>= 1.0)
# ==============================================================================
sub _smt_yield {
    my ($k) = @_;

    unless (@SMT_YIELD_POINTS) {
        @SMT_YIELD_POINTS = map { [ $_ + 0, $SMT_YIELD_CURVE{$_} + 0 ] }
                            sort { $a <=> $b } keys %SMT_YIELD_CURVE;
    }
    return 1.00 unless (@SMT_YIELD_POINTS);
    return $SMT_YIELD_POINTS[0][1]  if (!defined $k || $k <= $SMT_YIELD_POINTS[0][0]);
    return $SMT_YIELD_POINTS[-1][1] if ($k >= $SMT_YIELD_POINTS[-1][0]);

    for my $i (0 .. $#SMT_YIELD_POINTS - 1) {
        my ($k0, $y0) = @{ $SMT_YIELD_POINTS[$i] };
        my ($k1, $y1) = @{ $SMT_YIELD_POINTS[$i + 1] };
        next unless ($k >= $k0 && $k <= $k1);
        my $span = log($k1) - log($k0);
        return $y0 if ($span <= 0);
        return $y0 + (($y1 - $y0) * ((log($k) - log($k0)) / $span));
    }
    return $SMT_YIELD_POINTS[-1][1];
}

# ==============================================================================
# SUBROUTINE: _yield_aware_active_core_floor
# PURPOSE:    Smallest number of concurrently active cores that retains the
#             required share of the workload's estimated throughput at its
#             observed peak.
#
#             Estimated throughput on C active cores, with R runnable threads:
#                 T(C) = C * Y(clamp(R/C, curve bounds))
#             T is strictly increasing in C: in the interpolated region
#             dT/dC = Y(k) - 0.45/ln2 = Y(k) - 0.649 >= 0.35 for k >= 1, and it is
#             linear in the clamped regions. The floor is therefore unique and
#             bisection is sound. T(0) = 0 < target <= T(peak), so the bracket
#             [0, peak] is always valid.
#
#             k below 1 (PhysC exceeding runnable threads) is not a physical
#             state - a thread cannot consume more than one core - but arises
#             because RunQ is sampled instantaneously whilst PhysC is averaged
#             over the interval. It is clamped to 1 rather than trusted, which is
#             the conservative reading: the peak stands almost untouched.
#
#             For an UNCAPPED LPAR this is an active-core (and hence VP) floor.
#             For a CAPPED LPAR, entitlement is the dispatch ceiling, so it also
#             bounds entitlement - exposed via debug, not yet wired.
# ARGUMENTS:  1. $active_cores     Cores executing the work at the peak. Currently
#                                  the PhysC peak, which INCLUDES ceded/idle
#                                  consumption. PhysB (physical processors busy)
#                                  is the correct input and is not yet staged.
#                                  Because PhysB <= PhysC, the true threads-per-
#                                  busy-core is HIGHER than we compute, so this
#                                  floor is systematically CONSERVATIVE: it keeps
#                                  more width than PhysB evidence would justify.
#                                  IBM's guidance is explicit that VP decisions
#                                  should not rest on PhysC alone.
#             2. $threads_per_core Paired runnable density x SMT at the same tail
#             3. $retention        Required throughput share (0 < r <= 1)
# RETURNS:    ($floor_cores, $reason) or (undef, $reason) when not computable
# ==============================================================================
sub _yield_aware_active_core_floor {
    my ($active_cores, $threads_per_core, $retention) = @_;

    return (undef, 'peak PhysC unavailable')
        unless (defined $active_cores && looks_like_number($active_cores) && $active_cores > 0);
    return (undef, 'paired runnable density unavailable - no throughput estimate possible')
        unless (defined $threads_per_core && looks_like_number($threads_per_core) && $threads_per_core > 0);
    return ($active_cores, 'retention >= 100%: no consolidation permitted')
        unless (defined $retention && looks_like_number($retention) && $retention > 0 && $retention < 1.0);

    my $k0_raw = $threads_per_core + 0;
    my $k0     = ($k0_raw < 1.0) ? 1.0 : $k0_raw;
    my $threads = $k0 * $active_cores;              # implied runnable threads at the peak
    my $t0      = $active_cores * _smt_yield($k0);
    my $target  = $retention * $t0;

    my ($lo, $hi) = (0.0, $active_cores + 0);
    my $iter = 0;
    while (($hi - $lo) > 0.001 && $iter++ < 60) {
        my $mid = ($lo + $hi) / 2;
        my $t_mid = ($mid > 0) ? ($mid * _smt_yield($threads / $mid)) : 0;
        if ($t_mid >= $target) { $hi = $mid } else { $lo = $mid }
    }
    $hi = $active_cores if ($hi > $active_cores);

    my $reason = sprintf(
        "%.2f threads/core%s at a %.2f-core peak -> yield %.3f, throughput %.2f units; retaining %.0f%% (%.2f units) needs %.2f active cores (%.0f%% of peak) [curve: %s v%d, %s]",
        $k0_raw, (($k0_raw < 1.0) ? " (clamped to 1.00: RunQ sampling artefact)" : ""),
        $active_cores, _smt_yield($k0), $t0, $retention * 100, $target, $hi,
        ($active_cores > 0 ? ($hi / $active_cores) * 100 : 0),
        $SMT_YIELD_CURVE_NAME, $SMT_YIELD_CURVE_VERSION, $SMT_YIELD_CURVE_SOURCE);

    return ($hi, $reason);
}

# ==============================================================================
# SUBROUTINE: _resolve_tier_throughput_retention
# PURPOSE:    Resolve the configured credible-peak throughput-retention policy.
#             P is deliberately distinct from numeric tier 1 for this control;
#             the existing numeric tier remains valid for RunQ width and tactical
#             rate limiting. Centralising this small resolution step prevents the
#             authoritative, CSV-fallback and seasonal paths from drifting.
# ARGUMENTS:  1. $tier_label  Final/profile tier label (P, O1, G3, B4, or a
#                             profile name beginning with one of those labels)
#             2. $tier_num    Existing numeric fallback (1..4)
# RETURNS:    ($retention, $policy_key)
# ==============================================================================
sub _resolve_tier_throughput_retention {
    my ($tier_label, $tier_num) = @_;

    my $label = defined($tier_label) ? "$tier_label" : '';
    $label =~ s/-.*$//;
    $label = uc($label);

    if ($label eq 'P') {
        my $retention = $TIER_THROUGHPUT_RETENTION{'P'};
        $retention = 1.00 unless (defined $retention && looks_like_number($retention));
        $retention = 1.00 if ($retention > 1.00);
        $retention = 0.01 if ($retention <= 0);
        return ($retention + 0, 'P');
    }

    if ($label =~ /(\d)$/) {
        $tier_num = $1;
    }
    $tier_num = 3
        unless (defined $tier_num && looks_like_number($tier_num)
                && $tier_num >= 1 && $tier_num <= 4);
    $tier_num = int($tier_num);

    my $retention = $TIER_THROUGHPUT_RETENTION{$tier_num};
    $retention = $TIER_THROUGHPUT_RETENTION{3}
        unless (defined $retention && looks_like_number($retention));
    $retention = 0.92
        unless (defined $retention && looks_like_number($retention));
    $retention = 1.00 if ($retention > 1.00);
    $retention = 0.01 if ($retention <= 0);

    return ($retention + 0, "tier-$tier_num");
}

# ==============================================================================
# SUBROUTINE: _resolve_pool_evidence
# PURPOSE:    Keep configured pool geometry distinct from measured spare-pool
#             availability. No availability telemetry is staged today, so the
#             normal uncapped result is an explicitly-labelled advisory proxy:
#             min(proposed VPs, configured pool size) when the pool ceiling is
#             known, otherwise proposed VPs. This helper is audit-only in A2.6;
#             it does not replace the existing sizing or invariant arithmetic.
# ARGUMENTS:  hashref containing proposed_vcpu, proposed_entitlement,
#             pool_size, measured_lpar_reachable_capacity and is_capped.
#             measured_lpar_reachable_capacity is a measured TOTAL reachability
#             ceiling for this LPAR. It is not APP and not raw spare-pool cores.
# RETURNS:    hashref of distinct pool/reachability audit fields.
# ==============================================================================
sub _resolve_pool_evidence {
    my ($terms) = @_;
    $terms = {} unless (defined $terms && ref($terms) eq 'HASH');

    die "available_pool_capacity is ambiguous and unsupported; use "
      . "measured_lpar_reachable_capacity only for a measured total LPAR "
      . "reachability ceiling (never raw APP/spare-pool cores)\n"
        if exists $terms->{available_pool_capacity};

    my $vp = (defined $terms->{proposed_vcpu}
              && looks_like_number($terms->{proposed_vcpu})
              && $terms->{proposed_vcpu} > 0)
           ? ($terms->{proposed_vcpu} + 0) : undef;
    my $ent = (defined $terms->{proposed_entitlement}
               && looks_like_number($terms->{proposed_entitlement})
               && $terms->{proposed_entitlement} > 0)
            ? ($terms->{proposed_entitlement} + 0) : undef;
    my $pool_size = (defined $terms->{pool_size}
                     && looks_like_number($terms->{pool_size})
                     && $terms->{pool_size} > 0)
                  ? ($terms->{pool_size} + 0) : undef;
    my $measured_reachable = (defined $terms->{measured_lpar_reachable_capacity}
                              && looks_like_number($terms->{measured_lpar_reachable_capacity})
                              && $terms->{measured_lpar_reachable_capacity} >= 0)
                           ? ($terms->{measured_lpar_reachable_capacity} + 0) : undef;
    my $is_capped = $terms->{is_capped} ? 1 : 0;

    my ($status, $reachable, $basis, $note);
    if ($is_capped) {
        $status    = 'NOT_APPLICABLE';
        $reachable = $ent;
        $basis     = 'ENTITLEMENT';
        $note      = 'capped LPAR: reachable capacity is the proposed entitlement';
    } elsif (defined $measured_reachable) {
        $status    = 'MEASURED';
        $reachable = defined($vp) ? min($vp, $measured_reachable) : $measured_reachable;
        $basis     = 'MEASURED_LPAR_REACHABILITY';
        $note      = 'measured total LPAR reachability limits proposed VP reachability';
    } elsif (defined $pool_size) {
        $status    = 'UNKNOWN';
        $reachable = defined($vp) ? min($vp, $pool_size) : $pool_size;
        $basis     = 'CONFIGURED_POOL_CEILING_PROXY';
        $note      = 'configured pool size is an architectural ceiling, not measured spare capacity';
    } else {
        $status    = 'UNKNOWN';
        $reachable = $vp;
        $basis     = 'PROPOSED_VCPU_PROXY';
        $note      = 'pool size and spare-capacity telemetry unavailable; proposed VPs used as advisory proxy';
    }

    return {
        PoolSize                  => defined($pool_size) ? sprintf('%.2f', $pool_size) : 'N/A',
        MeasuredLPARReachableCapacity => defined($measured_reachable) ? sprintf('%.2f', $measured_reachable) : 'N/A',
        PoolAvailabilityStatus    => $status,
        ProposedReachable         => defined($reachable) ? sprintf('%.2f', $reachable) : 'N/A',
        ProposedReachabilityBasis => $basis,
        ProposedReachableIsProxy  => (!$is_capped && !defined($measured_reachable)) ? 1 : 0,
        PoolEvidenceNote          => $note,
    };
}

# ==============================================================================
# SUBROUTINE: _assess_pool_reliance
# PURPOSE:    Side-effect-free assessment of how far a proposed entitlement/VP
#             pair leans on non-guaranteed (shared-pool) capacity, expressed
#             against the tier's dispatch budget. Diagnostic only: it never
#             sizes, clamps or converges anything. Mirrors the guarantee-floor
#             algebra in _tier_guarantee_floor - pool reliance is the demand
#             above entitlement measured against the non-guaranteed band
#             (reachable minus entitlement), and must stay within the tier
#             budget fraction.
# CLASS:      NONE                - applicable demand already covered by guarantee
#             TRANSIENT_EVENT     - baseline covered; only a retained peak/burst leans
#             STRUCTURAL_BASELINE - ordinary planning demand itself leans on the pool
#             NOT_APPLICABLE      - capped LPAR, or inputs unavailable
# ARGUMENTS:  hashref: applicable_demand, base_planning_demand,
#             proposed_entitlement, reachable, is_capped, dispatch_budget
# RETURNS:    hashref of PoolReliance* fields (stringified/steady for the audit)
# ==============================================================================
sub _assess_pool_reliance {
    my ($t) = @_;
    $t = {} unless (defined $t && ref($t) eq 'HASH');

    my $num = sub {
        my ($v) = @_;
        return (defined $v && looks_like_number($v)) ? ($v + 0) : undef;
    };

    my %out = (
        PoolRelianceApplicableDemand    => 'N/A',
        PoolRelianceProposedEntitlement => 'N/A',
        PoolRelianceReachable           => 'N/A',
        PoolReliancePct                 => 'N/A',
        PoolRelianceBudgetPct           => 'N/A',
        PoolRelianceAssessment          => 'NOT_APPLICABLE',
        PoolRelianceClass               => 'NOT_APPLICABLE',
    );

    my $demand    = $num->($t->{applicable_demand});
    my $base      = $num->($t->{base_planning_demand});
    my $ent       = $num->($t->{proposed_entitlement});
    my $reach     = $num->($t->{reachable});
    my $budget    = $num->($t->{dispatch_budget});
    my $is_capped = $t->{is_capped} ? 1 : 0;

    # Without a resolved budget there is no policy test to make.
    return { %out } unless (defined $budget && $budget >= 0);
    $out{PoolRelianceBudgetPct} = sprintf('%.2f', $budget);

    return { %out } unless (defined $demand && defined $ent);
    $out{PoolRelianceApplicableDemand}    = sprintf('%.2f', $demand);
    $out{PoolRelianceProposedEntitlement} = sprintf('%.2f', $ent);

    # Capped LPAR: no non-guaranteed band exists, so pool reliance is not a
    # meaningful concept (the guarantee floor collapses to Ent >= Demand).
    if ($is_capped) {
        $out{PoolRelianceReachable}  = sprintf('%.2f', $ent);
        $out{PoolReliancePct}        = '0.00';
        $out{PoolRelianceAssessment} = 'NOT_APPLICABLE';
        $out{PoolRelianceClass}      = 'NONE';
        return { %out };
    }

    return { %out } unless (defined $reach);
    $out{PoolRelianceReachable} = sprintf('%.2f', $reach);

    my $reliance_cores = $demand - $ent;
    $reliance_cores = 0 if ($reliance_cores < 0);

    # No lean at all: applicable demand is inside the guarantee.
    if ($reliance_cores <= $FLOAT_EPSILON) {
        $out{PoolReliancePct}        = '0.00';
        $out{PoolRelianceAssessment} = 'WITHIN_ALLOWANCE';
        $out{PoolRelianceClass}      = 'NONE';
        return { %out };
    }

    # A lean exists; classify it as transient (only a retained peak/burst leans)
    # or structural (ordinary planning demand itself exceeds entitlement).
    my $structural = (defined $base && $base > $ent + $FLOAT_EPSILON) ? 1 : 0;
    $out{PoolRelianceClass} = $structural ? 'STRUCTURAL_BASELINE' : 'TRANSIENT_EVENT';

    # Infeasible width: applicable demand exceeds reachable capacity entirely,
    # so no entitlement can bring reliance within band (mirrors _tier_guarantee_floor).
    if ($demand > $reach + $FLOAT_EPSILON) {
        $out{PoolReliancePct}        = 'N/A';
        $out{PoolRelianceAssessment} = 'INFEASIBLE_WIDTH';
        return { %out };
    }

    # demand > ent and demand <= reach => band strictly positive.
    my $band_cores = $reach - $ent;
    my $frac = $reliance_cores / $band_cores;
    $out{PoolReliancePct}        = sprintf('%.2f', $frac);
    $out{PoolRelianceAssessment} =
        ($frac <= $budget + $FLOAT_EPSILON) ? 'WITHIN_ALLOWANCE' : 'EXCEEDS_ALLOWANCE';

    return { %out };
}

# ==============================================================================
# SUBROUTINE: _build_rvcpu_policy_audit
# PURPOSE:    Build calculation provenance and policy metadata for an rVCPU
#             recommendation without participating in sizing. All execution
#             paths persist this same shape so a planner can distinguish the
#             authoritative, seasonal and CSV-fallback calculations.
# ARGUMENTS:  hashref containing tier_label, tier_num, path,
#             convergence_mode, overwrote_authoritative, proposed_vcpu,
#             proposed_entitlement, pool_size, optional
#             measured_lpar_reachable_capacity, and is_capped.
# RETURNS:    hashref suitable for Profile_rVCPU_Explain.
# ==============================================================================
sub _build_rvcpu_policy_audit {
    my ($terms) = @_;
    $terms = {} unless (defined $terms && ref($terms) eq 'HASH');

    my $tier_label = defined($terms->{tier_label}) && $terms->{tier_label} ne ''
                   ? $terms->{tier_label} : 'N/A';
    my $tier_num = $terms->{tier_num};
    my ($dispatch_budget, $dispatch_policy) = _resolve_dispatch_budget($tier_label);
    my ($retention, $retention_policy) =
        _resolve_tier_throughput_retention($tier_label, $tier_num);
    my $pool_evidence = _resolve_pool_evidence({
        proposed_vcpu          => $terms->{proposed_vcpu},
        proposed_entitlement   => $terms->{proposed_entitlement},
        pool_size              => $terms->{pool_size},
        measured_lpar_reachable_capacity => $terms->{measured_lpar_reachable_capacity},
        is_capped              => $terms->{is_capped},
    });

    my $pool_reliance = _assess_pool_reliance({
        applicable_demand    => $terms->{applicable_demand},
        base_planning_demand => $terms->{base_planning_demand},
        proposed_entitlement => $terms->{proposed_entitlement},
        reachable            => $pool_evidence->{ProposedReachable},
        is_capped            => $terms->{is_capped},
        dispatch_budget      => $dispatch_budget,
    });

    return {
        %{$pool_evidence},
        %{$pool_reliance},
        PolicyContractVersion      => $RIGHTSIZING_POLICY_CONTRACT_VERSION,
        RecommendationPath         => $terms->{path} // 'UNKNOWN',
        StrategicConvergenceMode   => $terms->{convergence_mode} // 'UNKNOWN',
        OverwroteAuthoritativePair => $terms->{overwrote_authoritative} ? 1 : 0,
        TierPolicySource           => $tier_label,
        DispatchBudget             => sprintf('%.2f', $dispatch_budget),
        DispatchBudgetPolicy       => $dispatch_policy,
        ThroughputRetention        => sprintf('%.2f', $retention),
        ThroughputRetentionPolicy  => $retention_policy,
        YieldCurveName             => $SMT_YIELD_CURVE_NAME,
        YieldCurveVersion          => $SMT_YIELD_CURVE_VERSION,
        YieldCurveSource           => $SMT_YIELD_CURVE_SOURCE,
    };
}

# ==============================================================================
# SUBROUTINE: _mirror_rvcpu_policy_audit
# PURPOSE:    Mirror policy/provenance fields into the per-profile debug hash
#             consumed by planner rationale and diagnostic output.
# ==============================================================================
sub _mirror_rvcpu_policy_audit {
    my ($audit, $debug) = @_;
    return unless (defined $audit && ref($audit) eq 'HASH');
    return unless (defined $debug && ref($debug) eq 'HASH');

    for my $key (keys %$audit) {
        $debug->{"rVCPU_$key"} = defined($audit->{$key}) ? $audit->{$key} : 'N/A';
    }
}

# ==============================================================================
# SUBROUTINE: _configured_burst_vp_floor
# PURPOSE:    Preserve explicit configured burst width only when current-state
#             evidence says it is relevant. The credible P99W1 peak is the
#             activation witness; BasePlanningDemand is the sustained-demand
#             numerator. This avoids both a universal Ent*1.25 rule and the
#             semantic error of treating P99W1 as sustained demand for all tiers.
#
#             Active only when:
#               * the LPAR is uncapped;
#               * current entitlement, VPs and pool size are known;
#               * the pool provides a real burst band above entitlement;
#               * credible peak >= the A2.2 CAUTION share of current reach; and
#               * DBW/XRQ pathology does not invalidate the peak interpretation.
#
#             P is intentionally not assigned a target utilisation: raw P99W1
#             is already a hard peak floor through the tier-retention policy.
# ARGUMENTS:  hashref containing base_demand, credible_peak, current_vp,
#             current_entitlement, pool_cpu, is_capped, tier_label, tier_num,
#             and optional evidence hashref.
# RETURNS:    hashref with active, floor, target, policy_key, current_reachable,
#             peak_reach_ratio and reason.
# ==============================================================================
sub _configured_burst_vp_floor {
    my ($terms) = @_;
    $terms = {} unless (defined $terms && ref($terms) eq 'HASH');
    my $evidence = (defined $terms->{evidence} && ref($terms->{evidence}) eq 'HASH')
                 ? $terms->{evidence} : {};

    my $result = {
        active            => 0,
        floor             => undef,
        target            => undef,
        policy_key        => undef,
        current_reachable => undef,
        peak_reach_ratio  => undef,
        reason            => 'inactive: required evidence unavailable',
    };

    my $label = defined($terms->{tier_label}) ? "$terms->{tier_label}" : '';
    $label =~ s/-.*$//;
    $label = uc($label);
    if ($label eq 'P') {
        $result->{policy_key} = 'P';
        $result->{reason} = 'inactive: P uses raw Peak_P-99W1 as its hard VP floor';
        return $result;
    }

    my $tier_num = $terms->{tier_num};
    $tier_num = $1 if ($label =~ /(\d)$/);
    $tier_num = 3 unless (defined $tier_num && looks_like_number($tier_num)
                          && $tier_num >= 1 && $tier_num <= 4);
    $tier_num = int($tier_num);
    my $target = $VCPU_CONFIGURED_BURST_TARGET_UTILISATION{$tier_num};
    $target = $VCPU_CONFIGURED_BURST_TARGET_UTILISATION{3}
        unless (defined $target && looks_like_number($target) && $target > 0 && $target <= 1);
    $result->{target}     = $target + 0;
    $result->{policy_key} = "tier-$tier_num";

    if ($terms->{is_capped}) {
        $result->{reason} = 'inactive: capped LPAR has no configured pool-burst band';
        return $result;
    }

    my $base = (defined $terms->{base_demand} && looks_like_number($terms->{base_demand})
                && $terms->{base_demand} > 0) ? ($terms->{base_demand} + 0) : undef;
    my $peak = (defined $terms->{credible_peak} && looks_like_number($terms->{credible_peak})
                && $terms->{credible_peak} > 0) ? ($terms->{credible_peak} + 0) : undef;
    my $vp   = (defined $terms->{current_vp} && looks_like_number($terms->{current_vp})
                && $terms->{current_vp} > 0) ? ($terms->{current_vp} + 0) : undef;
    my $ent  = (defined $terms->{current_entitlement} && looks_like_number($terms->{current_entitlement})
                && $terms->{current_entitlement} > 0) ? ($terms->{current_entitlement} + 0) : undef;
    my $pool = (defined $terms->{pool_cpu} && looks_like_number($terms->{pool_cpu})
                && $terms->{pool_cpu} > 0) ? ($terms->{pool_cpu} + 0) : undef;

    unless (defined $base && defined $peak && defined $vp && defined $ent && defined $pool) {
        my @missing;
        push @missing, 'BasePlanningDemand' unless defined $base;
        push @missing, 'Peak_P-99W1'        unless defined $peak;
        push @missing, 'current VPs'        unless defined $vp;
        push @missing, 'current entitlement' unless defined $ent;
        push @missing, 'pool capacity'      unless defined $pool;
        $result->{reason} = 'inactive: missing ' . join(', ', @missing);
        return $result;
    }

    if ($pool <= $ent + $FLOAT_EPSILON) {
        $result->{reason} = sprintf(
            'inactive: pool %.2f does not provide a burst band above entitlement %.2f',
            $pool, $ent);
        return $result;
    }

    my $current_reachable = ($vp < $pool) ? $vp : $pool;
    $result->{current_reachable} = $current_reachable;
    unless ($current_reachable > 0) {
        $result->{reason} = 'inactive: current reachable width is not positive';
        return $result;
    }

    my $ratio = $peak / $current_reachable;
    $result->{peak_reach_ratio} = $ratio;

    if (defined $evidence->{'RunQ_Potential'}
        && $evidence->{'RunQ_Potential'} =~ /ANOMALY\s*\((?:DBW|XRQ)\)/i) {
        $result->{reason} = "inactive: pathological RunQ evidence ($evidence->{'RunQ_Potential'})";
        return $result;
    }

    if ($ratio < $VCPU_REDUCTION_CAUTION_REACH_RATIO - $FLOAT_EPSILON) {
        $result->{reason} = sprintf(
            'inactive: Peak_P-99W1 is %.0f%% of current reach, below the %.0f%% activation threshold',
            $ratio * 100, $VCPU_REDUCTION_CAUTION_REACH_RATIO * 100);
        return $result;
    }

    my $floor_raw = $base / $target;
    my $floor = int($floor_raw);
    $floor++ if ($floor_raw > $floor);
    $floor = 1 if ($floor < 1);

    $result->{active} = 1;
    $result->{floor}  = $floor;
    $result->{reason} = sprintf(
        'active: BasePlanningDemand %.2f / target VP utilisation %.0f%% = %.2f -> %d VPs; Peak_P-99W1 %.2f is %.0f%% of current reach %.2f',
        $base, $target * 100, $floor_raw, $floor, $peak, $ratio * 100, $current_reachable);
    return $result;
}

# ==============================================================================
# SUBROUTINE: _resolve_guarantee_demand
# PURPOSE:    Resolve the tier-applicable demand witness used by the proposal-
#             relative guarantee floor and invariant. The selected planning
#             demand protects the workload quantity chosen by the planner; the
#             yield-adjusted peak protects the tier-approved share of credible-
#             peak throughput. P additionally treats the complete credible peak
#             as a hard witness. When yield evidence is unavailable, the raw
#             credible peak is the conservative fallback for every tier.
# ARGUMENTS:  1. $base_demand       Selected profile + growth + positive additive
#             2. $yield_demand      Yield-adjusted credible-peak active-core floor
#             3. $credible_peak     Raw Peak_P-99W1 PhysC
#             4. $tier_label        P, O1, G3, B4, or full profile label
# RETURNS:    ($demand, $source)
# ==============================================================================
sub _resolve_guarantee_demand {
    my ($base_demand, $yield_demand, $credible_peak, $tier_label) = @_;

    my $label = defined($tier_label) ? "$tier_label" : '';
    $label =~ s/-.*$//;
    $label = uc($label);

    my @candidates;
    push @candidates, [ $base_demand + 0, 'BasePlanningDemand' ]
        if (defined $base_demand && looks_like_number($base_demand) && $base_demand > 0);

    if (defined $yield_demand && looks_like_number($yield_demand) && $yield_demand > 0) {
        push @candidates, [ $yield_demand + 0, 'YieldAdjustedPeakDemand' ];
    } elsif (defined $credible_peak && looks_like_number($credible_peak) && $credible_peak > 0) {
        push @candidates, [ $credible_peak + 0,
            'Peak_P-99W1 conservative fallback (yield evidence unavailable)' ];
    }

    if ($label eq 'P'
        && defined $credible_peak && looks_like_number($credible_peak) && $credible_peak > 0) {
        push @candidates, [ $credible_peak + 0, 'Peak_P-99W1 hard P witness' ];
    }

    return (undef, 'unavailable: no valid base, yield or credible-peak demand')
        unless @candidates;

    my $max_value = $candidates[0][0];
    foreach my $candidate (@candidates) {
        $max_value = $candidate->[0] if ($candidate->[0] > $max_value);
    }

    my @governing = map { $_->[1] }
                    grep { abs($_->[0] - $max_value) <= 0.0005 } @candidates;
    my %seen;
    @governing = grep { !$seen{$_}++ } @governing;

    return ($max_value, join(' + ', @governing));
}

# ==============================================================================
# SUBROUTINE: _resolve_peak_runnable_density
# PURPOSE:    Return the PAIRED runnable-density estimate for the P99W1 peak:
#             runnable threads per consumed thread slot, formed per sample by
#             nfit as runq/(physc*smt) BEFORE smoothing and percentiling.
#
#             Supersedes the estimator that divided AbsRunQ_P99W1 by SMT and then
#             by PhysC_P99W1. Both express runq/(physc*smt), but that form is a
#             ratio of two percentiles which need not come from the same minute,
#             whereas NormRunQ is a percentile of per-sample ratios.
#             E[X/Y] != E[X]/E[Y], and the two disagree materially in production
#             (vm1: 1.947 unpaired against 1.08 paired).
#
#             Prefers the peak profile's own block at its PhysC-aligned tail,
#             degrading through coarser tails, then the unified collation.
# ARGUMENTS:  1. $vm_map_ref
# RETURNS:    ($occupancy, $source_label) or (undef, undef)
# ==============================================================================
sub _resolve_peak_runnable_density {
    my ($vm_map_ref) = @_;
    return (undef, undef) unless (ref($vm_map_ref) eq 'HASH');

    my @tails = ('NormRunQ_P99.75', 'NormRunQ_P99', 'NormRunQ_P98', 'NormRunQ_P95', 'NormRunQ_P90');
    my @sources;

    if (ref($vm_map_ref->{RunQMetricsByProfile}) eq 'HASH') {
        foreach my $pk ($MANDATORY_PEAK_PROFILE_FOR_HINT, $LEGACY_MANDATORY_PEAK_PROFILE_FOR_HINT) {
            next unless (defined $pk && ref($vm_map_ref->{RunQMetricsByProfile}{$pk}) eq 'HASH');
            push @sources, [ $vm_map_ref->{RunQMetricsByProfile}{$pk}, $pk ];
        }
    }
    push @sources, [ $vm_map_ref->{RunQMetrics}, 'unified collation' ]
        if (ref($vm_map_ref->{RunQMetrics}) eq 'HASH');

    foreach my $src (@sources) {
        my ($blk, $label) = @$src;
        foreach my $tail (@tails) {
            next unless (defined $blk->{$tail} && looks_like_number($blk->{$tail}));
            return ($blk->{$tail} + 0, sprintf("%s %s (paired)", $label, $tail));
        }
    }
    return (undef, undef);
}

# ==============================================================================
# SUBROUTINE: _resolve_runq_target
# PURPOSE:    Resolve the idealised run-queue depth (runnable threads per
#             logical CPU) that sizing should aim for, given a tier label.
#             This is the single source of truth for BOTH the downsizing path
#             (which sizes towards this depth) and the additive path (whose
#             tolerance ceiling is derived from it), so the two directions
#             cannot diverge.
# ARGUMENTS:  1. $final_tier (string): tier label, e.g. 'G1', 'B3', 'P'.
# RETURNS:    ($target, $reason)
# ==============================================================================
sub _resolve_runq_target {
    my ($final_tier) = @_;
    $final_tier = '' unless defined $final_tier;

    if (exists $custom_runq_targets{$final_tier}) {
        return ($custom_runq_targets{$final_tier},
                "User-defined target for tier '$final_tier' from nfit.profiles.cfg");
    }
    if (exists $DEFAULT_RUNQ_TARGETS{$final_tier}) {
        return ($DEFAULT_RUNQ_TARGETS{$final_tier},
                "Built-in tier-major target for tier '$final_tier'");
    }
    if ($final_tier =~ /^P/i) {
        return ($DEFAULT_RUNQ_TARGETS{'P'}, "Fallback: mission-critical 'P' rung");
    }

    # Tier-major fallback: the tier NUMBER carries the appetite, so an
    # unrecognised or number-less label decays to the tier-3 rung. The previous
    # fallback keyed on the pattern letter, which encodes only the measurement
    # window and therefore cannot imply a risk appetite.
    my ($num) = ($final_tier =~ /(\d)$/);
    $num = 3 unless (defined $num && $num >= 1 && $num <= 4);
    return (($DEFAULT_RUNQ_TARGETS{'G' . $num} // $DEFAULT_TARGET_NORM_RUNQ_FOR_EFFICIENCY_CALC),
            "Fallback: tier-$num rung (pattern letter carries no risk appetite)");
}

# ==============================================================================
# SUBROUTINE: _resolve_vm_tier_pattern_policy
# PURPOSE:    Resolve business-risk tier and workload time pattern once, without
#             allowing the statistical hint to infer business importance.
#
#             Configured VM tier:
#               policy tier and pattern both come from the configuration.
#
#             No valid configured VM tier:
#               policy tier is always tier 3; the hint may select only the
#               O/B/G time pattern. A P hint (for example, automatic VIO
#               recognition) does not silently confer mission-critical policy.
# ARGUMENTS:
#   1. $configured_tier (string): Confirmed tier from VM configuration.
#   2. $hint_tier       (string): Statistical hint; only its O/B/G letter is used
#                                when configuration is absent.
#   3. $profiles_aref (array ref): Loaded profile objects ({name, csv_output, ...}).
# RETURNS:
#   Hashref containing ResolvedPolicyTier, ResolvedTierLabel,
#   ResolvedPattern, ResolvedPlanningProfile, TierPolicySource and
#   PlanningPatternSource.
# ==============================================================================
sub _resolve_vm_tier_pattern_policy {
    my ($configured_tier, $hint_tier, $profiles_aref) = @_;

    $configured_tier //= '';
    $hint_tier       //= '';
    $profiles_aref = [] unless (defined $profiles_aref && ref($profiles_aref) eq 'ARRAY');

    $configured_tier = uc($configured_tier);
    $configured_tier =~ s/\s+//g;
    $hint_tier = uc($hint_tier);
    $hint_tier =~ s/^\s+|\s+$//g;

    my ($policy_tier, $pattern, $tier_label, $tier_source, $pattern_source);

    if ($configured_tier =~ /^P(?:-|$)/) {
        $policy_tier   = 'P';
        $pattern       = 'P';
        $tier_label    = 'P';
        $tier_source   = 'CONFIGURED_TIER';
        $pattern_source = 'CONFIGURED_TIER';
    } elsif ($configured_tier =~ /^([OGB])([1-4])(?:-|$)/) {
        $pattern       = $1;
        $policy_tier   = $2 + 0;
        $tier_label    = $pattern . $policy_tier;
        $tier_source   = 'CONFIGURED_TIER';
        $pattern_source = 'CONFIGURED_TIER';
    } else {
        # Hint contributes only the time-of-day pattern. Neither a hinted digit
        # nor automatic P/VIO recognition is allowed to declare risk appetite.
        $pattern = ($hint_tier =~ /^([OB])/) ? $1 : 'G';
        $policy_tier   = 3;
        $tier_label    = $pattern . '3';
        $tier_source   = 'DEFAULT_TIER_3';
        $pattern_source = ($hint_tier =~ /^[OBG]/) ? 'HINT_PATTERN' : 'DEFAULT_PATTERN_G';
    }

    my %canonical_suffix = (
        1 => '99W5',
        2 => '98W10',
        3 => '95W15',
        4 => '90W15',
    );
    my $canonical_profile = ($tier_label eq 'P')
        ? $MISSION_CRITICAL_PROFILE_NAME
        : sprintf('%s-%s', $tier_label, $canonical_suffix{$policy_tier} // '95W15');

    # Prefer the loaded CSV-visible profile for the resolved token. This keeps
    # custom profile naming usable while excluding helper/median companions.
    my @matches;
    if ($tier_label eq 'P') {
        @matches = grep {
            defined $_->{name} && $_->{name} eq $MISSION_CRITICAL_PROFILE_NAME
        } @$profiles_aref;
    } else {
        @matches = grep {
            defined $_->{name} && index($_->{name}, $tier_label . '-') == 0
        } @$profiles_aref;
    }
    my ($visible) = grep { $_->{csv_output} } @matches;
    my $resolved_profile = $visible // $matches[0];
    my $planning_profile = (defined $resolved_profile && defined $resolved_profile->{name})
        ? $resolved_profile->{name} : $canonical_profile;

    return {
        ResolvedPolicyTier      => $policy_tier,
        ResolvedTierLabel       => $tier_label,
        ResolvedPattern         => $pattern,
        ResolvedPlanningProfile => $planning_profile,
        TierPolicySource        => $tier_source,
        PlanningPatternSource   => $pattern_source,
    };
}

# Persist the central decision into the per-VM map and retain FinalTierForVM as
# a compatibility alias for consumers not yet migrated to the explicit fields.
sub _store_vm_tier_pattern_policy {
    my ($vm_map_ref, $configured_tier, $hint_tier, $profiles_aref) = @_;
    my $resolved = _resolve_vm_tier_pattern_policy(
        $configured_tier, $hint_tier, $profiles_aref);

    $vm_map_ref->{Hinting} //= {};
    foreach my $key (qw(
        ResolvedPolicyTier ResolvedTierLabel ResolvedPattern
        ResolvedPlanningProfile TierPolicySource PlanningPatternSource
    )) {
        $vm_map_ref->{Hinting}{$key} = $resolved->{$key};
    }
    $vm_map_ref->{Hinting}{FinalTierForVM} = $resolved->{ResolvedTierLabel};
    return $resolved;
}

# Backwards-compatible RunQ source resolver. All policy decisions now come from
# the central tier/pattern resolver above.
sub _resolve_runq_source_profile {
    my ($configured_tier, $hint_tier, $profiles_aref) = @_;
    my $resolved = _resolve_vm_tier_pattern_policy(
        $configured_tier, $hint_tier, $profiles_aref);
    my $name = $resolved->{ResolvedPlanningProfile};
    return ($name, sprintf('%s (%s)', $name, $resolved->{TierPolicySource}));
}

# --- _classify_vcpu_reduction_safety -------------------------------------
# Classify the evidence for a VP-only reduction under the CURRENT
# configuration. This is deliberately separate from strategic sizing:
# rVCPU/rVCPU_EntBounded remain visible even when the actionable Tactical
# recommendation is slowed or held.
#
# Inputs are already-resolved values plus the profile debug hash. The current
# reachable capacity is entitlement for capped LPARs, otherwise min(current
# VPs, pool) when pool size is known, or current VPs with a CAUTION marker when
# pool evidence is unavailable.
# ---------------------------------------------------------------------------
sub _classify_vcpu_reduction_safety
{
    my ($terms) = @_;
    $terms = {} unless (defined $terms && ref($terms) eq 'HASH');
    my $evidence = (defined $terms->{evidence} && ref($terms->{evidence}) eq 'HASH')
                 ? $terms->{evidence} : {};

    my $current_vp  = (defined $terms->{current_vp} && looks_like_number($terms->{current_vp})
                       && $terms->{current_vp} > 0) ? ($terms->{current_vp} + 0) : undef;
    my $current_ent = (defined $terms->{current_entitlement} && looks_like_number($terms->{current_entitlement})
                       && $terms->{current_entitlement} > 0) ? ($terms->{current_entitlement} + 0) : undef;
    my $pool_cpu    = (defined $terms->{pool_cpu} && looks_like_number($terms->{pool_cpu})
                       && $terms->{pool_cpu} > 0) ? ($terms->{pool_cpu} + 0) : undef;
    my $is_capped   = $terms->{is_capped} ? 1 : 0;
    my $peak_physc  = (defined $terms->{peak_physc} && looks_like_number($terms->{peak_physc})
                       && $terms->{peak_physc} > 0) ? ($terms->{peak_physc} + 0) : undef;
    my $guarantee_demand = (defined $terms->{guarantee_demand}
                            && looks_like_number($terms->{guarantee_demand})
                            && $terms->{guarantee_demand} > 0)
                         ? ($terms->{guarantee_demand} + 0) : undef;

    # Resolve pool state through the same semantic layer used by the strategic
    # audit. Current callers have configured pool geometry but no measured
    # spare-capacity telemetry, so uncapped status is normally UNKNOWN while
    # current reach remains the existing conservative min(VP, PoolSize) proxy.
    my $pool_evidence = _resolve_pool_evidence({
        proposed_vcpu           => $current_vp,
        proposed_entitlement    => $current_ent,
        pool_size               => $pool_cpu,
        measured_lpar_reachable_capacity => $terms->{measured_lpar_reachable_capacity},
        is_capped               => $is_capped,
    });
    my $pool_availability_status = $pool_evidence->{PoolAvailabilityStatus} // 'UNKNOWN';
    my $current_reachable = (defined $pool_evidence->{ProposedReachable}
                             && looks_like_number($pool_evidence->{ProposedReachable}))
                          ? ($pool_evidence->{ProposedReachable} + 0) : undef;
    my $current_reachability_basis = $pool_evidence->{ProposedReachabilityBasis} // 'N/A';

    my (@block, @caution);
    my $add_unique = sub {
        my ($list, $reason) = @_;
        return unless (defined $reason && length $reason);
        push @$list, $reason unless (grep { $_ eq $reason } @$list);
    };

    $add_unique->(\@block, 'current VP count unavailable') unless (defined $current_vp);
    $add_unique->(\@block, 'current entitlement unavailable or stale') unless (defined $current_ent);

    for my $flag (qw(CPUFlatlining CPUFlatliningPartialSevere CPUFlatliningPartial)) {
        if (($evidence->{$flag} // 'No') eq 'Yes') {
            $add_unique->(\@block, "capacity-censoring/pathology signal: $flag");
        }
    }
    if (($evidence->{'CPUCapLimited'} // 'No') eq 'Yes') {
        $add_unique->(\@block, 'capacity is consistently close to the configured CPU ceiling');
    }
    if (($evidence->{'IsRunQPressure'} // 'False') eq 'True'
        || ($evidence->{'IsWorkloadPressure'} // 'False') eq 'True') {
        $add_unique->(\@block, 'material RunQ/workload pressure is present');
    }
    if (defined $evidence->{'RunQ_Potential'}
        && $evidence->{'RunQ_Potential'} =~ /ANOMALY\s*\((?:DBW|XRQ)\)/i) {
        $add_unique->(\@block, "RunQ pathology: $evidence->{'RunQ_Potential'}");
    }
    if (($evidence->{'HotThreadWLDampeningApplied'} // 'False') eq 'True') {
        $add_unique->(\@block, 'hot-thread/pathological workload signal is active');
    }
    my $strategic_invariant_status = $evidence->{'GuaranteeInvariantHolds'} // 'N/A';
    if ($strategic_invariant_status eq 'No') {
        $add_unique->(\@block, 'strategic guarantee invariant failed');
    }

    my $reach_ratio;
    if (defined $peak_physc && defined $current_reachable && $current_reachable > 0) {
        $reach_ratio = $peak_physc / $current_reachable;
        if ($reach_ratio >= $VCPU_REDUCTION_BLOCK_REACH_RATIO - $FLOAT_EPSILON) {
            $add_unique->(\@block, sprintf(
                'credible peak is %.0f%% of current reachable capacity (BLOCK at %.0f%%)',
                $reach_ratio * 100, $VCPU_REDUCTION_BLOCK_REACH_RATIO * 100));
        } elsif ($reach_ratio >= $VCPU_REDUCTION_CAUTION_REACH_RATIO - $FLOAT_EPSILON) {
            $add_unique->(\@caution, sprintf(
                'credible peak is %.0f%% of current reachable capacity (CAUTION at %.0f%%)',
                $reach_ratio * 100, $VCPU_REDUCTION_CAUTION_REACH_RATIO * 100));
        }
    } elsif (!defined $peak_physc) {
        $add_unique->(\@caution, 'credible peak evidence unavailable');
    }

    if (defined $guarantee_demand && defined $current_reachable
        && $guarantee_demand > $current_reachable + $FLOAT_EPSILON) {
        $add_unique->(\@block, sprintf(
            'applicable demand %.2f exceeds current reachable capacity %.2f',
            $guarantee_demand, $current_reachable));
    }

    my $growth = (defined $evidence->{'GrowthAdjUsed'} && looks_like_number($evidence->{'GrowthAdjUsed'}))
               ? ($evidence->{'GrowthAdjUsed'} + 0) : 0;
    if ($growth >= $MIN_MEANINGFUL_ADJUSTMENT_CORES - $FLOAT_EPSILON) {
        $add_unique->(\@caution, sprintf('positive growth adjustment %.2f cores', $growth));
    }

    my $peak_pae = (defined $evidence->{'PhysC_Peak_PAE'} && looks_like_number($evidence->{'PhysC_Peak_PAE'}))
                 ? ($evidence->{'PhysC_Peak_PAE'} + 0) : undef;
    my $peak_aae = (defined $evidence->{'PhysC_Peak_AAE'} && looks_like_number($evidence->{'PhysC_Peak_AAE'}))
                 ? ($evidence->{'PhysC_Peak_AAE'} + 0) : undef;
    if ((defined $peak_pae && $peak_pae >= $VCPU_REDUCTION_CAUTION_PEAK_PAE - $FLOAT_EPSILON)
        || (defined $peak_aae && $peak_aae >= $VCPU_REDUCTION_CAUTION_PEAK_AAE - $FLOAT_EPSILON)) {
        $add_unique->(\@caution, sprintf(
            'material served-burst evidence (peak PAE %s, AAE %s)',
            defined($peak_pae) ? sprintf('%.2f', $peak_pae) : 'N/A',
            defined($peak_aae) ? sprintf('%.2f', $peak_aae) : 'N/A'));
    }
    if (!$is_capped && !defined $pool_cpu) {
        $add_unique->(\@caution, 'shared-pool capacity unavailable; current reach assumes configured VPs');
    }

    # This flag becomes actionable only after the shared decision helper has
    # established that a genuinely downward Tactical step exists. A workload
    # whose applicable demand is already covered by entitlement does not depend
    # on pool grace for this policy test.
    my $depends_on_unmeasured_pool =
        (!$is_capped
         && $pool_availability_status ne 'MEASURED'
         && defined $guarantee_demand
         && defined $current_ent
         && $guarantee_demand > $current_ent + $FLOAT_EPSILON) ? 1 : 0;

    my $state = @block ? 'BLOCK' : (@caution ? 'CAUTION' : 'CLEAR');
    my @reasons = @block ? @block : @caution;
    @reasons = ('no blocking or caution evidence detected') unless (@reasons);

    return {
        state             => $state,
        reasons           => join('; ', @reasons),
        current_reachable => $current_reachable,
        peak_reach_ratio  => $reach_ratio,
        pool_availability_status     => $pool_availability_status,
        current_reachability_basis   => $current_reachability_basis,
        depends_on_unmeasured_pool   => $depends_on_unmeasured_pool,
        strategic_invariant_status   => $strategic_invariant_status,
    };
}

# --- _compute_entbounded_and_tactical -------------------------------------
# Centralised decision logic for the two entitlement-relative rVCPU outputs:
#   * rVCPU_EntBounded (Task 3) - the entitlement-preserving target with current
#     entitlement held as a lower bound; configuration feasibility remains a
#     separate rationale concern. Also returns its governing-term string and
#     needs-coordinated-change flag.
#   * rVCPU_Tactical   (Task 4) - the tier-aware, rate-limited step for the
#     current cycle; also its explanatory note.
#
# This block was previously triplicated verbatim across
# calculate_runq_modified_physc(), _execute_multiplicative_seasonal() and the
# _write_standard_csv_report() fallback recompute. The three copies were
# byte-identical apart from comments and the sourcing of the current VP count,
# so they are collapsed here with no behavioural change (Task 6, narrow scope:
# the entitlement-safe and rate-limited tail only; the upstream envelope,
# peak-floor and reserve chain deliberately stays per-site because it is NOT
# identical across the three).
#
# Scope boundary: this routine performs decision logic only. It never sources
# or recomputes an input. Each caller resolves its own envelope terms, current
# entitlement and current VP count, and keeps its own persistence, CSV row
# assembly and debug_info mirror. Callers that do not compute a given term
# pass undef, exactly as the in-line code did.
#
# In (hashref):
#   rvcpu_raw            - RunQ dispatch-sized VP count (may be undef)
#   rvcpu_min            - envelope minimum VPs (may be undef)
#   rvcpu_max            - envelope maximum VPs / 2:1 policy ceiling (may be undef)
#   rvcpu_final          - coordinated rVCPU (may be undef)
#   p99w1_floor_vcpu     - peak-derived VP floor (may be undef)
#   configured_burst_floor_vcpu - pressure-conditioned burst-width floor
#   rvcpu_tier_num       - tier number (1..4) driving the step fraction
#   vp_current_ent_floor - ceil(current entitlement), or VP_Min when stale
#   current_ent_stale    - 1 when current entitlement was unavailable/stale
#   current_vp_numeric   - current VP count, or undef when unavailable
#   reduction_safety     - result from _classify_vcpu_reduction_safety()
#   current_entitlement  - unchanged entitlement for the tactical pair
#   guarantee_demand     - tier-applicable demand witness
#   is_capped, pool_cpu, dispatch_budget, tier_label - immediate invariant inputs
#   reduction_safety also carries strategic-invariant and pool-evidence status
#
# Out (hashref):
#   entbounded, entbounded_governed, entbounded_needs_coordinated_change,
#   entbounded_evidence_above_envelope, tactical, tactical_note,
#   reduction_safety_state/reasons, pool-dependence and strategic status,
#   immediate_invariant_holds/message/reachable
# ---------------------------------------------------------------------------
sub _compute_entbounded_and_tactical
{
    my ($terms) = @_;
    $terms = {} unless (defined $terms && ref($terms) eq 'HASH');

    # Bind resolved inputs to the same names the original in-line code used, so
    # the decision logic below is a verbatim move (guards against transcription
    # drift during centralisation).
    my $rvcpu_raw            = $terms->{rvcpu_raw};
    my $rvcpu_min            = $terms->{rvcpu_min};
    my $rvcpu_max            = $terms->{rvcpu_max};
    my $rvcpu_final          = $terms->{rvcpu_final};
    my $p99w1_floor_vcpu     = $terms->{p99w1_floor_vcpu};
    my $configured_burst_floor_vcpu = $terms->{configured_burst_floor_vcpu};
    my $rvcpu_tier_num       = $terms->{rvcpu_tier_num};
    my $vp_current_ent_floor = $terms->{vp_current_ent_floor};
    my $current_ent_stale    = $terms->{current_ent_stale};
    my $current_vp_numeric   = $terms->{current_vp_numeric};
    my $reduction_safety     = (defined $terms->{reduction_safety}
                                && ref($terms->{reduction_safety}) eq 'HASH')
                             ? $terms->{reduction_safety} : {};
    my $safety_state         = $reduction_safety->{state} // 'CAUTION';
    my $safety_reasons       = $reduction_safety->{reasons} // 'reduction-safety evidence unavailable';
    my $append_safety_reason = sub {
        my ($reason) = @_;
        return unless (defined $reason && $reason ne '');
        return if ($safety_reasons =~ /(?:^|; )\Q$reason\E(?:; |$)/);
        $safety_reasons .= '; ' unless ($safety_reasons eq '');
        $safety_reasons .= $reason;
    };

    # max() includes $rvcpu_final (the coordinated rVCPU) so rVCPU_EntBounded
    # >= rVCPU holds by construction in every case, including upsize scenarios
    # where current entitlement is below recommended.
    my $rvcpu_entbounded = max(grep { defined $_ }
        ($vp_current_ent_floor, $rvcpu_raw, $p99w1_floor_vcpu,
         $configured_burst_floor_vcpu, $rvcpu_final));

    my $entbounded_governed;
    if (defined $vp_current_ent_floor && $rvcpu_entbounded == $vp_current_ent_floor) {
        $entbounded_governed = $current_ent_stale
            ? sprintf("entitlement delivery floor (%s) [current entitlement unavailable]", $rvcpu_min // 'N/A')
            : sprintf("current entitlement floor (%d)", $vp_current_ent_floor);
    } elsif (defined $p99w1_floor_vcpu && $rvcpu_entbounded == $p99w1_floor_vcpu) {
        $entbounded_governed = sprintf("peak-throughput protection (%d)", $p99w1_floor_vcpu);
    } elsif (defined $configured_burst_floor_vcpu
             && $rvcpu_entbounded == $configured_burst_floor_vcpu) {
        $entbounded_governed = sprintf("configured burst width (%d)", $configured_burst_floor_vcpu);
    } elsif (defined $rvcpu_raw && $rvcpu_entbounded == $rvcpu_raw) {
        $entbounded_governed = sprintf("run-queue dispatch width (%d)", $rvcpu_raw);
    } else {
        $entbounded_governed = sprintf("coordinated rVCPU (%d)", $rvcpu_final // 0);
    }

    # Distinguish WHY rVCPU_EntBounded can exceed the coordinated rVCPU. The two
    # causes carry very different planner actions, so they are reported as
    # separate flags rather than collapsed into "EntBounded > rVCPU".
    #
    #   needs_coordinated_change - the CURRENT-ENTITLEMENT floor sits above the
    #     strategic rVCPU, so reaching rVCPU genuinely requires a coordinated
    #     entitlement reduction first. Tested specifically against the entitlement
    #     floor (ceil of current Ent), not against EntBounded as a whole. Gated on
    #     !stale: when current entitlement is unavailable the floor is a VP_Min
    #     fallback, not an entitlement figure, so no entitlement change can be
    #     asserted (and by construction VP_Min <= rVCPU, so this cannot fire then).
    #
    #   evidence_above_envelope - raw RunQ, peak or configured-burst floor
    #     exceeds the 2:1 VP
    #     envelope ceiling (rVCPU_Max), i.e. dispatch/peak evidence wants more than
    #     policy allows. This is an envelope-policy conflict, NOT an entitlement
    #     constraint; reducing entitlement would not change it.
    my $entbounded_needs_coordinated_change =
        (!$current_ent_stale && defined $vp_current_ent_floor && defined $rvcpu_final
            && $vp_current_ent_floor > $rvcpu_final) ? 1 : 0;

    my $entbounded_evidence_above_envelope =
        (defined $rvcpu_max
            && ( (defined $rvcpu_raw        && $rvcpu_raw        > $rvcpu_max)
              || (defined $p99w1_floor_vcpu && $p99w1_floor_vcpu > $rvcpu_max)
              || (defined $configured_burst_floor_vcpu
                  && $configured_burst_floor_vcpu > $rvcpu_max) )) ? 1 : 0;

    # ================================================================
    # Task 4: Tier-aware rate limiting on VP reduction (rVCPU_Tactical)
    # ================================================================
    # Steps CURRENT VPs toward rVCPU_EntBounded, limited per cycle by tier
    # appetite (strictest for P/tier-1, most permissive for tiers 3-4).
    # Never steps below the strategic target (EntBounded) and never steps up:
    # upward recommendations are outside this reduction-only rate limiter and
    # require a separate configuration-feasibility review.
    my $rvcpu_tactical;
    my $tactical_note;
    if (!defined $current_vp_numeric) {
        # Watch for: current VP count unavailable. No safe step can be computed
        # without a starting point - hold at EntBounded (the most conservative,
        # already-validated figure) rather than inventing a step.
        $rvcpu_tactical = $rvcpu_entbounded;
        $tactical_note = "current VP count unavailable - held at rVCPU_EntBounded";
    } elsif ($rvcpu_entbounded >= $current_vp_numeric) {
        # No reduction is due. Hold at current VPs; an analytical upsize remains
        # visible in rVCPU/EntBounded but is outside this reduction-only limiter.
        $rvcpu_tactical = $current_vp_numeric;
        $tactical_note = ($rvcpu_entbounded > $current_vp_numeric)
            ? "no downward action; the strategic VP upsize is outside the reduction-only Tactical path and requires configuration-feasibility review"
            : "no downward action; current VPs already meet the entitlement-preserving target";
    } else {
        my $step_fraction = $VCPU_TIER_STAGE1_STEP_FRACTION{$rvcpu_tier_num} // $VCPU_TIER_STAGE1_STEP_FRACTION{3};
        my $reduction_needed = $current_vp_numeric - $rvcpu_entbounded;
        my $max_step = $step_fraction * $current_vp_numeric;
        $max_step = $VCPU_TIER_STAGE1_STEP_MIN_VP if ($max_step < $VCPU_TIER_STAGE1_STEP_MIN_VP);
        my $step = ($reduction_needed < $max_step) ? $reduction_needed : $max_step;

        my $rvcpu_tactical_raw = $current_vp_numeric - $step;
        $rvcpu_tactical = int($rvcpu_tactical_raw);
        $rvcpu_tactical++ if ($rvcpu_tactical_raw > $rvcpu_tactical); # ceil: never remove more than budgeted

        # Never step below the strategic target. Guaranteed by construction
        # above (step <= reduction_needed); re-asserted as a hard clamp.
        $rvcpu_tactical = $rvcpu_entbounded if ($rvcpu_tactical < $rvcpu_entbounded);

        $tactical_note = sprintf("stepped %.2f of %.2f VPs needed (tier %s cap %.0f%%)",
            $step, $reduction_needed, $rvcpu_tier_num, $step_fraction * 100);
    }

    # A2.2: pressure/evidence state governs only the actionable reduction.
    # Strategic rVCPU and EntBounded above remain untouched and visible.
    my $tactical_pre_safety = $rvcpu_tactical;
    my ($immediate_ok, $immediate_msg, $immediate_reachable, $immediate_candidate);

    # A2.7: qualify only a genuinely downward action. Unknown pool availability
    # is material when applicable demand exceeds the unchanged entitlement: the
    # proposed pair relies on some non-guaranteed capacity whose future presence
    # has not been measured. That is CAUTION, not BLOCK. Independently, a
    # downward action requires a positively-proven strategic invariant; No/N/A
    # is fail-closed. The immediate invariant is still evaluated below against
    # the actual post-CAUTION candidate and must also be positively proven.
    my $is_downward_candidate =
        (defined $current_vp_numeric
         && defined $rvcpu_tactical
         && $rvcpu_tactical < $current_vp_numeric) ? 1 : 0;
    if ($is_downward_candidate) {
        if ($reduction_safety->{depends_on_unmeasured_pool}) {
            my $pool_reason = sprintf(
                'downward action depends on non-guaranteed capacity while pool availability is %s',
                ($reduction_safety->{pool_availability_status} // 'UNKNOWN'));
            $append_safety_reason->($pool_reason);
            $safety_state = 'CAUTION' if ($safety_state eq 'CLEAR');
        }

        my $strategic_status = $reduction_safety->{strategic_invariant_status} // 'N/A';
        if ($strategic_status ne 'Yes') {
            $append_safety_reason->("strategic guarantee invariant not positively proven ($strategic_status)");
            $safety_state = 'BLOCK';
        }
    }

    if (!defined $current_vp_numeric) {
        # Preserve the established numeric fallback, but make it unambiguously
        # non-actionable: a BLOCK cannot literally hold an unknown VP count.
        $safety_state = 'BLOCK';
        $safety_reasons .= '; ' unless ($safety_reasons eq '');
        $safety_reasons .= 'cannot hold or validate a tactical pair without current VPs'
            unless ($safety_reasons =~ /without current VPs/);
        $tactical_note = sprintf(
            'BLOCK: current VP count unavailable; retained rVCPU_EntBounded (%s) for visibility only - do not implement',
            defined($rvcpu_entbounded) ? $rvcpu_entbounded : 'N/A');
        $immediate_msg = 'not evaluated: current VP count unavailable';
    } elsif (defined $rvcpu_tactical && $rvcpu_tactical < $current_vp_numeric) {
        if ($safety_state eq 'BLOCK') {
            $immediate_candidate = $rvcpu_tactical;
            $rvcpu_tactical = $current_vp_numeric;
            $tactical_note = sprintf(
                'BLOCK: candidate %s VPs held at current %s VPs (%s)',
                $immediate_candidate, $current_vp_numeric, $safety_reasons);
            $immediate_msg = 'not evaluated: reduction held by pre-existing BLOCK evidence';
        } else {
            if ($safety_state eq 'CAUTION') {
                my $caution_floor = $current_vp_numeric - $VCPU_REDUCTION_CAUTION_MAX_STEP_VP;
                $caution_floor = $rvcpu_entbounded if ($caution_floor < $rvcpu_entbounded);
                if ($rvcpu_tactical < $caution_floor) {
                    $rvcpu_tactical = $caution_floor;
                }
                $tactical_note = sprintf(
                    'CAUTION: limited to %d VP this cycle (%s)',
                    $VCPU_REDUCTION_CAUTION_MAX_STEP_VP, $safety_reasons);
            }

            # Validate the pair the planner would actually implement: current
            # entitlement held, candidate Tactical VPs supplying reachability.
            $immediate_candidate = $rvcpu_tactical;
            my $current_ent = (defined $terms->{current_entitlement}
                               && looks_like_number($terms->{current_entitlement})
                               && $terms->{current_entitlement} > 0)
                            ? ($terms->{current_entitlement} + 0) : undef;
            my $pool_cpu = (defined $terms->{pool_cpu} && looks_like_number($terms->{pool_cpu})
                            && $terms->{pool_cpu} > 0) ? ($terms->{pool_cpu} + 0) : undef;
            my $is_capped = $terms->{is_capped} ? 1 : 0;
            if ($is_capped) {
                $immediate_reachable = $current_ent;
            } elsif (defined $pool_cpu) {
                $immediate_reachable = ($rvcpu_tactical < $pool_cpu) ? $rvcpu_tactical : $pool_cpu;
            } else {
                $immediate_reachable = $rvcpu_tactical;
            }

            ($immediate_ok, $immediate_msg) = _assert_budget_invariant(
                $terms->{guarantee_demand}, $current_ent, $immediate_reachable,
                $is_capped, $terms->{dispatch_budget}, $terms->{tier_label});

            if (!defined $immediate_ok || !$immediate_ok) {
                my $candidate = $rvcpu_tactical;
                $safety_state = 'BLOCK';
                my $why = defined($immediate_msg) ? $immediate_msg : 'invariant unavailable';
                $safety_reasons .= '; ' unless ($safety_reasons eq '');
                $safety_reasons .= "immediate tactical pair failed: $why";
                $rvcpu_tactical = $current_vp_numeric;
                $tactical_note = sprintf(
                    'BLOCK: candidate %s VPs failed the immediate guarantee check; held at current %s VPs (%s)',
                    $candidate, $current_vp_numeric, $why);
            } else {
                $tactical_note .= sprintf(
                    '; immediate pair validated at reachable %.2f cores', $immediate_reachable);
            }
        }
    } else {
        $immediate_msg = 'not evaluated: no downward tactical action proposed';
        $tactical_note .= sprintf('; reduction-safety state %s (%s)', $safety_state, $safety_reasons);
    }

    return {
        entbounded                          => $rvcpu_entbounded,
        entbounded_governed                 => $entbounded_governed,
        entbounded_needs_coordinated_change => $entbounded_needs_coordinated_change,
        entbounded_evidence_above_envelope  => $entbounded_evidence_above_envelope,
        tactical                            => $rvcpu_tactical,
        tactical_note                       => $tactical_note,
        tactical_pre_safety                 => $tactical_pre_safety,
        reduction_safety_state              => $safety_state,
        reduction_safety_reasons            => $safety_reasons,
        reduction_current_reachable         => $reduction_safety->{current_reachable},
        reduction_peak_reach_ratio          => $reduction_safety->{peak_reach_ratio},
        reduction_pool_availability_status  => $reduction_safety->{pool_availability_status},
        reduction_current_reachability_basis => $reduction_safety->{current_reachability_basis},
        reduction_depends_on_unmeasured_pool =>
            ($is_downward_candidate && $reduction_safety->{depends_on_unmeasured_pool}) ? 1 : 0,
        strategic_invariant_status          => $reduction_safety->{strategic_invariant_status} // 'N/A',
        immediate_candidate                 => $immediate_candidate,
        immediate_invariant_holds           => $immediate_ok,
        immediate_invariant                 => $immediate_msg,
        immediate_reachable                 => $immediate_reachable,
    };
}

# --- calculate_runq_modified_physc (with enhanced efficiency logic and detailed debug output) ---
# Calculates the final PhysC value for a profile after applying efficiency factors
# and RunQ-driven additive CPU adjustments.
# Takes the raw PhysC from nfit, RunQ metrics, SMT, entitlement, MaxCPU, etc.
# Returns the adjusted PhysC value and a hash of debug information for logging.
# --- calculate_runq_modified_physc (refactor: decoupled C & D, no early-returns, adds RunQ_Strategic) ---
#
# --- _strategic_rvcpu_envelope --------------------------------------------
# Pure, side-effect-free strategic-rVCPU kernel (authoritative path only).
#
# Given a trial planning entitlement and the rENT-INDEPENDENT evidence
# (RunQ dispatch size and peak-floor value, both computed once by the caller),
# derive the VP envelope and the clamped/overridden strategic rVCPU. This is
# the exact envelope -> micro-partition -> clamp -> peak-floor application ->
# Layer-5a override sequence previously inlined in calculate_runq_modified_physc;
# it is lifted verbatim so the A1 proposal-relative convergence loop can
# re-derive the strategic pair for successive trial entitlements without side
# effects. Diagnostics are RETURNED, not written, so repeated calls are safe;
# the caller mirrors them into %debug_info once.
#
# Scope (constraint 1): the authoritative engine is the only caller. The
# seasonal and CSV-fallback paths keep their own inline logic and their known
# divergences - this kernel must NOT be wired into them.
#
# In (hashref): rent_p, rent_for_envelope, rvcpu_raw, p99w1_floor_vcpu,
#   configured_burst_floor_vcpu,
#   runnable_density, runq_hi_threads, smt, max_cpu, runq_potential,
#   is_runq_pressure, is_workload_pressure
# Out (hashref): rvcpu_min, rvcpu_max, rvcpu_final, orig_rvcpu_min,
#   orig_rvcpu_max, runq_envelope_override, runq_envelope_basis,
#   micro_expansion_note (undef unless expansion occurred)
# ---------------------------------------------------------------------------
sub _strategic_rvcpu_envelope
{
    my ($in) = @_;
    $in = {} unless (defined $in && ref($in) eq 'HASH');

    # Bind inputs to the names the lifted logic uses (verbatim move).
    my $rENT_P                   = $in->{rent_p};
    my $rENT_P_for_envelope      = $in->{rent_for_envelope};
    my $rvcpu_raw                = $in->{rvcpu_raw};
    my $p99w1_floor_vcpu         = $in->{p99w1_floor_vcpu};
    my $configured_burst_floor_vcpu = $in->{configured_burst_floor_vcpu};
    my $runnable_density         = $in->{runnable_density};
    my $runq_hi_threads          = $in->{runq_hi_threads};
    my $smt_for_vcpu             = $in->{smt};
    my $max_cpu_for_lpar_numeric = $in->{max_cpu};
    my $runq_potential           = $in->{runq_potential};
    my $is_runq_pressure         = $in->{is_runq_pressure};
    my $is_workload_pressure     = $in->{is_workload_pressure};

    my ($rvcpu_min, $rvcpu_max, $rvcpu_final, $orig_rvcpu_min, $orig_rvcpu_max);
    my $runq_envelope_override = 0;
    my $runq_envelope_basis    = undef;
    my $micro_expansion_note;

            # Vendor envelope from rENT_P_for_envelope (planning entitlement, pre-MaxCPU-sanity).
            # This ensures the VP envelope reflects workload demand, not current environment limits.
            my $min_v = $rENT_P_for_envelope * $VCPU_RATIO_MIN;
            my $max_v = $rENT_P_for_envelope * $VCPU_RATIO_MAX;
            $rvcpu_min = int($min_v); $rvcpu_min++ if ($min_v > $rvcpu_min);
            $rvcpu_max = int($max_v); $rvcpu_max++ if ($max_v > $rvcpu_max);

            # Enforce minimum VP floor (evenisation removed - odd VP counts now permitted)
            if (defined $rvcpu_min) {
                $rvcpu_min = 1 if ($rvcpu_min < 1);
            }
            if (defined $rvcpu_max) {
                $rvcpu_max = 1 if ($rvcpu_max < 1);
                $rvcpu_max = $rvcpu_min if (defined $rvcpu_min && $rvcpu_max < $rvcpu_min);
            }

            # Micro-partition envelope expansion (completed-evidence gated).
            #
            # The former gate considered rVCPU_raw (RunQ width) only. A completed
            # yield/peak floor of 2 could therefore be clamped back to env_max=1
            # at a sub-0.5 entitlement. A1 then saw Demand > Reachable and raised
            # entitlement to 1.00 solely to make the 2:1 envelope admit the two
            # VPs. On the next iteration reachability was 2 and the guarantee
            # floor vanished, but monotone convergence could not undo the
            # provisional entitlement raise (the observed G3 > G2 inversion).
            #
            # All three values below are rENT-independent width witnesses. Let
            # any of them open the existing two-VP micro envelope. This does not
            # create a new envelope policy; it makes the existing exception
            # listen to the completed evidence that the final kernel already
            # claims to floor against.
            my $micro_width_evidence_vp = $rvcpu_raw;
            my $micro_width_evidence_source = 'RunQ dispatch';
            for my $candidate (
                [ $p99w1_floor_vcpu,            'yield/peak' ],
                [ $configured_burst_floor_vcpu, 'configured burst' ],
            ) {
                next unless (defined $candidate->[0]);
                if (!defined $micro_width_evidence_vp
                    || $candidate->[0] > $micro_width_evidence_vp) {
                    $micro_width_evidence_vp = $candidate->[0];
                    $micro_width_evidence_source = $candidate->[1];
                }
            }
            if (defined $rENT_P_for_envelope
                && $rENT_P_for_envelope > 0
                && $rENT_P_for_envelope < $VCPU_MICRO_PARTITION_THRESHOLD
                && defined $rvcpu_max
                && $rvcpu_max < $VCPU_MICRO_PARTITION_ENV_MAX_FLOOR
                && defined $micro_width_evidence_vp
                && $micro_width_evidence_vp > $rvcpu_max) {
                my $original_env_max = $rvcpu_max;
                $rvcpu_max = $VCPU_MICRO_PARTITION_ENV_MAX_FLOOR;
                # Respect MaxCPU as absolute ceiling
                if (defined $max_cpu_for_lpar_numeric && $max_cpu_for_lpar_numeric > 0 && $rvcpu_max > $max_cpu_for_lpar_numeric) {
                    $rvcpu_max = int($max_cpu_for_lpar_numeric);
                }
                if ($rvcpu_max > $original_env_max) {
                    $micro_expansion_note = sprintf(
                        "Envelope max expanded %d -> %d (micro-partition floor; rENT_P=%.2f, %s evidence=%d VPs > ratio max=%d)",
                        $original_env_max, $rvcpu_max, $rENT_P_for_envelope,
                        $micro_width_evidence_source, $micro_width_evidence_vp, $original_env_max);
                }
            }

            # Track original envelope for rationale (before any override)
            ($orig_rvcpu_min, $orig_rvcpu_max) = ($rvcpu_min, $rvcpu_max);

            # Clamp
            $rvcpu_final = $rvcpu_raw;
            $rvcpu_final = $rvcpu_min if (defined $rvcpu_min && $rvcpu_final < $rvcpu_min);
            $rvcpu_final = $rvcpu_max if (defined $rvcpu_max && $rvcpu_final > $rvcpu_max);

            # Low-entitlement sanity rules
            $rvcpu_final = $VCPU_MIN_ABS if (defined $rvcpu_final && $rvcpu_final < $VCPU_MIN_ABS);
            if (defined $rENT_P && $rENT_P >= 0.5 && $rENT_P < 1.0) {
                $rvcpu_final = $VCPU_MIN_FOR_ENT_GE_0_5_LT_1 if (defined $rvcpu_final && $rvcpu_final < $VCPU_MIN_FOR_ENT_GE_0_5_LT_1);
            }
                if (defined $p99w1_floor_vcpu && defined $rvcpu_final && $p99w1_floor_vcpu > $rvcpu_final) {
                    $rvcpu_final = $p99w1_floor_vcpu;
                    $rvcpu_final = $rvcpu_max if (defined $rvcpu_max && defined $rvcpu_final && $rvcpu_final > $rvcpu_max);
                }
                if (defined $configured_burst_floor_vcpu && defined $rvcpu_final
                    && $configured_burst_floor_vcpu > $rvcpu_final) {
                    $rvcpu_final = $configured_burst_floor_vcpu;
                    $rvcpu_final = $rvcpu_max
                        if (defined $rvcpu_max && $rvcpu_final > $rvcpu_max);
                }
            # Enforce minimum (evenisation removed)
            $rvcpu_final = $VCPU_MIN_ABS if (defined $rvcpu_final && $rvcpu_final < $VCPU_MIN_ABS);

            # ================================================================
            # LAYER 5a: Micro-partition RunQ Envelope Override
            # ================================================================
            # When rENT_P < threshold and RunQ strongly exceeds PhysC (runnable_density > threshold),
            # and the RunQ-derived VP requirement exceeds the envelope max,
            # expand the envelope to accommodate the RunQ evidence.
            # This addresses scheduling disadvantage in tiny partitions.
            # ================================================================
            my $runq_width_cores_for_override = undef;

            # Calculate RunQ-derived core requirement for comparison
            if (defined $runq_hi_threads && defined $smt_for_vcpu && $smt_for_vcpu > 0) {
                $runq_width_cores_for_override = $runq_hi_threads / $smt_for_vcpu;
            }

            # Check DBW/XRQ anomaly state (do not apply override if pathological)
            my $is_dbw_anomaly = (defined $runq_potential && $runq_potential =~ /ANOMALY.*DBW/i);
            my $is_xrq_anomaly = (defined $runq_potential && $runq_potential =~ /ANOMALY.*XRQ/i);

            # Check pressure flags - use per-profile detection (not overall flags which can miss cases)
            my $has_pressure_for_override =
                (defined $is_runq_pressure && $is_runq_pressure eq "True") ||
                (defined $is_workload_pressure && $is_workload_pressure eq "True");

            if (   defined $rENT_P && $rENT_P > 0 && $rENT_P < $MICRO_PARTITION_RUNQ_OVERRIDE_ENT_THRESH
                && defined $runnable_density && $runnable_density > $MICRO_PARTITION_RUNQ_OVERRIDE_CRED_THRESH
                && defined $rvcpu_raw && defined $rvcpu_max && $rvcpu_raw > $rvcpu_max
                && !$is_dbw_anomaly && !$is_xrq_anomaly
                && $has_pressure_for_override
                && defined $runq_width_cores_for_override) {

                $runq_envelope_override = 1;
                $runq_envelope_basis = $runq_width_cores_for_override;

                # Extend env_max to permit the RunQ-derived VP requirement
                my $extended_max = $rvcpu_raw;
                $extended_max = $MICRO_PARTITION_RUNQ_MAX_VP_CAP if ($extended_max > $MICRO_PARTITION_RUNQ_MAX_VP_CAP);
                $rvcpu_max = $extended_max;

                # Re-apply clamp with new envelope
                $rvcpu_final = $rvcpu_raw;
                $rvcpu_final = $rvcpu_min if (defined $rvcpu_min && $rvcpu_final < $rvcpu_min);
                $rvcpu_final = $rvcpu_max if (defined $rvcpu_max && $rvcpu_final > $rvcpu_max);
            }

    return {
        rvcpu_min              => $rvcpu_min,
        rvcpu_max              => $rvcpu_max,
        rvcpu_final            => $rvcpu_final,
        orig_rvcpu_min         => $orig_rvcpu_min,
        orig_rvcpu_max         => $orig_rvcpu_max,
        runq_envelope_override => $runq_envelope_override,
        runq_envelope_basis    => $runq_envelope_basis,
        micro_expansion_note   => $micro_expansion_note,
    };
}

sub calculate_runq_modified_physc
{
    my ($vm_name, $vm_map_ref, $profile_ref, $pressure_flags_href, $adaptive_thresholds_href) = @_;

    # --- Unpack all required values from the assimilation map and arguments ---
    my $profile_name = $profile_ref->{name};
    my $profile_runq_behavior_setting = $profile_ref->{runq_behavior} // 'default';

    # Core values from the map
    my $selected_tier_physc_value_str = $vm_map_ref->{CoreResults}{ProfileValues}{$profile_name};
    my $pure_p99w1_physc              = $vm_map_ref->{CoreResults}{ProfileValues}{$MANDATORY_PEAK_PROFILE_FOR_HINT};

    # Configuration from the map
    my $cfg_ref                 = $vm_map_ref->{Configuration};
    my $smt_used                = $cfg_ref->{smt};
    my $current_entitlement_str = $cfg_ref->{entitlement};
    my $max_cpu_config_str      = $cfg_ref->{max_cpu};
    my $vcpu_for_lpar_numeric   = $cfg_ref->{virtual_cpus};
    my $pool_cpu_for_lpar_numeric = $cfg_ref->{pool_cpu};
    my $is_in_non_default_pool  = (defined $cfg_ref->{pool_id} && $cfg_ref->{pool_id} != 0);

    # RunQ Metrics from the map
    my $na_str = 'N/A';

    # --- Per-profile measurement provenance (key-level fallback) ---
    # Prefer the RunQ percentile block computed for THIS profile, which carries
    # the profile's own time filter (-online / -batch / 24x7) and smoothing
    # window. Fall back key-by-key to the legacy unified block for any
    # percentile the profile's nfit run did not emit, and fall back entirely
    # when per-profile blocks are absent (seasonal / history-primed maps),
    # preserving prior behaviour on those paths. The unified block reference
    # is retained because flat-lining detection deliberately consumes the
    # peak-window view further down.
    my $runq_metrics_ref = $vm_map_ref->{RunQMetrics};   # unified (legacy) block
    my $runq_profile_block_ref =
        (ref($vm_map_ref->{RunQMetricsByProfile}) eq 'HASH')
            ? $vm_map_ref->{RunQMetricsByProfile}{$profile_name}
            : undef;
    $runq_profile_block_ref = undef
        unless (ref($runq_profile_block_ref) eq 'HASH'
                && scalar(grep { $_ ne 'SourceProfile' } keys %$runq_profile_block_ref));

    my $runq_used_profile_local    = 0;
    my $runq_used_unified_fallback = 0;
    my $_resolve_runq_metric = sub {
        my ($key) = @_;
        if (defined $runq_profile_block_ref && defined $runq_profile_block_ref->{$key}) {
            $runq_used_profile_local = 1;
            return $runq_profile_block_ref->{$key};
        }
        my $val = (ref($runq_metrics_ref) eq 'HASH') ? $runq_metrics_ref->{$key} : undef;
        $runq_used_unified_fallback = 1 if defined $val;
        return $val;
    };

    my $norm_runq_p25_str = $_resolve_runq_metric->('NormRunQ_P25') // $na_str;
    my $norm_runq_p50_str = $_resolve_runq_metric->('NormRunQ_P50') // $na_str;
    my $norm_runq_p75_str = $_resolve_runq_metric->('NormRunQ_P75') // $na_str;
    my $norm_runq_p90_str = $_resolve_runq_metric->('NormRunQ_P90') // $na_str;

    # Determine which AbsRunQ percentile value to use based on profile behaviour.
    my $abs_runq_key_to_use = "AbsRunQ_P90"; # Default to fixed
    if ($runq_perc_behavior_mode eq 'match' && $profile_ref->{flags} =~ /-p\s+([0-9.]+)/) {
        $abs_runq_key_to_use = "AbsRunQ_P" . clean_perc_label($1);
    }
    my $abs_runq_p_value_str = $_resolve_runq_metric->($abs_runq_key_to_use) // $na_str;
    my $abs_runq_key_for_debug = $abs_runq_key_to_use;

    # Human-readable measurement provenance for rationale logging.
    my $runq_metrics_source_name;
    if ($runq_used_profile_local && $runq_used_unified_fallback) {
        $runq_metrics_source_name = sprintf("%s (profile-local; unified fallback for missing keys)", $profile_name);
    } elsif ($runq_used_profile_local) {
        $runq_metrics_source_name = sprintf("%s (profile-local)", $profile_name);
    } else {
        my $unified_src = (ref($runq_metrics_ref) eq 'HASH' && defined $runq_metrics_ref->{SourceProfile})
            ? $runq_metrics_ref->{SourceProfile}
            : 'RunQMetrics';
        $runq_metrics_source_name = sprintf("%s (unified collation)", $unified_src);
    }

    # Pressure flags and adaptive thresholds passed in from the main loop
    my $p99w1_overall_vm_has_abs_runq_pressure  = $pressure_flags_href->{abs_pressure};
    my $p99w1_overall_vm_has_norm_runq_pressure = $pressure_flags_href->{norm_pressure};
    my $adaptive_runq_saturation_thresh   = $adaptive_thresholds_href->{saturation};
    # Task 5: 'target' and 'max_reduction' are gone from the thresholds hash.
    # max_reduction fed only the retired reduction cap. target was already dead
    # in this sub before Task 5 - the tier's RunQ target is resolved per-tier by
    # _resolve_runq_target(), which the additive path still uses.

    # The tier for all modifier calculations must come from the profile being processed,
    # not the global VM hint, to ensure logical consistency.
    my $final_tier = $profile_ref->{name};
    $final_tier =~ s/-.*$//o; # Extract the tier part (e.g., "G2-98W10" -> "G2")
    $final_tier =~ s/^\s+|\s+$//g; # remove any whitespace

    my %debug_info;

    # Defensive normalisation: seasonal/bucket execution paths may call into
    # RunQ logic without a tier PhysC string populated.
    $selected_tier_physc_value_str = $na_str
        unless defined($selected_tier_physc_value_str) && length($selected_tier_physc_value_str);

    # --- Initialize all debug fields to sensible defaults or N/A ---
    $debug_info{'AbsRunQKeyUsed'} = $abs_runq_key_for_debug // 'N/A (key not provided)';
    $debug_info{'AbsRunQValueUsedForCalc'} = $abs_runq_p_value_str;
    $debug_info{'RunQMetricsSourceName'} = $runq_metrics_source_name;
    $debug_info{'BasePhysC'} = $selected_tier_physc_value_str // $na_str;
    $profile_runq_behavior_setting //= 'default';

    my $base_physc = ($selected_tier_physc_value_str ne $na_str && $selected_tier_physc_value_str =~ /^-?[0-9.]+$/)
        ? ($selected_tier_physc_value_str + 0)
        : undef;

    # Task 5: the reduction-family defaults (DownsizingReason, DownsizingFactor
    # and the Eff* block) are removed. Every one of them was write-only once the
    # analysis and its rationale prints were deleted - initialised here and read
    # by nothing.

    # Diagnostics (daily-series based; diagnostic approximation)
    $debug_info{'PhysC_Daily_PAE'}  = $na_str;
    $debug_info{'PhysC_Daily_AAE'}  = $na_str;
    $debug_info{'PhysC_Daily_IQRC'} = $na_str;

    # Headroom diagnostics (threads + cores)
    $debug_info{'Headroom_Guaranteed_Threads'} = $na_str;
    $debug_info{'Headroom_Guaranteed_Cores'}   = $na_str;
    $debug_info{'Headroom_Reachable_Threads'}  = $na_str;
    $debug_info{'Headroom_Reachable_Cores'}    = $na_str;
    $debug_info{'Headroom_AbsRunQKey'}         = $abs_runq_key_for_debug // $na_str;
    $debug_info{'Headroom_AbsRunQ_Threads'}    = $na_str;
    $debug_info{'Headroom_EffectiveReachableCores'} = $na_str;

    # General fields
    $debug_info{'DownsizedPhysC'} = defined($base_physc) ? sprintf("%.4f", $base_physc) : $na_str;
    $debug_info{'RunQ_Strategic'} = "0.0000";
    $debug_info{'RunQ_Potential'} = "0.0000";
    $debug_info{'RunQPressure_P90_Val'} = 0; $debug_info{'IsRunQPressure'} = "False";
    $debug_info{'IsWorkloadPressure'} = "False"; $debug_info{'WorkloadPressureReason'} = "Conditions not met or N/A inputs";
    $debug_info{'EffectiveLCPUsAtBase'} = $na_str; $debug_info{'ExcessThreads'} = $na_str;
    $debug_info{'RawAdditive'} = "0.0000"; $debug_info{'MaxAdditiveCap'} = "0.0000"; $debug_info{'CappedRawAdditive'} = "0.0000";
    $debug_info{'VoltFactorReason'} = "Default (no overriding condition met or additive not applied)";
    $debug_info{'VoltFactor'} = "1.00";
    $debug_info{'PoolFactor'} = "1.00";
    $debug_info{'FinalAdditive'} = "0.0000";
    $debug_info{'PreMaxCpuCapRec'} = $debug_info{'DownsizedPhysC'};
    $debug_info{'LPARMaxCPUConfig'} = ($max_cpu_config_str ne "" && $max_cpu_config_str =~ /^[0-9.]+$/ && ($max_cpu_config_str+0) > 0)
        ? ($max_cpu_config_str+0) : $na_str;
    $debug_info{'EntitlementForForecast'} = (defined $current_entitlement_str && $current_entitlement_str ne "" && $current_entitlement_str =~ /^-?[0-9.]+$/)
        ? ($current_entitlement_str + 0) : 0;
    $debug_info{'ForecastMultiplier'} = $na_str; $debug_info{'EffectiveMaxCPUCap'} = $na_str;
    $debug_info{'CappedByMaxCPU'} = $na_str;
    $debug_info{'FinalAdjustedPhysC'} = $debug_info{'BasePhysC'};
    $debug_info{'ReasonForNoModification'} = "";

    my $curr_ent_numeric = $debug_info{'EntitlementForForecast'};
    my $eff_p_base_numeric = undef;          # Pre-growth base for efficiency/downsizing logic
    my $growth_adj_numeric = 0.0;            # GrowthAdj associated with this profile
    my $pre_growth_base_physc_numeric = undef;

    # ------------------------------------------------------------------
    # Growth vs Downsizing ordering fix (production fix)
    # ------------------------------------------------------------------
    # We must avoid disqualifying downsizing because GrowthAdj inflated BasePhysC.
    # Therefore:
    #   1) Compute downsizing on PRE-GROWTH base (BaseValue)
    #   2) Apply GrowthAdj AFTER downsizing, then continue with additive logic
    #
    # NOTE: CoreResults.ProfileValues already holds the growth-inclusive FinalValue.
    #       We retrieve BaseValue & GrowthAdj from vm_map->{Growth}{...} to restore order.
    my $pre_base_from_map = _safe_dig($vm_map_ref, 'Growth', 'base_values', $profile_name);
    my $growth_adj_from_map = _safe_dig($vm_map_ref, 'Growth', 'adjustments', $profile_name);

    if (defined $growth_adj_from_map && looks_like_number($growth_adj_from_map)) {
        $growth_adj_numeric = $growth_adj_from_map + 0;
    }

    if (defined $pre_base_from_map && looks_like_number($pre_base_from_map)) {
        $pre_growth_base_physc_numeric = $pre_base_from_map + 0;
    } elsif (defined $base_physc) {
        # Fallback: if BaseValue missing, infer pre-growth base from growth-inclusive base_physc
        $pre_growth_base_physc_numeric = ($base_physc + 0) - $growth_adj_numeric;
    }

    # Final guard: if still undefined, fall back to growth-inclusive base
    $pre_growth_base_physc_numeric = $base_physc
        if (!defined $pre_growth_base_physc_numeric && defined $base_physc);

    $eff_p_base_numeric = defined($pre_growth_base_physc_numeric) ? ($pre_growth_base_physc_numeric + 0) : undef;

    $debug_info{'PreGrowthBasePhysC'}  = defined($pre_growth_base_physc_numeric) ? sprintf("%.4f", $pre_growth_base_physc_numeric) : $na_str;
    $debug_info{'GrowthAdjUsed'}       = defined($growth_adj_numeric) ? sprintf("%+.4f", $growth_adj_numeric) : $na_str;
    $debug_info{'PostGrowthBasePhysC'} = defined($base_physc) ? sprintf("%.4f", $base_physc) : $na_str;

    # Task 5: EffPBase removed. It existed to give the downsizing/efficiency
    # logic a pre-growth base; that logic is gone and nothing else read it.
    # PreGrowthBasePhysC above remains the pre-growth reference.

    unless (defined $base_physc)
    {
        $debug_info{'ReasonForNoModification'} = "BasePhysC for profile not numeric or N/A";
        $debug_info{'FinalAdjustedPhysC'} = $selected_tier_physc_value_str // $na_str;
        return ($selected_tier_physc_value_str // $na_str, \%debug_info);
    }

    my $norm_p50_numeric = ($norm_runq_p50_str ne $na_str && $norm_runq_p50_str =~ /^-?[0-9.]+$/) ? ($norm_runq_p50_str + 0) : undef;
    my $norm_p90_numeric = ($norm_runq_p90_str ne $na_str && $norm_runq_p90_str =~ /^-?[0-9.]+$/) ? ($norm_runq_p90_str + 0) : undef;
    my $abs_runq_p_numeric  = ($abs_runq_p_value_str ne $na_str && $abs_runq_p_value_str  =~ /^-?[0-9.]+$/) ? ($abs_runq_p_value_str + 0)  : undef;
    $debug_info{'NormRunQ_P90_Val'} = (defined $norm_p90_numeric) ? sprintf("%.2f", $norm_p90_numeric) : $na_str;
    # ------------------------------------------------------------------
    # Harvest PhysC diagnostics (DailySeries-based approximation)
    # ------------------------------------------------------------------
    # Two scopes are harvested and the distinction is material:
    #
    #   Profile-local : PAE/AAE/IQRC through THIS profile's smoothed percentile
    #                   series. Retained unchanged, and still the sole input to
    #                   the downsizing guardrail, which reasons about the value
    #                   it is protecting.
    #   Peak-sourced  : PAE/AAE through the unfiltered peak profile - the
    #                   partition's ACTUAL burst behaviour, and the only valid
    #                   basis for asking whether it receives unguaranteed
    #                   capacity when it asks.
    #
    # The two diverge sharply. A partition peaking at 2.5x its entitlement
    # reports PAE 0.31 through a G1 lens and PAE 0.00 through a G3 lens, because
    # G3's 95th-percentile-over-15-minute series never crosses the entitlement
    # line. The profile-local figure is true of the profile and false of the
    # partition, so corroboration logic must not consume it.
    my $physc_diag = _safe_dig($vm_map_ref, 'Diagnostics', 'PhysC', $profile_name);
    if (ref($physc_diag) eq 'HASH') {
        if (defined $physc_diag->{PAE} && looks_like_number($physc_diag->{PAE})) {
            $debug_info{'PhysC_Daily_PAE'} = sprintf("%.4f", $physc_diag->{PAE} + 0);
        }
        if (defined $physc_diag->{AAE} && looks_like_number($physc_diag->{AAE})) {
            $debug_info{'PhysC_Daily_AAE'} = sprintf("%.4f", $physc_diag->{AAE} + 0);
        }
        if (defined $physc_diag->{IQRC} && looks_like_number($physc_diag->{IQRC})) {
            $debug_info{'PhysC_Daily_IQRC'} = sprintf("%.4f", $physc_diag->{IQRC} + 0);
        }
    }

    # Peak-sourced burst evidence, used only by corroboration logic.
    my ($peak_pae_numeric, $peak_aae_numeric);
    my $peak_diag_source = $na_str;
    foreach my $peak_key ($MANDATORY_PEAK_PROFILE_FOR_HINT, $LEGACY_MANDATORY_PEAK_PROFILE_FOR_HINT) {
        my $peak_diag = _safe_dig($vm_map_ref, 'Diagnostics', 'PhysC', $peak_key);
        next unless (ref($peak_diag) eq 'HASH');
        next unless (defined $peak_diag->{PAE} && looks_like_number($peak_diag->{PAE}));
        $peak_pae_numeric = $peak_diag->{PAE} + 0;
        $peak_aae_numeric = (defined $peak_diag->{AAE} && looks_like_number($peak_diag->{AAE}))
                          ? ($peak_diag->{AAE} + 0) : undef;
        $peak_diag_source = $peak_key;
        last;
    }
    $debug_info{'PhysC_Peak_PAE'}         = defined($peak_pae_numeric) ? sprintf("%.4f", $peak_pae_numeric) : $na_str;
    $debug_info{'PhysC_Peak_AAE'}         = defined($peak_aae_numeric) ? sprintf("%.4f", $peak_aae_numeric) : $na_str;
    $debug_info{'PhysC_Peak_Diag_Source'} = $peak_diag_source;

    # ------------------------------------------------------------------
    # Headroom diagnostics (threads & cores)
    # ------------------------------------------------------------------
    if (defined $smt_used && $smt_used > 0 && defined $abs_runq_p_numeric) {
        my $guaranteed_threads = (defined $curr_ent_numeric && looks_like_number($curr_ent_numeric) && $curr_ent_numeric > 0)
                               ? ($smt_used * $curr_ent_numeric)
                               : 0.0;

        # "Reachable" cores is bounded by vCPU and pool CPU when uncapped.
        my $reachable_cores = 0.0;
        if (defined $cfg_ref->{is_capped} && $cfg_ref->{is_capped}) {
            $reachable_cores = $curr_ent_numeric;
        } else {
            if (defined $pool_cpu_for_lpar_numeric && looks_like_number($pool_cpu_for_lpar_numeric) && $pool_cpu_for_lpar_numeric > 0
                && defined $vcpu_for_lpar_numeric && looks_like_number($vcpu_for_lpar_numeric) && $vcpu_for_lpar_numeric > 0) {
                $reachable_cores = ($vcpu_for_lpar_numeric < $pool_cpu_for_lpar_numeric) ? $vcpu_for_lpar_numeric : $pool_cpu_for_lpar_numeric;
            } elsif (defined $vcpu_for_lpar_numeric && looks_like_number($vcpu_for_lpar_numeric) && $vcpu_for_lpar_numeric > 0) {
                $reachable_cores = $vcpu_for_lpar_numeric;
            } else {
                $reachable_cores = $curr_ent_numeric;
            }
        }
        $reachable_cores = 0.0 if (!defined $reachable_cores || $reachable_cores < 0);
        my $reachable_threads = $smt_used * $reachable_cores;

        my $headroom_g_threads = $guaranteed_threads - $abs_runq_p_numeric;
        my $headroom_r_threads = $reachable_threads  - $abs_runq_p_numeric;

        $debug_info{'Headroom_AbsRunQ_Threads'} = sprintf("%.2f", $abs_runq_p_numeric);
        $debug_info{'Headroom_EffectiveReachableCores'} = sprintf("%.2f", $reachable_cores);
        $debug_info{'Headroom_Guaranteed_Threads'} = sprintf("%.2f", $headroom_g_threads);
        $debug_info{'Headroom_Guaranteed_Cores'}   = sprintf("%.4f", ($smt_used > 0 ? ($headroom_g_threads / $smt_used) : 0.0));
        $debug_info{'Headroom_Reachable_Threads'}  = sprintf("%.2f", $headroom_r_threads);
        $debug_info{'Headroom_Reachable_Cores'}    = sprintf("%.4f", ($smt_used > 0 ? ($headroom_r_threads / $smt_used) : 0.0));
    }

    # ------------------------------------------------------------------
    # CPU Ceiling Detection (Two-Tier System)
    # ------------------------------------------------------------------
    # Tier 1 (CAP_LIMITED): VM is consistently near MaxCPU - informational.
    # Tier 2 (CPU_FLATLINING): Suspicious plateau not explained by demand.
    # ------------------------------------------------------------------
    $debug_info{'CPUCapLimited'} = "No";
    $debug_info{'CPUCapLimitedDetail'} = "";
    $debug_info{'CPUFlatlining'} = "No";
    $debug_info{'CPUFlatliningDetail'} = "";

    $debug_info{'CPUFlatliningPartialSevere'} = "No";
    $debug_info{'CPUFlatliningPartialSevereDetail'} = "";
    $debug_info{'CPUFlatliningPartial'} = "No";
    $debug_info{'CPUFlatliningPartialDetail'} = "";

    my $fl_max_cpu = (defined $max_cpu_config_str && looks_like_number($max_cpu_config_str)) ? ($max_cpu_config_str + 0) : 0;
    my $fl_base_physc = (defined $base_physc && looks_like_number($base_physc)) ? ($base_physc + 0) : 0;
    my $fl_iqrc = (defined $debug_info{'PhysC_Daily_IQRC'} && looks_like_number($debug_info{'PhysC_Daily_IQRC'}))
                ? ($debug_info{'PhysC_Daily_IQRC'} + 0) : 999;
    my $fl_pae = (defined $debug_info{'PhysC_Daily_PAE'} && looks_like_number($debug_info{'PhysC_Daily_PAE'}))
               ? ($debug_info{'PhysC_Daily_PAE'} + 0) : 0;
    my $fl_aae = (defined $debug_info{'PhysC_Daily_AAE'} && looks_like_number($debug_info{'PhysC_Daily_AAE'}))
               ? ($debug_info{'PhysC_Daily_AAE'} + 0) : 0;
    my $fl_is_capped = (defined $cfg_ref->{is_capped} && $cfg_ref->{is_capped}) ? 1 : 0;

    # Corroboration gate: compute RunQ demand vs reachable capacity
    # CRITICAL: Use FIXED PEAK RunQ for corroboration, NOT the profile-matched
    # percentile. The question "is the VM genuinely overloaded at its ceiling?"
    # is a VM-level question that should be answered consistently across all
    # profiles. Use tail-to-tail comparison: P99.75 PhysC vs P99.75 AbsRunQ.
    my $fl_reachable_threads = ($fl_max_cpu > 0 && defined $smt_used && $smt_used > 0)
        ? ($fl_max_cpu * $smt_used) : 0;

    # Prefer peak-aligned P99.75 (tail-to-tail with Peak_P-99W1's PhysC), then P99, then P90
    my $fl_runq_key_used = 'AbsRunQ_P99.75';
    my $fl_runq_demand_peak = $runq_metrics_ref->{'AbsRunQ_P99.75'};

    if (!defined $fl_runq_demand_peak || !looks_like_number($fl_runq_demand_peak)) {
        $fl_runq_key_used = 'AbsRunQ_P99';
        $fl_runq_demand_peak = $runq_metrics_ref->{'AbsRunQ_P99'};
    }
    if (!defined $fl_runq_demand_peak || !looks_like_number($fl_runq_demand_peak)) {
        $fl_runq_key_used = 'AbsRunQ_P90';
        $fl_runq_demand_peak = $runq_metrics_ref->{'AbsRunQ_P90'};
    }
    if (!defined $fl_runq_demand_peak || !looks_like_number($fl_runq_demand_peak)) {
        $fl_runq_key_used = $abs_runq_key_to_use // 'profile-matched';
        $fl_runq_demand_peak = $abs_runq_p_numeric;
    }

    my $fl_runq_demand = (defined $fl_runq_demand_peak && looks_like_number($fl_runq_demand_peak))
        ? ($fl_runq_demand_peak + 0) : 0;
    my $fl_runq_ratio = ($fl_reachable_threads > 0) ? ($fl_runq_demand / $fl_reachable_threads) : 0;

    # Store corroboration key for rationale transparency
    $debug_info{'CPUCeilingRunQKeyUsed'} = $fl_runq_key_used;

    if ($fl_max_cpu > 0 && $fl_base_physc > 0) {
        my $fl_pct_of_maxcpu = $fl_base_physc / $fl_max_cpu;

        # Condition 1: Near MaxCPU (>= 97% of ceiling)
        my $cond_near_maxcpu = ($fl_pct_of_maxcpu >= $CPU_CEILING_PCT_OF_MAXCPU);

        # Condition 2a: Low day-to-day variability (for cap-limited)
        my $cond_low_iqrc = ($fl_iqrc <= $CPU_CAPLIMITED_IQRC_THRESHOLD);

        # Condition 2b: Very low day-to-day variability (for suspicious flatlining)
        my $cond_very_low_iqrc = ($fl_iqrc <= $CPU_FLATLINING_IQRC_THRESHOLD);

        # Condition 3: Chronic under-entitlement (AND logic, not OR)
        # For capped VMs, skip this requirement entirely (ceiling = entitlement)
        my $cond_under_ent = $fl_is_capped
                           || (($fl_pae >= $CPU_FLATLINING_PAE_THRESHOLD)
                               && ($fl_aae >= $CPU_FLATLINING_AAE_THRESHOLD));

        # Condition 4: NOT genuine overload
        # If RunQ demand strongly exceeds reachable capacity, the plateau is explained
        # by genuine demand, not a suspicious artefact. Do NOT flag as CPU_FLATLINING.
        my $cond_not_genuine_overload = ($fl_runq_ratio <= $CPU_FLATLINING_OVERLOAD_RATIO);

        # --- Tier 1: Cap-Limited (informational) ---
        # Triggers when near MaxCPU with low variability, regardless of cause.
        if ($cond_near_maxcpu && $cond_low_iqrc) {
            $debug_info{'CPUCapLimited'} = "Yes";
            $debug_info{'CPUCapLimitedDetail'} = sprintf(
                "BasePhysC %.2f is %.0f%% of MaxCPU %.2f with low variability (IQRC %.4f)",
                $fl_base_physc, $fl_pct_of_maxcpu * 100, $fl_max_cpu, $fl_iqrc
            );
            $debug_info{'CPUCapLimitedPctOfMaxCPU'} = sprintf("%.0f", $fl_pct_of_maxcpu * 100);
        }

        # --- Tier 2: CPU Flatlining (suspicious/warning) ---
        # Triggers only when the plateau is NOT explained by genuine overload.
        if ($cond_near_maxcpu && $cond_very_low_iqrc && $cond_under_ent && $cond_not_genuine_overload) {
            $debug_info{'CPUFlatlining'} = "Yes";
            my $fl_detail = sprintf(
                "BasePhysC %.2f is %.0f%% of MaxCPU %.2f with very low variability (IQRC %.4f)",
                $fl_base_physc, $fl_pct_of_maxcpu * 100, $fl_max_cpu, $fl_iqrc
            );
            if ($fl_is_capped) {
                $fl_detail .= "; capped mode";
            } else {
                $fl_detail .= sprintf("; chronic over-entitlement (PAE %.2f, AAE %.2f)", $fl_pae, $fl_aae);
            }
            $fl_detail .= sprintf("; RunQ ratio %.2f (%s) does not indicate genuine overload", $fl_runq_ratio, $fl_runq_key_used);

            $debug_info{'CPUFlatliningDetail'} = $fl_detail;
            $debug_info{'CPUFlatliningPctOfMaxCPU'} = sprintf("%.0f", $fl_pct_of_maxcpu * 100);
            $debug_info{'CPUFlatliningRunQRatio'} = sprintf("%.2f", $fl_runq_ratio);
        }

        # --- Secondary: Partial CPU Flat-lining (below MaxCPU) ---
        # Detect an unusually flat plateau materially below MaxCPU, with corroborating
        # RunQ pressure that maps back to a stable "core-equivalent" demand level.
        #
        # Goal: produce a high-confidence planner signal for likely pathological states
        # (e.g. ~1-2 core plateaus) without spamming legitimate steady workloads.
        if ($debug_info{'CPUFlatlining'} ne "Yes"
            && defined $smt_used && $smt_used > 0
            && defined $fl_runq_demand && looks_like_number($fl_runq_demand) && $fl_runq_demand > 0) {

            my $cond_below_ceiling = (!$cond_near_maxcpu);  # exclude near-ceiling cases handled above
            my $cond_partial_min_maxcpu = (defined $fl_max_cpu && $fl_max_cpu >= 2.0); # guard: avoid partial logic on 1-core MaxCPU
            my $cond_in_partial_band = ($fl_pct_of_maxcpu >= $CPU_FLATLINING_PARTIAL_MIN_PCT_OF_MAXCPU
                                     && $fl_pct_of_maxcpu <= $CPU_FLATLINING_PARTIAL_MAX_PCT_OF_MAXCPU);

            # Convert RunQ thread pressure back to "core-equivalents" at current SMT.
            my $runq_core_equiv = $fl_runq_demand / $smt_used;
            my $runq_core_diff  = abs($runq_core_equiv - $fl_base_physc);

            # Corroboration alignment:
            #  - Severe: directional alignment (avoid RunQ_core_equiv >> BasePhysC)
            #  - Partial: symmetric proximity (avoid spamming "high CPU / low RunQ" cases)
            my $cond_runq_align_severe  = (($fl_base_physc + $CPU_FLATLINING_PARTIAL_RUNQ_CORE_TOLERANCE) >= $runq_core_equiv);
            my $cond_runq_align_partial = ($runq_core_diff <= $CPU_FLATLINING_PARTIAL_RUNQ_CORE_TOLERANCE);

            # Severe only: ensure RunQ corroboration is non-trivial (avoid "flat CPU with near-zero RunQ" noise)
            my $cond_runq_nontrivial = ($runq_core_equiv >= 0.50);

            # Shared: RunQ corroboration ratio (RunQ_core_equiv / BasePhysC)
            my $runq_core_ratio = ($fl_base_physc > 0) ? ($runq_core_equiv / $fl_base_physc) : 0;

            # Severe only: require RunQ corroboration to be genuinely strong.
            # If RunQ evidence is materially lower than the plateau CPU level, we should not
            # label it SEVERE (these cases are already handled elsewhere as "low RunQ corroboration").
            my $cond_runq_ratio = ($runq_core_ratio >= 0.75);    # RunQ ~= at least 70% of plateau level
            my $cond_runq_close = ($runq_core_diff  <= 0.30);    # tighter than the general tolerance (SEVERE only)

            # Partial: require corroboration to be material (avoid weak RunQ alignment outliers)
            my $cond_runq_ratio_partial = ($runq_core_ratio >= $CPU_FLATLINING_PARTIAL_RUNQ_RATIO_FLOOR);

            # Corroboration: signs of chronic constraint (uncapped only); capped VMs skip this.
            my $cond_partial_constraint = $fl_is_capped
                                       || (($fl_pae >= $CPU_FLATLINING_PARTIAL_PAE_THRESHOLD)
                                           && ($fl_aae >= $CPU_FLATLINING_PARTIAL_AAE_THRESHOLD));

            # --- Severe: most likely pathological (~1-2 cores stuck) ---
            my $cond_severe_band = ($fl_base_physc >= $CPU_FLATLINING_PARTIAL_SEVERE_MIN_BASEPHYSC
                                 && $fl_base_physc <= $CPU_FLATLINING_PARTIAL_SEVERE_MAX_BASEPHYSC);

            if ($cond_below_ceiling
                && $cond_partial_min_maxcpu
                && $cond_in_partial_band
                && $cond_very_low_iqrc
                && $cond_severe_band
                && $cond_runq_align_severe
                && $cond_runq_nontrivial
                && $cond_runq_ratio
                && $cond_runq_close
                && $cond_partial_constraint) {

                $debug_info{'CPUFlatliningPartialSevere'} = "Yes";
                my $DELTA = "\x{0394}";
                my $detail = sprintf(
                    "BasePhysC %.2f is %.0f%% of MaxCPU %.2f with very low variability (IQRC %.4f); RunQ %.2f (%s) ~= %.2f cores (%s%.2f)",
                    $fl_base_physc, $fl_pct_of_maxcpu * 100, $fl_max_cpu, $fl_iqrc,
                    $fl_runq_demand, $fl_runq_key_used, $runq_core_equiv, $DELTA, $runq_core_diff
                );
                if ($fl_is_capped) {
                    $detail .= "; capped mode";
                } else {
                    $detail .= sprintf("; constraint evidence (PAE %.2f, AAE %.2f)", $fl_pae, $fl_aae);
                }
                $debug_info{'CPUFlatliningPartialSevereDetail'} = $detail;
                $debug_info{'CPUFlatliningPartialRunQCoreEquiv'} = sprintf("%.2f", $runq_core_equiv);
            }

            # --- Partial (broader): below-ceiling plateau worth investigation ---
            # Only emit if severe did not already trigger.
            if ($debug_info{'CPUFlatliningPartialSevere'} ne "Yes"
                && $cond_below_ceiling
                && $cond_partial_min_maxcpu
                && $cond_in_partial_band
                && $cond_low_iqrc
                && $cond_runq_align_partial
                && $cond_runq_ratio_partial
                && $cond_partial_constraint) {

                my $DELTA = "\x{0394}";   # Greek capital delta
                $debug_info{'CPUFlatliningPartial'} = "Yes";
                my $detail = sprintf(
                    "BasePhysC %.2f is %.0f%% of MaxCPU %.2f with low variability (IQRC %.4f); RunQ %.2f (%s) ~= %.2f cores (%s%.2f)",
                    $fl_base_physc, $fl_pct_of_maxcpu * 100, $fl_max_cpu, $fl_iqrc,
                    $fl_runq_demand, $fl_runq_key_used, $runq_core_equiv, $DELTA, $runq_core_diff
                );
                if ($fl_is_capped) {
                    $detail .= "; capped mode";
                } else {
                    $detail .= sprintf("; constraint evidence (PAE %.2f, AAE %.2f)", $fl_pae, $fl_aae);
                }
                $debug_info{'CPUFlatliningPartialDetail'} = $detail;
                $debug_info{'CPUFlatliningPartialRunQCoreEquiv'} = sprintf("%.2f", $runq_core_equiv);
            }
        }
    }

    # ------------------------------------------------------------------
    # Effective Dispatch Threads (Allowance) - tier dispatch budget model
    # ------------------------------------------------------------------
    # The allowance answers one question: how many dispatch threads may this
    # workload's queue COUNT ON being served?
    #
    #   Guaranteed = Ent x SMT             (PowerVM guarantees this capacity)
    #   Reachable  = min(VP, Pool) x SMT   (best case, an uncontended pool)
    #   Allowance  = Guaranteed + Budget x (Reachable - Guaranteed)
    #
    # The budget is the fraction of the non-guaranteed band that the tier is
    # willing to rely on: a business decision about how much pool grace a
    # workload of this importance may depend upon.
    #
    # This replaces the EVR-derived burst factor, which inferred the allowance
    # from the vCPU:Entitlement ratio and therefore granted the LARGEST
    # allowance - and so the LEAST pressure sensitivity - to precisely those
    # partitions most dependent on unguaranteed capacity. It also retires the
    # max(theoretical, observed peak) selection, whose denominator followed
    # demand: a partition that had already burst inflated its own allowance and
    # suppressed its own pressure ratio. Whether bursting is actually honoured
    # is corroborated separately by the measured PAE/AAE evidence.
    #
    # The pool CONTENTION heuristic is retired with it: inferring contention
    # from a VM's share of its pool was a guess, and the "middle band" this
    # model creates does not need it - the band exists precisely because pool
    # delivery is unknowable. The pool SIZE bound is retained below, since that
    # is a physical fact rather than an inference.
    my ($effective_lcpus_for_pressure_calc, $pressure_basis_rationale);
    my $max_cpu_for_lpar_numeric = (defined $max_cpu_config_str && looks_like_number($max_cpu_config_str)) ? ($max_cpu_config_str + 0) : 0;

    my $ent_is_valid = (defined $curr_ent_numeric && looks_like_number($curr_ent_numeric) && $curr_ent_numeric > 0) ? 1 : 0;
    my $smt_is_valid = (defined $smt_used && looks_like_number($smt_used) && $smt_used > 0) ? 1 : 0;
    my $vcpu_is_valid = (defined $vcpu_for_lpar_numeric && looks_like_number($vcpu_for_lpar_numeric) && $vcpu_for_lpar_numeric > 0) ? 1 : 0;
    my $pool_is_valid = (defined $pool_cpu_for_lpar_numeric && looks_like_number($pool_cpu_for_lpar_numeric) && $pool_cpu_for_lpar_numeric > 0) ? 1 : 0;

    # Absolute dispatch ceiling: no allowance may exceed the configured width.
    my $absolute_ceiling_lcpus = 0;
    if ($smt_is_valid) {
        $absolute_ceiling_lcpus = ($max_cpu_for_lpar_numeric > 0) ? ($max_cpu_for_lpar_numeric * $smt_used)
                                : ($vcpu_is_valid ? ($vcpu_for_lpar_numeric * $smt_used) : 0);
    }

    # Reachable cores: a capped LPAR can never exceed its entitlement, so its
    # non-guaranteed band is legitimately zero and no tier receives a budget.
    my $is_capped_lpar = (defined $cfg_ref->{is_capped} && $cfg_ref->{is_capped}) ? 1 : 0;
    my $reachable_cores = 0;
    my $reachable_reason;
    if ($is_capped_lpar) {
        $reachable_cores = $ent_is_valid ? $curr_ent_numeric : 0;
        $reachable_reason = "capped LPAR: reachable == entitlement, no non-guaranteed band";
    } elsif ($vcpu_is_valid && $pool_is_valid) {
        $reachable_cores = min($vcpu_for_lpar_numeric, $pool_cpu_for_lpar_numeric);
        $reachable_reason = sprintf("uncapped: min(VP %.2f, Pool %.2f)", $vcpu_for_lpar_numeric, $pool_cpu_for_lpar_numeric);
    } elsif ($vcpu_is_valid) {
        $reachable_cores = $vcpu_for_lpar_numeric;
        $reachable_reason = sprintf("uncapped: VP %.2f (pool size unknown)", $vcpu_for_lpar_numeric);
    } else {
        $reachable_cores = $ent_is_valid ? $curr_ent_numeric : 0;
        $reachable_reason = "VP count unavailable: reachable defaulted to entitlement";
    }

    my $guaranteed_lcpus = ($ent_is_valid && $smt_is_valid) ? ($curr_ent_numeric * $smt_used) : 0;
    my $reachable_lcpus  = $smt_is_valid ? ($reachable_cores * $smt_used) : 0;
    $reachable_lcpus = min($reachable_lcpus, $absolute_ceiling_lcpus) if ($absolute_ceiling_lcpus > 0);
    $reachable_lcpus = max($reachable_lcpus, $guaranteed_lcpus);

    my ($dispatch_budget, $dispatch_budget_reason) = _resolve_dispatch_budget($final_tier);
    my $non_guaranteed_band = max(0, $reachable_lcpus - $guaranteed_lcpus);

    my $allowance_method;
    if (!$ent_is_valid || !$smt_is_valid) {
        # Without a usable entitlement or SMT there is no guarantee to anchor
        # against. Fall back to the reachable ceiling (the previous, most
        # permissive behaviour) rather than synthesising a tiny allowance that
        # would manufacture false pressure.
        $effective_lcpus_for_pressure_calc = ($reachable_lcpus > 0) ? $reachable_lcpus : $absolute_ceiling_lcpus;
        $allowance_method = "Fallback: entitlement or SMT unavailable, allowance = reachable ceiling";
    } else {
        $effective_lcpus_for_pressure_calc = $guaranteed_lcpus + ($dispatch_budget * $non_guaranteed_band);
        $allowance_method = "Guaranteed + Budget x (Reachable - Guaranteed)";
    }
    $effective_lcpus_for_pressure_calc = min($effective_lcpus_for_pressure_calc, $absolute_ceiling_lcpus) if ($absolute_ceiling_lcpus > 0);
    $effective_lcpus_for_pressure_calc = max($effective_lcpus_for_pressure_calc, 0);

    my $ceiling_is_binding = ($absolute_ceiling_lcpus > 0 && $reachable_lcpus >= $absolute_ceiling_lcpus - 0.0001) ? 1 : 0;

    $pressure_basis_rationale = sprintf(
        "\n   1. Guaranteed Dispatch Capacity (PowerVM entitlement)\n".
        "      - Entitlement                           : %s cores\n".
        "      => Guaranteed Dispatch Threads          : %s Ent * %s SMT = %.1f\n".
        "   2. Reachable Dispatch Capacity (best case, uncontended pool)\n".
        "      - Reachable Cores                       : %.2f (%s)\n".
        "      => Reachable Dispatch Threads           : %.2f Cores * %s SMT = %.1f (%s)\n".
        "      - Non-Guaranteed Band                   : %.1f - %.1f = %.1f threads\n".
        "   3. Tier Dispatch Budget and Decision\n".
        "      - Profile Tier                          : %s\n".
        "      - Dispatch Budget                       : %.0f%% of the non-guaranteed band (%s)\n".
        "        (how far into unguaranteed capacity this tier's queue may count on being served)\n".
        "      => Effective Dispatch Threads (allowance): %.1f + (%.2f * %.1f) = %.1f\n".
        "         - Absolute Ceiling                   : %.1f threads (%s)\n".
        "         - Method                             : %s",
        ($ent_is_valid ? sprintf("%.2f", $curr_ent_numeric) : $na_str),
        ($ent_is_valid ? sprintf("%.2f", $curr_ent_numeric) : $na_str),
        ($smt_is_valid ? $smt_used : $na_str), $guaranteed_lcpus,
        $reachable_cores, $reachable_reason,
        $reachable_cores, ($smt_is_valid ? $smt_used : $na_str), $reachable_lcpus,
        ($ceiling_is_binding ? "ceiling-bound" : "within ceiling"),
        $reachable_lcpus, $guaranteed_lcpus, $non_guaranteed_band,
        $final_tier,
        $dispatch_budget * 100, $dispatch_budget_reason,
        $guaranteed_lcpus, $dispatch_budget, $non_guaranteed_band, $effective_lcpus_for_pressure_calc,
        $absolute_ceiling_lcpus, ($ceiling_is_binding ? "binding on reachable" : "not binding"),
        $allowance_method
    );

    my $norm_p25_numeric = ($norm_runq_p25_str ne $na_str && $norm_runq_p25_str =~ /^-?[0-9.]+$/) ? ($norm_runq_p25_str + 0) : undef;
    my $norm_p75_numeric = ($norm_runq_p75_str ne $na_str && $norm_runq_p75_str =~ /^-?[0-9.]+$/) ? ($norm_runq_p75_str + 0) : undef;
    my $normrunq_iqrc_val = undef;
    if (defined $norm_p25_numeric && defined $norm_p50_numeric && defined $norm_p75_numeric)
    {
        my $p50_denominator_for_iqrc = (abs($norm_p50_numeric) > $MIN_P50_DENOMINATOR_FOR_VOLATILITY)
            ? $norm_p50_numeric
            : (($norm_p50_numeric >= 0) ? $MIN_P50_DENOMINATOR_FOR_VOLATILITY : -$MIN_P50_DENOMINATOR_FOR_VOLATILITY);
        if (abs($p50_denominator_for_iqrc) > $FLOAT_EPSILON)
        {
            $normrunq_iqrc_val = ($norm_p75_numeric - $norm_p25_numeric) / $p50_denominator_for_iqrc;
        }
        elsif (abs($norm_p75_numeric - $norm_p25_numeric) < $FLOAT_EPSILON) { $normrunq_iqrc_val = 0.0; }
        else { $normrunq_iqrc_val = 999.0; }
    }
    $debug_info{'NormRunQ_P25_Val'} = (defined $norm_p25_numeric) ? sprintf("%.2f", $norm_p25_numeric) : $na_str;
    $debug_info{'NormRunQ_P50_Val'} = (defined $norm_p50_numeric) ? sprintf("%.2f", $norm_p50_numeric) : $na_str;
    $debug_info{'NormRunQ_P75_Val'} = (defined $norm_p75_numeric) ? sprintf("%.2f", $norm_p75_numeric) : $na_str;
    $debug_info{'EffectiveLCPUsForPressure'} = sprintf("%.1f", $effective_lcpus_for_pressure_calc);
    $debug_info{'EffectiveLCPUsAtBase'} = sprintf("%.4f", $effective_lcpus_for_pressure_calc);
    my $runq_pressure_p_val = ($effective_lcpus_for_pressure_calc > 0) ? (($abs_runq_p_numeric // 0) / $effective_lcpus_for_pressure_calc) : 0;
    $debug_info{'NormRunQ_IQRC_Val'} = (defined $normrunq_iqrc_val) ? sprintf("%.3f", $normrunq_iqrc_val) : $na_str;
    $debug_info{'RunQPressure_P90_Val'} = sprintf("%.4f", $runq_pressure_p_val);
    $debug_info{'PressureBasisRationale'} = $pressure_basis_rationale;
    $debug_info{'BurstAllowanceUsed'} = sprintf("%.0f%% of the non-guaranteed band (%s): %.1f of %.1f reachable threads counted",
        $dispatch_budget * 100, $dispatch_budget_reason, $effective_lcpus_for_pressure_calc, $reachable_lcpus);
    $debug_info{'GuaranteedDispatchThreads'} = sprintf("%.1f", $guaranteed_lcpus);
    $debug_info{'ReachableDispatchThreads'}  = sprintf("%.1f", $reachable_lcpus);
    $debug_info{'DispatchBudgetFraction'}    = sprintf("%.2f", $dispatch_budget);
    $debug_info{'SmallEntitlementHandlerActive'} = ($curr_ent_numeric < 1.0 && $max_cpu_for_lpar_numeric > $curr_ent_numeric) ? "Yes" : "No";

    # =========================
    # Section C: Strategic Efficiency / Downsizing - REMOVED (Task 5)
    # =========================
    # The RunQ efficiency (entitlement) reduction, the AAE/PAE downsize guard
    # band, the NormRunQ P50 gate and the STD dampening path are removed.
    #
    # They were already inert: $RUNQ_EFFICIENCY_REDUCTION_ENABLED was 0, and a
    # choke point below the analysis restored $base_adjusted_physc to
    # $eff_p_base_numeric and withdrew every RunQ_Strategic / RunQ_Potential
    # value the reduction family had set. The analysis nevertheless ran on every
    # profile of every VM and published verdicts (guard bands, blend weights,
    # reduction cores) that governed nothing - the failure mode the Reference
    # Guide names directly: machinery that prints a verdict a planner might act
    # upon, while governing nothing, is worse than absent.
    #
    # The mechanism is retired on evidence, not deferred: its premise was
    # falsified, entitlement was the wrong lever, and it was worth -1.53 cores
    # across a 97-VM estate. The full record is the "RunQ efficiency (entitlement)
    # reduction: REMOVED" note at the head of this file. The dispatch-width
    # evidence it used is now applied correctly to rVCPU via the yield-aware
    # active-core floor (Section F).
    #
    # $base_adjusted_physc therefore carries the profile's PhysC unchanged, which
    # is exactly what the choke point produced. RunQ_Strategic and RunQ_Potential
    # keep their "0.0000" initialisation from the defaults block above; the
    # additive path below sets them where it has something to say.
    my $base_adjusted_physc = $eff_p_base_numeric;

    # Apply GrowthAdj. Ordering is preserved from the previous implementation:
    # growth was applied after downsizing so it could not disqualify the
    # downsizing gates. The gates are gone, but the ordering is retained because
    # $downsized_pre_growth / DownsizedPhysC_PreGrowth remain the pre-growth
    # reference the additive path and rationale expect.
    my $downsized_pre_growth = $base_adjusted_physc;
    if (defined $growth_adj_numeric && looks_like_number($growth_adj_numeric)) {
        $base_adjusted_physc = $downsized_pre_growth + $growth_adj_numeric;
    }
    $debug_info{'DownsizedPhysC_PreGrowth'} = sprintf("%.4f", $downsized_pre_growth);
    $debug_info{'DownsizedPhysC'} = sprintf("%.4f", $base_adjusted_physc);

    # =========================
    # Section D: Tactical Additive CPU
    # =========================
    my $tier_scaling_factor = 1.00;
    # Default to Tier 3 (baseline, 1.00x scaling) if the tier cannot be determined.
    # This is a safe fallback that prevents uninitialised value warnings.
    my $tier_num_for_scaling = 3;
    my $is_runq_pressure = ($runq_pressure_p_val > $adaptive_runq_saturation_thresh);
    $debug_info{'IsRunQPressure'} = $is_runq_pressure ? "True" : "False";
    my $is_workload_pressure_calc = 0;
    my $workload_pressure_reason_str_calc = "Workload pressure conditions not met or inputs N/A.";
    my $min_absrunq_for_workload_pressure_check = $smt_used > 0 ? $smt_used : 1.0;
    if (defined $norm_p90_numeric) {
        if ($norm_p90_numeric > $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD) {
            if (defined $abs_runq_p_numeric && $abs_runq_p_numeric >= $min_absrunq_for_workload_pressure_check) {
                $is_workload_pressure_calc = 1;
                $workload_pressure_reason_str_calc = sprintf("NormRunQ P90 (%.2f) > threshold (%.2f) AND AbsRunQ (%s=%.2f) >= SMT-based min threshold (%.2f)", $norm_p90_numeric, $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD, $debug_info{AbsRunQKeyUsed}, $abs_runq_p_numeric, $min_absrunq_for_workload_pressure_check);
            } else {
                $workload_pressure_reason_str_calc = sprintf("NormRunQ P90 (%.2f) > threshold (%.2f), BUT AbsRunQ (%s=%s) < SMT-based min threshold (%.2f). Workload Pressure NOT flagged.", $norm_p90_numeric, $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD, $debug_info{AbsRunQKeyUsed}, (defined $abs_runq_p_numeric ? sprintf("%.2f", $abs_runq_p_numeric) : $na_str), $min_absrunq_for_workload_pressure_check);
            }
        } else {
            $workload_pressure_reason_str_calc = sprintf("NormRunQ P90 (%.2f) <= threshold (%.2f)", $norm_p90_numeric, $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD);
        }
    } else {
        $workload_pressure_reason_str_calc = "NormRunQ P90 N/A";
    }
    $debug_info{'IsWorkloadPressure'} = $is_workload_pressure_calc ? "True" : "False";
    $debug_info{'WorkloadPressureReason'} = $workload_pressure_reason_str_calc;


    # --- RunQ Design Philosophy ---
    # These three signals provide complementary views of CPU pressure at different
    # planning horizons, cleanly separating statistical measurement from business
    # policy. All values are ADDITIVE (delta cores), not absolute totals.
    #
    # RunQ_Potential: Pure Statistical Demand (Measurement)
    #   - Formula: excess_threads / SMT
    #   - No caps, no policy, no constraints applied
    #   - Answers: "What is the raw, unconstrained CPU demand that is not being met?"
    #   - Purpose: Baseline workload signal for trend analysis and anomaly detection
    #   - Time Horizon: Instantaneous snapshot of current pressure
    #
    # RunQ_Strategic: Architecturally Feasible Demand (Measurement)
    #   - Formula: min(RunQ_Potential, MaxCPU - BasePhysC)
    #   - Capped ONLY by available architectural headroom before hitting MaxCPU
    #   - No entitlement constraints, no tier policy, no volatility dampening
    #   - Answers: "What is the maximum demand that could be met within the VM's
    #              current architectural limits?"
    #   - Purpose: Identify VMs that are architecturally constrained (hitting MaxCPU)
    #   - Time Horizon: Quarterly planning cycle (3-6 months)
    #   - Diagnostic: If Tactical > Strategic, MaxCPU must be raised to implement
    #                 the recommendation
    #
    # RunQ_Tactical: Actionable Monthly Increment (Recommendation)
    #   - Formula: Raw demand passed through all safety gates and policy adjustments
    #   - Applies: EntCap (tier-aware), volatility factor, pool constraints,
    #              tier scaling, final adaptive safety cap
    #   - Answers: "What is the single, safe, incremental change I should make
    #              this month to begin addressing the pressure?"
    #   - Purpose: Safe, implementable monthly entitlement adjustment
    #   - Time Horizon: Monthly operational cycle (30 days)
    #
    # CRITICAL DESIGN PRINCIPLES:
    #   1. Potential and Strategic are MEASUREMENTS (no business policy)
    #   2. Tactical is a RECOMMENDATION (all business policy applied)
    #   3. Never contaminate Potential/Strategic with tier classifications or
    #      operational constraints (entitlement) - these are statistical signals
    #   4. All three signals are additive deltas for direct comparability
    #   5. The relationship Tactical â‰¤ Strategic â‰¤ Potential should hold under
    #      normal conditions (violations indicate architectural constraints)
    # =============================================================================

    my $apply_additive_logic = ($is_runq_pressure || $is_workload_pressure_calc);
    my $additive_cpu = 0.0;
    my $raw_additive_cpu = 0.0;
    # The queue's own reading, before PhysC corroboration. Retained so that the
    # anomaly sentinel and the audit trail see what the queue actually said.
    my $raw_additive_uncorroborated = 0.0;
    my $max_additive_cap_sliding = 0.0;
    my $capped_raw_additive_val = 0.0;
    my $volatility_confidence_factor = 1.0;
    my $pool_confidence_factor = 1.0;
    my $excess_threads = 0;

    # The additive logic path is only entered if significant pressure has been detected.
    if ($apply_additive_logic && defined $smt_used && $smt_used > 0)
    {
        # Calculate how many threads are waiting above a tolerated ceiling.
        # The tolerance factor allows for a healthy, non-problematic queue before recommending upsizing.

        # --- Tier-Aware Tolerance Factor ---
        # Select the tolerance for calculating "excess threads" based on the VM's tier.
        # Performance-critical tiers have a much lower tolerance for queuing.
        # Tier-aware tolerance, sourced from a single table so that the additive
        # operating point (tolerance x headroom factor) stays consistently above
        # the corresponding %DEFAULT_RUNQ_TARGETS reduction target for every
        # rung. Previously B1-B4, O3, O4 and G4 all fell through to the flat
        # 1.80 default, which left Batch without a tier gradient and inverted the
        # B4 rung against its own reduction target.
        # The tolerance ceiling is derived from the tier's idealised queue depth
        # rather than from a second, independently maintained ladder. Since the
        # additive path drives towards (tolerance x $RUNQ_TARGET_HEADROOM_FACTOR),
        # setting tolerance = target / headroom makes the additive operating
        # point EQUAL the downsizing target by construction: the two directions
        # aim at the same queue depth, and the crossover defect (B4 previously
        # added cores towards 1.44/LCPU whilst downsizing targeted 1.50/LCPU)
        # becomes structurally impossible. The gap between the target and the
        # trigger is a natural hysteresis band of 1/headroom - 1 (25% at 0.80).
        my ($tolerance_target, $tolerance_target_reason) = _resolve_runq_target($final_tier);
        my $tolerance_factor = ($RUNQ_TARGET_HEADROOM_FACTOR > 0)
            ? ($tolerance_target / $RUNQ_TARGET_HEADROOM_FACTOR)
            : $RUNQ_ADDITIVE_TOLERANCE_FACTOR;
        $debug_info{'AdditiveToleranceFactorSource'} = sprintf(
            "%s: target %.2f threads/LCPU -> tolerance %.2f (trigger); operating point %.2f threads/LCPU",
            $tolerance_target_reason, $tolerance_target, $tolerance_factor,
            $tolerance_factor * $RUNQ_TARGET_HEADROOM_FACTOR);

        my $capacity_threshold_for_excess = $tolerance_factor * $effective_lcpus_for_pressure_calc;

        # Trigger remains tied to the tolerance ceiling (pressure boundary), but the additive magnitude
        # should aim for a safer target below that ceiling.
        #
        # - Tolerance ceiling: the maximum "acceptable" queue before action is required.
        # - Target ceiling:    the desired operating point (headroom), below the tolerance ceiling.
        my $capacity_threshold_target = $capacity_threshold_for_excess * $RUNQ_TARGET_HEADROOM_FACTOR;

        $excess_threads = (defined $abs_runq_p_numeric ? $abs_runq_p_numeric : 0) - $capacity_threshold_target;
        if ((defined $abs_runq_p_numeric ? $abs_runq_p_numeric : 0) > $capacity_threshold_for_excess && $excess_threads > 0)
        {
            # Convert the excess threads into a raw CPU core requirement. This is the unconstrained demand.
            $debug_info{'ExcessThreads'} = sprintf(
                "\n         1. Observed Run Queue (%s)          : %.2f threads\n".
                "         2. Tolerance Ceiling               : %.1f LCPUs * %.2f (Tolerance Factor) = %.2f threads\n".
                "         3. Target Ceiling (Headroom)        : %.2f * %.2f (Target Factor) = %.2f threads\n".
                "         => Excess Threads to Service (to target): %.2f - %.2f = %.2f",
                $debug_info{AbsRunQKeyUsed},
                ($abs_runq_p_numeric // 0.0),
                $effective_lcpus_for_pressure_calc, $tolerance_factor, $capacity_threshold_for_excess,
                $capacity_threshold_for_excess, $RUNQ_TARGET_HEADROOM_FACTOR, $capacity_threshold_target,
                ($abs_runq_p_numeric // 0.0), $capacity_threshold_target, $excess_threads
            );
            $raw_additive_cpu = $excess_threads / $smt_used if $smt_used > 0;
            $raw_additive_uncorroborated = $raw_additive_cpu;

            # --- PhysC corroboration of the queue-derived capacity demand ---
            # Without this gate a partition peaking at a quarter of its
            # reachable capacity can still receive an entitlement uplift several
            # times its measured consumption, contradicting the principle that
            # the RunQ modifier is a secondary adjustment. Where PhysC is a
            # valid witness and reports slack, the runnable threads need
            # dispatch SLOTS (assessed as rVCPU in Section F), not guaranteed
            # capacity.
            my $censoring_ratio;
            my $corroboration_factor = 1.0;
            my $corroboration_reason;

            if ($is_capped_lpar) {
                $corroboration_reason = "Capped LPAR: PhysC cannot exceed entitlement and is therefore not an independent capacity witness. Queue reading trusted in full.";
            } elsif (!defined $pure_p99w1_physc || !looks_like_number($pure_p99w1_physc) || $reachable_cores <= $FLOAT_EPSILON) {
                $corroboration_reason = "Peak PhysC or reachable capacity unavailable; no corroboration possible. Queue reading trusted in full.";
            } else {
                $censoring_ratio = ($pure_p99w1_physc + 0) / $reachable_cores;

                if ($censoring_ratio >= $ADDITIVE_CENSORING_RATIO_FULL_TRUST) {
                    $corroboration_factor = 1.0;
                    $corroboration_reason = sprintf(
                        "Peak PhysC %.3f of %.2f reachable cores (%.0f%%): demand is censored by the dispatch ceiling, so PhysC cannot see it and the queue is the only witness. Full trust.",
                        $pure_p99w1_physc, $reachable_cores, $censoring_ratio * 100);
                } elsif ($censoring_ratio <= $ADDITIVE_CENSORING_RATIO_NO_TRUST) {
                    $corroboration_factor = 0.0;
                    $corroboration_reason = sprintf(
                        "Peak PhysC %.3f of %.2f reachable cores (%.0f%%): the LPAR left %.0f%% of its reachable capacity unused, so its runnable threads are not capacity-starved. Queue-derived capacity demand suppressed; dispatch width is assessed separately in Section F.",
                        $pure_p99w1_physc, $reachable_cores, $censoring_ratio * 100, (1 - $censoring_ratio) * 100);
                } else {
                    $corroboration_factor = ($censoring_ratio - $ADDITIVE_CENSORING_RATIO_NO_TRUST)
                                          / ($ADDITIVE_CENSORING_RATIO_FULL_TRUST - $ADDITIVE_CENSORING_RATIO_NO_TRUST);
                    $corroboration_reason = sprintf(
                        "Peak PhysC %.3f of %.2f reachable cores (%.0f%%): partially censored. Queue-derived capacity demand scaled by %.2f.",
                        $pure_p99w1_physc, $reachable_cores, $censoring_ratio * 100, $corroboration_factor);
                }

                # NOTE: a "refusal override" was trialled here - restoring full
                # trust when a queueing LPAR never exceeded its entitlement, on
                # the theory that it was asking for pool capacity and being
                # denied. Validation showed the signature is inverted: PAE ~= 0
                # overwhelmingly identifies partitions that never reach their
                # guarantee at all (peaks at 37% and 92% of entitlement), not
                # partitions being denied beyond it. Refusal is not observable
                # from PhysC and RunQ alone - it requires pool-level free-core
                # telemetry (lparstat 'app'), which is not staged. The override
                # is deliberately absent rather than approximated.
            }

            $raw_additive_cpu *= $corroboration_factor;

            $debug_info{'AdditiveCensoringRatio'}      = defined($censoring_ratio) ? sprintf("%.4f", $censoring_ratio) : $na_str;
            $debug_info{'AdditiveCorroborationFactor'} = sprintf("%.2f", $corroboration_factor);
            $debug_info{'AdditiveCorroborationReason'} = $corroboration_reason;
            $debug_info{'AdditiveRawUncorroborated'}   = sprintf("%.4f", $raw_additive_uncorroborated);

            # Determine the business policy scaling factor based on the VM's final tier.
            if (defined $final_tier && $final_tier =~ /(\d)$/) {
                $tier_num_for_scaling = $1;
            } elsif (defined $final_tier && $final_tier eq 'P') {
                $tier_num_for_scaling = 1;
            }

            if (defined $tier_num_for_scaling) {
                my %tier_upsizing_factors = (
                    1 => 1.30, 2 => 1.15, 3 => 1.00, 4 => 0.95
                );
                $tier_scaling_factor = $tier_upsizing_factors{$tier_num_for_scaling} // 1.00;
            }

            # --- Apply the Tier-Aware Entitlement-Based Cap (EntCap) ---
            # This is the first major safety gate. It limits the upsizing recommendation to a proportion
            # of the VM's current size, enforcing incremental change. Performance tiers get more aggressive caps.
            # IMPORTANT: This cap is applied ONLY to the TACTICAL path.
            my ($max_add_abs1, $max_add_perc2, $max_add_perc3, $max_add_perc_else);

            # Determine which tier group the VM falls into.
            # Performance group: mission-critical 'P' plus all tier-1/tier-2
            # classifications (O1/O2, G1/G2, B1/B2). Bare 'P' was previously
            # unmatched and fell into the conservative group; batch tier-1/2 are
            # now deliberately included, as a saturated overnight B1 chain is as
            # throughput-critical as its online counterpart.
            if ($final_tier =~ /^P\d?$|^[OGB][12]$/) {
                # Performance Tiers (Aggressive Response)
                $max_add_abs1      = 2.0;  # Allow up to +2.0 cores for small critical VMs
                $max_add_perc2     = 1.50; # 150% of Ent
                $max_add_perc3     = 1.00; # 100% of Ent
                $max_add_perc_else = 0.75; # 75% of Ent
            } else {
                # Efficiency Tiers (Conservative, Original Logic)
                $max_add_abs1      = 1.0;  # 1.0 core
                $max_add_perc2     = 1.00; # 100% of Ent
                $max_add_perc3     = 0.75; # 75% of Ent
                $max_add_perc_else = 0.50; # 50% of Ent
            }

            if ($curr_ent_numeric < 1.0)      { $max_additive_cap_sliding = $max_add_abs1; }
            elsif ($curr_ent_numeric < 2.0)   { $max_additive_cap_sliding = $curr_ent_numeric * $max_add_perc2; }
            elsif ($curr_ent_numeric < 4.0)   { $max_additive_cap_sliding = $curr_ent_numeric * $max_add_perc3; }
            else                               { $max_additive_cap_sliding = $curr_ent_numeric * $max_add_perc_else; }
            if ($curr_ent_numeric == 0 && $max_additive_cap_sliding == 0) { $max_additive_cap_sliding = $max_add_abs1; }

            # The EntCap is applied to the raw demand to begin the TACTICAL calculation path.
            $capped_raw_additive_val = min($raw_additive_cpu, $max_additive_cap_sliding);

            # --- Heuristic Checks for Pathological Workloads (HTW, DBW, etc.) ---
            # These checks identify workloads where simply adding CPU is inefficient or incorrect.
            $debug_info{'HotThreadWLDampeningApplied'} = "False"; $debug_info{'HotThreadWLConditionsString'} = "N/A";
            $debug_info{'HotThreadWLDynamicFactor'} = "N/A"; $debug_info{'HotThreadWLDampenedAdditiveFrom'} = "N/A";
            $debug_info{'HotThreadWLDampenedAdditiveTo'} = "N/A";
            if ($capped_raw_additive_val > $FLOAT_EPSILON)
            {
                my @htw_conditions_met_details; my $htw_condition_count = 0;
                if ($is_workload_pressure_calc) { push @htw_conditions_met_details, "HighNormP90"; $htw_condition_count++; }
                my $cond2_underutilized = 0;
                if (defined $base_physc && $base_physc > $FLOAT_EPSILON) {
                    my $underutilized_vs_ent = (defined $curr_ent_numeric && $curr_ent_numeric > $FLOAT_EPSILON && $base_physc < ($curr_ent_numeric * $HOT_THREAD_WL_ENT_FACTOR));
                    my $underutilized_vs_maxcpu = (defined $max_cpu_for_lpar_numeric && $max_cpu_for_lpar_numeric > $FLOAT_EPSILON && $base_physc < ($max_cpu_for_lpar_numeric * $HOT_THREAD_WL_MAXCPU_FACTOR));
                    if ($underutilized_vs_ent || $underutilized_vs_maxcpu) {
                        $cond2_underutilized = 1;
                        my $detail_ent_str = $underutilized_vs_ent ? sprintf("BaseP(%.2f)<Ent(%.2f)*%.1f", $base_physc, $curr_ent_numeric // 0, $HOT_THREAD_WL_ENT_FACTOR) : "";
                        my $detail_max_str = $underutilized_vs_maxcpu ? sprintf("BaseP(%.2f)<MaxP(%.2f)*%.1f", $base_physc, $max_cpu_for_lpar_numeric // 0, $HOT_THREAD_WL_MAXCPU_FACTOR) : "";
                        push @htw_conditions_met_details, "UnderutilizedCap(" . join(" or ", grep { $_ ne "" } $detail_ent_str, $detail_max_str) . ")";
                        $htw_condition_count++;
                    }
                }
                if (defined $norm_p50_numeric && $norm_p50_numeric > $HOT_THREAD_WL_HIGH_NORM_P50_THRESHOLD) { push @htw_conditions_met_details, sprintf("HighNormP50(%.2f>%.1f)", $norm_p50_numeric, $HOT_THREAD_WL_HIGH_NORM_P50_THRESHOLD); $htw_condition_count++; }
                if (!$is_runq_pressure && defined $debug_info{'RunQPressure_P90_Val'} && $debug_info{'RunQPressure_P90_Val'} ne $na_str) { push @htw_conditions_met_details, sprintf("NoLPARRunQSat(AbsPVal:%.2f<%.1f)", ($debug_info{'RunQPressure_P90_Val'} + 0), $RUNQ_PRESSURE_P90_SATURATION_THRESHOLD); $htw_condition_count++; }
                if (defined $normrunq_iqrc_val && abs($normrunq_iqrc_val) > $HOT_THREAD_WL_IQRC_THRESHOLD) { push @htw_conditions_met_details, sprintf("HighIQRC(%.2f>%.1f)", $normrunq_iqrc_val, $HOT_THREAD_WL_IQRC_THRESHOLD); $htw_condition_count++; }
                my $hot_thread_wl_conditions_met_str = @htw_conditions_met_details ? join("; ", @htw_conditions_met_details) : "No specific conditions met";
                if ($htw_condition_count >= $HOT_THREAD_WL_DETECTION_MIN_CONDITIONS_MET)
                {
                    my $util_ratio = (defined $max_cpu_for_lpar_numeric && $max_cpu_for_lpar_numeric > $FLOAT_EPSILON && defined $base_physc) ? ($base_physc / $max_cpu_for_lpar_numeric) : 1.0;
                    my $util_damp_multiplier = max(0.1, min(1.0, $util_ratio));
                    my $iqrc_damp_multiplier = (defined $normrunq_iqrc_val) ? min(1.0, 1.0 / (1.0 + abs($normrunq_iqrc_val))) : 1.0;
                    my $base_physc_severity_multiplier = (defined $base_physc && $base_physc > $FLOAT_EPSILON) ? min(1.0, $base_physc / 1.0) : 0.1;
                    my $calculated_dynamic_damp_factor = $HOT_THREAD_WL_BASE_DAMPENING_FACTOR * $util_damp_multiplier * $iqrc_damp_multiplier * $base_physc_severity_multiplier;
                    my $final_dynamic_dampening_factor_calc = max($HOT_THREAD_WL_MIN_DYNAMIC_DAMPENING, min($HOT_THREAD_WL_MAX_DYNAMIC_DAMPENING, $calculated_dynamic_damp_factor));
                    my $original_additive_val = $capped_raw_additive_val;
                    $capped_raw_additive_val *= $final_dynamic_dampening_factor_calc;
                    $debug_info{'HotThreadWLDampeningApplied'} = "True";
                    $debug_info{'HotThreadWLConditionsString'} = $hot_thread_wl_conditions_met_str;
                    $debug_info{'HotThreadWLDynamicFactor'} = sprintf("%.4f (Base:%.2f UtilM:%.2f IqrcM:%.2f SevM:%.2f -> RawCalc:%.4f)", $final_dynamic_dampening_factor_calc, $HOT_THREAD_WL_BASE_DAMPENING_FACTOR, $util_damp_multiplier, $iqrc_damp_multiplier, $base_physc_severity_multiplier, $calculated_dynamic_damp_factor);
                    $debug_info{'HotThreadWLDampenedAdditiveFrom'} = sprintf("%.4f", $original_additive_val);
                    $debug_info{'HotThreadWLDampenedAdditiveTo'}   = sprintf("%.4f", $capped_raw_additive_val);
                    $debug_info{'CappedRawAdditive'} = sprintf("%.4f", $capped_raw_additive_val);
                } else {
                    $debug_info{'HotThreadWLDampeningApplied'} = "False";
                    $debug_info{'HotThreadWLConditionsString'} = sprintf("Conditions not met for HTW dampening (%d/5 met: %s).", $htw_condition_count, $hot_thread_wl_conditions_met_str);
                }
            }
            if ($is_runq_pressure) {
                $volatility_confidence_factor = $RUNQ_PRESSURE_SATURATION_CONFIDENCE_FACTOR;
                $debug_info{'VoltFactorReason'} = sprintf("RunQPressure Saturation (Factor set to %.2f)", $RUNQ_PRESSURE_SATURATION_CONFIDENCE_FACTOR);
            } elsif ($is_workload_pressure_calc && defined $norm_p50_numeric && defined $norm_p90_numeric && $norm_p90_numeric > 0.01) {
                my $volatility_ratio_for_factor = ($norm_p50_numeric > 0.01) ? ($norm_p90_numeric / $norm_p50_numeric) : 999;
                if ($volatility_ratio_for_factor < $VOLATILITY_SPIKY_THRESHOLD) { $volatility_confidence_factor = $VOLATILITY_SPIKY_FACTOR; }
                elsif ($volatility_ratio_for_factor < $VOLATILITY_MODERATE_THRESHOLD){ $volatility_confidence_factor = $VOLATILITY_MODERATE_FACTOR; }
                else { $volatility_confidence_factor = 1.0; }
                $debug_info{'VoltFactorReason'} = sprintf("Calculated (NormRQ P90/P50 ratio %.2f for WorkloadPressure -> Factor %.2f)", $volatility_ratio_for_factor, $volatility_confidence_factor);
            } else {
                $debug_info{'VoltFactorReason'} = "Additive logic applied, but conditions for specific Volatility Factor adjustment not met (e.g., WorkloadPressure False or P50/P90 N/A for ratio). Using default factor.";
            }
            $additive_cpu = $capped_raw_additive_val * $volatility_confidence_factor;
            if ($is_in_non_default_pool && $additive_cpu > 0) {
                $pool_confidence_factor = $POOL_CONSTRAINT_CONFIDENCE_FACTOR;
                $additive_cpu *= $pool_confidence_factor;
            }

            # --- FINAL SIGNAL ASSIGNMENT ---
            my $sanity_bound = (defined $max_cpu_for_lpar_numeric && $max_cpu_for_lpar_numeric > 0) ? ($max_cpu_for_lpar_numeric * 2.0) : 10.0;

            # 1. Potential is the pure, unscaled, raw demand.
            $debug_info{'RunQ_Potential'} = $raw_additive_cpu;

            # 2. RunQ_Strategic: Architecturally feasible demand, capped only by MaxCPU.
            # formula: min(RunQ_Potential, MaxCPU - BasePhysC)
            my $strategic_val = $raw_additive_cpu;
            if ($max_cpu_for_lpar_numeric > 0) {
                my $available_headroom = $max_cpu_for_lpar_numeric - $base_physc;
                $strategic_val = min($raw_additive_cpu, $available_headroom);
            }
            $debug_info{'RunQ_Strategic'} = $strategic_val;

            # 3. Check for pathological state (Signal Inversion)
            # Deliberately evaluated against the UNCORROBORATED reading: a queue
            # large enough to trip this bound is an anomaly worth surfacing
            # whether or not PhysC corroborates it. Suppressing it because the
            # LPAR had spare capacity would hide the more interesting case -
            # threads runnable in volume whilst capacity goes unused.
            if ($raw_additive_uncorroborated > $sanity_bound) {
                $debug_info{'RunQ_Potential'} = "ANOMALY (XRQ)";
                $debug_info{'RunQ_Strategic'} = $max_cpu_for_lpar_numeric;
                $debug_info{'ReasonForSignalInversion'} = sprintf(
                    "Raw Additive CPU (%.2f, uncorroborated) exceeded sanity bound (%.2f), indicating a probable system backlog or malfunction.",
                    $raw_additive_uncorroborated, $sanity_bound
                );
            }

      } else {
            my $capacity_threshold_target = $capacity_threshold_for_excess * $RUNQ_TARGET_HEADROOM_FACTOR;
            $debug_info{'ExcessThreads'} = sprintf(
                "0.0000 (AbsRunQ %s was %.2f; target ceiling %.2f = tolerance %.2f * target %.2f; basis=%s)",
                $debug_info{AbsRunQKeyUsed}, ($abs_runq_p_numeric // $na_str),
                $capacity_threshold_target, $capacity_threshold_for_excess, $RUNQ_TARGET_HEADROOM_FACTOR,
                ($pressure_basis_rationale =~ /Burst-Tolerant/ ? "Entitlement+Burst" : "MaxCPU")
            );
            $raw_additive_cpu = 0.0;
            $capped_raw_additive_val = 0.0;
            $additive_cpu = 0.0;
            $debug_info{'VoltFactorReason'} = "No excess threads, so no additive CPU calculated.";
            $debug_info{'RunQ_Strategic'} = "0.00";
            $debug_info{'RunQ_Potential'} = "0.00";
        }
    } else {
        $debug_info{'ExcessThreads'} = "N/A (Additive logic not applied as no significant pressure detected or missing inputs)";
        $debug_info{'VoltFactorReason'} = "Additive logic not applied.";
    }
    $debug_info{'RawAdditive'}       = sprintf("%.4f", $raw_additive_cpu);
    $debug_info{'MaxAdditiveCap'}    = sprintf("%.4f", $max_additive_cap_sliding);
    $debug_info{'CappedRawAdditive'} = sprintf("%.4f", $capped_raw_additive_val);
    $debug_info{'VoltFactor'}        = sprintf("%.2f", $volatility_confidence_factor);
    $debug_info{'PoolFactor'}        = sprintf("%.2f", $pool_confidence_factor);
    my $dbw_dampening_applied = "False";
    my $cond1_low_util = (defined $base_physc && $base_physc < ($curr_ent_numeric * $DBW_LOW_UTIL_FACTOR));
    my $dsr = 0;
    if (defined $base_physc && $base_physc > 0.01 && defined $abs_runq_p_numeric) { $dsr = $abs_runq_p_numeric / ($base_physc * $smt_used); }
    my $cond2_high_dsr = ($dsr > $DBW_DSR_THRESHOLD);
    my $cond3_high_median_pressure = (defined $norm_p50_numeric && $norm_p50_numeric > $DBW_MEDIAN_PRESSURE_THRESHOLD);
    if ($cond1_low_util && $cond2_high_dsr && $cond3_high_median_pressure) {
        my $original_additive = $additive_cpu;
        $debug_info{'RunQ_Potential'} = "ANOMALY (DBW)";
        $additive_cpu *= 0.25;
        $dbw_dampening_applied = sprintf("True (75%% dampening applied).\n                                               Additive CPU reduced from %.4f to %.4f.\n                                               Conditions met: Low Util (BaseP %.2f < %.2f Ent * %.2f), High DSR (%.1f > %.1f), High Median Pressure (NormP50 %.2f > %.1f)", $original_additive, $additive_cpu, $base_physc, $curr_ent_numeric, $DBW_LOW_UTIL_FACTOR, $dsr, $DBW_DSR_THRESHOLD, $norm_p50_numeric, $DBW_MEDIAN_PRESSURE_THRESHOLD);
    }
    $debug_info{'DBWDampeningApplied'} = $dbw_dampening_applied;

    # This is the final and most important safety cap. It prevents recommendations from violating
    # the VM's hard limits (MaxCPU) while allowing for "Intelligent Headroom" based on pressure severity.
    # --- Adaptive Safety Hard-Cap with Intelligent Headroom ---
    my $original_additive_before_safety_cap = $additive_cpu;
    my $additive_safety_cap_applied_reason = "Not applied";

    # Step 1: Calculate Pressure Severity to determine Virtual Headroom
    my $pressure_ratio = ($effective_lcpus_for_pressure_calc > 0) ? (($excess_threads // 0) / $effective_lcpus_for_pressure_calc) : 0;
    my $virtual_headroom_factor = 0;
    if ($apply_additive_logic) { # Only apply headroom if there's pressure
        if ($pressure_ratio >= 1.0) {
            $virtual_headroom_factor = 0.50; # 50% for Severe Pressure
        } else {
            $virtual_headroom_factor = 0.25; # 25% for Significant Pressure
        }
    }
    my $virtual_max_cpu = $max_cpu_for_lpar_numeric * (1 + $virtual_headroom_factor);

    # Step 2: Calculate the Primary Dynamic Cap using Virtual Headroom
    # NOTE (Fix 3): Tactical should not be constrained by MaxCPU-derived headroom.
    # The EntCap provides a safe incremental limit based on entitlement alone.
    # The HeadCap is now computed for diagnostic/rationale purposes only.

    # Tier-graded EntCap percentage with a small-entitlement floor (Phase 2).
    my $is_performance_tier_for_cap = ($final_tier =~ /^P\d?$|^[OGB][12]$/) ? 1 : 0;
    my $cap_pct_of_ent = $is_performance_tier_for_cap
        ? $FINAL_ADDITIVE_CAP_PCT_ENT_PERF
        : $FINAL_ADDITIVE_CAP_PCT_ENT_STD;
    my $cap_from_ent = $curr_ent_numeric * $cap_pct_of_ent;
    my $headroom = ($virtual_max_cpu > $curr_ent_numeric) ? ($virtual_max_cpu - $curr_ent_numeric) : 0;
    my $cap_from_headroom = $headroom * 0.50;

    # Tactical uses EntCap only (demand-oriented, not environment-constrained).
    # HeadCap is retained for rationale logging and Strategic comparison.
    my $primary_cap = $cap_from_ent;

    # Record whether HeadCap would have been binding (for rationale/diagnostics)
    my $headcap_would_bind = ($headroom > 0 && $cap_from_headroom < $cap_from_ent);
    my $headcap_constrained_value = ($headroom > 0) ? min($cap_from_ent, $cap_from_headroom) : $cap_from_ent;

    # The Pressure Gate moderates the cap for borderline cases.
    # If pressure is only moderate, we apply a small dampening to the cap.
    # For significant or severe pressure, we apply the full cap without dampening.
    my $pressure_gate_modifier = 1.0;
    if ($pressure_ratio < 0.5) {
        $pressure_gate_modifier = 0.75;
    }

    my $gated_cap = $primary_cap * $pressure_gate_modifier;

    # Small-entitlement floor (Phase 2): for micro-partitions a
    # percentage-of-entitlement cap collapses to a value too small to ever
    # address demand (e.g. 40% of a 0.41-core LPAR is 0.16 cores against
    # multi-core queue evidence). The floor raises only the cap ceiling; the
    # additive remains demand-derived and never exceeds the raw requirement.
    my $tier_cap_floor = $is_performance_tier_for_cap
        ? $FINAL_ADDITIVE_CAP_FLOOR_PERF
        : $FINAL_ADDITIVE_CAP_FLOOR_STD;
    my $final_safety_cap_value = max($tier_cap_floor, $gated_cap);
    $final_safety_cap_value = min($final_safety_cap_value, $FINAL_ADDITIVE_CAP_ABS_MAX);

    # Build cap rationale (EntCap-only for Tactical; HeadCap is diagnostic)
    my $floor_note = ($final_safety_cap_value > $gated_cap + 0.0001)
        ? sprintf(" [tier floor %.2f applied]", $tier_cap_floor)
        : "";
    my $cap_rationale;
    if ($headcap_would_bind) {
        $cap_rationale = sprintf("EntCap=%.2f * PresGate=%.2f -> %.4f%s (HeadCap=%.2f would be lower but Tactical is demand-oriented)",
            $cap_from_ent, $pressure_gate_modifier, $final_safety_cap_value, $floor_note, $cap_from_headroom);
    } else {
        $cap_rationale = sprintf("EntCap=%.2f * PresGate=%.2f -> %.4f%s", $cap_from_ent, $pressure_gate_modifier, $final_safety_cap_value, $floor_note);
    }

    if ($additive_cpu > $final_safety_cap_value) {
        $additive_cpu = $final_safety_cap_value;
        $additive_safety_cap_applied_reason = sprintf("True: Additive CPU hard-capped to %.4f (%s)", $additive_cpu, $cap_rationale);
    } else {
        $additive_safety_cap_applied_reason = sprintf("False (Additive %.4f within adaptive hard cap of %.4f from %s)", $original_additive_before_safety_cap, $final_safety_cap_value, $cap_rationale);
    }
    $debug_info{'AdditiveSafetyCapApplied'} = $additive_safety_cap_applied_reason;

    # --- Final Tier-Aware Scaling for the Tactical Recommendation ---
    # This is the last step, applying the business policy (tier importance) to the final, safety-vetted additive value.
    if ($tier_scaling_factor != 1.00 && $additive_cpu > 0) {
        my $pre_scaled_additive = $additive_cpu;
        $additive_cpu *= $tier_scaling_factor;

        # Reconstruct the rationale for logging
        my $increase_pct = ($tier_scaling_factor - 1.0) * 100;
        my $rationale_text = sprintf(
            "Tier %d: Enhanced upsizing (+%.0f%%) for lower latency tolerance. Base: %.3f -> Scaled: %.3f cores",
            $tier_num_for_scaling, $increase_pct, $pre_scaled_additive, $additive_cpu
        );

        $debug_info{'TierScalingFactor'}        = sprintf("%.2f", $tier_scaling_factor);
        $debug_info{'TierNumber'}               = $tier_num_for_scaling;
        $debug_info{'TierScalingRationale'}     = $rationale_text;
        $debug_info{'AdditiveCPU_PreTierScaling'}  = sprintf("%.4f", $pre_scaled_additive);
        $debug_info{'AdditiveCPU_PostTierScaling'} = sprintf("%.4f", $additive_cpu);
    }

    # Task 5: the reduction branch is removed with the machinery that fed it. It
    # read $efficiency_factor_numeric, which the retired choke point pinned at
    # 1.00, so it could never fire; a negative tactical modifier has not been
    # reachable since the reduction was disabled.
    my $final_tactical_modifier = 0;
    if ($additive_cpu > $FLOAT_EPSILON) {
        $final_tactical_modifier = $additive_cpu;
    }

    # Implementability deadband (additive path). $additive_cpu is zeroed with the
    # reported modifier so that $calculated_demand, synthesised below, stays
    # coherent with the CSV recommendation. Measurements are untouched.
    if ($final_tactical_modifier > $FLOAT_EPSILON && $final_tactical_modifier < $MIN_MEANINGFUL_ADJUSTMENT_CORES) {
        $debug_info{'TacticalDeadbandApplied'} = sprintf(
            "True: Tactical +%.4f cores is below the smallest implementable entitlement increment (%.2f cores); suppressed. RunQ_Potential/RunQ_Strategic retain the measured values.",
            $final_tactical_modifier, $MIN_MEANINGFUL_ADJUSTMENT_CORES);
        $final_tactical_modifier = 0;
        $additive_cpu = 0.0;
    }

    $debug_info{'RunQ_Tactical'} = $final_tactical_modifier;
    $debug_info{'FinalAdditive'} = sprintf("%.4f", $final_tactical_modifier);

    # ================================================================
    # Tactical vs Strategic Diagnostic (Fix 3)
    # ================================================================
    # When Tactical > Strategic, the safe incremental step exceeds what
    # is achievable under current MaxCPU. This is a signal that MaxCPU
    # must be raised before implementing the Tactical recommendation.
    # ================================================================
    my $strategic_val = (defined $debug_info{'RunQ_Strategic'} && looks_like_number($debug_info{'RunQ_Strategic'}))
                      ? ($debug_info{'RunQ_Strategic'} + 0) : 0;
    my $tactical_exceeds_strategic = ($final_tactical_modifier > 0 && $strategic_val >= 0 && $final_tactical_modifier > ($strategic_val + 0.005));
    $debug_info{'TacticalExceedsStrategic'} = $tactical_exceeds_strategic ? 1 : 0;
    if ($tactical_exceeds_strategic) {
        $debug_info{'TacticalExceedsStrategicNote'} = sprintf(
            "Tactical (%.4f cores) exceeds Strategic (%.4f cores). Raise MaxCPU before implementing Tactical.",
            $final_tactical_modifier, $strategic_val
        );
    }

    # =========================
    # Final Synthesis + MaxCPU
    # =========================
    my $calculated_demand = $base_adjusted_physc + $additive_cpu;

    # A2.1: preserve the workload-profile demand before any guarantee floor.
    # This is the business-selected quantity that entitlement must protect:
    # selected profile + growth + any corroborated positive RunQ additive.
    my $base_planning_demand = $calculated_demand;
    $debug_info{'BasePlanningDemand'} = sprintf("%.4f", $base_planning_demand);

    # The complete tier witness depends on the yield floor calculated inside the
    # rVCPU block below. Seed convergence from BasePlanningDemand when the inputs
    # required to finish that witness are available. If they are not, preserve the
    # prior conservative behaviour by using raw Peak_P-99W1 as the fallback now;
    # otherwise a missing RunQ/SMT path could silently lose peak protection.
    my ($seed_paired_density) = _resolve_peak_runnable_density($vm_map_ref);
    my $seed_smt = (defined $vm_map_ref->{Configuration}{smt}
                    && looks_like_number($vm_map_ref->{Configuration}{smt})
                    && $vm_map_ref->{Configuration}{smt} > 0)
                 ? ($vm_map_ref->{Configuration}{smt} + 0) : undef;
    my $can_complete_yield_witness =
        (defined $base_planning_demand && looks_like_number($base_planning_demand) && $base_planning_demand > 0
         && defined $pure_p99w1_physc && looks_like_number($pure_p99w1_physc) && $pure_p99w1_physc > 0
         && defined $seed_paired_density && looks_like_number($seed_paired_density) && $seed_paired_density > 0
         && defined $seed_smt
         && defined $abs_runq_p_numeric && looks_like_number($abs_runq_p_numeric)) ? 1 : 0;

    my ($guarantee_seed_demand, $guarantee_seed_source);
    if ($can_complete_yield_witness) {
        $guarantee_seed_demand = $base_planning_demand;
        $guarantee_seed_source = 'BasePlanningDemand (yield witness pending)';
    } else {
        ($guarantee_seed_demand, $guarantee_seed_source) = _resolve_guarantee_demand(
            $base_planning_demand, undef, $pure_p99w1_physc, $final_tier);
    }
    $debug_info{'GuaranteeSeedDemand'} = defined($guarantee_seed_demand)
        ? sprintf("%.4f", $guarantee_seed_demand) : 'N/A';
    $debug_info{'GuaranteeSeedSource'} = $guarantee_seed_source // 'N/A';
    $debug_info{'YieldAdjustedPeakDemand'} = 'N/A';
    $debug_info{'YieldAdjustedPeakDemandSource'} = $can_complete_yield_witness
        ? 'pending rVCPU yield calculation'
        : 'N/A (raw credible-peak fallback used)';
    $debug_info{'GuaranteeDemand'} = defined($guarantee_seed_demand)
        ? sprintf("%.4f", $guarantee_seed_demand) : 'N/A';
    $debug_info{'GuaranteeDemandSource'} = $guarantee_seed_source // 'N/A';

    # --- Pre-yield guarantee seed (dispatch budget applied to entitlement) ---
    # This pass exists so missing yield inputs retain a conservative fallback.
    # When the yield witness is computable it deliberately uses BasePlanningDemand
    # only; the completed, proposal-relative GuaranteeDemand is applied by A1
    # after the yield floor exists. A monotone convergence loop cannot undo an
    # entitlement that was prematurely raised from raw Peak_P-99W1 here.
    my ($budget_floor_cores, $budget_floor_reason) = _tier_guarantee_floor(
        $guarantee_seed_demand, $reachable_cores, $is_capped_lpar, $dispatch_budget, $final_tier);

    $debug_info{'BudgetFloorCores'}  = defined($budget_floor_cores) ? sprintf("%.4f", $budget_floor_cores) : 'N/A';
    $debug_info{'BudgetFloorReason'} = $budget_floor_reason // 'N/A';
    $debug_info{'BudgetFloorApplied'} = 'No';

    if (defined $budget_floor_cores && $budget_floor_cores > $calculated_demand + $FLOAT_EPSILON) {
        $debug_info{'BudgetFloorApplied'} = sprintf("Yes: raised %.4f -> %.4f cores (+%.4f)",
            $calculated_demand, $budget_floor_cores, $budget_floor_cores - $calculated_demand);
        $calculated_demand = $budget_floor_cores;
    }

    # Preserve the workload-driven (planning) entitlement before any MaxCPU sanity capping.
    # This is the "what the workload needs" value, independent of current environment limits.
    my $rENT_P_planning = $calculated_demand;

    my $runq_modified_rec = $calculated_demand;
    $debug_info{'PreMaxCpuCapRec'} = sprintf("%.4f", $runq_modified_rec);
    my $forecast_multiplier_val = 1.25;
    if ($curr_ent_numeric < 0.5)    { $forecast_multiplier_val = 2.5; }
    elsif ($curr_ent_numeric < 1.0) { $forecast_multiplier_val = 2.0; }
    elsif ($curr_ent_numeric < 2.0) { $forecast_multiplier_val = 1.75; }
    elsif ($curr_ent_numeric < 4.0) { $forecast_multiplier_val = 1.5; }
    $debug_info{'ForecastMultiplier'} = $forecast_multiplier_val;
    my $effective_max_cpu_cap_val = ($max_cpu_for_lpar_numeric > 0) ? ($max_cpu_for_lpar_numeric * $forecast_multiplier_val) : undef;
    $debug_info{'EffectiveMaxCPUCap'} = defined($effective_max_cpu_cap_val) ? sprintf("%.4f", $effective_max_cpu_cap_val) : $na_str;
    if (defined $effective_max_cpu_cap_val && $calculated_demand > $effective_max_cpu_cap_val) {
        $runq_modified_rec = $effective_max_cpu_cap_val;
        $debug_info{'CappedByMaxCPU'} = "True";
    } else {
        $debug_info{'CappedByMaxCPU'} = (defined $effective_max_cpu_cap_val) ? "False" : "N/A (No LPAR MaxCPU for cap check or MaxCPU not exceeded)";
    }
    if ($runq_modified_rec < 0) { $runq_modified_rec = 0; }
    $debug_info{'FinalAdjustedPhysC'} = sprintf("%.4f", $runq_modified_rec);
    $debug_info{'rENT_P_Planning'} = sprintf("%.4f", $rENT_P_planning);

    # ------------------------------------------------------------------
    # rVCPU computation (stress-driven, slot-aware, rENT-bounded, peak-aware)
    #
    # IMPORTANT: This must be computed here (where per-profile AbsRunQ_Pxx is
    # already available as $abs_runq_p_numeric) so rationale logging can be
    # deterministic and consistent with other debug_info fields.
    # ------------------------------------------------------------------
    do {
        my $rvcpu_raw;
        my $rvcpu_min;
        my $rvcpu_max;
        my $rvcpu_final;
        my $p99w1_floor_vcpu;
        my $configured_burst_floor_vcpu;
        my $configured_burst_floor = {};
        my $p99w1_factor_eff;
        my $p99w1_mult;
        my $runnable_density = 1.00;
        my $p99w1_adjusted;
        my $yield_adjusted_peak_demand;
        my $yield_adjusted_peak_source;

        # Dispatch reserve variables (Layer 5: uncertainty/reserve adjustments)
        my $dispatch_reserve_vp = 0;
        my $dispatch_reserve_reason = '';
        my $dispatch_reserve_pre_final;  # Store the pre-reserve rVCPU for rationale

        # Micro-partition RunQ envelope override tracking
        my $runq_envelope_override = 0;
        my $runq_envelope_basis = undef;
        my ($orig_rvcpu_min, $orig_rvcpu_max) = (undef, undef);

        # rENT_P (operational): the post-MaxCPU-sanity value used for the final entitlement output.
        my $rENT_P = (defined $runq_modified_rec && looks_like_number($runq_modified_rec)) ? ($runq_modified_rec + 0) : undef;

        # rENT_P_for_envelope (planning): the pre-MaxCPU-sanity value used for VP envelope derivation.
        # This ensures the VP envelope reflects workload demand, not current environment limits.
        # When MaxCPU sanity does not cap the recommendation, these are identical.
        my $rENT_P_for_envelope = (defined $rENT_P_planning && looks_like_number($rENT_P_planning) && $rENT_P_planning > 0)
                                ? ($rENT_P_planning + 0)
                                : $rENT_P;

        # Track whether the planning and operational values diverge (for rationale clarity).
        my $envelope_exceeds_operational = (defined $rENT_P_for_envelope && defined $rENT_P && $rENT_P_for_envelope > $rENT_P + 0.005);

        my $smt_for_vcpu = (defined $vm_map_ref->{Configuration}{smt} && looks_like_number($vm_map_ref->{Configuration}{smt}))
                         ? ($vm_map_ref->{Configuration}{smt} + 0)
                         : undef;

        # Use the per-profile AbsRunQ percentile already computed in this function.
        my $runq_hi_threads = (defined $abs_runq_p_numeric && looks_like_number($abs_runq_p_numeric)) ? ($abs_runq_p_numeric + 0) : undef;

        # Tier-aware headroom: extract tier number from $final_tier (already in scope).
        my $rvcpu_tier_num = 3;  # Default baseline
        if (defined $final_tier && $final_tier =~ /(\d)$/) {
            $rvcpu_tier_num = $1;
        } elsif (defined $final_tier && $final_tier eq 'P') {
            $rvcpu_tier_num = 1;
        }
        my $rvcpu_tier_factor = $VCPU_TIER_HEADROOM_FACTORS{$rvcpu_tier_num} // 1.00;

        # Interval-adaptive divisor for Gate 1 (dispatch sizing).
        # This is a divisor (target utilisation), not a multiplier.
        my $runq_width_divisor = $RUNQ_TARGET_HEADROOM_FACTOR;
        $runq_width_divisor = 0.80 if (!defined $runq_width_divisor || !looks_like_number($runq_width_divisor) || $runq_width_divisor <= 0);

        my $runq_width_divisor_base = $runq_width_divisor;
        my $runq_interval_minutes_snapped;

        if (defined $adaptive_thresholds_href && ref($adaptive_thresholds_href) eq 'HASH') {
            if (defined $adaptive_thresholds_href->{runq_width_divisor_base}
                && looks_like_number($adaptive_thresholds_href->{runq_width_divisor_base})
                && $adaptive_thresholds_href->{runq_width_divisor_base} > 0) {
                $runq_width_divisor_base = $adaptive_thresholds_href->{runq_width_divisor_base} + 0;
            }
            if (defined $adaptive_thresholds_href->{runq_width_divisor}
                && looks_like_number($adaptive_thresholds_href->{runq_width_divisor})
                && $adaptive_thresholds_href->{runq_width_divisor} > 0) {
                $runq_width_divisor = $adaptive_thresholds_href->{runq_width_divisor} + 0;
            }
            if (defined $adaptive_thresholds_href->{snapped_minutes}
                && looks_like_number($adaptive_thresholds_href->{snapped_minutes})
                && $adaptive_thresholds_href->{snapped_minutes} > 0) {
                $runq_interval_minutes_snapped = int($adaptive_thresholds_href->{snapped_minutes} + 0);
            }
        }

        # Hard safety clamps (never allow divide-by-zero or absurd divisors).
        my $MIN_RUNQ_WIDTH_DIVISOR = 0.50;
        my $MAX_RUNQ_WIDTH_DIVISOR = 1.00;
        $runq_width_divisor_base = 0.80 if (!defined $runq_width_divisor_base || !looks_like_number($runq_width_divisor_base) || $runq_width_divisor_base <= 0);
        $runq_width_divisor_base = $MIN_RUNQ_WIDTH_DIVISOR if ($runq_width_divisor_base < $MIN_RUNQ_WIDTH_DIVISOR);
        $runq_width_divisor_base = $MAX_RUNQ_WIDTH_DIVISOR if ($runq_width_divisor_base > $MAX_RUNQ_WIDTH_DIVISOR);

        $runq_width_divisor = $runq_width_divisor_base if (!defined $runq_width_divisor || !looks_like_number($runq_width_divisor) || $runq_width_divisor <= 0);
        $runq_width_divisor = $MIN_RUNQ_WIDTH_DIVISOR if ($runq_width_divisor < $MIN_RUNQ_WIDTH_DIVISOR);
        $runq_width_divisor = $MAX_RUNQ_WIDTH_DIVISOR if ($runq_width_divisor > $MAX_RUNQ_WIDTH_DIVISOR);

        # Interval credibility correction (for corroboration ratio only):
        # Coarser sampling dampens RunQ tails, which can falsely reduce RunQ↔PhysC corroboration.
        # Apply a *relative* correction ONLY to the RunQ-derived cores used in the credibility ratio:
        #   corr = base_divisor / adaptive_divisor
        # This is an identity at 60s (corr=1.00), never deflates RunQ credibility (corr>=1.00),
        # and is hard-clamped to avoid over-trusting RunQ tails.
        my $runq_cred_corr = 1.00;
        my $runq_cred_corr_suffix = '';
        do {
            my $corr = 1.00;
            if (defined $runq_width_divisor_base && defined $runq_width_divisor && $runq_width_divisor > 0) {
                $corr = $runq_width_divisor_base / $runq_width_divisor;
            }
            $corr = 1.00 if (!defined $corr || !looks_like_number($corr) || $corr <= 0);
            $corr = 1.00 if ($corr < 1.00);
            $corr = 1.50 if ($corr > 1.50);
            $runq_cred_corr = $corr;

            if ($runq_cred_corr > 1.0005) {
                $runq_cred_corr_suffix = sprintf(" [Interval Correction: x%.2f%s]",
                    $runq_cred_corr,
                    (defined $runq_interval_minutes_snapped ? sprintf(", %dm", $runq_interval_minutes_snapped) : "")
                );
            }
        };

        if (defined $runq_hi_threads && defined $smt_for_vcpu && $smt_for_vcpu > 0 && defined $rENT_P && $rENT_P > 0) {
            # Workload-driven width requirement (threads -> cores -> vCPUs), tier-adjusted.
            # Higher tiers demand more spare runnable capacity (lower acceptable queue utilisation).
            # NOTE: The divisor below is a target utilisation divisor (e.g., 0.80), not a multiplier.
            my $required_threads = ($runq_hi_threads / $runq_width_divisor) * $rvcpu_tier_factor;
            my $required_cores   = $required_threads / $smt_for_vcpu;
            $rvcpu_raw = int($required_cores);
            $rvcpu_raw++ if ($required_cores > $rvcpu_raw); # ceil

            # ------------------------------------------------------------------
            # Peak-aware floor VALUE (rENT-independent). Hoisted above the
            # strategic envelope/clamp below so the A1 convergence loop can
            # re-derive the envelope for a trial planning rENT without
            # recomputing this. Sets $p99w1_floor_vcpu / $p99w1_factor_eff /
            # $p99w1_mult / $runnable_density.
            # ------------------------------------------------------------------
            # Peak-aware floor from P-99W1 (mandatory helper profile)
            if (defined $pure_p99w1_physc && looks_like_number($pure_p99w1_physc) && $pure_p99w1_physc > 0) {
                # Conservative default. A valid paired yield calculation replaces
                # this with the tier-retained active-core witness below. Retaining
                # raw Peak_P-99W1 when paired evidence is absent prevents missing
                # data from making downsizing more aggressive.
                $yield_adjusted_peak_demand = $pure_p99w1_physc + 0;
                $yield_adjusted_peak_source = 'Peak_P-99W1 conservative fallback (paired yield unavailable)';

                # RunQ runnable-density assessment of the P99W1 peak.
                #
                # CAUTION: the discount applied below rests on the premise that a
                # PhysC peak with few runnable threads reflects dispatch overhead.
                # Estate evidence contradicts this. At 1.2-3.9 runnable threads per
                # consumed core (the observed low-occupancy range), the commercial
                # SMT yield curve Y(k) = 1 + 0.45*log2(k) puts per-thread throughput
                # at 88-51% of a solo core: the work is running fast, not idling.
                # Low occupancy is a WIDTH observation, not a capacity one.
                #
                # ESTIMATOR CAVEAT: this ratio compares two independently derived
                # percentiles (P99W1 PhysC against AbsRunQ_P99W1) that need not come
                # from the same minute. NormRunQ pairs the same quantity per sample
                # before aggregating, and the two disagree materially (vm1: 1.947
                # here against NormRunQ P90 1.08). E[X/Y] != E[X]/E[Y]; the paired
                # form is correct. Superseded by paired metrics in nfit (Stage 2).
                $p99w1_adjusted = $pure_p99w1_physc;
                #
                # Prefer the peak-helper-aligned W1 RunQ tail for credibility, so we
                # compare like-for-like: P99W1 PhysC vs AbsRunQ_P99W1 (window=1).
                # Paired runnable density (Stage 2): NormRunQ already IS
                # runq/(physc*smt), formed per sample inside nfit. No arithmetic is
                # needed here - only a lookup at the PhysC-aligned tail.
                my ($paired_density, $occupancy_source) = _resolve_peak_runnable_density($vm_map_ref);
                if (defined $paired_density) {
                    # Interval correction is identity at the native 60s cadence and
                    # only engages on coarser staging, where the RunQ numerator is
                    # undercounted at the tail.
                    $runnable_density = $paired_density * $runq_cred_corr;
                    $debug_info{'rVCPU_RunnableDensitySource'} = $occupancy_source;

                    # Runnable threads per consumed CORE, for the planner note.
                    # ThreadsPerCore = NormRunQ * SMT exactly: SMT is constant within
                    # a config state and percentiles are equivariant under
                    # multiplication by a positive constant, so no separate nfit
                    # transform is required.
                    $debug_info{'rVCPU_RunQThreadsPerPhysC'} =
                        (defined $smt_for_vcpu && $smt_for_vcpu > 0)
                            ? sprintf("%.2f", $runnable_density * $smt_for_vcpu) : 'N/A';

                    # Yield-aware active-core floor (Stage 3). This replaces the
                    # withdrawn occupancy discount, which multiplied the peak by an
                    # arbitrary max(0.65, occupancy + 0.15). The floor instead asks a
                    # falsifiable question: how many active cores are needed to retain
                    # this tier's required share of the throughput the workload is
                    # estimated to be achieving now?
                    my $threads_per_core_peak = (defined $smt_for_vcpu && $smt_for_vcpu > 0)
                        ? ($runnable_density * $smt_for_vcpu) : undef;
                    my ($retention_eff, $retention_policy_key) =
                        _resolve_tier_throughput_retention($final_tier, $rvcpu_tier_num);
                    my ($yield_floor_cores, $yield_floor_reason) =
                        _yield_aware_active_core_floor($pure_p99w1_physc, $threads_per_core_peak, $retention_eff);

                    if (defined $yield_floor_cores) {
                        $p99w1_adjusted = $yield_floor_cores;
                        $yield_adjusted_peak_demand = $yield_floor_cores + 0;
                        $yield_adjusted_peak_source = sprintf(
                            'yield-aware credible peak (%s, %.0f%% retention)',
                            $retention_policy_key, $retention_eff * 100);
                    }
                    $debug_info{'rVCPU_YieldFloorCores'}     = defined($yield_floor_cores) ? sprintf("%.2f", $yield_floor_cores) : 'N/A';
                    $debug_info{'rVCPU_YieldRetentionUsed'}  = sprintf("%.2f", $retention_eff);
                    $debug_info{'rVCPU_YieldRetentionPolicy'} = $retention_policy_key;
                    $debug_info{'rVCPU_YieldFloorReason'}    = $yield_floor_reason // 'N/A';

                    # Retained for comparison only - see $VCPU_PEAK_CRED_DISCOUNT_ENABLED.
                    if ($VCPU_PEAK_CRED_DISCOUNT_ENABLED) {
                        my $credibility = $runnable_density + $VCPU_PEAK_CRED_BIAS;
                        $credibility = $VCPU_PEAK_CRED_MIN if ($credibility < $VCPU_PEAK_CRED_MIN);
                        $credibility = 1.00 if ($credibility > 1.00);
                        $p99w1_adjusted = $pure_p99w1_physc * $credibility;
                    }
                } else {
                    $debug_info{'rVCPU_RunnableDensitySource'} = 'N/A (no paired NormRunQ percentile available)';
                }

                # Peak-sourced burst evidence. These previously read the PROFILE-LOCAL
                # PAE/AAE, which describe how often THIS PROFILE's smoothed series
                # crossed the entitlement line - a property of the lens, not of the
                # partition. The same VM reads PAE 1.0000 through its peak profile and
                # 0.0000 through G3, so the VP headroom this drives varied by profile
                # for reasons unconnected to the workload. Burst behaviour belongs to
                # the partition; only the peak profile witnesses it.
                my $pae_raw = (defined $debug_info{'PhysC_Peak_PAE'} && looks_like_number($debug_info{'PhysC_Peak_PAE'})) ? ($debug_info{'PhysC_Peak_PAE'} + 0) : 0.0;
                my $aae_raw = (defined $debug_info{'PhysC_Peak_AAE'} && looks_like_number($debug_info{'PhysC_Peak_AAE'})) ? ($debug_info{'PhysC_Peak_AAE'} + 0) : 0.0;

                # Each component contributes up to +15% of peak when its threshold is reached.
                # PAE: proportion of days above entitlement (chronic burst indicator)
                # AAE: aggregate excess above entitlement (burst magnitude indicator)
                my $pae_component = ($pae_raw > 0) ? (($pae_raw < 0.30 ? $pae_raw : 0.30) / 0.30) * 0.15 : 0.0;
                my $aae_component = ($aae_raw > 0) ? (($aae_raw < 0.10 ? $aae_raw : 0.10) / 0.10) * 0.15 : 0.0;

                # Task 2: shadow diagnostic by default - see $VCPU_PAE_AAE_HEADROOM_ENABLED.
                # $headroom is still computed and logged (as $p99w1_mult) so PAE/AAE
                # chronic-burst evidence stays visible; it is not applied to the floor.
                my $headroom = ($pae_component + $aae_component) * $rvcpu_tier_factor;
                $p99w1_factor_eff = $VCPU_PAE_AAE_HEADROOM_ENABLED ? (1.00 + $headroom) : 1.00;
                $p99w1_mult = $headroom;  # Shadow diagnostic: portion above 1.00 that would apply if enabled

                my $floor_v = ($p99w1_adjusted + 0) * $p99w1_factor_eff;

                $p99w1_floor_vcpu = int($floor_v); $p99w1_floor_vcpu++ if ($floor_v > $p99w1_floor_vcpu);

                # Enforce minimum floor (evenisation removed)
                if (defined $p99w1_floor_vcpu) {
                    $p99w1_floor_vcpu = 1 if ($p99w1_floor_vcpu < 1);
                }
            }

            # A2.1: complete the tier-applicable witness now that the yield floor
            # exists. BasePlanningDemand protects the profile-selected workload;
            # YieldAdjustedPeakDemand protects the tier-retained credible peak.
            # For P, the resolver additionally enforces raw Peak_P-99W1 as a hard
            # witness. This value, not raw peak universally, governs A1.
            my ($guarantee_demand, $guarantee_demand_source) = _resolve_guarantee_demand(
                $base_planning_demand, $yield_adjusted_peak_demand,
                $pure_p99w1_physc, $final_tier);

            $debug_info{'YieldAdjustedPeakDemand'} = defined($yield_adjusted_peak_demand)
                ? sprintf("%.4f", $yield_adjusted_peak_demand) : 'N/A';
            $debug_info{'YieldAdjustedPeakDemandSource'} = $yield_adjusted_peak_source // 'N/A';
            $debug_info{'GuaranteeDemand'} = defined($guarantee_demand)
                ? sprintf("%.4f", $guarantee_demand) : 'N/A';
            $debug_info{'GuaranteeDemandSource'} = $guarantee_demand_source // 'N/A';

            # A2.3: retain configured burst width only when the raw credible
            # peak shows that the CURRENT reachable width has actually been
            # exercised. Sustained demand is the selected profile-derived
            # BasePlanningDemand; P99W1 is the activation witness, not the
            # numerator. P remains protected by its hard raw-peak floor.
            $configured_burst_floor = _configured_burst_vp_floor({
                base_demand         => $base_planning_demand,
                credible_peak       => $pure_p99w1_physc,
                current_vp          => $vcpu_for_lpar_numeric,
                current_entitlement => $curr_ent_numeric,
                pool_cpu            => $pool_cpu_for_lpar_numeric,
                is_capped           => $is_capped_lpar,
                tier_label          => $final_tier,
                tier_num            => $rvcpu_tier_num,
                evidence            => \%debug_info,
            });
            $configured_burst_floor_vcpu = $configured_burst_floor->{active}
                                           ? $configured_burst_floor->{floor} : undef;
            $debug_info{'rVCPU_ConfiguredBurstFloorActive'} =
                $configured_burst_floor->{active} ? 'Yes' : 'No';
            $debug_info{'rVCPU_ConfiguredBurstFloor'} = defined($configured_burst_floor_vcpu)
                ? $configured_burst_floor_vcpu : 'N/A';
            $debug_info{'rVCPU_ConfiguredBurstTargetUtilisation'} =
                defined($configured_burst_floor->{target})
                    ? sprintf('%.2f', $configured_burst_floor->{target}) : 'N/A';
            $debug_info{'rVCPU_ConfiguredBurstPolicy'} =
                $configured_burst_floor->{policy_key} // 'N/A';
            $debug_info{'rVCPU_ConfiguredBurstCurrentReachable'} =
                defined($configured_burst_floor->{current_reachable})
                    ? sprintf('%.2f', $configured_burst_floor->{current_reachable}) : 'N/A';
            $debug_info{'rVCPU_ConfiguredBurstPeakReachRatio'} =
                defined($configured_burst_floor->{peak_reach_ratio})
                    ? sprintf('%.3f', $configured_burst_floor->{peak_reach_ratio}) : 'N/A';
            $debug_info{'rVCPU_ConfiguredBurstReason'} =
                $configured_burst_floor->{reason} // 'N/A';

            # ==================================================================
            # A1: Proposal-relative guarantee-floor convergence (strategic pair)
            # ==================================================================
            # The tier guarantee floor must be evaluated against the reachability
            # the PROPOSED strategic pair delivers - min(proposed rVCPU, pool)
            # when uncapped, or the proposed entitlement when capped - not the
            # current configured VPs. Because the strategic rVCPU depends on the
            # planning entitlement (envelope) and the floor depends on that rVCPU
            # (reachability), the pair is solved by a bounded, monotone-raising
            # fixed-point iteration over the PLANNING entitlement only. The
            # rENT-independent evidence ($rvcpu_raw, $p99w1_floor_vcpu,
            # $runnable_density) is already computed above, so the A0 kernel is
            # re-evaluated for each trial with no side effects. EntBounded and
            # Tactical are NOT part of this loop; they run once, afterwards.
            #
            # The seed is BasePlanningDemand (or the conservative raw-peak fallback
            # when yield evidence was unavailable). The loop only ever RAISES the
            # planning entitlement. This ordering is essential: a raw-peak floor
            # applied before the tier yield witness existed could not be undone by
            # monotone convergence and silently defeated lower-tier risk appetite.
            my ($conv_current_reach, $conv_pre_rent, $conv_pre_rvcpu,
                $conv_iters, $conv_stop, $conv_applied, $conv_maxcpu_blocks);
            $conv_current_reach = $reachable_cores;
            $conv_pre_rent      = $rENT_P_for_envelope;
            {
                my $pre = _strategic_rvcpu_envelope({
                    rent_p               => $rENT_P,
                    rent_for_envelope    => $conv_pre_rent,
                    rvcpu_raw            => $rvcpu_raw,
                    p99w1_floor_vcpu     => $p99w1_floor_vcpu,
                    configured_burst_floor_vcpu => $configured_burst_floor_vcpu,
                    runnable_density     => $runnable_density,
                    runq_hi_threads      => $runq_hi_threads,
                    smt                  => $smt_for_vcpu,
                    max_cpu              => $max_cpu_for_lpar_numeric,
                    runq_potential       => $debug_info{'RunQ_Potential'},
                    is_runq_pressure     => $debug_info{'IsRunQPressure'},
                    is_workload_pressure => $debug_info{'IsWorkloadPressure'},
                });
                $conv_pre_rvcpu = $pre->{rvcpu_final};
            }

            # The convergence result must be expressible at the same increment
            # requested for nfit's entitlement output. A bare -r/-u has no
            # explicit increment and therefore retains the 0.05 default.
            my $ent_granule = (defined $DEFAULT_ROUND_INCREMENT
                                && looks_like_number($DEFAULT_ROUND_INCREMENT)
                                && $DEFAULT_ROUND_INCREMENT > 0)
                              ? ($DEFAULT_ROUND_INCREMENT + 0) : 0.05;
            if (defined $round_arg && looks_like_number($round_arg) && $round_arg > 0) {
                $ent_granule = $round_arg + 0;
            } elsif (defined $roundup_arg && looks_like_number($roundup_arg) && $roundup_arg > 0) {
                $ent_granule = $roundup_arg + 0;
            }
            $debug_info{'GuaranteeEntitlementGranule'} = sprintf("%.4f", $ent_granule);
            my $conv_trial = $rENT_P_for_envelope;
            my $CONV_MAX_ITERS = 8;   # conservative; the iteration is monotone and typically settles in <=3
            $conv_iters = 0;
            $conv_stop  = 'converged';
            my ($conv_floor, $conv_floor_reason, $conv_proposed_reach);

            while (defined $conv_trial) {
                $conv_iters++;
                my $s = _strategic_rvcpu_envelope({
                    rent_p               => $conv_trial,
                    rent_for_envelope    => $conv_trial,
                    rvcpu_raw            => $rvcpu_raw,
                    p99w1_floor_vcpu     => $p99w1_floor_vcpu,
                    configured_burst_floor_vcpu => $configured_burst_floor_vcpu,
                    runnable_density     => $runnable_density,
                    runq_hi_threads      => $runq_hi_threads,
                    smt                  => $smt_for_vcpu,
                    max_cpu              => $max_cpu_for_lpar_numeric,
                    runq_potential       => $debug_info{'RunQ_Potential'},
                    is_runq_pressure     => $debug_info{'IsRunQPressure'},
                    is_workload_pressure => $debug_info{'IsWorkloadPressure'},
                });
                my $rv_trial = $s->{rvcpu_final};

                # Proposed reachability from THIS trial's strategic pair.
                if ($is_capped_lpar) {
                    $conv_proposed_reach = $conv_trial;                       # capped: reachable == entitlement
                } elsif (defined $pool_cpu_for_lpar_numeric && looks_like_number($pool_cpu_for_lpar_numeric) && $pool_cpu_for_lpar_numeric > 0) {
                    $conv_proposed_reach = (defined $rv_trial && $rv_trial < $pool_cpu_for_lpar_numeric)
                                         ? $rv_trial : $pool_cpu_for_lpar_numeric;   # uncapped: min(proposed VP, pool)
                } else {
                    $conv_proposed_reach = $rv_trial;                         # pool size unknown: reachable == proposed VP
                }

                # For an uncapped proposal, Demand > Reachable is a width or
                # configuration infeasibility, not an entitlement floor. The
                # guarantee helper deliberately returns a reach-pinned numeric
                # floor for diagnostics in this state. Feeding that value into
                # this monotone loop, however, can raise entitlement until the
                # ratio envelope widens and then retain the provisional raise
                # after the final proposal-relative floor has disappeared.
                # Completed RunQ/yield/burst evidence has already had the chance
                # to open the strategic envelope above. If demand is still
                # unreachable, stop and let the final invariant fail closed (and
                # Tactical hold) rather than manufacturing guaranteed demand.
                if (!$is_capped_lpar
                    && defined $guarantee_demand
                    && looks_like_number($guarantee_demand)
                    && defined $conv_proposed_reach
                    && looks_like_number($conv_proposed_reach)
                    && $guarantee_demand > $conv_proposed_reach + $FLOAT_EPSILON) {
                    $conv_floor = undef;
                    $conv_floor_reason = sprintf(
                        "INFEASIBLE WIDTH: applicable demand %.2f cores exceeds proposed reachable capacity %.2f; entitlement was not raised because the uncapped proposal requires more reachable width, pool capacity or MaxCPU",
                        $guarantee_demand, $conv_proposed_reach);
                    $conv_stop = 'infeasible proposed width';
                    last;
                }

                ($conv_floor, $conv_floor_reason) = _tier_guarantee_floor(
                    $guarantee_demand, $conv_proposed_reach, $is_capped_lpar, $dispatch_budget, $final_tier);

                last unless (defined $conv_floor && $conv_floor > $conv_trial + $FLOAT_EPSILON);

                my $raised = _ceil_to_granule($conv_floor, $ent_granule);
                if (!defined $raised || $raised <= $conv_trial + $FLOAT_EPSILON) {
                    $conv_stop = 'no progress at granule';
                    last;
                }
                $conv_trial = $raised;
                if ($conv_iters >= $CONV_MAX_ITERS) { $conv_stop = 'iteration cap'; last; }
            }

            # Commit the converged PLANNING entitlement (monotone: raise only).
            # Re-derive the OPERATIONAL entitlement from the existing MaxCPU cap;
            # convergence itself operates on planning values only.
            $conv_applied       = 0;
            $conv_maxcpu_blocks = 0;
            if (defined $conv_trial && $conv_trial > $rENT_P_for_envelope + $FLOAT_EPSILON) {
                $rENT_P_for_envelope = $conv_trial;
                $rENT_P_planning     = $conv_trial;
                my $op = $conv_trial;
                if (defined $effective_max_cpu_cap_val && $op > $effective_max_cpu_cap_val) {
                    $op = $effective_max_cpu_cap_val;
                    $conv_maxcpu_blocks = 1;
                }
                $rENT_P            = $op;
                $runq_modified_rec = $op;
                $conv_applied      = 1;
                $debug_info{'rENT_P_Planning'}    = sprintf("%.4f", $rENT_P_planning);
                $debug_info{'FinalAdjustedPhysC'} = sprintf("%.4f", $runq_modified_rec);
                $debug_info{'CappedByMaxCPU'}     = $conv_maxcpu_blocks ? "True" : $debug_info{'CappedByMaxCPU'};
                $debug_info{'PreMaxCpuCapRec'}    = sprintf("%.4f", $rENT_P_for_envelope);
            }

            # Always replace the pre-yield/current-reachability seed rationale
            # with the final tier witness evaluated against proposed reachability,
            # even when no entitlement raise was necessary.
            $debug_info{'BudgetFloorCores'} = defined($conv_floor)
                ? sprintf("%.4f", $conv_floor) : 'N/A';
            $debug_info{'BudgetFloorReason'} = $conv_floor_reason // 'N/A';

            # Convergence may change the relationship between the planning and
            # operational recommendations. Refresh the lexical source consumed
            # later by Profile_rVCPU_Explain and its debug mirror.
            $envelope_exceeds_operational =
                (defined $rENT_P_for_envelope
                 && defined $rENT_P
                 && $rENT_P_for_envelope > $rENT_P + 0.005) ? 1 : 0;

            # ------------------------------------------------------------------
            # Strategic rVCPU envelope + clamp + Layer-5a override (A0 kernel).
            # Side-effect-free: given the trial planning rENT and the
            # rENT-independent evidence above, returns the envelope and the
            # clamped/overridden strategic rVCPU. Diagnostics are returned and
            # mirrored into %debug_info here. Authoritative path only.
            # Runs once more with the CONVERGED planning entitlement to produce
            # the final strategic pair.
            # ------------------------------------------------------------------
            my $strat = _strategic_rvcpu_envelope({
                rent_p               => $rENT_P,
                rent_for_envelope    => $rENT_P_for_envelope,
                rvcpu_raw            => $rvcpu_raw,
                p99w1_floor_vcpu     => $p99w1_floor_vcpu,
                configured_burst_floor_vcpu => $configured_burst_floor_vcpu,
                runnable_density     => $runnable_density,
                runq_hi_threads      => $runq_hi_threads,
                smt                  => $smt_for_vcpu,
                max_cpu              => $max_cpu_for_lpar_numeric,
                runq_potential       => $debug_info{'RunQ_Potential'},
                is_runq_pressure     => $debug_info{'IsRunQPressure'},
                is_workload_pressure => $debug_info{'IsWorkloadPressure'},
            });
            $rvcpu_min              = $strat->{rvcpu_min};
            $rvcpu_max              = $strat->{rvcpu_max};
            $rvcpu_final            = $strat->{rvcpu_final};
            $orig_rvcpu_min         = $strat->{orig_rvcpu_min};
            $orig_rvcpu_max         = $strat->{orig_rvcpu_max};
            $runq_envelope_override = $strat->{runq_envelope_override};
            $runq_envelope_basis    = $strat->{runq_envelope_basis};
            $debug_info{'MicroPartitionEnvExpansion'} = $strat->{micro_expansion_note}
                if (defined $strat->{micro_expansion_note});

            # ------------------------------------------------------------------
            # A1: final proposed reachability, soft budget invariant, rationale.
            # The invariant is a rationale/debug flag, never a batch abort.
            # ------------------------------------------------------------------
            my $conv_final_reach;
            if ($is_capped_lpar) {
                $conv_final_reach = $rENT_P_for_envelope;
            } elsif (defined $pool_cpu_for_lpar_numeric && looks_like_number($pool_cpu_for_lpar_numeric) && $pool_cpu_for_lpar_numeric > 0) {
                $conv_final_reach = (defined $rvcpu_final && $rvcpu_final < $pool_cpu_for_lpar_numeric)
                                  ? $rvcpu_final : $pool_cpu_for_lpar_numeric;
            } else {
                $conv_final_reach = $rvcpu_final;
            }
            my $conv_pool_bound = (!$is_capped_lpar
                && defined $pool_cpu_for_lpar_numeric && $pool_cpu_for_lpar_numeric > 0
                && defined $rvcpu_final && $rvcpu_final > $pool_cpu_for_lpar_numeric) ? 1 : 0;

            my ($conv_inv_ok, $conv_inv_msg) = _assert_budget_invariant(
                $guarantee_demand, $rENT_P_for_envelope, $conv_final_reach,
                $is_capped_lpar, $dispatch_budget, $final_tier);
            $debug_info{'GuaranteeInvariantHolds'} = !defined($conv_inv_ok) ? 'N/A'
                                                   : ($conv_inv_ok ? 'Yes' : 'No');
            $debug_info{'GuaranteeInvariant'}      = $conv_inv_msg;

            my @conv_impl_blocks;
            push @conv_impl_blocks, sprintf("MaxCPU cap %.2f cores", $effective_max_cpu_cap_val)
                if ($conv_maxcpu_blocks && defined $effective_max_cpu_cap_val);
            push @conv_impl_blocks, sprintf("pool %.2f < proposed %s VPs", $pool_cpu_for_lpar_numeric, (defined $rvcpu_final ? $rvcpu_final : '?'))
                if ($conv_pool_bound);
            push @conv_impl_blocks, sprintf(
                "proposed rVCPU %d exceeds current MaxCPU ceiling %.2f",
                $rvcpu_final, $max_cpu_for_lpar_numeric)
                if (defined $rvcpu_final
                    && defined $max_cpu_for_lpar_numeric
                    && $max_cpu_for_lpar_numeric > 0
                    && $rvcpu_final > $max_cpu_for_lpar_numeric + $FLOAT_EPSILON);

            $debug_info{'GuaranteeConvergence'} = sprintf(
                "demand witness %.4f [%s]; current reachability %.2f -> proposed reachability %.2f; pre-convergence (Ent %.4f, rVCPU %s) -> converged (Ent %.4f, rVCPU %s); %d iteration(s) (%s); %s%s",
                (defined $guarantee_demand ? $guarantee_demand : 0),
                ($guarantee_demand_source // 'N/A'),
                (defined $conv_current_reach ? $conv_current_reach : 0),
                (defined $conv_final_reach   ? $conv_final_reach   : 0),
                (defined $conv_pre_rent      ? $conv_pre_rent      : 0),
                (defined $conv_pre_rvcpu     ? $conv_pre_rvcpu     : 'N/A'),
                $rENT_P_for_envelope,
                (defined $rvcpu_final        ? $rvcpu_final        : 'N/A'),
                (defined $conv_iters         ? $conv_iters         : 0),
                (defined $conv_stop          ? $conv_stop          : 'n/a'),
                ($conv_applied ? 'guarantee raised the planning entitlement'
                 : ($conv_stop eq 'infeasible proposed width'
                    ? 'no entitlement raise applied; the uncapped proposal requires additional reachable width'
                    : 'no raise required (budget satisfied at seed)')),
                (@conv_impl_blocks ? ('; implementation/reachability constrained by ' . join(', ', @conv_impl_blocks)) : '')
            );
            $debug_info{'GuaranteeConvergencePlannerVisible'} =
                ($conv_applied
                 || (defined $conv_inv_ok && !$conv_inv_ok)
                 || @conv_impl_blocks) ? 'Yes' : 'No';

            # Same facts, split for planner-facing presentation. The combined
            # string above is retained for the CSV/debug trail; the rationale
            # prints these labelled components instead of one dense sentence.
            $debug_info{'ConvDemandWitness'} = sprintf("%.4f cores (%s)",
                (defined $guarantee_demand ? $guarantee_demand : 0),
                ($guarantee_demand_source // 'N/A'));
            $debug_info{'ConvReachability'} = sprintf("%.2f -> %.2f cores",
                (defined $conv_current_reach ? $conv_current_reach : 0),
                (defined $conv_final_reach   ? $conv_final_reach   : 0));
            $debug_info{'ConvPair'} = sprintf("Ent %.4f / %s VPs -> Ent %.4f / %s VPs",
                (defined $conv_pre_rent  ? $conv_pre_rent  : 0),
                (defined $conv_pre_rvcpu ? $conv_pre_rvcpu : 'N/A'),
                $rENT_P_for_envelope,
                (defined $rvcpu_final    ? $rvcpu_final    : 'N/A'));
            $debug_info{'ConvOutcome'} = sprintf("%s (%d iteration(s), %s)",
                ($conv_applied ? 'guarantee raised the planning entitlement'
                 : ($conv_stop eq 'infeasible proposed width'
                    ? 'no entitlement raise applied; the uncapped proposal requires additional reachable width'
                    : 'no raise required (budget satisfied at seed)')),
                (defined $conv_iters ? $conv_iters : 0),
                (defined $conv_stop  ? $conv_stop  : 'n/a'));
            $debug_info{'ConvFeasibility'} = (@conv_impl_blocks)
                ? join(', ', @conv_impl_blocks) : '';

            $debug_info{'BudgetFloorApplied'} = $conv_applied
                ? sprintf("Yes (proposal-relative): planning Ent -> %.4f cores at proposed reachability %.2f",
                          $rENT_P_for_envelope, (defined $conv_final_reach ? $conv_final_reach : 0))
                : $debug_info{'BudgetFloorApplied'};

            # ================================================================
            # LAYER 5: Conditional Dispatch Reserve (Dynamic Scaling)
            # ================================================================
            # When uncertainty indicators are present and rVCPU would collapse
            # to the envelope minimum, add a scaled reserve to provide dispatch
            # margin. Reserve scales with risk level and respects env_max.
            # ================================================================
            $dispatch_reserve_pre_final = $rvcpu_final;

            RESERVE_CALC: {
                # Task 1: retired - see $VCPU_DISPATCH_RESERVE_ENABLED for why all three
                # triggers below are either a falsified premise or duplicated evidence.
                # Checked first so that while disabled, $dispatch_reserve_vp and
                # $dispatch_reserve_reason are never touched and stay at their
                # initialised (0, '') values - no rationale text is produced.
                last RESERVE_CALC unless $VCPU_DISPATCH_RESERVE_ENABLED;

                last RESERVE_CALC unless (defined $rvcpu_final && defined $rvcpu_min && defined $rvcpu_max);

                # Only trigger if final would otherwise equal or near the floor
                my $would_collapse = ($rvcpu_final <= $rvcpu_min);
                last RESERVE_CALC unless $would_collapse;

                # Uncertainty indicators
                my $has_growth = (defined $growth_adj_numeric && $growth_adj_numeric > 0.25);
                my $has_pressure = ($p99w1_overall_vm_has_abs_runq_pressure || $p99w1_overall_vm_has_norm_runq_pressure);
                my $has_low_corroboration = (defined $runnable_density && $runnable_density < 0.70);

                # Count risk triggers
                my $risk_count = 0;
                $risk_count++ if $has_growth;
                $risk_count++ if $has_pressure;
                $risk_count++ if $has_low_corroboration;

                last RESERVE_CALC unless ($risk_count > 0);

                # --- Dynamic Scaling Logic ---

                # 1. Define Base Percentage by Tier
                my %tier_base_pct = (1 => 0.10, 2 => 0.075, 3 => 0.05);
                my $target_pct = $tier_base_pct{$rvcpu_tier_num} // 0.05;

                # 2. Apply Risk Multiplier (2.0x boost for multiple risk indicators)
                my $risk_multiplier = ($risk_count >= 2) ? 2.0 : 1.0;
                $target_pct *= $risk_multiplier;

                # 3. Calculate Raw Reserve based on Planning Entitlement
                my $basis_cores = $rENT_P_for_envelope // $rENT_P // 0;
                my $raw_reserve = $basis_cores * $target_pct;

                # 4. Tiered Floor (scaled to VP_Min to avoid blunt fixed step changes)
                #    NOTE: rVCPU evenisation is intentionally disabled (commit 95f3364c...),
                #          so do NOT force this floor to be even.
                #    Tier 1/2: floor = max(2, ceil(VP_Min × 0.25))
                #    Tier 3+:  floor = max(2, ceil(VP_Min × 0.15))
                my $vp_min_for_floor = (defined $rvcpu_min && looks_like_number($rvcpu_min)) ? ($rvcpu_min + 0) : 0;
                my $floor_ratio = ($rvcpu_tier_num <= 2) ? 0.25 : 0.15;
                my $floor_raw = $vp_min_for_floor * $floor_ratio;

                # ceil
                my $floor_vps = int($floor_raw + 0.999);
                $floor_vps = 2 if ($floor_vps < 2);

                # 5. Integer Rounding (Ceiling)
                my $calc_reserve = int($raw_reserve + 0.999);  # ceil

                # Apply floor
                $calc_reserve = $floor_vps if ($calc_reserve < $floor_vps);

                # 6. Headroom-aware cap: avoid consuming most of the remaining VP envelope when reserve is
                #    triggered by uncertainty (e.g., LowCorroboration) rather than demonstrated dispatch demand.
                #
                #    Cap reserve to a fraction of available headroom above the *pre-reserve* rVCPU:
                #      Tier 1/2: up to 50% of headroom
                #      Tier 3+:  up to 40% of headroom
                #
                #    NOTE: rVCPU evenisation is intentionally disabled (commit 95f3364c...),
                #          so do NOT force reserve or caps to be even.
                my $available_headroom = $rvcpu_max - $rvcpu_final;
                $available_headroom = 0 if (!defined $available_headroom || $available_headroom < 0);

                my $headroom_frac = ($rvcpu_tier_num <= 2) ? 0.50 : 0.40;
                my $headroom_cap_vps = 0;
                if ($available_headroom > 0) {
                    my $cap_raw = $available_headroom * $headroom_frac;
                    $headroom_cap_vps = int($cap_raw + 0.999);  # ceil
                    $headroom_cap_vps = 0 if ($headroom_cap_vps < 0);
                }

                my $was_headroom_capped = 0;
                my $pre_headroom_cap_reserve = $calc_reserve;
                if ($headroom_cap_vps >= 0 && $calc_reserve > $headroom_cap_vps) {
                    $calc_reserve = $headroom_cap_vps;
                    $was_headroom_capped = 1;
                }

                # 7. Safe Clamping (respect env_max)
                my $was_clamped = 0;
                my $pre_clamp_reserve = $calc_reserve;

                $dispatch_reserve_vp = $calc_reserve;

                if ($dispatch_reserve_vp > $available_headroom) {
                    $dispatch_reserve_vp = $available_headroom;
                    $was_clamped = 1;

                    # Ensure non-negative
                    $dispatch_reserve_vp = 0 if ($dispatch_reserve_vp < 0);

                }

                # Build trigger list for rationale
                my @triggers;
                push @triggers, sprintf("GrowthAdj +%.2f", $growth_adj_numeric) if $has_growth;
                push @triggers, "Pressure" if $has_pressure;
                push @triggers, sprintf("LowCorroboration %.2f", $runnable_density) if $has_low_corroboration;
                my $trigger_str = join(", ", @triggers);
                my $risk_label = ($risk_count >= 2) ? "HighRisk" : "Standard";

                # Build reason for rationale (including suppression cases)
                if ($dispatch_reserve_vp > 0) {
                    my $clamp_note = "";
                    if ($was_headroom_capped) {
                        my $cap_pct = int($headroom_frac * 100 + 0.5);
                        $clamp_note .= sprintf(" [headroom-cap %d%% (%d/%d) from %d]",
                            $cap_pct, $headroom_cap_vps, $available_headroom, $pre_headroom_cap_reserve
                        );
                    }
                    if ($was_clamped) {
                        $clamp_note .= sprintf(" [clamped from %d; headroom %d]", $pre_clamp_reserve, $available_headroom);
                    }
                    $dispatch_reserve_reason = sprintf(
                        "Dispatch reserve +%d VPs (Mode: %s; Scale: %.1f%% of %.2f cores; Floor: %d; Triggers: %s)%s",
                        $dispatch_reserve_vp, $risk_label, $target_pct * 100, $basis_cores, $floor_vps, $trigger_str, $clamp_note
                    );
                    $rvcpu_final += $dispatch_reserve_vp;
                } else {
                    # Reserve triggered but fully suppressed by env_max (diagnostic)
                    $dispatch_reserve_reason = sprintf(
                        "Dispatch reserve SUPPRESSED (would add %d VPs but env_max headroom is %d; Mode: %s; Triggers: %s)",
                        $pre_clamp_reserve, $available_headroom, $risk_label, $trigger_str
                    );
                }
            }

        }

        # ================================================================
        # Task 3: Stage-1-safe VP recommendation
        # ================================================================
        # rVCPU (above) is bounded below by ceil(rENT), the RECOMMENDED
        # entitlement, so implementing it may require a coordinated
        # entitlement change. rVCPU_EntBounded uses ceil(CURRENT
        # entitlement) instead, so it preserves entitlement during Stage 1
        # of the two-stage cycle (cut VPs, hold entitlement, let true
        # consumption become visible before entitlement is revisited next
        # cycle). MaxCPU/profile feasibility is checked separately.
        # ================================================================
        my $current_ent_numeric = (defined $current_entitlement_str && $current_entitlement_str ne ""
                                    && looks_like_number($current_entitlement_str))
                                 ? ($current_entitlement_str + 0) : undef;
        my $current_ent_stale = (!defined $current_ent_numeric || $current_ent_numeric <= 0) ? 1 : 0;

        my $vp_current_ent_floor;
        if ($current_ent_stale) {
            # Watch for: current entitlement unavailable or stale on this execution
            # path. Do not invent a VP floor from unknown data - fall back to the
            # recommended envelope minimum (VP_Min) so EntBounded degrades to the
            # coordinated figure rather than silently under-reporting.
            $vp_current_ent_floor = $rvcpu_min;
        } else {
            $vp_current_ent_floor = int($current_ent_numeric);
            $vp_current_ent_floor++ if ($current_ent_numeric > $vp_current_ent_floor); # ceil
        }

        # Current VP count for the rate limiter (Task 4). Sourced here, on this
        # path, and reused for persistence below; passed into the centralised
        # decision helper rather than recomputed inside it.
        my $current_vp_numeric = (defined $vcpu_for_lpar_numeric && looks_like_number($vcpu_for_lpar_numeric) && $vcpu_for_lpar_numeric > 0)
                                ? ($vcpu_for_lpar_numeric + 0) : undef;
        my $tactical_guarantee_demand = (defined $debug_info{'GuaranteeDemand'}
                                         && looks_like_number($debug_info{'GuaranteeDemand'}))
                                      ? ($debug_info{'GuaranteeDemand'} + 0) : undef;

        my $reduction_safety = _classify_vcpu_reduction_safety({
            evidence            => \%debug_info,
            current_vp          => $current_vp_numeric,
            current_entitlement => $current_ent_numeric,
            pool_cpu            => $pool_cpu_for_lpar_numeric,
            is_capped           => $is_capped_lpar,
            peak_physc          => $pure_p99w1_physc,
            guarantee_demand    => $tactical_guarantee_demand,
        });

        # Task 3 (rVCPU_EntBounded) + Task 4 (rVCPU_Tactical): centralised so the
        # entitlement-safe and rate-limited tail cannot drift across the three
        # rVCPU paths. Envelope terms above are passed in unchanged.
        my $rvcpu_ebt = _compute_entbounded_and_tactical({
            rvcpu_raw            => $rvcpu_raw,
            rvcpu_min            => $rvcpu_min,
            rvcpu_max            => $rvcpu_max,
            rvcpu_final          => $rvcpu_final,
            p99w1_floor_vcpu     => $p99w1_floor_vcpu,
            configured_burst_floor_vcpu => $configured_burst_floor_vcpu,
            rvcpu_tier_num       => $rvcpu_tier_num,
            vp_current_ent_floor => $vp_current_ent_floor,
            current_ent_stale    => $current_ent_stale,
            current_vp_numeric   => $current_vp_numeric,
            reduction_safety     => $reduction_safety,
            current_entitlement  => $current_ent_numeric,
            guarantee_demand     => $tactical_guarantee_demand,
            is_capped            => $is_capped_lpar,
            pool_cpu             => $pool_cpu_for_lpar_numeric,
            dispatch_budget      => $dispatch_budget,
            tier_label           => $final_tier,
        });
        my $rvcpu_entbounded                    = $rvcpu_ebt->{entbounded};
        my $entbounded_governed                 = $rvcpu_ebt->{entbounded_governed};
        my $entbounded_needs_coordinated_change = $rvcpu_ebt->{entbounded_needs_coordinated_change};
        my $entbounded_evidence_above_envelope  = $rvcpu_ebt->{entbounded_evidence_above_envelope};
        my $rvcpu_tactical                      = $rvcpu_ebt->{tactical};
        my $tactical_note                       = $rvcpu_ebt->{tactical_note};
        my $rvcpu_policy_audit = _build_rvcpu_policy_audit({
            tier_label              => $final_tier,
            tier_num                => $rvcpu_tier_num,
            path                    => 'AUTHORITATIVE',
            convergence_mode        => 'FULL',
            overwrote_authoritative => 0,
            proposed_vcpu           => $rvcpu_final,
            proposed_entitlement    => $rENT_P_for_envelope,
            pool_size               => $pool_cpu_for_lpar_numeric,
            is_capped               => $is_capped_lpar,
            applicable_demand       => $debug_info{'GuaranteeDemand'},
            base_planning_demand    => $debug_info{'BasePlanningDemand'},
        });

        # Persist for CSV and rationale consumers
        $vm_map_ref->{CoreResults}{Profile_rVCPU}{$profile_name} = defined($rvcpu_final) ? $rvcpu_final : '';
        $vm_map_ref->{CoreResults}{Profile_rVCPU_EntBounded}{$profile_name} = $rvcpu_entbounded;
        $vm_map_ref->{CoreResults}{Profile_rVCPU_Tactical}{$profile_name} = $rvcpu_tactical;
        # Single authoritative strategic governor for the rationale, so the
        # decision trace never reconstructs which protection won. Uses the same
        # floors that produced rVCPU; ties break by operational priority
        # (dispatch > peak > burst > entitlement).
        my $strategic_governor;
        {
            my @gv = (
                [ $rvcpu_raw,                   'run-queue dispatch width'   ],
                [ $p99w1_floor_vcpu,            'peak-throughput protection' ],
                [ $configured_burst_floor_vcpu, 'configured burst width'     ],
                [ $rvcpu_min,                   'entitlement delivery floor' ],
            );
            my $peak_vp;
            for my $g (@gv) {
                next unless defined $g->[0] && looks_like_number($g->[0]);
                $peak_vp = $g->[0] if (!defined $peak_vp || $g->[0] > $peak_vp);
            }
            for my $g (@gv) {
                next unless defined $g->[0] && looks_like_number($g->[0]);
                if (defined $peak_vp && $g->[0] == $peak_vp) { $strategic_governor = $g->[1]; last; }
            }
            if (defined $rvcpu_max && looks_like_number($rvcpu_max)
                && defined $peak_vp && $peak_vp > $rvcpu_max
                && defined $rvcpu_final && looks_like_number($rvcpu_final)
                && $rvcpu_final == $rvcpu_max) {
                $strategic_governor = sprintf('normal VP range maximum (%s VPs)', $rvcpu_max);
            }
            $strategic_governor //= 'entitlement delivery floor';
        }
        $vm_map_ref->{CoreResults}{Profile_rVCPU_Explain}{$profile_name} = {
            %{$rvcpu_policy_audit},
            Raw            => $rvcpu_raw,
            Min            => $rvcpu_min,
            Max            => $rvcpu_max,
            EntitlementMinimumVP => $rvcpu_min,
            StrategicGovernor    => $strategic_governor,
            EntCores       => (defined $rENT_P ? sprintf("%.2f", $rENT_P) : undef),
            EntCoresPlanning => (defined $rENT_P_for_envelope ? sprintf("%.2f", $rENT_P_for_envelope) : undef),
            EnvelopeExceedsOperational => ($envelope_exceeds_operational ? 1 : 0),
            DispatchReserveVP     => $dispatch_reserve_vp,
            DispatchReserveReason => $dispatch_reserve_reason,
            DispatchReservePreFinal => $dispatch_reserve_pre_final,
            TierNum        => $rvcpu_tier_num,
            TierFactor     => sprintf("%.2f", $rvcpu_tier_factor),
            RunQKeyUsed    => $abs_runq_key_for_debug,  # Must match the key actually selected for this profile's AbsRunQ
            RunQHiThreads  => (defined $runq_hi_threads ? sprintf("%.2f", $runq_hi_threads) : undef),
            RunQWidthDivisor      => sprintf("%.2f", $runq_width_divisor),
            RunQWidthDivisorBase  => sprintf("%.2f", $runq_width_divisor_base),
            RunQIntervalMinutes   => (defined $runq_interval_minutes_snapped ? $runq_interval_minutes_snapped : undef),
            P99W1Floor     => $p99w1_floor_vcpu,
            ConfiguredBurstFloor       => $configured_burst_floor_vcpu,
            ConfiguredBurstFloorActive => $configured_burst_floor->{active} ? 1 : 0,
            ConfiguredBurstTargetUtilisation => $configured_burst_floor->{target},
            ConfiguredBurstPolicy      => $configured_burst_floor->{policy_key},
            ConfiguredBurstCurrentReachable => $configured_burst_floor->{current_reachable},
            ConfiguredBurstPeakReachRatio => $configured_burst_floor->{peak_reach_ratio},
            ConfiguredBurstReason      => $configured_burst_floor->{reason},
            P99W1FactorEff => (defined $p99w1_factor_eff ? sprintf("%.3f", $p99w1_factor_eff) : undef),
            P99W1Mult      => (defined $p99w1_mult ? sprintf("%.3f", $p99w1_mult) : undef),
            P99W1RunnableDensity => sprintf("%.3f", $runnable_density),
            P99W1OccupancyIntervalCorr  => sprintf("%.2f", $runq_cred_corr),
            P99W1RunnableDensitySuffix => $runq_cred_corr_suffix,
            P99W1AdjPeak   => (defined $p99w1_adjusted ? sprintf("%.2f", $p99w1_adjusted) : undef),
            P99W1RawPeak   => (defined $pure_p99w1_physc ? sprintf("%.2f", $pure_p99w1_physc) : undef),
            RunQEnvelopeOverride => $runq_envelope_override ? "Yes" : "No",
            RunQEnvelopeBasis    => defined $runq_envelope_basis ? sprintf("%.3f", $runq_envelope_basis) : undef,
            OrigMin              => $orig_rvcpu_min,
            OrigMax              => $orig_rvcpu_max,
            EntBounded                    => $rvcpu_entbounded,
            EntBoundedGovernedBy          => $entbounded_governed,
            EntBoundedNeedsCoordinatedChange => $entbounded_needs_coordinated_change,
            EntBoundedEvidenceAboveEnvelope  => $entbounded_evidence_above_envelope,
            CurrentEntCores               => (defined $current_ent_numeric ? sprintf("%.2f", $current_ent_numeric) : undef),
            CurrentEntStale               => $current_ent_stale,
            Tactical                      => $rvcpu_tactical,
            TacticalNote                  => $tactical_note,
            TacticalPreSafety             => $rvcpu_ebt->{tactical_pre_safety},
            ReductionSafetyState          => $rvcpu_ebt->{reduction_safety_state},
            ReductionSafetyReasons        => $rvcpu_ebt->{reduction_safety_reasons},
            ReductionCurrentReachable     => $rvcpu_ebt->{reduction_current_reachable},
            ReductionPeakReachRatio       => $rvcpu_ebt->{reduction_peak_reach_ratio},
            ReductionPoolAvailabilityStatus => $rvcpu_ebt->{reduction_pool_availability_status},
            ReductionCurrentReachabilityBasis => $rvcpu_ebt->{reduction_current_reachability_basis},
            ReductionDependsOnUnmeasuredPool => $rvcpu_ebt->{reduction_depends_on_unmeasured_pool},
            StrategicInvariantStatus      => $rvcpu_ebt->{strategic_invariant_status},
            ImmediateCandidate            => $rvcpu_ebt->{immediate_candidate},
            ImmediateInvariantHolds       => $rvcpu_ebt->{immediate_invariant_holds},
            ImmediateInvariant            => $rvcpu_ebt->{immediate_invariant},
            ImmediateReachable            => $rvcpu_ebt->{immediate_reachable},
            CurrentVPs                    => $current_vp_numeric,
        };

        # Mirror into debug_info
        $debug_info{'rVCPU_RunQKeyUsed'}    = $abs_runq_key_for_debug // 'N/A';
        $debug_info{'rVCPU_TierNum'}        = $rvcpu_tier_num;
        $debug_info{'rVCPU_TierFactor'}     = sprintf("%.2f", $rvcpu_tier_factor);
        $debug_info{'rVCPU_Raw'}            = defined($rvcpu_raw) ? $rvcpu_raw : 'N/A';
        $debug_info{'rVCPU_Min'}            = defined($rvcpu_min) ? $rvcpu_min : 'N/A';
        $debug_info{'rVCPU_Max'}            = defined($rvcpu_max) ? $rvcpu_max : 'N/A';
        $debug_info{'rVCPU_EntCores'}       = defined($rENT_P) ? sprintf("%.2f", $rENT_P) : 'N/A';
        $debug_info{'rVCPU_EntCoresPlanning'} = defined($rENT_P_for_envelope) ? sprintf("%.2f", $rENT_P_for_envelope) : 'N/A';
        $debug_info{'rVCPU_EnvelopeExceedsOp'} = $envelope_exceeds_operational ? 1 : 0;
        $debug_info{'rVCPU_DispatchReserveVP'} = $dispatch_reserve_vp;
        $debug_info{'rVCPU_DispatchReserveReason'} = $dispatch_reserve_reason;
        $debug_info{'rVCPU_DispatchReservePreFinal'} = defined($dispatch_reserve_pre_final) ? $dispatch_reserve_pre_final : 'N/A';
        $debug_info{'rVCPU_P99W1Floor'}     = defined($p99w1_floor_vcpu) ? $p99w1_floor_vcpu : 'N/A';
        $debug_info{'rVCPU_ConfiguredBurstFloor'} = defined($configured_burst_floor_vcpu)
            ? $configured_burst_floor_vcpu : 'N/A';
        $debug_info{'rVCPU_P99W1FactorEff'} = defined($p99w1_factor_eff) ? sprintf("%.3f",$p99w1_factor_eff) : 'N/A';
        $debug_info{'rVCPU_P99W1Mult'}      = defined($p99w1_mult) ? sprintf("%.3f",$p99w1_mult) : 'N/A';
        $debug_info{'rVCPU_P99W1RunnableDensity'} = defined($runnable_density) ? sprintf("%.3f", $runnable_density) : 'N/A';
        $debug_info{'rVCPU_P99W1AdjPeak'}   = defined($p99w1_adjusted) ? sprintf("%.2f", $p99w1_adjusted) : "N/A";
        $debug_info{'rVCPU_P99W1RawPeak'}   = defined($pure_p99w1_physc) ? sprintf("%.2f", $pure_p99w1_physc) : "N/A";
        $debug_info{'rVCPU_RunQHiThreads'}  = defined($runq_hi_threads) ? sprintf("%.2f",$runq_hi_threads) : 'N/A';
        $debug_info{'rVCPU_RunQWidthDivisor'}     = defined($runq_width_divisor) ? sprintf("%.2f", $runq_width_divisor) : 'N/A';
        $debug_info{'rVCPU_RunQWidthDivisorBase'} = sprintf("%.2f", $runq_width_divisor_base);
        $debug_info{'rVCPU_RunQIntervalMinutes'}  = defined($runq_interval_minutes_snapped) ? $runq_interval_minutes_snapped : 'N/A';
        $debug_info{'rVCPU_P99W1OccupancyIntervalCorr'}        = sprintf("%.2f", $runq_cred_corr);
        $debug_info{'rVCPU_P99W1RunnableDensitySuffix'} = $runq_cred_corr_suffix;
        $debug_info{'rVCPU_Final'}          = defined($rvcpu_final) ? $rvcpu_final : 'N/A';
        $debug_info{'rVCPU_RunQEnvelopeOverride'} = $runq_envelope_override ? "Yes" : "No";
        $debug_info{'rVCPU_RunQEnvelopeBasis'}    = defined $runq_envelope_basis ? sprintf("%.3f", $runq_envelope_basis) : 'N/A';
        $debug_info{'rVCPU_OrigMin'}              = defined $orig_rvcpu_min ? $orig_rvcpu_min : 'N/A';
        $debug_info{'rVCPU_OrigMax'}              = defined $orig_rvcpu_max ? $orig_rvcpu_max : 'N/A';
        $debug_info{'rVCPU_EntBounded'}           = defined($rvcpu_entbounded) ? $rvcpu_entbounded : 'N/A';
        $debug_info{'rVCPU_EntBoundedGovernedBy'} = $entbounded_governed // 'N/A';
        $debug_info{'rVCPU_EntBoundedNeedsCoordinatedChange'} = $entbounded_needs_coordinated_change ? 1 : 0;
        $debug_info{'rVCPU_EntBoundedEvidenceAboveEnvelope'} = $entbounded_evidence_above_envelope ? 1 : 0;
        $debug_info{'rVCPU_CurrentEntStale'}      = $current_ent_stale ? 1 : 0;
        $debug_info{'rVCPU_Tactical'}             = defined($rvcpu_tactical) ? $rvcpu_tactical : 'N/A';
        $debug_info{'rVCPU_TacticalNote'}         = $tactical_note // 'N/A';
        $debug_info{'rVCPU_TacticalPreSafety'}    = defined($rvcpu_ebt->{tactical_pre_safety}) ? $rvcpu_ebt->{tactical_pre_safety} : 'N/A';
        $debug_info{'rVCPU_ReductionSafetyState'} = $rvcpu_ebt->{reduction_safety_state} // 'N/A';
        $debug_info{'rVCPU_ReductionSafetyReasons'} = $rvcpu_ebt->{reduction_safety_reasons} // 'N/A';
        $debug_info{'rVCPU_ReductionCurrentReachable'} = defined($rvcpu_ebt->{reduction_current_reachable})
            ? sprintf('%.2f', $rvcpu_ebt->{reduction_current_reachable}) : 'N/A';
        $debug_info{'rVCPU_ReductionPeakReachRatio'} = defined($rvcpu_ebt->{reduction_peak_reach_ratio})
            ? sprintf('%.3f', $rvcpu_ebt->{reduction_peak_reach_ratio}) : 'N/A';
        $debug_info{'rVCPU_ReductionPoolAvailabilityStatus'} =
            $rvcpu_ebt->{reduction_pool_availability_status} // 'N/A';
        $debug_info{'rVCPU_ReductionCurrentReachabilityBasis'} =
            $rvcpu_ebt->{reduction_current_reachability_basis} // 'N/A';
        $debug_info{'rVCPU_ReductionDependsOnUnmeasuredPool'} =
            $rvcpu_ebt->{reduction_depends_on_unmeasured_pool} ? 1 : 0;
        $debug_info{'rVCPU_StrategicInvariantStatus'} =
            $rvcpu_ebt->{strategic_invariant_status} // 'N/A';
        $debug_info{'rVCPU_ImmediateCandidate'} = defined($rvcpu_ebt->{immediate_candidate}) ? $rvcpu_ebt->{immediate_candidate} : 'N/A';
        $debug_info{'rVCPU_ImmediateInvariantHolds'} = !defined($rvcpu_ebt->{immediate_invariant_holds}) ? 'N/A'
            : ($rvcpu_ebt->{immediate_invariant_holds} ? 'Yes' : 'No');
        $debug_info{'rVCPU_ImmediateInvariant'} = $rvcpu_ebt->{immediate_invariant} // 'N/A';
        $debug_info{'rVCPU_ImmediateReachable'} = defined($rvcpu_ebt->{immediate_reachable})
            ? sprintf('%.2f', $rvcpu_ebt->{immediate_reachable}) : 'N/A';
        $debug_info{'rVCPU_CurrentVPs'}           = defined($current_vp_numeric) ? $current_vp_numeric : 'N/A';
        _mirror_rvcpu_policy_audit($rvcpu_policy_audit, \%debug_info);
    };

    return ($runq_modified_rec, \%debug_info);
}

# --- generate_sizing_hint (Unified Global Pressure Detection with Logging Rationale) ---
# Generates a sizing tier hint, pattern, and overall pressure indication for a VM.
# Also returns a detailed rationale string for its pressure assessment, AND
# specific boolean flags for P-99W1's RunQ pressure conditions.
sub generate_sizing_hint
{
    # This function is now refactored to read all its inputs from the assimilation map.
    my ($vm_map_ref, $log_fh, $adaptive_saturation_thresh) = @_;

    # --- Unpack all required values from the assimilation map ---
    my $vm_name                  = $vm_map_ref->{Configuration}{vm_name}; # We will add vm_name to the map
    my $config_ref               = $vm_map_ref->{Configuration};
    my $results_ref              = $vm_map_ref->{CoreResults}{ProfileValues};
    my $runq_metrics_ref         = $vm_map_ref->{RunQMetrics};
    my $max_cpu_for_vm_numeric   = $config_ref->{max_cpu} // 0;
    my $smt_used_for_vm_numeric  = $config_ref->{smt} // $default_smt_arg;
    my $LOG_FH                   = $log_fh;

    my $na_str_hint = "N/A";
    my @global_pressure_rationale_lines;

    # ... (initial part of rationale logging: Inputs like MaxCPU, SMT etc. - as in previous version) ...
    push @global_pressure_rationale_lines, sprintf("  Input LPAR MaxCPU            : %.2f cores", $max_cpu_for_vm_numeric);
    push @global_pressure_rationale_lines, sprintf("  Input SMT for VM             : %d", $smt_used_for_vm_numeric);
    # Determine if small entitlement handler would be active
    my $vm_entitlement = $config_ref->{'entitlement'} // 0;
    my $is_small_ent_handler = ($vm_entitlement > 0 && $vm_entitlement < 1.0 &&
                                 $max_cpu_for_vm_numeric > $vm_entitlement) ? "Yes" : "No";
    my $burst_used = ($vm_entitlement < 1.0 && $is_small_ent_handler eq "Yes") ?
                     calculate_graduated_burst($vm_entitlement) : 0.25;

    push @global_pressure_rationale_lines, sprintf("  Small Entitlement Handler    : %s", $is_small_ent_handler);
    push @global_pressure_rationale_lines, sprintf("  Burst Allowance Factor       : %.0f%% (Ent=%.2f)",
                                                   $burst_used * 100, $vm_entitlement);

    # --- VIO Server Check ---
    my $is_vio_server = 0;
    if (defined $config_ref->{systemtype} && $config_ref->{systemtype} =~ /VIO Server/i) {
       $is_vio_server = 1;
    }

    # --- Profile Value Parsing (Pattern/Peakiness & P-99W1 PhysC) ---
    my $o3_val_str = $results_ref->{'O3-95W15'} // "0";
    my $o3_val_num = ($o3_val_str ne $na_str_hint && $o3_val_str =~ /^-?[0-9.]+\z/) ? ($o3_val_str + 0) : 0;
    my $b3_val_str = $results_ref->{'B3-95W15'} // "0";
    my $b3_val_num = ($b3_val_str ne $na_str_hint && $b3_val_str =~ /^-?[0-9.]+\z/) ? ($b3_val_str + 0) : 0;
    my $g3_val_str = $results_ref->{'G3-95W15'} // "0";
    my $g3_val_num = ($g3_val_str ne $na_str_hint && $g3_val_str =~ /^-?[0-9.]+\z/) ? ($g3_val_str + 0) : 0;
    my $p99w1_physc_val_str = looks_like_number($results_ref->{$MANDATORY_PEAK_PROFILE_FOR_HINT}) ? sprintf("%.3f", $results_ref->{$MANDATORY_PEAK_PROFILE_FOR_HINT}) : $na_str_hint;
    my $p99w1_physc_val_num = ($p99w1_physc_val_str ne $na_str_hint && $p99w1_physc_val_str =~ /^-?[0-9.]+\z/)
    ? ($p99w1_physc_val_str + 0)
    : 0;
    push @global_pressure_rationale_lines, sprintf("  Input %s PhysC Value     : %s (from nfit output for %s)", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_physc_val_str, $MANDATORY_PEAK_PROFILE_FOR_HINT);

    # (Pattern and Peakiness logic - unchanged)
    my $suggested_pattern = "G";
    if ($b3_val_num > 0.01 && $o3_val_num > ($b3_val_num * $PATTERN_RATIO_THRESHOLD)) { $suggested_pattern = "O"; }
    elsif ($o3_val_num > 0.01 && $b3_val_num > ($o3_val_num * $PATTERN_RATIO_THRESHOLD)) { $suggested_pattern = "B"; }
    my $peakiness_ratio = ($g3_val_num > 0.001) ? ($p99w1_physc_val_num / $g3_val_num) : 0;
    my $shape_descriptor = "Steady";
    if ($peakiness_ratio >= $HIGH_PEAK_RATIO_THRESHOLD) { $shape_descriptor = "Very Peaky"; }
    elsif ($peakiness_ratio >= $LOW_PEAK_RATIO_THRESHOLD) { $shape_descriptor = "Moderately Peaky"; }


    # --- Unified Pressure Detection ---
    my $pressure_detected_maxcpu_limit = 0;
    # Specific P-99W1 RunQ pressure flags to be returned
    my $p99w1_has_absolute_runq_pressure = 0;
    my $p99w1_has_normalized_runq_pressure = 0;
    my @pressure_points;

    # Fetch P-99W1's specific RunQ metrics
    # Use the percentile key aligned to the mandatory peak profile's -p configuration.
    # Falls back through P99 to P90 for installations not using --runq-perc-behavior match.
    my $_peak_abs_runq_val = $runq_metrics_ref->{$MANDATORY_PEAK_ABSRUNQ_KEY}
                          // $runq_metrics_ref->{'AbsRunQ_P99'}
                          // $runq_metrics_ref->{'AbsRunQ_P90'};
    my $p99w1_abs_runq_p90_val_str = looks_like_number($_peak_abs_runq_val) ? sprintf("%.3f", $_peak_abs_runq_val) : $na_str_hint;
    my $p99w1_abs_runq_key_label   = defined $runq_metrics_ref->{$MANDATORY_PEAK_ABSRUNQ_KEY} ? $MANDATORY_PEAK_ABSRUNQ_KEY
                                   : defined $runq_metrics_ref->{'AbsRunQ_P99'}               ? 'AbsRunQ_P99'
                                   :                                                             'AbsRunQ_P90';

    my $p99w1_norm_runq_p90_val_str = looks_like_number($runq_metrics_ref->{'NormRunQ_P90'}) ? sprintf("%.3f", $runq_metrics_ref->{'NormRunQ_P90'}) : $na_str_hint;

    push @global_pressure_rationale_lines, sprintf("  Input %s %-16s: %s threads (from nfit output for %s)", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_abs_runq_key_label, $p99w1_abs_runq_p90_val_str, $MANDATORY_PEAK_PROFILE_FOR_HINT);
    push @global_pressure_rationale_lines, sprintf("  Input %s NormRunQ P90    : %s (from nfit output for %s)", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_norm_runq_p90_val_str, $MANDATORY_PEAK_PROFILE_FOR_HINT);
    push @global_pressure_rationale_lines, "";


    # 1. MaxCPU Limit Pressure
    # ... (logic as before, sets $pressure_detected_maxcpu_limit, logs to @global_pressure_rationale_lines) ...
    # ... (ensure push @pressure_points, "MaxCPU"; happens if $pressure_detected_maxcpu_limit = 1;) ...
    push @global_pressure_rationale_lines, sprintf("  1. MaxCPU Limit Pressure Check (%s PhysC vs LPAR MaxCPU):", $MANDATORY_PEAK_PROFILE_FOR_HINT);
    # ... (detailed logging lines for MaxCPU check)
    my $maxcpu_limit_calc_threshold = ($max_cpu_for_vm_numeric > 0) ? ($max_cpu_for_vm_numeric * $LIMIT_THRESHOLD_PERC) : 0;
    my $maxcpu_condition_met_str = "FALSE";
    if ($max_cpu_for_vm_numeric > 0 && $p99w1_physc_val_num >= $maxcpu_limit_calc_threshold)
    {
        $pressure_detected_maxcpu_limit = 1;
        $maxcpu_condition_met_str = "TRUE";
        push @pressure_points, "MaxCPU";
    }
    push @global_pressure_rationale_lines, sprintf("     - %s PhysC Value      : %.2f", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_physc_val_num);
    push @global_pressure_rationale_lines, sprintf("     - LPAR MaxCPU             : %.2f", $max_cpu_for_vm_numeric);
    push @global_pressure_rationale_lines, sprintf("     - Threshold (>= %.0f%%)      : %.2f cores", $LIMIT_THRESHOLD_PERC * 100, $maxcpu_limit_calc_threshold);
    push @global_pressure_rationale_lines, sprintf("     - Condition Met           : (%.2f >= %.2f) -> %s", $p99w1_physc_val_num, $maxcpu_limit_calc_threshold, $maxcpu_condition_met_str);
    push @global_pressure_rationale_lines, sprintf("     - MaxCPU Pressure Flag    : %s", $maxcpu_condition_met_str);
    push @global_pressure_rationale_lines, "";


    # 2. Absolute RunQ Pressure (using the tail-aligned AbsRunQ key for the mandatory peak profile)
    my $p99w1_abs_runq_p90_num = ($p99w1_abs_runq_p90_val_str ne $na_str_hint && $p99w1_abs_runq_p90_val_str =~ /^-?[0-9.]+$/) ? ($p99w1_abs_runq_p90_val_str + 0) : undef;
    my $calculated_abs_runq_pressure_ratio = 0;
    my $lpar_max_lcpu_capacity = ($max_cpu_for_vm_numeric > 0 && $smt_used_for_vm_numeric > 0) ? ($max_cpu_for_vm_numeric * $smt_used_for_vm_numeric) : 0;

    # Dual-quantile corroboration gate: when the primary key is a high-percentile value
    # (e.g. P99.75), require that P90 also exceeds the threshold, confirming pressure
    # is distributed across the tail rather than concentrated in a single extreme spike.
    # When the primary key IS P90, $p99w1_abs_runq_corr_val is undef and the gate
    # degrades gracefully to single-quantile (legacy behaviour preserved).
    my $p99w1_abs_runq_corr_val = ($MANDATORY_PEAK_ABSRUNQ_KEY ne 'AbsRunQ_P90')
                                ? $runq_metrics_ref->{'AbsRunQ_P90'} : undef;
    my $p99w1_abs_runq_corr_num = (defined $p99w1_abs_runq_corr_val && looks_like_number($p99w1_abs_runq_corr_val))
                                ? ($p99w1_abs_runq_corr_val + 0) : undef;
    my $calculated_abs_runq_corr_ratio = (defined $p99w1_abs_runq_corr_num && $lpar_max_lcpu_capacity > 0)
                                ? ($p99w1_abs_runq_corr_num / $lpar_max_lcpu_capacity) : undef;

    push @global_pressure_rationale_lines, sprintf("  2. Absolute RunQ Pressure Check (%s %s vs LPAR Capacity):", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_abs_runq_key_label);

    # ... (detailed logging lines for AbsRunQ check)
    if (defined $p99w1_abs_runq_p90_num && $lpar_max_lcpu_capacity > 0)
    {
        $calculated_abs_runq_pressure_ratio = $p99w1_abs_runq_p90_num / $lpar_max_lcpu_capacity;
    }
    my $absrunq_cond_met_str = "FALSE";

    # Pressure confirmed only when primary ratio exceeds threshold AND, where a
    # high-percentile key is in use, P90 corroborates — preventing a single extreme
    # spike from triggering pressure without broader tail evidence.
    my $upper_tail_corroborates = !defined($calculated_abs_runq_corr_ratio)
                               || ($calculated_abs_runq_corr_ratio > $adaptive_saturation_thresh);
    if ($calculated_abs_runq_pressure_ratio > $adaptive_saturation_thresh && $upper_tail_corroborates)
    {
        $p99w1_has_absolute_runq_pressure = 1; # Set the specific flag
        $absrunq_cond_met_str = "TRUE";
        push @pressure_points, sprintf("RunQAbs_%s(%s=%.2f)", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_abs_runq_key_label, $calculated_abs_runq_pressure_ratio);
    }
    push @global_pressure_rationale_lines, sprintf("     - %s %-16s: %s threads", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_abs_runq_key_label, $p99w1_abs_runq_p90_val_str);
    push @global_pressure_rationale_lines, sprintf("     - %s AbsRunQ P90 (corr): %s threads", $MANDATORY_PEAK_PROFILE_FOR_HINT, defined $p99w1_abs_runq_corr_val ? sprintf("%.3f", $p99w1_abs_runq_corr_val) : "N/A (single-quantile mode)");
    push @global_pressure_rationale_lines, sprintf("     - LPAR Max LCPU Capacity  : (%.2f MaxCPU * %d SMT) = %.2f threads", $max_cpu_for_vm_numeric, $smt_used_for_vm_numeric, $lpar_max_lcpu_capacity);
    push @global_pressure_rationale_lines, sprintf("     - Calculated Ratio        : %.4f", $calculated_abs_runq_pressure_ratio);
    push @global_pressure_rationale_lines, sprintf("     - P90 Corroboration       : %s", $upper_tail_corroborates ? "YES" : "NO (transient - pressure suppressed)");
    push @global_pressure_rationale_lines, sprintf("     - Threshold               : > %.2f", $adaptive_saturation_thresh);
    push @global_pressure_rationale_lines, sprintf("     - Condition Met           : (%.4f > %.2f) -> %s", $calculated_abs_runq_pressure_ratio, $adaptive_saturation_thresh, $absrunq_cond_met_str);
    push @global_pressure_rationale_lines, sprintf("     - %s Specific Absolute RunQ Pressure Flag: %s", $MANDATORY_PEAK_PROFILE_FOR_HINT, $absrunq_cond_met_str);
    push @global_pressure_rationale_lines, "";


    # 3. Normalised Workload Pressure (using P-99W1's NormRunQ_P90)
    # ... (logic as before, sets $p99w1_has_normalized_runq_pressure, logs to @global_pressure_rationale_lines) ...
    # ... (ensure push @pressure_points, ... happens if $p99w1_has_normalized_runq_pressure = 1;) ...
    my $p99w1_norm_runq_p90_num = ($p99w1_norm_runq_p90_val_str ne $na_str_hint && $p99w1_norm_runq_p90_val_str =~ /^-?[0-9.]+$/) ? ($p99w1_norm_runq_p90_val_str + 0) : undef;
    my $min_abs_runq_for_norm_check = $smt_used_for_vm_numeric > 0 ? $smt_used_for_vm_numeric : 1.0;
    push @global_pressure_rationale_lines, sprintf("  3. Normalised Workload Pressure Check (%s NormRunQ P90):", $MANDATORY_PEAK_PROFILE_FOR_HINT);
    # ... (detailed logging lines for NormRunQ check)
    my $normrunq_cond1_met_str = (defined $p99w1_norm_runq_p90_num && $p99w1_norm_runq_p90_num > $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD) ? "TRUE" : "FALSE";
    my $normrunq_cond2_met_str = (defined $p99w1_abs_runq_p90_num && $p99w1_abs_runq_p90_num >= $min_abs_runq_for_norm_check) ? "TRUE" : "FALSE";
    my $normrunq_overall_cond_met_str = "FALSE";
    if ($normrunq_cond1_met_str eq "TRUE" && $normrunq_cond2_met_str eq "TRUE")
    {
        $p99w1_has_normalized_runq_pressure = 1; # Set the specific flag
        $normrunq_overall_cond_met_str = "TRUE";
        push @pressure_points, sprintf("RunQNorm_%s(P90=%.2f)", $MANDATORY_PEAK_PROFILE_FOR_HINT, defined $p99w1_norm_runq_p90_num ? $p99w1_norm_runq_p90_num : 0);
    }
    push @global_pressure_rationale_lines, sprintf("     - %s NormRunQ P90     : %s", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_norm_runq_p90_val_str);
    push @global_pressure_rationale_lines, sprintf("     - Threshold               : > %.2f", $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD);
    push @global_pressure_rationale_lines, sprintf("     - Condition Met (Norm)    : (%s > %.2f) -> %s", $p99w1_norm_runq_p90_val_str, $WORKLOAD_PRESSURE_NORM_P90_TRIGGER_THRESHOLD, $normrunq_cond1_met_str);
    push @global_pressure_rationale_lines, sprintf("     - %s %-16s: %s (for magnitude check)", $MANDATORY_PEAK_PROFILE_FOR_HINT, $p99w1_abs_runq_key_label, $p99w1_abs_runq_p90_val_str);
    push @global_pressure_rationale_lines, sprintf("     - Min AbsRunQ Threshold   : %.2f (typically SMT)", $min_abs_runq_for_norm_check);
    push @global_pressure_rationale_lines, sprintf("     - Condition Met (Mag)     : (%s >= %.2f) -> %s", $p99w1_abs_runq_key_label, $min_abs_runq_for_norm_check, $normrunq_cond2_met_str);
    push @global_pressure_rationale_lines, sprintf("     - %s Specific Normalised Workload Pressure Flag: %s", $MANDATORY_PEAK_PROFILE_FOR_HINT, $normrunq_overall_cond_met_str);
    push @global_pressure_rationale_lines, "";


    # --- Combine pressure flags & Pool Context ---
    my $overall_pressure_detected_for_csv = $pressure_detected_maxcpu_limit ||
    $p99w1_has_absolute_runq_pressure || # Use the specific P-99W1 flags here for overall CSV flag
    $p99w1_has_normalized_runq_pressure;
    # Pool context logic, using @pressure_points
    push @global_pressure_rationale_lines, "  4. Pool Context:";

    # Get Pool ID from nfit's dynamic data, and Pool Name from the optional config file
    my $pool_id_from_nmon = $config_ref->{pool_id} // 0;
    my $pool_name_from_config = $vm_config_data{$vm_name}{pool_name} // undef; # Still need the original config file for this

    # A non-default pool is one where the ID is not 0.
    my $is_non_default_pool = (looks_like_number($pool_id_from_nmon) && $pool_id_from_nmon != 0);

    # Pool ID is now directly from the JSON output of nfit
    push @global_pressure_rationale_lines, sprintf("     - Pool ID                 : %s", $pool_id_from_nmon);
    push @global_pressure_rationale_lines, sprintf("     - Pool Name (from config) : %s", $pool_name_from_config // "N/A");
    push @global_pressure_rationale_lines, sprintf("     - Is Non-Default Pool     : %s", $is_non_default_pool ? "TRUE" : "FALSE");

    if ($is_non_default_pool && $overall_pressure_detected_for_csv) {
        # If we have a pool name, use it. Otherwise, fall back to the ID.
        my $pool_identifier = defined($pool_name_from_config) && $pool_name_from_config ne '' ? $pool_name_from_config : "ID:$pool_id_from_nmon";
        push @pressure_points, "Pool($pool_identifier)";
    }
    push @global_pressure_rationale_lines, "";

    my $overall_pressure_detected_for_csv_str = $overall_pressure_detected_for_csv ? "TRUE" : "FALSE";
    my $pressure_detail_str = @pressure_points ? join(", ", @pressure_points) : "None";
    push @global_pressure_rationale_lines, sprintf("  5. Overall Global Hint Pressure Flag (for CSV): %s", $overall_pressure_detected_for_csv_str);
    push @global_pressure_rationale_lines, sprintf("  6. Final PressureDetail string for CSV     : \"%s\"", $pressure_detail_str);

    my $global_pressure_rationale_text = "Section: Global Sizing Hint Pressure Assessment (source: generate_sizing_hint)\n" .
    join("\n", @global_pressure_rationale_lines);


    # --- Tiering logic (remains unchanged) ---
    my $initial_tier_range_str = "3/4";
    # --- Tiering logic (with added safety checks for numeric values) ---
    my $p99w1_val_for_tier = $results_ref->{'P-99W1'};
    my $g3_val_for_tier    = $results_ref->{'G3-95W15'};

    if (looks_like_number($p99w1_val_for_tier) && looks_like_number($g3_val_for_tier) && $g3_val_for_tier > 0) {
        if ($p99w1_val_for_tier > $g3_val_for_tier * $HIGH_PEAK_RATIO_THRESHOLD) {
            $shape_descriptor = "Very Peaky";
        }
        elsif ($p99w1_val_for_tier > $g3_val_for_tier * $LOW_PEAK_RATIO_THRESHOLD) {
            $shape_descriptor = "Moderately Peaky";
        }
    }

    if ($shape_descriptor eq "Very Peaky") { $initial_tier_range_str = "1/2"; }
    elsif ($shape_descriptor eq "Moderately Peaky") { $initial_tier_range_str = "2/3"; }
    my $adjusted_tier_str = $initial_tier_range_str;
    if ($overall_pressure_detected_for_csv)
    {
        if ($initial_tier_range_str eq "3/4") { $adjusted_tier_str = "3"; }
        elsif ($initial_tier_range_str eq "2/3") { $adjusted_tier_str = "2"; }
        elsif ($initial_tier_range_str eq "1/2") { $adjusted_tier_str = "1"; }
    }
    my $pattern_tier_string = $suggested_pattern . $adjusted_tier_str;

    if ($is_vio_server)
    {
        # For VIOs, we return the *actual* calculated pressure flags and details,
        # but override the final tier/pattern hint for safety and clarity.
        return (
            "P",    # Override Hint to "P" for Peak/Manual
            $shape_descriptor, # Override Pattern
            $overall_pressure_detected_for_csv, # Return ACTUAL calculated pressure
            $pressure_detail_str,               # Return ACTUAL pressure details
            $global_pressure_rationale_text,
            $p99w1_has_absolute_runq_pressure,
            $p99w1_has_normalized_runq_pressure
        );
    }
    else
    {
        # For non-VIOs, return the standard, calculated hint and pattern.
        return (
            $pattern_tier_string,
            $shape_descriptor,
            $overall_pressure_detected_for_csv,
            $pressure_detail_str,
            $global_pressure_rationale_text,
            $p99w1_has_absolute_runq_pressure,
            $p99w1_has_normalized_runq_pressure
        );
    }
}

);

# --- RunQ efficiency (entitlement) reduction: REMOVED (Task 5) ---
# The mechanism reduced a profile's PhysC value towards a RunQ-derived
# "efficient target", on the premise that PhysC unaccompanied by runnable threads
# is dispatch overhead and therefore recoverable. Three independent findings
# retired it:
#
#   1. FALSIFIED PREMISE. Estate evidence puts the low-occupancy population at
#      1.2-3.9 runnable threads per consumed core. On the commercial SMT yield
#      curve that is 88-51% of a solo core per thread: the work is running fast,
#      not idling. Low occupancy means threads are receiving near-full cores.
#   2. WRONG LEVER. Entitlement is a guarantee, not a ceiling. Reducing it on an
#      uncapped LPAR does not pack threads, does not change the run queue and does
#      not reduce consumption - it moves capacity from the guaranteed band into
#      the pool-dependent band. Packing is governed by VP count, which is where
#      the yield-aware active-core floor now applies the same evidence correctly.
#   3. IMMATERIAL. It was worth -1.53 cores across a 97-VM estate.
#
# It was first disabled behind $RUNQ_EFFICIENCY_REDUCTION_ENABLED = 0. The
# analysis, its guard bands and its rationale prints nevertheless kept running
# and kept publishing verdicts that governed nothing, so the code is now gone
# rather than merely switched off. This note is the permanent record of why; do
# not reinstate the mechanism without first overturning finding 1 or 2.
#
# The RunQ additive path is unaffected: it answers a different question (demand
# that PhysC cannot express because dispatch is censored).

# --- PhysC corroboration of RunQ-derived capacity demand (additive path) ---
# The excess-thread arithmetic answers "how many cores of dispatch WIDTH do
# these threads need?" and the answer is then applied to ENTITLEMENT, which is
# capacity. The two coincide only when the partition was actually prevented
# from consuming what it needed. Peak PhysC against reachable capacity tells us
# whether it was: pinned near the ceiling means demand was censored and the
# queue is the only witness; ample unused headroom means the partition could
# have taken more capacity and chose not to.
my $ADDITIVE_CENSORING_RATIO_FULL_TRUST = 0.90;  # Peak PhysC >= this share of reachable -> censored, trust the queue fully
my $ADDITIVE_CENSORING_RATIO_NO_TRUST   = 0.70;  # Peak PhysC <= this share of reachable -> PhysC is a valid witness, suppress
# Refusal signature: a partition that queues yet never exceeds its entitlement,
# whilst uncapped, is asking for pool capacity and not receiving it. Its PhysC
# headroom is then an artefact of the refusal, not evidence of sufficiency.
my $ADDITIVE_REFUSAL_PAE_THRESHOLD      = 0.05;

# --- Phase 2: Tier-graded final additive safety cap ---
# The final hard cap on RunQ_Tactical was previously a flat 40% of entitlement,
# which collapses to noise on micro-partitions and ignores tier importance.
# Performance tiers (P, O1/O2, G1/G2, B1/B2) receive a higher percentage and a
# higher small-entitlement floor. The floor raises only the cap ceiling; the
# additive itself remains demand-derived and never exceeds the raw requirement.
# All values are back-test candidates.
my $FINAL_ADDITIVE_CAP_PCT_ENT_PERF = 0.60;  # Performance tiers: cap at 60% of Ent
my $FINAL_ADDITIVE_CAP_PCT_ENT_STD  = 0.40;  # Efficiency tiers: retain 40% of Ent
my $FINAL_ADDITIVE_CAP_FLOOR_PERF   = 0.75;  # Performance tiers: cap never below 0.75 cores
my $FINAL_ADDITIVE_CAP_FLOOR_STD    = 0.30;  # Efficiency tiers: cap never below 0.30 cores
my $FINAL_ADDITIVE_CAP_ABS_MAX      = 2.0;   # Absolute ceiling per monthly increment (unchanged)

# Task 5: the Phase 4 tier-adaptive downsizing appetite
# (%TIER_VOLATILITY_CAUTION_THRESHOLD, %TIER_BLEND_BASE_WEIGHT_CEILING) and the
# P-tier conservative downsizing mode ($P_TIER_VOLATILITY_CAUTION_THRESHOLD,
# $P_TIER_BLEND_BASE_WEIGHT_FLOOR, $P_TIER_MAX_REDUCTION_FACTOR) are removed with
# the reduction they tuned. Note that tier appetite is NOT lost: it survives in
# the three channels that size rVCPU (profile percentile -> rENT; tier factor ->
# VP_RunQ; %TIER_THROUGHPUT_RETENTION -> the yield floor) plus the Task 4 change-
# rate limiter. These four constants tuned entitlement reduction only.

# Smallest implementable entitlement increment. Tactical recommendations below
# this cannot be actioned by a planner, so they are suppressed rather than
# reported as churn. This is an implementability floor, NOT a noise floor:
# measurements (RunQ_Potential / RunQ_Strategic) are never deadbanded.
my $MIN_MEANINGFUL_ADJUSTMENT_CORES = 0.05;

# NOTE: the separate additive tolerance ladder has been retired. The tolerance
# ceiling is now DERIVED from %DEFAULT_RUNQ_TARGETS (see _resolve_runq_target
# and the additive path), so the downsizing and additive paths can never pursue
# contradictory queue depths, and a single ruling on risk appetite governs both
# directions.

# VCPU sizing policy (stress-driven, slot-aware, rENT-bounded)
# Note: rVCPU is emitted per profile. The envelope is computed from the profile's rENT (growth-aware).
my $VCPU_RATIO_MIN = 1.00;                              # Minimum allowable VCPU >= ~1.00x entitlement (rounded up to nearest whole number)
my $VCPU_RATIO_MAX = 2.00;                              # IBM guidance (typical): keep VCPU <= ~2.00x entitlement

my $VCPU_MIN_ABS = 1;                                   # Never recommend below 1 VP
my $VCPU_MIN_FOR_ENT_GE_0_5_LT_1 = 1;                    # For 0.5 <= rENT < 1.0, 1 VP is sufficient
my $VCPU_ROUND_UP_TO_EVEN = 0;                           # RETIRED: rVCPU evenisation is disabled chain-wide. This flag no
                                                         # longer gates any sizing - it only ever gated the rationale's
                                                         # "pre-even" governing-term attribution (subtracting 1 from an even
                                                         # final to find the true binding constraint). With evenisation off an
                                                         # even rVCPU is genuinely even, so that adjustment would mis-attribute
                                                         # the governing term to a lower odd constraint. Keep at 0 unless
                                                         # sizing-level evenisation is ever reintroduced.

# Micro-partition VP envelope expansion.
# For rENT_P < 1.0, the 2:1 VP:ENT ratio can yield env_max = 1 (for rENT_P < 0.50),
# which provides zero dispatch headroom. A single VP cannot service any workload
# concurrency. This floor ensures micro-partitions can reach at least 2 VPs when
# completed, rENT-independent width evidence (RunQ, yield/peak, or configured
# burst) demonstrates demand exceeding the ratio-derived envelope. Entitlement
# must not be raised merely to make the ratio envelope admit that evidence.
my $VCPU_MICRO_PARTITION_THRESHOLD     = 1.0;   # rENT_P < this qualifies as micro-partition
my $VCPU_MICRO_PARTITION_ENV_MAX_FLOOR = 2;     # Minimum env_max when expansion triggered

# RETIRED - the following four peak-headroom knobs no longer govern sizing and
# are not read anywhere. The static/dynamic peak-headroom multiplier they once
# fed has been superseded by the yield-aware active-core floor plus the PAE/AAE
# chronic-burst headroom (Task 2); the effective peak-floor factor is now
# $p99w1_factor_eff (1.00 + headroom when PAE/AAE is enabled, else 1.00) and does
# not reference these values. Retained only to document the former knobs so their
# disappearance is traceable - do NOT tune them expecting output to change.
my $VCPU_PEAK_HEADROOM_FACTOR = 1.20;   # UNUSED (see note above)
my $VCPU_PEAK_HEADROOM_DYNAMIC = 1;     # UNUSED (see note above)
my $VCPU_PEAK_HEADROOM_MULT_MIN = 0.90; # UNUSED (see note above)
my $VCPU_PEAK_HEADROOM_MULT_MAX = 1.20; # UNUSED (see note above)

# Runnable-density assessment of the P99W1 peak floor.
# HISTORICAL: these constants once discounted the PhysC peak when RunQ-derived
# core demand fell well below it, on the premise that the gap reflected VP
# dispatch overhead. That premise is falsified - low density means each thread is
# receiving close to a full core, which is how low-concurrency work runs fastest.
# The discount is disabled ($VCPU_PEAK_CRED_DISCOUNT_ENABLED) and superseded by
# the yield-aware active-core floor. Retained only so the comparison can be
# re-enabled during back-testing.
my $VCPU_PEAK_CRED_BIAS    = 0.15;   # Benefit-of-doubt for PhysC (I/O, interrupts, cache affinity)
my $VCPU_PEAK_CRED_MIN     = 0.65;   # Never discount PhysC peak by more than 35%

# --- Stage 1c: RunQ runnable-density discount on the P99W1 peak floor ---
# When enabled, the P99W1 PhysC peak was discounted by max(CRED_MIN, occupancy +
# CRED_BIAS) before setting the rVCPU peak floor, on the premise that a peak with
# few runnable threads reflects VP dispatch overhead rather than real work.
#
# Disabled by default. Two independent reasons:
#
#   1. FALSIFIED PREMISE. Estate evidence puts the low-occupancy population at
#      1.2-3.9 runnable threads per consumed core. Under the commercial SMT
#      yield curve Y(k) = 1 + 0.45*log2(k), that is 88-51% of a solo core per
#      thread - the work is running fast, not idling. Low occupancy means each
#      thread is receiving nearly a full core, which is how low-concurrency work
#      achieves its throughput. Discounting the peak recommends packing it and
#      destroying that throughput.
#
#   2. WRONG ESTIMATOR. The ratio compares two independently derived percentiles
#      (P99W1 PhysC against AbsRunQ_P99W1) that need not share a timestamp.
#      NormRunQ pairs the same quantity per sample before aggregating, and the
#      two disagree materially (vm1: 1.947 unpaired against 1.08 paired).
#      E[X/Y] != E[X]/E[Y]; the paired form is correct.
#
# The occupancy ratio remains computed and published as a shadow diagnostic.
# Genuine VP over-provisioning is real, but separating it from low-concurrency
# work requires the throughput-aware floor (Stage 3), not this discount.
my $VCPU_PEAK_CRED_DISCOUNT_ENABLED = 0;

# --- Layer 5: Conditional Dispatch Reserve (Task 1 - retired) ---
# The dispatch reserve added VPs when rVCPU would collapse to VP_Min and one
# of three uncertainty triggers fired. All three are either a falsified
# premise or duplicated evidence already counted elsewhere in the rVCPU chain:
#
#   1. LowCorroboration (runnable density < 0.70). FALSIFIED PREMISE - the
#      same one $VCPU_PEAK_CRED_DISCOUNT_ENABLED documents above. At SMT-8,
#      density < 0.70 is <5.6 threads per consumed core, which covers most of
#      a normal estate. It added VPs to precisely the consolidation
#      candidates this reserve should not have widened.
#   2. GrowthAdj (growth > 0.25 cores). DUPLICATED. Growth already raises
#      rENT, which already raises ceil(rENT) -> VP_Min. The reserve added
#      width for growth a second time.
#   3. Pressure (RunQ pressure). DUPLICATED TWICE. Pressure already drives
#      the RunQ additive (-> rENT -> VP_Min) and VP_RunQ (the dispatch-width
#      driver computed upstream of the reserve). The reserve added a third
#      increment for the same evidence.
#
# Disabled by default. The reserve computation is retained, unexecuted,
# behind this switch so a narrow, evidence-gated reinstatement remains
# possible after back-testing (see nFit - Interim VP Right-Sizing
# Implementation Strategy, Task 1).
my $VCPU_DISPATCH_RESERVE_ENABLED = 0;

# --- Peak floor: PAE/AAE headroom multiplier (Task 2 - shadow diagnostic) ---
# p99w1_factor_eff multiplies the yield-aware active-core floor (Stage 3) by
# up to ~1.375x based on PAE/AAE burst evidence. Since the yield-floor work,
# that floor *is* the yield floor: it is derived from the P-99W1 peak, so the
# peak's burst is already carried in it. Multiplying the floor back up by
# PAE/AAE - which is itself sourced from the same peak profile - cancels the
# yield floor's deliberate throughput-for-width trade-off, and the floor can
# never govern while this multiplier is live.
#
# Disabled by default: p99w1_factor_eff is held at 1.00 so the yield floor
# governs unmultiplied. PAE, AAE and the shadow headroom value they would
# have produced remain computed and logged at every site (see $headroom /
# P99W1Mult in the rationale) - they stay the correct diagnostic of chronic
# bursting, just not evidence about the *width* a proposed configuration
# needs (see nFit - Interim VP Right-Sizing Implementation Strategy, Task 2).
my $VCPU_PAE_AAE_HEADROOM_ENABLED = 0;

# --- SMT yield curve: DEFAULT COMMERCIAL PLANNING CURVE ---
# Throughput of one POWER core running k threads, relative to that core running a
# single thread.
#
# PROVENANCE: a configured POLICY ASSUMPTION, not an IBM-published constant. IBM
# documentation supports the MECHANISM and DIRECTION (threads slow as more share a
# core; SMT raises aggregate capacity substantially), but not these exact points.
# They vary by POWER generation, vpm_throughput_mode and workload class. Note also
# that Y(k) = 1 + 0.45*log2(k) reproduces them exactly with a single fitted
# parameter - a good fit is not evidence the points are right, particularly if the
# source that supplied them fitted a log model of its own. Calibrate against
# benchmark or estate outcomes before treating the floor as a precise guarantee.
#
# Compute-intensive workloads yield far less (roughly 1.00/1.15/1.25/1.35).
# Selecting a curve per workload needs signals not staged (%usr vs %sys, CPI,
# cache behaviour); inferring it from the profile letter would repeat the
# pattern-major error. Commercial is assumed.
my $SMT_YIELD_CURVE_NAME    = 'commercial-default';
my $SMT_YIELD_CURVE_VERSION = 1;
my $SMT_YIELD_CURVE_SOURCE  = 'configured-policy';
my %SMT_YIELD_CURVE = ( 1 => 1.00, 2 => 1.45, 4 => 1.90, 8 => 2.35 );
my @SMT_YIELD_POINTS;   # lazily built, sorted [k, y] - see _smt_yield

# Fraction of estimated credible-peak throughput that must survive consolidation
# onto fewer active cores. Unlike the other numeric rVCPU controls, P is an
# explicit policy rung here: mission-critical workloads permit no intentional
# peak-throughput compression. The numbered tiers use the initial conservative
# ladder from the Tier-Aware CPU and VCPU Right-Sizing Policy Contract.
#
# These are configured POLICY assumptions and back-test candidates, not IBM
# constants. Changing them changes the binding yield-aware VP floor and must be
# versioned and estate-tested. The previous 0.95/0.90/0.85/0.80 ladder remains
# recorded in history; it was considered too aggressive before PhysB and
# outcome-based calibration because 80% throughput retention can translate into
# materially more than a 20% reduction in active-core width after SMT packing.
my %TIER_THROUGHPUT_RETENTION = (
    'P' => 1.00,  # Mission-critical: preserve the complete credible peak
     1  => 0.98,  # Performance-critical: near-complete peak protection
     2  => 0.95,  # Business-important: high retention with healthy burst scope
     3  => 0.92,  # Standard production: modest peak compression
     4  => 0.90,  # Economy-led: stronger consolidation, still pressure-aware
);

# A2.3: configured burst-width policy. This is deliberately conditional, not
# a universal entitlement multiplier. When an uncapped LPAR's credible P99W1
# peak has approached its CURRENT reachable width, the selected workload-
# profile demand is divided by this target VP utilisation to preserve explicit
# configured burst room. P is excluded because its raw credible peak already
# acts as a hard VP floor. These are policy/back-test candidates, not IBM rules.
my %VCPU_CONFIGURED_BURST_TARGET_UTILISATION = (
    1 => 0.80,
    2 => 0.80,
    3 => 0.85,
    4 => 0.90,
);

# Micro-partition RunQ envelope override.
# When a tiny partition (rENT < threshold) has strong RunQ evidence (runnable_density > threshold)
# that exceeds the PhysC-derived envelope, allow VP envelope to expand to meet RunQ demand.
# This addresses scheduling disadvantage in micro-partitions where PhysC under-reports true demand.
my $MICRO_PARTITION_RUNQ_OVERRIDE_ENT_THRESH  = 0.50;  # rENT_P must be below this
my $MICRO_PARTITION_RUNQ_OVERRIDE_CRED_THRESH = 1.50;  # runnable_density must exceed this
my $MICRO_PARTITION_RUNQ_MAX_VP_CAP           = 6;     # Absolute VP ceiling for override

# Tier-aware rVCPU headroom factors
# Higher tiers (lower latency tolerance) receive more conservative (wider) VP allocation.
# Applied to both the RunQ operating-point and the P99W1 peak floor.
# Split into separate maps if independent tuning is required later.
my %VCPU_TIER_HEADROOM_FACTORS = (
    1 => 1.25,  # Tier 1: +25% more width (low latency tolerance)
    2 => 1.15,  # Tier 2: +15% more width
    3 => 1.00,  # Tier 3: Baseline (no adjustment)
    4 => 0.95,  # Tier 4: Slightly moderated width
);

# Task 4: Tier-aware rate limiting on VP reduction (rVCPU_Tactical).
# Fraction of CURRENT VPs that may be removed in a single cycle, keyed on
# $rvcpu_tier_num. Tier 'P' continues to share the tier-1 tactical step and
# RunQ-width headroom factor for this interim phase; only peak-throughput
# retention now resolves P independently. Tactical-rate calibration is a
# separate policy decision and is intentionally unchanged by this patch.
#
# This is the FOURTH place tier appetite appears in the rVCPU chain. It is
# legitimate here because it governs CHANGE RATE, not sizing - a different
# question from the other three (profile percentile -> rENT -> ceil(rENT);
# $rvcpu_tier_num -> VP_RunQ via %VCPU_TIER_HEADROOM_FACTORS; and
# %TIER_THROUGHPUT_RETENTION -> the yield floor). Do not fold this into
# those three, and do not remove it as apparent double-counting.
#
# Back-test candidates, not findings (nFit - Interim VP Right-Sizing
# Implementation Strategy, Task 4 / open question 1). Tier 2 is interpolated
# pending its own back-test evidence.
my %VCPU_TIER_STAGE1_STEP_FRACTION = (
    1 => 0.25,  # P/tier-1: strictest - latency-sensitive, move cautiously
    2 => 0.35,  # Tier 2: interpolated pending back-test
    3 => 0.50,  # Tier 3: most permissive
    4 => 0.50,  # Tier 4: most permissive
);
my $VCPU_TIER_STAGE1_STEP_MIN_VP = 1;  # Floor so small partitions can still move

# A2.2: tactical VP-reduction safety policy. These thresholds classify the
# evidence; they do not alter strategic rVCPU or rVCPU_EntBounded. CLEAR uses
# the ordinary tier step, CAUTION permits at most one VP this cycle, and BLOCK
# holds the configured VP count. They are explicit back-test candidates rather
# than IBM limits and must be reviewed as estate evidence accumulates.
my $VCPU_REDUCTION_CAUTION_REACH_RATIO = 0.70;
my $VCPU_REDUCTION_BLOCK_REACH_RATIO   = 0.90;
my $VCPU_REDUCTION_CAUTION_PEAK_PAE    = 0.30;
my $VCPU_REDUCTION_CAUTION_PEAK_AAE    = 0.10;
my $VCPU_REDUCTION_CAUTION_MAX_STEP_VP = 1;

my $ENTITLEMENT_BURST_ALLOWANCE_FACTOR = 0.25;          # Allow uncapped VMs to burst 25% over their entitlement before pressure is assessed
my $BURST_ALLOWANCE_MIN_FACTOR = 0.0;
my $BURST_ALLOWANCE_MAX_FACTOR = 0.5;                   # Clamp at 50%

# Internal constants for growth heuristics (not user-configurable initially)
my $GROWTH_MIN_HISTORICAL_PERIODS       = 5;    # Min number of windowed periods to attempt trend
my $GROWTH_MAX_CV_THRESHOLD             = 0.50; # Max Coefficient of Variation (StdDev/Mean); if > this, data too volatile
my $GROWTH_MIN_POSITIVE_SLOPE_THRESHOLD = 0.01; # Min slope (units/period) to consider as actual growth for inflation
my $GROWTH_MAX_PROJECTION_HISTORY_RATIO = 2.0;  # Max ratio of projection duration to history duration used for trend
my $DEFAULT_GROWTH_PROJECTION_DAYS         = 90;
my $DEFAULT_MAX_GROWTH_INFLATION_PERCENT   = 25;

# RunQ Volatility Confidence Factor Thresholds & Values (adjusts additive CPU based on P90/P50 RunQ ratio)
my $VOLATILITY_SPIKY_THRESHOLD = 0.5;
my $VOLATILITY_SPIKY_FACTOR = 0.70;    # Very stable/spiky, less confidence in adding CPU
my $VOLATILITY_MODERATE_THRESHOLD = 0.8;
my $VOLATILITY_MODERATE_FACTOR = 0.85; # Moderately stable
my $RUNQ_PRESSURE_SATURATION_CONFIDENCE_FACTOR = 1.0; # Full confidence if RunQ saturation is high

# Task 5: the entitlement-reduction tunables are removed with the machinery they
# configured. This block previously held:
#   - the "CPU Downsizing Skip" constraint guard rail
#   - the dynamic blending weights (BasePhysC vs RunQ-derived efficient target)
#   - the volatility-sensitive reduction cap ladder and its scale factors
#   - the Single-Thread-Dominated (STD) workload heuristics
#   - the AAE/PAE/IQRC downsizing guardrail banding
# None of it survives Stage 5a. PAE and AAE themselves are NOT removed: they
# remain live diagnostics of chronic bursting (see PhysC_Daily_PAE/AAE and the
# chronic under-entitlement planner note in the rationale).

# --- Dispatch-Bound Workload (DBW) Anomaly Heuristics ---
# Detects workloads with very low CPU usage but extremely high dispatch contention.
my $DBW_LOW_UTIL_FACTOR = 0.5; # BasePhysC must be less than 50% of Entitlement.
my $DBW_DSR_THRESHOLD = 10.0;  # Dispatch Stress Ratio must be > 10.0.
my $DBW_MEDIAN_PRESSURE_THRESHOLD = 1.5; # NormRunQ P50 must be > 1.5.

# Task 5: $VOLATILITY_CAUTION_THRESHOLD, $NORM_P50_THRESHOLD_FOR_EFFICIENCY_CONSIDERATION
# and $MAX_EFFICIENCY_REDUCTION_PERCENTAGE are removed with the reduction.
# The two constants below are RETAINED - both are live outside the reduction:
#   MIN_P50_DENOMINATOR_FOR_VOLATILITY   - divide-by-zero guard in the NormRunQ IQRC calculation
#   DEFAULT_TARGET_NORM_RUNQ_FOR_EFFICIENCY_CALC - fallback rung in _resolve_runq_target(),
#                                          which the ADDITIVE path uses
my $MIN_P50_DENOMINATOR_FOR_VOLATILITY = 0.1;    # Min P50 value to avoid division by zero in volatility calc
my $DEFAULT_TARGET_NORM_RUNQ_FOR_EFFICIENCY_CALC = 0.8; # Base, SMT-dependent adjustments in calc sub (ADAPTIVE)

# --- Hot Thread Workload (HTW) Additive Dampening Heuristics ---
# These constants are used to detect and dampen additive CPU for workloads
# that appear constrained (e.g., single-threaded) despite high normalized RunQ.
my $HOT_THREAD_WL_ENT_FACTOR = 0.80;    # BasePhysC < Entitlement * this_factor
my $HOT_THREAD_WL_MAXCPU_FACTOR = 0.25;   # OR BasePhysC < MaxCPU * this_factor
my $HOT_THREAD_WL_HIGH_NORM_P50_THRESHOLD = 3.0; # NormRunQ P50 > this_threshold
# RUNQ_PRESSURE_P90_SATURATION_THRESHOLD (1.8) is an existing constant, also used here.
my $HOT_THREAD_WL_IQRC_THRESHOLD = 1.0;    # NormRunQ_IQRC > this_threshold (tune based on data)
my $HOT_THREAD_WL_DETECTION_MIN_CONDITIONS_MET = 4; # Minimum number of detection conditions to be met

# Dynamic Dampening Multipliers for HTW
my $HOT_THREAD_WL_BASE_DAMPENING_FACTOR = 0.25; # Base factor for the dynamic dampening calculation
my $HOT_THREAD_WL_MIN_DYNAMIC_DAMPENING = 0.05; # Floor for the final dynamic dampening factor
my $HOT_THREAD_WL_MAX_DYNAMIC_DAMPENING = 0.75; # Ceiling for the final dynamic dampening factor

# Enhanced Safety Caps for Additive CPU (applied AFTER all other factors)
my $ADDITIVE_CPU_SAFETY_CAP_FACTOR_OF_BASE = 2.0; # Max additive CPU as a multiple of BasePhysC
my $ADDITIVE_CPU_SAFETY_CAP_ABSOLUTE = 0.5;       # Absolute maximum additive CPU in cores

# CPU ceiling detection thresholds (two-tier system).
# Tier 1 (CAP_LIMITED): Informational - VM is running near MaxCPU consistently.
# Tier 2 (CPU_FLATLINING): Warning - Suspicious plateau not explained by genuine demand.
my $CPU_CEILING_PCT_OF_MAXCPU         = 0.97;   # BasePhysC >= this fraction of MaxCPU
my $CPU_CAPLIMITED_IQRC_THRESHOLD     = 0.05;   # PhysC_Daily_IQRC <= this (low variability)
my $CPU_FLATLINING_IQRC_THRESHOLD     = 0.03;   # PhysC_Daily_IQRC <= this (very low variability)
my $CPU_FLATLINING_PAE_THRESHOLD      = 0.95;   # PAE >= this (exceeds entitlement most days)
my $CPU_FLATLINING_AAE_THRESHOLD      = 0.40;   # AAE >= this (material average excess) - AND with PAE
my $CPU_FLATLINING_OVERLOAD_RATIO     = 1.10;   # RunQ/Reachable > this = genuine overload (not suspicious)
my $CPU_FLATLINING_MAX_TAGS           = 5;      # Maximum tags in VM_Comments column

# Partial CPU flat-lining detection (below MaxCPU).
# Purpose: high-confidence signal that a VM may be "stuck" at ~1-2 cores (or similar)
# with unusually low variability and corroborating RunQ pressure.
my $CPU_FLATLINING_PARTIAL_MIN_PCT_OF_MAXCPU        = 0.15;  # Lower bound for partial plateau band
my $CPU_FLATLINING_PARTIAL_MAX_PCT_OF_MAXCPU        = 0.85;  # Upper bound (must be below near-ceiling logic)
my $CPU_FLATLINING_PARTIAL_SEVERE_MAX_BASEPHYSC     = 2.25;  # Severe focuses on ~1-2 core-equivalents
my $CPU_FLATLINING_PARTIAL_SEVERE_MIN_BASEPHYSC     = 0.85;  # Exclude tiny background CPU
my $CPU_FLATLINING_PARTIAL_RUNQ_CORE_TOLERANCE      = 0.50;  # |RunQ_core_equiv - BasePhysC| <= this
my $CPU_FLATLINING_PARTIAL_PAE_THRESHOLD            = 0.90;  # Looser corroboration for partial (uncapped only)
my $CPU_FLATLINING_PARTIAL_AAE_THRESHOLD            = 0.25;
my $CPU_FLATLINING_PARTIAL_RUNQ_RATIO_FLOOR         = 0.60;  # Partial: require RunQ corroboration to be material

my $POOL_CONSTRAINT_CONFIDENCE_FACTOR = 0.80; # Reduction factor for additive CPU if VM is in a non-default pool

# --- Built-in default Target NormRunQ values for the adaptive heuristic ---
# Idealised run-queue depth per logical CPU that sizing aims for, per tier.
#
# SEMANTICS (confirmed with IBM): the AIX/nmon run-queue metrics count threads
# that are RUNNING plus threads WAITING for a processor - not waiting threads
# alone. The target is therefore TOTAL RUNNABLE threads per logical CPU at the
# recommended size:
#   0.25 = a quarter of the dispatch slots occupied (4x headroom)
#   1.00 = every dispatch slot occupied, nothing waiting (saturation boundary)
#   1.50 = 50% over-subscribed: one thread waiting for every two running
#   2.00 = one thread waiting for every thread running - poor practice at any tier
# Each rung is additionally evaluated at its own profile percentile and window
# (tier 1 = p99/W5 ... tier 4 = p90/W15), so the ladder carries a second,
# compounding gradient: a tier-4 rung tolerates a deeper queue AND is measured
# at a more forgiving percentile.
#
# TIER-MAJOR: risk appetite is a function of the tier NUMBER alone. The pattern
# letter is a time-window selector in nfit_profiles.cfg (-online / -batch / 24h)
# and carries no latency information: G1-99W5, O1-99W5 and B1-99W5 are identical
# but for their time filter. Keys are retained per pattern so that per-label
# overrides in nfit_profiles.cfg keep working; the values are tier-major.
# All values are back-test candidates.
my %DEFAULT_RUNQ_TARGETS = (
    'P'  => 0.25,                                    # Mission-critical: near-zero queueing
    'O1' => 0.45, 'G1' => 0.45, 'B1' => 0.45,        # Tier 1
    'O2' => 0.70, 'G2' => 0.70, 'B2' => 0.70,        # Tier 2
    'O3' => 1.00, 'G3' => 1.00, 'B3' => 1.00,        # Tier 3 (anchor: unchanged)
    'O4' => 1.50, 'G4' => 1.50, 'B4' => 1.50,        # Tier 4
);
my %custom_runq_targets;
my %tier_override_for_csv;


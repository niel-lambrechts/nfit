        print {$LOG_FH} "                         Investigate caps, resource constraints, or shaping policies.\n";
        print {$LOG_FH} "                       - CPU_FLATLINING_PARTIAL_SEVERE[<profile>]: Likely pathological\n";
        print {$LOG_FH} "                         partial plateau below MaxCPU (often ~1-2 cores). RunQ evidence\n";
        print {$LOG_FH} "                         aligns to plateau level; warrants investigation.\n";
        print {$LOG_FH} "                       - CPU_FLATLINING_PARTIAL[<profile>]: Partial plateau below MaxCPU\n";
        print {$LOG_FH} "                         with corroboration. Investigate if unexpected for workload.\n";
        print {$LOG_FH} "\n";
        print {$LOG_FH} "                     RunQ Anomalies:\n";
        print {$LOG_FH} "                       - ANOMALY_DBW[<profile>]: Dispatch Bottleneck Warning.\n";
        print {$LOG_FH} "                         High RunQ with low CPU utilisation; suggests blocking or\n";
        print {$LOG_FH} "                         application-level waits rather than CPU starvation.\n";
        print {$LOG_FH} "                       - ANOMALY_XRQ[<profile>]: Extreme RunQ Warning.\n";
        print {$LOG_FH} "                         RunQ demand exceeds plausible capacity; pathological state.\n";
        print {$LOG_FH} "\n";

        print {$LOG_FH} "  Pool and VP        End-of-system checks on the recommendations taken together. They change\n";
        print {$LOG_FH} "  Checks             no figure in the CSV; they say whether the proposals can be applied together.\n";
        print {$LOG_FH} "                     The order of each LPAR's own change is stated in NFIT - Action.\n";
        print {$LOG_FH} "\n";
        if (_cut_protection_wanted($current_cache_path))
        {
            print {$LOG_FH} "  Cut protection     A cut is limited so that it adds no observed contested exposure: the\n";
            print {$LOG_FH} "                     target is raised to the highest protected level seen in a contested\n";
            print {$LOG_FH} "                     minute, never above installed. Protected level = PhysB + share x\n";
            print {$LOG_FH} "                     (PhysC - PhysB); the profile's tier sets the share. See Cut Protection.\n";

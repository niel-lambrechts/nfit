        print {$LOG_FH} "                     equals the physical CPU required to execute the work.\n";
        print {$LOG_FH} "\n";
        print {$LOG_FH} "  Peak-throughput    The minimum active-core width that retains the tier-approved share of\n";
        print {$LOG_FH} "  protection         estimated credible-peak throughput after VP consolidation, using the SMT\n";
        print {$LOG_FH} "                     yield curve. Replaces the retired peak-credibility discount.\n";
        print {$LOG_FH} "\n";
        print {$LOG_FH} "  Configured         The conditional VP floor that retains configured burst room when a recent\n";
        print {$LOG_FH} "  burst width        credible peak approached current reachable width. Not a universal\n";
        print {$LOG_FH} "                     entitlement x 1.25 rule; inactive by default.\n";
        print {$LOG_FH} "\n";
        print {$LOG_FH} "  Queue-width        Run-queue-derived VPs divided by recommended VPs, as a percentage. A\n";
